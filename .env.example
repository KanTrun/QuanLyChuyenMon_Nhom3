# Local Docker defaults. Override before running if port/password conflicts.
APP_HTTP_PORT=8080
DB_PORT=14333
MSSQL_SA_PASSWORD=QlcmDev_ChangeMe_2026!
CHATBOT_API_KEY=
CHATBOT_PROVIDER=Gemini
CHATBOT_MODEL=gemini-2.5-flash
# Anthropic requires CHATBOT_PROVIDER=Anthropic and CHATBOT_BASE_URL=https://api.anthropic.com.
CHATBOT_BASE_URL=https://generativelanguage.googleapis.com
CHATBOT_MAX_TOKENS=4096
SMARTCA_ENABLED=false
SMARTCA_BASE_URL=https://rmgateway.vnptit.vn
SMARTCA_API_PREFIX=/sca/sp769
SMARTCA_SP_ID=
SMARTCA_SP_PASSWORD=
SMARTCA_DEFAULT_USER_ID=
SMARTCA_DEFAULT_SERIAL_NUMBER=
# Bind the default CA subscriber to exactly one app signer for sandbox use.
# Use either SMARTCA_SIGNER_USER_ID or SMARTCA_SIGNER_USERNAME.
SMARTCA_SIGNER_USER_ID=
SMARTCA_SIGNER_USERNAME=
# For multiple app users, set one-line JSON:
# [{"appUsername":"admin","subscriberId":"012345678901","serialNumber":"optional"}]
SMARTCA_USER_BINDINGS_JSON=
SMARTCA_CALLBACK_URL=
SMARTCA_REQUEST_TIMEOUT_SECONDS=45
