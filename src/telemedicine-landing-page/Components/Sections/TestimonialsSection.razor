<section class="testimonials-section section-band" aria-labelledby="testimonials-title">
    <div class="section-heading" style="text-align: center;">
        <p class="eyebrow">Phản hồi bệnh nhân</p>
        <h2 id="testimonials-title">Được tin dùng bởi hàng ngàn người bệnh.</h2>
    </div>

    <div class="testimonial-track">
        @foreach (var item in _testimonials)
        {
            <div class="testimonial-card">
                <div class="testimonial-avatar" style="background: linear-gradient(135deg, @item.AvatarColor, var(--color-secondary));">
                    @item.Name[0]
                </div>
                <div class="rating-stars">
                    @for (int i = 0; i < item.Rating; i++)
                    {
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="#f59e0b"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
                    }
                    @for (int i = item.Rating; i < 5; i++)
                    {
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="#e5e7eb"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
                    }
                </div>
                <p class="testimonial-quote">@item.Quote</p>
                <div class="testimonial-author">
                    <strong>@item.Name</strong>
                    <span>@item.Role</span>
                </div>
            </div>
        }
        @* Duplicate for seamless infinite scroll *@
        @foreach (var item in _testimonials)
        {
            <div class="testimonial-card">
                <div class="testimonial-avatar" style="background: linear-gradient(135deg, @item.AvatarColor, var(--color-secondary));">
                    @item.Name[0]
                </div>
                <div class="rating-stars">
                    @for (int i = 0; i < item.Rating; i++)
                    {
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="#f59e0b"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
                    }
                    @for (int i = item.Rating; i < 5; i++)
                    {
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="#e5e7eb"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
                    }
                </div>
                <p class="testimonial-quote">@item.Quote</p>
                <div class="testimonial-author">
                    <strong>@item.Name</strong>
                    <span>@item.Role</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record TestimonialData(string Name, string Role, int Rating, string Quote, string AvatarColor);

    private static readonly List<TestimonialData> _testimonials =
    [
        new("Nguyễn Văn A", "Bệnh nhân tim mạch", 5, "Giao diện dễ sử dụng, bác sĩ tận tâm. Tôi rất hài lòng với dịch vụ khám từ xa này.", "#3b82f6"),
        new("Trần Thị B", "Bệnh nhân nội tiết", 5, "Tiết kiệm thời gian đi lại. Bác sĩ tư vấn rất kỹ và chuyên nghiệp.", "#10b981"),
        new("Lê Văn C", "Bệnh nhân nhi khoa", 4, "Ứng dụng tiện lợi, đặt lịch nhanh chóng. Con tôi được chăm sóc tốt.", "#f59e0b"),
        new("Phạm Thị D", "Bệnh nhân đa khoa", 5, "Bảo mật thông tin tốt, kết quả xét nghiệm cập nhật nhanh chóng.", "#8b5cf6"),
        new("Hoàng Văn E", "Bệnh nhân thần kinh", 5, "Dịch vụ hỗ trợ 24/7 rất hữu ích. Cảm thấy an tâm hơn nhiều.", "#ec4899"),
        new("Võ Thị F", "Bệnh nhân cơ xương khớp", 4, "Theo dõi sức khỏe liên tục giúp tôi kiểm soát bệnh tốt hơn.", "#06b6d4")
    ];
}
