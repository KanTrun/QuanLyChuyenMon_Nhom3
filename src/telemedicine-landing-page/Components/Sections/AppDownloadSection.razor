<section id="download-app" class="site-shell download-section" aria-labelledby="download-title">
    <div class="download-copy reveal-left">
        <p class="eyebrow">Ứng dụng di động</p>
        <h2 id="download-title">Tải ứng dụng để tiếp tục chăm sóc sau mỗi lần khám.</h2>
        <p class="download-desc">Lịch hẹn, tin nhắn, kết quả và hướng dẫn tái khám nằm trong một ứng dụng duy nhất. Quản lý sức khỏe chưa bao giờ dễ dàng đến thế.</p>

        <ul class="feature-list">
            <li>Lịch hẹn và nhắc nhở</li>
            <li>Tin nhắn bác sĩ</li>
            <li>Kết quả xét nghiệm</li>
            <li>Hướng dẫn tái khám</li>
        </ul>

        <div class="rating-display">
            <span class="rating-score">4.8/5</span>
            <span class="rating-stars-visual">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="#f59e0b"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="#f59e0b"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="#f59e0b"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="#f59e0b"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="#f59e0b"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>
            </span>
        </div>

        <div class="store-actions" aria-label="Tải ứng dụng">
            <a class="store-button" href="@Links.AppStoreUrl">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                <span>App Store</span>
            </a>
            <a class="store-button" href="@Links.GooglePlayUrl">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85c-.5-.24-.84-.76-.84-1.35zm13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27zm.91-.91L19.59 12 17.72 10.79l-2.27 2.27 2.27 2.15zM6.05 2.66l10.76 6.22-2.27 2.27-8.49-8.49z"/></svg>
                <span>Google Play</span>
            </a>
        </div>
    </div>

    <div class="download-visual reveal-right">
        <div class="phone-frame">
            <div class="phone-notch"></div>
            <div class="phone-screen">
                <div class="qr-code" aria-hidden="true">
                    @for (var index = 0; index < 49; index++)
                    {
                        <span class="@GetQrCellClass(index)"></span>
                    }
                </div>
                <div class="scan-line"></div>
            </div>
        </div>
        <p class="qr-label">Quét mã tại quầy tiếp đón hoặc trong email xác nhận lịch hẹn.</p>
    </div>
</section>

@code {
    private static readonly HashSet<int> DarkCells =
    [
        0, 1, 2, 4, 6, 7, 8, 12, 14, 16, 18, 20, 22, 25, 27,
        28, 30, 33, 35, 36, 38, 40, 42, 44, 45, 46, 48
    ];

    [Parameter, EditorRequired]
    public required LandingPageLinksOptions Links { get; set; }

    private static string GetQrCellClass(int index) => DarkCells.Contains(index) ? "is-dark" : "";
}
