<section id="specialists" class="site-shell specialists-section section-decorated" aria-labelledby="specialists-title">
    <div class="section-heading reveal">
        <p class="eyebrow">Danh bạ chuyên khoa</p>
        <h2 id="specialists-title">Tìm bác sĩ theo chuyên khoa và lịch trong ngày.</h2>
        <a class="text-link" href="@Links.FindSpecialistUrl">Xem tất cả chuyên khoa</a>
    </div>

    <div class="filter-row reveal" aria-label="Bộ lọc chuyên khoa đề xuất">
        <span class="filter-pill hover-glow">Tim mạch</span>
        <span class="filter-pill hover-glow">Nội tiết</span>
        <span class="filter-pill hover-glow">Nhi khoa</span>
        <span class="filter-pill hover-glow active">Có lịch trong ngày</span>
    </div>

    <div class="specialist-grid">
        @{ var idx = 0; }
        @foreach (var specialist in Specialists)
        {
            <article class="specialist-card reveal stagger-@(++idx)">
                <div class="specialist-photo @specialist.ToneClass" aria-hidden="true"></div>
                <div class="specialist-overlay">
                    <p class="availability-status">
                        <span class="availability-dot" aria-hidden="true"></span>
                        @specialist.Availability
                    </p>
                    <a class="btn-book" href="@Links.FindSpecialistUrl">Đặt lịch</a>
                </div>
                <div class="specialist-info">
                    <p class="specialty">@specialist.Specialty</p>
                    <h3>@specialist.Name</h3>
                    <p class="department">@specialist.Department</p>
                </div>
                <dl>
                    <div>
                        <dt>Lịch gần nhất</dt>
                        <dd>@specialist.Availability</dd>
                    </div>
                    <div>
                        <dt>Ngôn ngữ</dt>
                        <dd>@specialist.Languages</dd>
                    </div>
                </dl>
            </article>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<SpecialistProfile> Specialists { get; set; }

    [Parameter, EditorRequired]
    public required LandingPageLinksOptions Links { get; set; }
}
