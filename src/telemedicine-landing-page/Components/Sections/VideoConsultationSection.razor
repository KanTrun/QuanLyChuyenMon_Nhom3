<section id="consultation" class="section-band video-section section-decorated" aria-labelledby="consultation-title">
    <div class="site-shell split-section">
        <div class="section-copy reveal-left">
            <p class="eyebrow">Xem trước tư vấn video</p>
            <h2 id="consultation-title" class="text-gradient">Một phiên khám rõ ràng cho cả bác sĩ và người bệnh.</h2>
            <p>
                Giao diện ưu tiên âm thanh, hình ảnh, thông tin sinh tồn và ghi chú lâm sàng.
                Mọi nội dung trong bản xem trước vẫn đọc được khi tắt chuyển động.
            </p>

            <div class="step-process">
                <div class="step-line" aria-hidden="true"></div>
                <div class="step-item stagger-1">
                    <span class="step-number">1</span>
                    <p>Xác thực người bệnh và triệu chứng chính</p>
                </div>
                <div class="step-item stagger-2">
                    <span class="step-number">2</span>
                    <p>Mở hồ sơ tóm tắt, chỉ số theo dõi</p>
                </div>
                <div class="step-item stagger-3">
                    <span class="step-number">3</span>
                    <p>Kết thúc với hướng dẫn tái khám</p>
                </div>
            </div>
        </div>

        <div class="consult-preview reveal-right">
            <div class="consult-header">
                <span>Phòng khám từ xa</span>
                <span class="encryption-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Đã mã hóa
                </span>
            </div>
            <div class="consult-grid">
                <div class="consult-main portrait-sky">
                    <span>BS. Minh An</span>
                </div>
                <aside class="consult-side">
                    <div class="mini-video portrait-mint">Người bệnh</div>
                    <div class="vital-card">
                        <span>Mạch</span>
                        <strong class="counter-animate">72</strong>
                        <span class="vital-unit">bpm</span>
                        <span class="pulse-dot" aria-hidden="true"></span>
                    </div>
                </aside>
            </div>
            <div class="live-badge" aria-label="Đang kết nối">
                <span class="live-dot" aria-hidden="true"></span>
                Đang kết nối...
            </div>
            <details class="call-flow">
                <summary>Xem quy trình cuộc gọi</summary>
                <ol>
                    <li>Xác thực người bệnh và triệu chứng chính.</li>
                    <li>Mở hồ sơ tóm tắt, chỉ số theo dõi và đơn thuốc gần nhất.</li>
                    <li>Kết thúc bằng hướng dẫn tái khám và thông báo trên ứng dụng.</li>
                </ol>
            </details>
        </div>
    </div>
</section>
