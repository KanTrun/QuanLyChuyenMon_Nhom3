<!-- ═══ Trust Ticker — Horizontal Infinite Scroll ═══ -->
<section class="trust-ticker" aria-label="Tin cay va van hanh">
    <div class="ticker-track">
        @foreach (var signal in Signals)
        {
            <article class="ticker-card reveal">
                <strong>@signal.Value</strong>
                <span>@signal.Label</span>
                <p>@signal.Detail</p>
            </article>
        }
        <!-- Duplicate for seamless infinite loop -->
        @foreach (var signal in Signals)
        {
            <article class="ticker-card" aria-hidden="true">
                <strong>@signal.Value</strong>
                <span>@signal.Label</span>
                <p>@signal.Detail</p>
            </article>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<TrustSignal> Signals { get; set; }
}
