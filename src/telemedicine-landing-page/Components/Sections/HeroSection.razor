<header class="site-shell site-header" id="site-header" aria-label="Điều hướng chính">
    <a class="brand-mark" href="/" aria-label="Trang chủ Bệnh viện số">
        <span class="brand-symbol" aria-hidden="true"></span>
        <span>Bệnh viện số</span>
    </a>
    <div class="site-header-cta">
        <a class="header-nav-link" href="/login">Đăng nhập</a>
        <a class="header-action" href="/register">Đăng ký ngay</a>
    </div>
</header>

<section class="hero-section" aria-labelledby="hero-title">
    <div class="hero-layer" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>
    <div class="site-shell hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Nền tảng y tế từ xa thế hệ mới</p>
            <h1 id="hero-title">Sức khỏe của bạn, được chăm sóc mọi lúc mọi nơi.</h1>
            <p class="hero-lede">
                Tiếp cận các chuyên gia y tế hàng đầu qua các phiên khám video bảo mật cao. Quản lý hồ sơ sức khỏe và theo dõi chỉ số sống một cách dễ dàng với giao diện thân thiện, hiện đại.
            </p>
            <div class="hero-actions" aria-label="Hành động chính">
                <a class="button button-primary" href="/login">Đăng nhập</a>
                <a class="button button-secondary" href="/register">Đăng ký tài khoản</a>
            </div>

            <div class="hero-trust">
                <div class="hero-trust-avatars" aria-hidden="true">
                    <span class="hero-trust-avatar hero-trust-avatar--primary"></span>
                    <span class="hero-trust-avatar hero-trust-avatar--secondary"></span>
                    <span class="hero-trust-avatar hero-trust-avatar--accent"></span>
                </div>
                <span>Được tin dùng bởi hơn <strong>10,000+</strong> bệnh nhân</span>
            </div>
        </div>

        <div class="hero-device" aria-label="Màn hình xem trước ứng dụng khám từ xa">
            <div class="device-topbar">
                <span>Phòng khám trực tuyến</span>
                <strong>09:40 AM</strong>
            </div>
            <div class="video-preview">
                <div class="doctor-frame portrait-sky">
                    <div class="doctor-frame-caption">ThS. BS Trần Minh An</div>
                </div>
                <div class="patient-frame portrait-mint"></div>
                <div class="call-status">Đang kết nối...</div>
            </div>
            <div class="metric-strip">
                @foreach (var stat in Stats)
                {
                    <span><strong>@stat.Value</strong>@stat.Label</span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required LandingPageLinksOptions Links { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<LandingStat> Stats { get; set; }
}
