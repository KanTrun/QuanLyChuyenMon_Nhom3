<header class="site-shell site-header" id="site-header" aria-label="Điều hướng chính">
    <a class="brand-mark" href="/" aria-label="Trang chủ Bệnh viện số">
        <span class="brand-symbol" aria-hidden="true"></span>
        <span>Bệnh viện số</span>
    </a>
    <nav class="header-nav" aria-label="Điều hướng nội dung">
        <a href="#consultation">Tư vấn video</a>
        <a href="#specialists">Chuyên khoa</a>
        <a href="#tracking">Theo dõi sức khỏe</a>
    </nav>
    <a class="header-action" href="/login">Đăng nhập</a>
</header>

<section class="hero-section" aria-labelledby="hero-title">
    <div class="hero-layer" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>
    <div class="site-shell hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Nền tảng khám từ xa cho hệ thống bệnh viện</p>
            <h1 id="hero-title">Chăm sóc liên tục, từ phòng khám đến màn hình nhà bạn.</h1>
            <p class="hero-lede">
                Đặt lịch, gặp bác sĩ qua video bảo mật, xem hồ sơ sức khỏe và theo dõi chỉ số
                trong một trải nghiệm nhẹ, rõ ràng và đáng tin cậy.
            </p>
            <div class="hero-actions" aria-label="Hành động chính">
                <a class="button button-primary" href="@Links.StartVisitUrl">Bắt đầu khám video</a>
                <a class="button button-secondary" href="@Links.FindSpecialistUrl">Tìm bác sĩ</a>
            </div>
        </div>

        <div class="hero-device" aria-label="Màn hình xem trước ứng dụng khám từ xa">
            <div class="device-topbar">
                <span>Phiên khám bảo mật</span>
                <strong>09:40</strong>
            </div>
            <div class="video-preview">
                <div class="doctor-frame portrait-sky"></div>
                <div class="patient-frame portrait-mint"></div>
                <div class="call-status">Sẵn sàng tư vấn</div>
            </div>
            <div class="metric-strip">
                @foreach (var stat in Stats)
                {
                    <span><strong>@stat.Value</strong>@stat.Label</span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required LandingPageLinksOptions Links { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<LandingStat> Stats { get; set; }
}
