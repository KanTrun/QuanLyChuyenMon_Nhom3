<!-- ═══ Floating Glass Navbar ═══ -->
<header class="site-shell site-header" id="site-header" aria-label="Điều hướng chính">
    <a class="brand-mark" href="/" aria-label="Trang chủ Bệnh viện số">
        <span class="brand-symbol" aria-hidden="true"></span>
        <span>Bệnh viện số</span>
    </a>
    <nav class="header-nav" aria-label="Điều hướng nội dung">
        <a href="#consultation">Tư vấn video</a>
        <a href="#specialists">Chuyên khoa</a>
        <a href="#tracking">Theo dõi sức khỏe</a>
    </nav>
    <div class="header-auth">
        <a class="header-login" href="/login">Đăng nhập</a>
        <a class="header-action" href="/register">Đăng ký</a>
    </div>
</header>

<!-- ═══ Cinematic Hero Section ═══ -->
<section class="hero-section" aria-labelledby="hero-title">
    <!-- Animated Gradient Mesh Background -->
    <div class="hero-layer" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="orb orb-4"></div>
    </div>

    <!-- Hero Content: 2-column grid -->
    <div class="site-shell hero-content">
        <!-- Left Column: Copy -->
        <div class="hero-copy reveal">
            <p class="eyebrow">Nền tảng y tế từ xa thế hệ mới</p>
            <h1 id="hero-title" class="text-reveal">
                Sức khỏe của bạn, được chăm sóc mọi lúc mọi nơi.
            </h1>
            <p class="hero-lede">
                Tiếp cận các chuyên gia y tế hàng đầu qua các phiên khám video bảo mật cao.
                Quản lý hồ sơ sức khỏe và theo dõi chỉ số sống một cách dễ dàng với giao diện
                thân thiện, hiện đại.
            </p>
            <div class="hero-actions" aria-label="Hành động chính">
                <a class="button button-primary" href="@Links.StartVisitUrl">Đặt lịch khám ngay</a>
                <a class="button button-secondary" href="@Links.FindSpecialistUrl">Tìm bác sĩ</a>
            </div>

            <!-- Social Proof Strip -->
            <div class="social-proof-strip">
                <div class="avatar-stack" aria-hidden="true">
                    <span class="avatar avatar-1"></span>
                    <span class="avatar avatar-2"></span>
                    <span class="avatar avatar-3"></span>
                    <span class="avatar avatar-4"></span>
                </div>
                <span class="social-proof-text">Được tin dùng bởi hơn <strong data-counter="10000">10,000+</strong> bệnh nhân</span>
            </div>
        </div>

        <!-- Right Column: 3D Device Mockup -->
        <div class="hero-device reveal-right" data-parallax-speed="0.3" aria-label="Màn hình xem trước ứng dụng khám từ xa">
            <div class="device-topbar">
                <span>Phòng khám trực tuyến</span>
                <strong>09:40 AM</strong>
            </div>
            <div class="video-preview">
                <div class="doctor-frame">
                    <div class="doctor-label">ThS. BS Trần Minh An</div>
                </div>
                <div class="patient-frame"></div>
                <div class="call-status">
                    <span class="pulse-dot" aria-hidden="true"></span>
                    Đang kết nối...
                </div>
            </div>
            <div class="metric-strip">
                @foreach (var stat in Stats)
                {
                    <span class="metric-item">
                        <strong data-counter="@stat.Value">@stat.Value</strong>
                        @stat.Label
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required LandingPageLinksOptions Links { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<LandingStat> Stats { get; set; }
}
