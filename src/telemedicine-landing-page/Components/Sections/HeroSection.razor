<header class="site-shell site-header" id="site-header" aria-label="Điều hướng chính">
    <a class="brand-mark" href="/" aria-label="Trang chủ Bệnh viện số">
        <span class="brand-symbol" aria-hidden="true"></span>
        <span>Bệnh viện số</span>
    </a>
    <nav class="header-nav" aria-label="Điều hướng nội dung">
        <a href="#consultation">Tư vấn video</a>
        <a href="#specialists">Chuyên khoa</a>
        <a href="#tracking">Theo dõi sức khỏe</a>
    </nav>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <a class="header-nav" href="/login" style="color: var(--color-ink); text-decoration: none; font-weight: 500; font-size: 0.9rem; padding: 0.5rem 1rem;">Đăng nhập</a>
        <a class="header-action" href="/register">Đăng ký ngay</a>
    </div>
</header>

<section class="hero-section" aria-labelledby="hero-title">
    <div class="hero-layer" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>
    <div class="site-shell hero-content">
        <div class="hero-copy">
            <p class="eyebrow">Nền tảng y tế từ xa thế hệ mới</p>
            <h1 id="hero-title">Sức khỏe của bạn, được chăm sóc mọi lúc mọi nơi.</h1>
            <p class="hero-lede">
                Tiếp cận các chuyên gia y tế hàng đầu qua các phiên khám video bảo mật cao. Quản lý hồ sơ sức khỏe và theo dõi chỉ số sống một cách dễ dàng với giao diện thân thiện, hiện đại.
            </p>
            <div class="hero-actions" aria-label="Hành động chính">
                <a class="button button-primary" href="@Links.StartVisitUrl">Đặt lịch khám ngay</a>
                <a class="button button-secondary" href="@Links.FindSpecialistUrl">Tìm bác sĩ</a>
            </div>
            
            <div style="margin-top: 3rem; display: flex; align-items: center; gap: 1rem; color: var(--color-muted); font-size: 0.85rem;">
                <div style="display: flex; margin-left: 0.5rem;">
                    <!-- Placeholder avatar stack -->
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-primary-light); border: 2px solid white; margin-left: -0.5rem;"></div>
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-secondary-light); border: 2px solid white; margin-left: -0.5rem;"></div>
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-accent); border: 2px solid white; margin-left: -0.5rem;"></div>
                </div>
                <span>Được tin dùng bởi hơn <strong>10,000+</strong> bệnh nhân</span>
            </div>
        </div>

        <div class="hero-device" aria-label="Màn hình xem trước ứng dụng khám từ xa">
            <div class="device-topbar">
                <span>Phòng khám trực tuyến</span>
                <strong>09:40 AM</strong>
            </div>
            <div class="video-preview">
                <div class="doctor-frame portrait-sky">
                    <div style="position: absolute; bottom: 1rem; left: 1rem; background: rgba(0,0,0,0.5); color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; backdrop-filter: blur(4px);">ThS. BS Trần Minh An</div>
                </div>
                <div class="patient-frame portrait-mint"></div>
                <div class="call-status">Đang kết nối...</div>
            </div>
            <div class="metric-strip">
                @foreach (var stat in Stats)
                {
                    <span><strong>@stat.Value</strong>@stat.Label</span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required LandingPageLinksOptions Links { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<LandingStat> Stats { get; set; }
}
