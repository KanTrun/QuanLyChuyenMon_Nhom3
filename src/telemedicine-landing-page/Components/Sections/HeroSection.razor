<!-- ═══ Floating Glass Navbar ═══ -->
<header class="site-shell site-header" id="site-header" aria-label="Dieu huong chinh">
    <a class="brand-mark" href="/" aria-label="Trang chu Benh vien so">
        <span class="brand-symbol" aria-hidden="true"></span>
        <span>Benh vien so</span>
    </a>
    <nav class="header-nav" aria-label="Dieu huong noi dung">
        <a href="#consultation">Tu van video</a>
        <a href="#specialists">Chuyen khoa</a>
        <a href="#tracking">Theo doi suc khoe</a>
    </nav>
    <div class="header-auth">
        <a class="header-login" href="/login">Dang nhap</a>
        <a class="header-action" href="/register">Dang ky</a>
    </div>
</header>

<!-- ═══ Cinematic Hero Section ═══ -->
<section class="hero-section" aria-labelledby="hero-title">
    <!-- Animated Gradient Mesh Background -->
    <div class="hero-layer" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="orb orb-4"></div>
    </div>

    <!-- Hero Content: 2-column grid -->
    <div class="site-shell hero-content">
        <!-- Left Column: Copy -->
        <div class="hero-copy reveal">
            <p class="eyebrow">Nen tang y te tu xa the he moi</p>
            <h1 id="hero-title" class="text-reveal">
                Suc khoe cua ban, duoc cham soc moi luc moi noi.
            </h1>
            <p class="hero-lede">
                Tiep can cac chuyen gia y te hang dau qua cac phien kham video bao mat cao.
                Quan ly ho so suc khoe va theo doi chi so song mot cach de dang voi giao dien
                than thien, hien dai.
            </p>
            <div class="hero-actions" aria-label="Hanh dong chinh">
                <a class="button button-primary" href="@Links.StartVisitUrl">Dat lich kham ngay</a>
                <a class="button button-secondary" href="@Links.FindSpecialistUrl">Tim bac si</a>
            </div>

            <!-- Social Proof Strip -->
            <div class="social-proof-strip">
                <div class="avatar-stack" aria-hidden="true">
                    <span class="avatar avatar-1"></span>
                    <span class="avatar avatar-2"></span>
                    <span class="avatar avatar-3"></span>
                    <span class="avatar avatar-4"></span>
                </div>
                <span class="social-proof-text">Duoc tin dung boi hon <strong data-counter="10000">10,000+</strong> benh nhan</span>
            </div>
        </div>

        <!-- Right Column: 3D Device Mockup -->
        <div class="hero-device reveal-right" data-parallax-speed="0.3" aria-label="Man hinh xem truoc ung dung kham tu xa">
            <div class="device-topbar">
                <span>Phong kham truc tuyen</span>
                <strong>09:40 AM</strong>
            </div>
            <div class="video-preview">
                <div class="doctor-frame">
                    <div class="doctor-label">ThS. BS Tran Minh An</div>
                </div>
                <div class="patient-frame"></div>
                <div class="call-status">
                    <span class="pulse-dot" aria-hidden="true"></span>
                    Dang ket noi...
                </div>
            </div>
            <div class="metric-strip">
                @foreach (var stat in Stats)
                {
                    <span class="metric-item">
                        <strong data-counter="@stat.Value">@stat.Value</strong>
                        @stat.Label
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required LandingPageLinksOptions Links { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<LandingStat> Stats { get; set; }
}
