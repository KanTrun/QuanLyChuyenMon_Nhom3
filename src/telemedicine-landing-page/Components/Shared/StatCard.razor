@* StatCard.razor - Reusable statistics card with icon, value, trend *@

<div class="stat-card stat-card--@ColorClass">
    <div class="stat-card__icon-wrap">
        @Icon
    </div>
    <div class="stat-card__content">
        <span class="stat-card__title">@Title</span>
        <span class="stat-card__value">@Value</span>
        <span class="stat-card__trend stat-card__trend--@TrendDirection">
            @if (TrendDirection == "up")
            {
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 11V3M4 5l3-3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            }
            else if (TrendDirection == "down")
            {
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 3v8M4 9l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            }
            @TrendText
        </span>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string TrendText { get; set; } = "";
    [Parameter] public string TrendDirection { get; set; } = "neutral"; // up, down, neutral
    [Parameter] public string ColorClass { get; set; } = "primary"; // primary, warning, success, info
}
