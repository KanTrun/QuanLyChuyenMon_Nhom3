@* SidebarNav.razor - Collapsible sidebar navigation for authenticated area *@

<aside class="sidebar @(IsCollapsed ? "sidebar--collapsed" : "")" aria-label="Menu dieu huong chinh">
    <!-- Logo & Collapse Toggle -->
    <div class="sidebar__header">
        @if (!IsCollapsed)
        {
            <a href="/dashboard" class="sidebar__logo" aria-label="Trang chu QLCM Pro">
                <span class="sidebar__logo-icon">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                        <rect width="28" height="28" rx="8" fill="url(#logo-gradient)"/>
                        <path d="M8 14h12M14 8v12M10 10l8 8M18 10l-8 8" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                        <defs><linearGradient id="logo-gradient" x1="0" y1="0" x2="28" y2="28"><stop stop-color="#2563eb"/><stop offset="1" stop-color="#06b6d4"/></linearGradient></defs>
                    </svg>
                </span>
                <span class="sidebar__logo-text">QLCM Pro</span>
            </a>
        }
        else
        {
            <a href="/dashboard" class="sidebar__logo sidebar__logo--mini" aria-label="Trang chu QLCM Pro">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                    <rect width="28" height="28" rx="8" fill="url(#logo-gradient-mini)"/>
                    <path d="M8 14h12M14 8v12M10 10l8 8M18 10l-8 8" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
                    <defs><linearGradient id="logo-gradient-mini" x1="0" y1="0" x2="28" y2="28"><stop stop-color="#2563eb"/><stop offset="1" stop-color="#06b6d4"/></linearGradient></defs>
                </svg>
            </a>
        }
        <button class="sidebar__toggle" @onclick="ToggleCollapsed" aria-label="@(IsCollapsed ? "Mo rong menu" : "Thu gon menu")" title="@(IsCollapsed ? "Mo rong" : "Thu gon")">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                @if (IsCollapsed)
                {
                    <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                }
                else
                {
                    <path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                }
            </svg>
        </button>
    </div>

    <!-- Navigation Groups -->
    <nav class="sidebar__nav" aria-label="Menu chinh">
        <!-- TONG QUAN -->
        <div class="sidebar__group">
            @if (!IsCollapsed) { <span class="sidebar__group-label">TONG QUAN</span> }
            <a href="/dashboard" class="sidebar__item @(IsActive("/dashboard") ? "sidebar__item--active" : "")" aria-current="@(IsActive("/dashboard") ? "page" : null)">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="2" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="2" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="11" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="11" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.5"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Dashboard</span> }
            </a>
        </div>

        <!-- QUY TRINH -->
        <div class="sidebar__group">
            @if (!IsCollapsed) { <span class="sidebar__group-label">QUY TRINH</span> }
            <a href="/procedures" class="sidebar__item @(IsActive("/procedures") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 3h12a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.5"/><path d="M7 7h6M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Quy trinh KT</span> }
            </a>
            <a href="/procedures/create" class="sidebar__item @(IsActive("/procedures/create") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="3" y="3" width="14" height="14" rx="3" stroke="currentColor" stroke-width="1.5"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Tao moi</span> }
            </a>
            <a href="/procedures/publish" class="sidebar__item @(IsActive("/procedures/publish") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3v8M6 7l4-4 4 4M4 13v2a2 2 0 002 2h8a2 2 0 002-2v-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Ban hanh</span> }
            </a>
        </div>

        <!-- PHAN QUYEN -->
        <div class="sidebar__group">
            @if (!IsCollapsed) { <span class="sidebar__group-label">PHAN QUYEN</span> }
            <a href="/permissions" class="sidebar__item @(IsActive("/permissions") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2l7 4v5c0 3.5-2.8 6.5-7 8-4.2-1.5-7-4.5-7-8V6l7-4z" stroke="currentColor" stroke-width="1.5"/><path d="M7 10l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Thiet lap</span> }
            </a>
            <a href="/permissions/adjust" class="sidebar__item @(IsActive("/permissions/adjust") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 5h12M4 10h12M4 15h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="5" r="2" fill="currentColor"/><circle cx="14" cy="10" r="2" fill="currentColor"/><circle cx="6" cy="15" r="2" fill="currentColor"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Dieu chinh</span> }
            </a>
            <a href="/permissions/audit" class="sidebar__item @(IsActive("/permissions/audit") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 4h12v12H4z" stroke="currentColor" stroke-width="1.5" rx="2"/><path d="M7 8h6M7 11h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="15" cy="15" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M17 17l2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Nhat ky</span> }
            </a>
        </div>

        <!-- DANH MUC -->
        <div class="sidebar__group">
            @if (!IsCollapsed) { <span class="sidebar__group-label">DANH MUC</span> }
            <a href="/catalog" class="sidebar__item @(IsActive("/catalog") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 5a2 2 0 012-2h10a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V5z" stroke="currentColor" stroke-width="1.5"/><path d="M3 8h14M8 8v9" stroke="currentColor" stroke-width="1.5"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Ky thuat & Dinh muc</span> }
            </a>
            <a href="/catalog/reports" class="sidebar__item @(IsActive("/catalog/reports") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 17V7l4-4h6l4 4v10a1 1 0 01-1 1H4a1 1 0 01-1-1z" stroke="currentColor" stroke-width="1.5"/><path d="M7 12v4M10 9v7M13 11v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Bao cao tieu thu</span> }
            </a>
        </div>

        <!-- LAM SANG -->
        <div class="sidebar__group">
            @if (!IsCollapsed) { <span class="sidebar__group-label">LAM SANG</span> }
            <a href="/protocols" class="sidebar__item @(IsActive("/protocols") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2a4 4 0 014 4v1h1a2 2 0 012 2v7a2 2 0 01-2 2H5a2 2 0 01-2-2V9a2 2 0 012-2h1V6a4 4 0 014-4z" stroke="currentColor" stroke-width="1.5"/><path d="M8 12h4M10 10v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Phac do</span> }
            </a>
            <a href="/protocols/suggest" class="sidebar__item @(IsActive("/protocols/suggest") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2a6 6 0 014 10.5V15a2 2 0 01-2 2H8a2 2 0 01-2-2v-2.5A6 6 0 0110 2z" stroke="currentColor" stroke-width="1.5"/><path d="M8 18h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Goi y ICD</span> }
            </a>
        </div>

        <!-- HE THONG -->
        <div class="sidebar__group">
            @if (!IsCollapsed) { <span class="sidebar__group-label">HE THONG</span> }
            <a href="/notifications" class="sidebar__item @(IsActive("/notifications") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2a5 5 0 015 5v3l2 2H3l2-2V7a5 5 0 015-5z" stroke="currentColor" stroke-width="1.5"/><path d="M8 15a2 2 0 004 0" stroke="currentColor" stroke-width="1.5"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Thong bao</span> }
            </a>
            <a href="/reports" class="sidebar__item @(IsActive("/reports") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 3v14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M7 13l3-4 3 2 4-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Bao cao</span> }
            </a>
            <a href="/settings" class="sidebar__item @(IsActive("/settings") ? "sidebar__item--active" : "")">
                <span class="sidebar__item-icon">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.9 4.9l1.4 1.4M13.7 13.7l1.4 1.4M4.9 15.1l1.4-1.4M13.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                @if (!IsCollapsed) { <span class="sidebar__item-label">Cai dat</span> }
            </a>
        </div>
    </nav>

    <!-- User Profile Mini Card -->
    <div class="sidebar__footer">
        <div class="sidebar__user">
            <div class="sidebar__user-avatar" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M3 18c0-3.3 3.1-6 7-6s7 2.7 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            @if (!IsCollapsed)
            {
                <div class="sidebar__user-info">
                    <span class="sidebar__user-name">BS. Nguyen Van A</span>
                    <span class="sidebar__user-role">Quan tri vien</span>
                </div>
            }
        </div>
        <a href="/login" class="sidebar__logout" title="Dang xuat" aria-label="Dang xuat">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M7 17H4a1 1 0 01-1-1V4a1 1 0 011-1h3M13 14l4-4-4-4M17 10H7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
    </div>
</aside>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private bool IsActive(string href)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrEmpty(relativePath)) relativePath = "/";
        else relativePath = "/" + relativePath;

        if (href == "/dashboard" && relativePath == "/dashboard") return true;
        if (href != "/dashboard" && relativePath.StartsWith(href, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task ToggleCollapsed()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }
}
