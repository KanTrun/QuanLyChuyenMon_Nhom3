@* Compact pagination bar showing prev/next + range label. *@

@if (TotalItems > 0)
{
    <div class="admin-pagination" role="navigation" aria-label="Phân trang">
        <span class="admin-pagination-info">
            Hiển thị @from-@to / tổng @TotalItems
        </span>
        <div class="admin-pagination-controls">
            <button type="button" class="admin-pagination-btn" @onclick="OnPrev" disabled="@(!HasPrev)" aria-label="Trang trước">
                <span aria-hidden="true">←</span>
                Trước
            </button>
            <span class="admin-pagination-page" aria-live="polite">Trang @CurrentPage / @TotalPages</span>
            <button type="button" class="admin-pagination-btn" @onclick="OnNext" disabled="@(!HasNext)" aria-label="Trang sau">
                Sau
                <span aria-hidden="true">→</span>
            </button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public int CurrentPage { get; set; }
    [Parameter, EditorRequired] public int PageSize { get; set; } = 10;
    [Parameter, EditorRequired] public int TotalItems { get; set; }
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)PageSize));
    private bool HasPrev => CurrentPage > 1;
    private bool HasNext => CurrentPage < TotalPages;
    private int from => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int to => Math.Min(TotalItems, CurrentPage * PageSize);

    private async Task OnPrev()
    {
        if (!HasPrev) return;
        await CurrentPageChanged.InvokeAsync(CurrentPage - 1);
    }

    private async Task OnNext()
    {
        if (!HasNext) return;
        await CurrentPageChanged.InvokeAsync(CurrentPage + 1);
    }
}
