        => Sql.MedLookups.ProcedureTypes.FirstOrDefault(item => item.Code == code)?.Name ?? code;

    private static string AttachmentTypeName(string code)
        => Sql.MedLookups.AttachmentTypes.FirstOrDefault(item => item.Code == code)?.Name ?? code;

    private static string VersionLabel(Sql.ProcedureVersion version) => version.VersionLabel ?? $"v{version.VersionNo:00}";
    private static string StatusLabel(string status) => Sql.MedLookups.VersionStatuses.FirstOrDefault(s => s.Code == status)?.Name ?? status;
    private static string VersionTone(string status) => status switch
    {
        "active" => "tone-success",
        "pending_approval" => "tone-warning",
        "rejected" or "archived" => "tone-danger",
        "draft" => "tone-muted",
        _ => "tone-muted"
    };

    private static string FormatBytes(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.##} MB" : $"{bytes / 1024d:0.##} KB";

    private sealed record SignatureCard(
        string RoleLabel,
        string StatusLabel,
        string Tone,
        string SignerLabel,
        string SignedAtLabel,
        string? SignatureImageDataUrl,
        string? HashLabel,
        bool Signed,
        bool Stale);
    private sealed record WriterSignoffRow(
        string WriterName,
        int DisplayOrder,
        string StatusLabel,
        string Tone,
        string SignedAtLabel,
        string? SignatureImageDataUrl,
        bool Signed,
        bool CanSign,
        bool CanEdit);
    private sealed record ProcedureDiffMetadataChange(string Label, string Before, string After);
    private sealed record ProcedureDiffListGroup(string Title, string Kicker, IReadOnlyList<string> Added, IReadOnlyList<string> Removed, string Summary);
    private sealed record ProcedureDiffView(
        string FromVersionLabel,
        string ToVersionLabel,
        IReadOnlyList<ProcedureDiffMetadataChange> MetadataChanges,
        IReadOnlyList<ProcedureDiffListGroup> ListGroups,
        int TotalChangedFields,
        int TotalAddedItems,
        int TotalRemovedItems);
