@using Microsoft.AspNetCore.SignalR.Client
@using TelemedicineLandingPage.Hubs
@using TelemedicineLandingPage.Services.Admin
@using TelemedicineLandingPage.Services.Admin.Sql
@inject IMedDataStore Store
@inject IMedDataChangeBus ChangeBus
@inject ICurrentUserContext UserContext
@inject BrowserSessionService BrowserSession
@inject NavigationManager Navigation
@inject IToastService Toasts
@implements IAsyncDisposable

@if (_showSessionEndOverlay)
{
    <div class="session-ended-overlay" role="alertdialog" aria-modal="true" aria-labelledby="session-ended-title">
        <div class="session-ended-dialog">
            <span class="session-ended-dialog__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.6 1.8 18.2A2 2 0 0 0 3.5 21h17a2 2 0 0 0 1.7-2.8L13.7 3.6a2 2 0 0 0-3.4 0Z"/></svg>
            </span>
            <h2 id="session-ended-title">@_sessionEndTitle</h2>
            <p>@_sessionEndMessage</p>
            <button type="button" class="session-ended-dialog__action" @onclick="FinalizeSessionEndAsync">
                Đăng nhập lại
            </button>
        </div>
    </div>
}

@code {
    private HubConnection? _hub;
    private string? _sessionToken;
    private long _lastAppliedRevision = -1;
    private bool _disposed;
    private bool _showSessionEndOverlay;
    private bool _sessionEndFinalizing;
    private string _sessionEndReason = "replaced";
    private string _sessionEndTitle = "Phiên đăng nhập đã kết thúc";
    private string _sessionEndMessage = "Phiên đăng nhập đã hết hạn hoặc tài khoản này vừa đăng nhập trên một thiết bị khác.";

    protected override void OnInitialized()
    {
        ChangeBus.Changed += OnLocalDataChanged;
        UserContext.StateChanged += OnUserChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
        {
            return;
        }

        if (UserContext.CurrentUser is null)
        {
            try
            {
                await BrowserSession.RestoreCurrentUserAsync();
            }
            catch
            {
                // Layout also restores; ignore transient JS failures here.
            }
        }

        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/notification"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<long>("DataRevisionChanged", OnRemoteRevisionAsync);
        _hub.On<string>("SessionInvalidated", OnSessionInvalidatedAsync);
        _hub.Reconnected += OnHubReconnectedAsync;

        try
        {
            await _hub.StartAsync();
            await JoinHubGroupsAsync();
        }
        catch
        {
            // Hub is optional; in-process bus still refreshes this circuit.
        }
    }

    private void OnLocalDataChanged()
    {
        ApplyRevision(ChangeBus.Revision);
    }

    private Task OnRemoteRevisionAsync(long revision)
    {
        ApplyRevision(revision);
        return Task.CompletedTask;
    }

    private async Task OnHubReconnectedAsync(string? _)
    {
        _sessionToken = null;
        await JoinHubGroupsAsync();
    }

    private Task OnSessionInvalidatedAsync(string activeSessionIdText)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed || _showSessionEndOverlay)
            {
                return;
            }

            if (!Guid.TryParse(activeSessionIdText, out var activeSessionId))
            {
                return;
            }

            if (!BrowserSession.IsSupersededByActiveSession(activeSessionId))
            {
                return;
            }

            await ShowSessionEndedOverlayAsync("replaced");
        });

        return Task.CompletedTask;
    }

    private void OnUserChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await JoinHubGroupsAsync();
            ApplyRevision(ChangeBus.Revision);
            StateHasChanged();
        });
    }

    private async Task JoinHubGroupsAsync()
    {
        if (_hub is null || _hub.State != HubConnectionState.Connected || _showSessionEndOverlay)
        {
            return;
        }

        var token = await BrowserSession.GetCircuitSessionTokenAsync();
        if (string.IsNullOrWhiteSpace(token))
        {
            if (UserContext.CurrentUser is not null && await BrowserSession.IsCircuitSessionRevokedAsync())
            {
                await ShowSessionEndedOverlayAsync("replaced");
            }

            _sessionToken = null;
            return;
        }

        if (string.Equals(_sessionToken, token, StringComparison.Ordinal))
        {
            return;
        }

        await _hub.InvokeAsync("JoinDataSyncGroup", token);
        await _hub.InvokeAsync("JoinUserGroup", token);
        _sessionToken = token;
    }

    private async Task ShowSessionEndedOverlayAsync(string reason)
    {
        if (_showSessionEndOverlay)
        {
            return;
        }

        _sessionEndReason = reason;
        (_sessionEndTitle, _sessionEndMessage) = reason switch
        {
            "expired" => (
                "Phiên đăng nhập đã hết hạn",
                "Phiên làm việc của bạn đã hết hạn. Vui lòng đăng nhập lại để tiếp tục."),
            "disabled" => (
                "Không thể tiếp tục phiên hiện tại",
                "Tài khoản hiện không còn hợp lệ hoặc đã bị vô hiệu hóa. Vui lòng liên hệ quản trị viên."),
            _ => (
                "Phiên đăng nhập đã kết thúc",
                "Phiên đăng nhập đã hết hạn hoặc tài khoản này vừa đăng nhập trên một thiết bị khác.")
        };

        _showSessionEndOverlay = true;
        Toasts.Show(_sessionEndTitle, _sessionEndMessage, ToastVariant.Warning);
        StateHasChanged();

        await Task.Delay(4500);
        if (!_disposed && _showSessionEndOverlay && !_sessionEndFinalizing)
        {
            await FinalizeSessionEndAsync();
        }
    }

    private async Task FinalizeSessionEndAsync()
    {
        if (_sessionEndFinalizing || _disposed)
        {
            return;
        }

        _sessionEndFinalizing = true;
        await BrowserSession.MarkSessionEndedNoticeAsync(_sessionEndReason);
        await BrowserSession.SignOutLocalAsync();
        Navigation.NavigateTo($"/login?reason={Uri.EscapeDataString(_sessionEndReason)}", forceLoad: true, replace: true);
    }

    private void ApplyRevision(long revision)
    {
        if (revision <= _lastAppliedRevision)
        {
            return;
        }

        _lastAppliedRevision = revision;
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return Task.CompletedTask;
            }

            Store.Refresh();
            UserContext.RefreshFromDatabase();
            return Task.CompletedTask;
        });
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ChangeBus.Changed -= OnLocalDataChanged;
        UserContext.StateChanged -= OnUserChanged;

        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
