@if (IsVisible)
{
    <div class="admin-loading-overlay" role="status" aria-label="Đang xử lý">
        <div class="admin-loading-content">
            <div class="admin-loading-spinner">
                <div class="admin-loading-ring"></div>
                <div class="admin-loading-ring"></div>
                <div class="admin-loading-ring"></div>
            </div>
            <p class="admin-loading-text">@(Message ?? "Đang xử lý...")</p>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string? Message { get; set; }
}
