@* Lightweight tab strip used by the Phân quyền page. *@

<div class="admin-tabs" role="tablist" aria-label="@AriaLabel">
    @foreach (var tab in Tabs)
    {
        var isActive = string.Equals(tab.Key, ActiveKey, StringComparison.Ordinal);
        <button type="button"
                role="tab"
                aria-selected="@(isActive ? "true" : "false")"
                class="admin-tab @(isActive ? "is-active" : null)"
                @onclick="() => OnSelect(tab.Key)">
            <span class="admin-tab-label">@tab.Label</span>
            @if (tab.Count is { } count)
            {
                <span class="admin-tab-count">@count</span>
            }
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TabItem> Tabs { get; set; } = Array.Empty<TabItem>();
    [Parameter, EditorRequired] public string ActiveKey { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ActiveKeyChanged { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Tab";

    private async Task OnSelect(string key)
    {
        if (string.Equals(key, ActiveKey, StringComparison.Ordinal)) return;
        await ActiveKeyChanged.InvokeAsync(key);
    }

    public sealed record TabItem(string Key, string Label, int? Count = null);
}
