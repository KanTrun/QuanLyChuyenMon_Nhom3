@inject IPermissionService PermissionService

<article class="admin-panel">
    <header class="admin-panel-head">
        <div>
            <h2 class="admin-panel-title">Lịch sử thay đổi phân quyền</h2>
            <p class="admin-panel-subtitle">Tổng @_log.Count thay đổi đã ghi nhận.</p>
        </div>
    </header>

    @if (_log.Count == 0)
    {
        <div class="admin-empty" style="padding:24px;">
            <div class="admin-empty-title">Chưa có thay đổi nào</div>
            <div class="admin-empty-body">Mọi cập nhật quyền vai trò hoặc tài khoản sẽ được ghi nhận tại đây.</div>
        </div>
    }
    else
    {
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Đối tượng</th>
                        <th>Loại</th>
                        <th>Người thực hiện</th>
                        <th>Thời điểm</th>
                        <th>Lý do</th>
                        <th>Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _log)
                    {
                        <tr>
                            <td class="admin-table-cell-strong">@entry.TargetLabel</td>
                            <td><AdminBadge Tone="tone-secondary">@AdminEnumLabels.GetLabel(entry.TargetType)</AdminBadge></td>
                            <td>@entry.ChangedBy</td>
                            <td class="admin-table-cell-muted">@entry.AppliedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="admin-table-cell-muted">@entry.Reason</td>
                            <td>
                                <details>
                                    <summary style="cursor:pointer; color:var(--color-primary-deep); font-weight:600;">Xem JSON</summary>
                                    <div style="display:flex; flex-direction:column; gap:8px; margin-top:8px;">
                                        <div>
                                            <div class="admin-form-field-hint">Trước</div>
                                            <pre class="admin-json-block">@entry.BeforeJson</pre>
                                        </div>
                                        <div>
                                            <div class="admin-form-field-hint">Sau</div>
                                            <pre class="admin-json-block">@entry.AfterJson</pre>
                                        </div>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</article>

@code {
    private IReadOnlyList<PermissionChangeLog> _log = Array.Empty<PermissionChangeLog>();

    protected override void OnParametersSet()
    {
        _log = PermissionService.GetChangeLog();
    }
}
