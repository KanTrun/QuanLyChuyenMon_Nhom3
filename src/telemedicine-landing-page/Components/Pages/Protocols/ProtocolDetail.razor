@page "/protocols/{Id}"
@layout AppLayout

<PageTitle>Chi tiết Phác đồ - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-2);flex-wrap:wrap;">
            <span class="protocol-card__type-badge protocol-card__type-badge--treatment">Phác đồ</span>
            <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Active</span>
            <span style="font-size:var(--text-xs);color:var(--color-muted);">v2.0</span>
        </div>
        <h1>Phác đồ điều trị viem phoi cong dong</h1>
        <p>Ma: PD-001 &bull; Khoa Nội khoa &bull; Ban hành: 01/01/2024</p>
    </div>
    <div class="module-page__actions">
        <button class="btn-primary" aria-label="Áp dụng cho bệnh nhân">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2a4 4 0 014 4v1h1a1.5 1.5 0 011.5 1.5v4A1.5 1.5 0 0113 14H3a1.5 1.5 0 01-1.5-1.5v-4A1.5 1.5 0 013 7h1V6a4 4 0 014-4z" stroke="currentColor" stroke-width="1.5"/><path d="M6 10h4M8 8v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Áp dụng cho bệnh nhân
        </button>
    </div>
</div>

<!-- Detail Tabs -->
<div class="detail-tabs" role="tablist" aria-label="Chi tiết phác đồ">
    <button class="detail-tab @(activeTab == "overview" ? "detail-tab--active" : "")" @onclick='() => activeTab = "overview"' role="tab" aria-selected="@(activeTab == "overview" ? "true" : "false")">Tổng quan</button>
    <button class="detail-tab @(activeTab == "steps" ? "detail-tab--active" : "")" @onclick='() => activeTab = "steps"' role="tab" aria-selected="@(activeTab == "steps" ? "true" : "false")">Bước thực hiện</button>
    <button class="detail-tab @(activeTab == "icd" ? "detail-tab--active" : "")" @onclick='() => activeTab = "icd"' role="tab" aria-selected="@(activeTab == "icd" ? "true" : "false")">ICD &amp; Đối tượng</button>
    <button class="detail-tab @(activeTab == "contra" ? "detail-tab--active" : "")" @onclick='() => activeTab = "contra"' role="tab" aria-selected="@(activeTab == "contra" ? "true" : "false")">Chống chỉ định</button>
    <button class="detail-tab @(activeTab == "history" ? "detail-tab--active" : "")" @onclick='() => activeTab = "history"' role="tab" aria-selected="@(activeTab == "history" ? "true" : "false")">Lịch sử</button>
    <button class="detail-tab @(activeTab == "stats" ? "detail-tab--active" : "")" @onclick='() => activeTab = "stats"' role="tab" aria-selected="@(activeTab == "stats" ? "true" : "false")">Thống kê</button>
</div>

<!-- Tab: Tổng quan -->
@if (activeTab == "overview")
{
    <div class="service-info-card glass-card">
        <div class="service-info-card__item"><label>Mã phác đồ</label><span>PD-001</span></div>
        <div class="service-info-card__item"><label>Ten</label><span>Phác đồ điều trị viem phoi cong dong</span></div>
        <div class="service-info-card__item"><label>Loai</label><span>Phác đồ điều trị</span></div>
        <div class="service-info-card__item"><label>Khoa</label><span>Nội khoa</span></div>
        <div class="service-info-card__item"><label>ICD liên quan</label><span>J18.9, J15.0, J15.1</span></div>
        <div class="service-info-card__item"><label>Ngày ban hành</label><span>01/01/2024</span></div>
        <div class="service-info-card__item"><label>Người tạo</label><span>PGS. TS. Nguyen Van B</span></div>
        <div class="service-info-card__item"><label>Trạng thái</label><span>Active - Phiên bản 2.0</span></div>
    </div>
    <div class="glass-card" style="padding:var(--space-5);margin-top:var(--space-5);">
        <h3 style="font-size:var(--text-sm);font-weight:600;margin-bottom:var(--space-3);color:var(--color-ink);">Mô tả</h3>
        <p style="font-size:var(--text-sm);color:var(--color-muted);line-height:1.7;">Phác đồ nay ap dung cho bệnh nhân viem phoi cong dong muc do trung binh den nang, nhap vien dieu tri. Bao gom phác đồ khang sinh theo kinh nghiem, theo doi dap ung lâm sàng va điều chỉnh phác đồ sau 48-72 gio.</p>
    </div>
}

<!-- Tab: Bước thực hiện -->
@if (activeTab == "steps")
{
    <div class="stepper-vertical">
        <div class="stepper-step">
            <div class="stepper-step__marker"></div>
            <div class="stepper-step__content">
                <div class="stepper-step__title">Bước 1: Đánh giá ban đầu</div>
                <div class="stepper-step__meta">
                    <span class="stepper-step__meta-item">Bác sĩ</span>
                    <span class="stepper-step__meta-item">20 phút</span>
                </div>
                <div class="stepper-step__resources">Vật tư: Ong nghe, nhiet ke, huyet ap ke</div>
            </div>
        </div>
        <div class="stepper-step">
            <div class="stepper-step__marker"></div>
            <div class="stepper-step__content">
                <div class="stepper-step__title">Bước 2: Chỉ định xét nghiệm</div>
                <div class="stepper-step__meta">
                    <span class="stepper-step__meta-item">Bác sĩ</span>
                    <span class="stepper-step__meta-item">10 phút</span>
                </div>
                <div class="stepper-step__resources">XN: CTM, CRP, Pro-calcitonin, Cay dom, X-quang nguc</div>
            </div>
        </div>
        <div class="stepper-step">
            <div class="stepper-step__marker"></div>
            <div class="stepper-step__content">
                <div class="stepper-step__title">Bước 3: Bắt đầu kháng sinh kinh nghiệm</div>
                <div class="stepper-step__meta">
                    <span class="stepper-step__meta-item">Điều dưỡng</span>
                    <span class="stepper-step__meta-item">15 phút</span>
                </div>
                <div class="stepper-step__resources">Thuốc: Amoxicillin/Clavulanate 1.2g IV q8h + Azithromycin 500mg PO daily</div>
            </div>
        </div>
        <div class="stepper-step">
            <div class="stepper-step__marker"></div>
            <div class="stepper-step__content">
                <div class="stepper-step__title">Bước 4: Theo dõi đáp ứng lâm sàng</div>
                <div class="stepper-step__meta">
                    <span class="stepper-step__meta-item">Điều dưỡng</span>
                    <span class="stepper-step__meta-item">24 gio</span>
                </div>
                <div class="stepper-step__resources">Theo dõi: Nhiệt độ, SpO2, nhịp thở, CRP mỗi 24h</div>
            </div>
        </div>
        <div class="stepper-step">
            <div class="stepper-step__marker"></div>
            <div class="stepper-step__content">
                <div class="stepper-step__title">Bước 5: Đánh giá lại sau 48-72h</div>
                <div class="stepper-step__meta">
                    <span class="stepper-step__meta-item">Bác sĩ</span>
                    <span class="stepper-step__meta-item">15 phút</span>
                </div>
                <div class="stepper-step__resources">Quyết định: Tiếp tục / Đổi kháng sinh / Chuyển ICU</div>
            </div>
        </div>
    </div>
}

<!-- Tab: ICD &amp; Đối tượng -->
@if (activeTab == "icd")
{
    <div class="glass-card" style="padding:var(--space-5);margin-bottom:var(--space-5);">
        <h3 style="font-size:var(--text-sm);font-weight:600;margin-bottom:var(--space-4);color:var(--color-ink);">Mã ICD áp dụng</h3>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);">
            <span class="icd-chip">J18.9 - Viêm phổi không xác định</span>
            <span class="icd-chip">J15.0 - Viem phoi do Klebsiella</span>
            <span class="icd-chip">J15.1 - Viem phoi do Pseudomonas</span>
            <span class="icd-chip">J13 - Viem phoi do Pneumococcus</span>
        </div>
    </div>
    <div class="glass-card" style="padding:var(--space-5);margin-bottom:var(--space-5);">
        <h3 style="font-size:var(--text-sm);font-weight:600;margin-bottom:var(--space-4);color:var(--color-ink);">Tieu chi bệnh nhân</h3>
        <div class="service-info-card" style="padding:0;border:none;background:none;">
            <div class="service-info-card__item"><label>Độ tuổi</label><span>18 - 80 tuoi</span></div>
            <div class="service-info-card__item"><label>Giới tính</label><span>Tất cả</span></div>
            <div class="service-info-card__item"><label>Điều kiện</label><span>Viêm phổi cộng đồng, nhập viện, không suy hô hấp nặng</span></div>
            <div class="service-info-card__item"><label>CURB-65</label><span>Score 1-3 (nhap vien)</span></div>
        </div>
    </div>
}

<!-- Tab: Chống chỉ định -->
@if (activeTab == "contra")
{
    <div style="display:flex;flex-direction:column;gap:var(--space-3);">
        <div class="warning-card">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-2);">
                <span class="warning-card__title">Dị ứng Penicillin</span>
                <span class="warning-card__severity warning-card__severity--serious">Nghiêm trọng</span>
            </div>
            <p style="font-size:var(--text-sm);color:var(--color-muted);margin-top:var(--space-2);">Bệnh nhân co tien su di ung Penicillin hoac Cephalosporin. Chuyen sang phác đồ thay the (Fluoroquinolone).</p>
        </div>
        <div class="warning-card">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-2);">
                <span class="warning-card__title">Suy thận mạn giai đoạn 4-5</span>
                <span class="warning-card__severity warning-card__severity--relative">Tương đối</span>
            </div>
            <p style="font-size:var(--text-sm);color:var(--color-muted);margin-top:var(--space-2);">Cần hiệu chỉnh liều theo GFR. Tham vấn bác sĩ thận trước khi áp dụng.</p>
        </div>
        <div class="warning-card">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--space-2);">
                <span class="warning-card__title">Phụ nữ có thai 3 tháng đầu</span>
                <span class="warning-card__severity warning-card__severity--absolute">Tuyệt đối</span>
            </div>
            <p style="font-size:var(--text-sm);color:var(--color-muted);margin-top:var(--space-2);">Không sử dụng Fluoroquinolone và Tetracycline. Chuyen sang phác đồ an toan cho thai ky.</p>
        </div>
    </div>
}

<!-- Tab: Lịch sử -->
@if (activeTab == "history")
{
    <div class="stepper-vertical">
        <div class="stepper-step">
            <div class="stepper-step__marker" style="background:var(--color-primary);"></div>
            <div class="stepper-step__content">
                <div class="stepper-step__title">v2.0 - Cập nhật phác đồ khang sinh</div>
                <div class="stepper-step__meta">
                    <span class="stepper-step__meta-item">01/01/2024</span>
                    <span class="stepper-step__meta-item">PGS. Nguyen Van B</span>
                </div>
                <div class="stepper-step__resources">Thay doi: Bo sung Azithromycin cho phác đồ ket hop</div>
            </div>
        </div>
        <div class="stepper-step">
            <div class="stepper-step__marker" style="background:var(--color-subtle);"></div>
            <div class="stepper-step__content">
                <div class="stepper-step__title">v1.5 - Điều chỉnh lieu</div>
                <div class="stepper-step__meta">
                    <span class="stepper-step__meta-item">15/08/2023</span>
                    <span class="stepper-step__meta-item">TS. Tran Van C</span>
                </div>
                <div class="stepper-step__resources">Thay đổi: Tăng liều Amoxicillin/Clavulanate</div>
            </div>
        </div>
        <div class="stepper-step">
            <div class="stepper-step__marker" style="background:var(--color-subtle);"></div>
            <div class="stepper-step__content">
                <div class="stepper-step__title">v1.0 - Phiên bản dau tien</div>
                <div class="stepper-step__meta">
                    <span class="stepper-step__meta-item">01/03/2023</span>
                    <span class="stepper-step__meta-item">PGS. Nguyen Van B</span>
                </div>
                <div class="stepper-step__resources">Phác đồ goc duoc Hoi dong Thuốc va Dieu tri phê duyệt</div>
            </div>
        </div>
    </div>
}

<!-- Tab: Thống kê -->
@if (activeTab == "stats")
{
    <div class="stats-row">
        <div class="stat-card-mini">
            <div class="stat-card-mini__label">Số lần áp dụng</div>
            <div class="stat-card-mini__value stat-card-mini__value--primary">128</div>
        </div>
        <div class="stat-card-mini">
            <div class="stat-card-mini__label">Tỷ lệ thành công</div>
            <div class="stat-card-mini__value stat-card-mini__value--success">87.5%</div>
        </div>
        <div class="stat-card-mini">
            <div class="stat-card-mini__label">Thời gian TB</div>
            <div class="stat-card-mini__value">5.2 ngay</div>
        </div>
    </div>
    <div class="glass-card" style="padding:var(--space-5);">
        <h3 style="font-size:var(--text-sm);font-weight:600;margin-bottom:var(--space-4);color:var(--color-ink);">Áp dụng theo tháng (6 thang gan nhat)</h3>
        <div class="mini-bar-chart">
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Tháng 10</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:45%;"></div></div>
                <span class="mini-bar-chart__value">18</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Tháng 11</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:60%;"></div></div>
                <span class="mini-bar-chart__value">24</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Tháng 12</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:55%;"></div></div>
                <span class="mini-bar-chart__value">22</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Tháng 1</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:70%;"></div></div>
                <span class="mini-bar-chart__value">28</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Tháng 2</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:80%;"></div></div>
                <span class="mini-bar-chart__value">32</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Tháng 3</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:50%;"></div></div>
                <span class="mini-bar-chart__value">20</span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "PD-001";
    private string activeTab = "overview";
}
