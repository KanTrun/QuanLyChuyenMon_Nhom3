@page "/protocols/{Id}"
@layout AppLayout

<PageTitle>Chi tiet Phac do - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/dashboard" class="breadcrumb__item">Dashboard</a>
        <span class="breadcrumb__sep">/</span>
        <a href="/protocols" class="breadcrumb__item">Phac do</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__item breadcrumb__item--current">Phac do dieu tri viem phoi cong dong</span>
    </nav>

    <!-- Header -->
    <div class="module-page__header">
        <div class="module-page__header-left">
            <h1>Phac do dieu tri viem phoi cong dong</h1>
            <div class="module-page__meta">
                <span style="font-size:0.6875rem; font-weight:600; padding:0.125rem 0.5rem; border-radius:4px; background:rgba(59,130,246,0.1); color:var(--color-info);">Dieu tri</span>
                <span style="font-size:0.625rem; padding:0.0625rem 0.375rem; border-radius:3px; background:var(--surface-secondary);">J15.0</span>
                <span style="font-size:0.625rem; padding:0.0625rem 0.375rem; border-radius:3px; background:var(--surface-secondary);">J18.1</span>
                <span class="priority-badge priority-badge--normal">v2.1</span>
                <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span>
                <span class="kanban__card-dept">Noi tong hop</span>
            </div>
        </div>
        <div class="module-page__actions">
            <button class="btn-secondary">Chinh sua</button>
            <button class="btn-secondary">Phien ban moi</button>
            <button class="btn-primary">Ap dung cho BN</button>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-animated" role="tablist">
        <button class="tabs-animated__tab tabs-animated__tab--active" role="tab">Tong quan</button>
        <button class="tabs-animated__tab" role="tab">Cac buoc</button>
        <button class="tabs-animated__tab" role="tab">Dieu kien ap dung</button>
        <button class="tabs-animated__tab" role="tab">Lich su ap dung</button>
        <button class="tabs-animated__tab" role="tab">Phien ban</button>
    </div>

    <!-- Tab 1: Tong quan -->
    <div class="tabs-animated__content" data-tab="overview">
        <div class="glass-card" style="padding:1.5rem; margin-bottom:1.5rem;">
            <h3 style="margin-bottom:1rem;">Thong tin chung</h3>
            <div class="detail-grid">
                <div class="detail-grid__item"><span class="detail-grid__label">Ma phac do</span><span class="detail-grid__value">PD-DT-001</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Loai</span><span class="detail-grid__value">Dieu tri</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Khoa ap dung</span><span class="detail-grid__value">Noi tong hop, Hoi suc</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Nguoi tao</span><span class="detail-grid__value">BS. Tran Van Duc</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Ngay ban hanh</span><span class="detail-grid__value">01/02/2024</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Doi tuong</span><span class="detail-grid__value">Nguoi lon >= 18 tuoi</span></div>
            </div>
        </div>
        <div class="glass-card" style="padding:1.5rem;">
            <h3 style="margin-bottom:0.75rem;">Muc tieu dieu tri</h3>
            <p style="font-size:0.875rem; color:var(--text-secondary);">Dieu tri hieu qua viem phoi cong dong (CAP) o nguoi lon, giam ty le tu vong, rut ngan thoi gian nam vien, phong ngua bien chung va khang thuoc.</p>
        </div>
    </div>

    <!-- Tab 2: Cac buoc -->
    <div class="tabs-animated__content" data-tab="steps" style="display:none;">
        <div class="glass-card" style="padding:1.5rem;">
            <div class="step-list stagger-children">
                <div class="step-list__item">
                    <span class="step-list__number">1</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Danh gia muc do nang (CURB-65)</div>
                        <div class="step-list__desc">Tinh diem CURB-65 de phan loai muc do: 0-1 = Nhe, 2 = Trung binh, 3-5 = Nang</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--normal">BS. Dieu tri</span><span>SLA: 15 phut</span></div>
                        <div style="margin-top:0.5rem; padding:0.5rem; background:rgba(245,158,11,0.05); border-left:3px solid var(--color-warning); border-radius:0 4px 4px 0; font-size:0.75rem; color:var(--color-warning);">Luu y: CURB-65 >= 3 can chuyen ICU ngay</div>
                    </div>
                </div>
                <div class="step-list__item">
                    <span class="step-list__number">2</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Khang sinh theo kinh nghiem</div>
                        <div class="step-list__desc">Nhe: Amoxicillin 1g x 3 lan/ngay PO | Trung binh: Amoxicillin/Clavulanate IV + Azithromycin | Nang: Ceftriaxone 2g IV + Azithromycin</div>
                        <div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">Thuoc: Amoxicillin, Ceftriaxone, Azithromycin | Vat tu: Kim truyen, day truyen</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--normal">BS. Dieu tri</span><span>7-14 ngay</span></div>
                    </div>
                </div>
                <div class="step-list__item">
                    <span class="step-list__number">3</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Ho tro ho hap</div>
                        <div class="step-list__desc">SpO2 &lt; 92%: Tho oxy mask 5-10L/phut. SpO2 &lt; 88%: Can nhac CPAP hoac tho may</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--urgent">BS + DD</span><span>Lien tuc</span></div>
                    </div>
                </div>
                <div class="step-list__item">
                    <span class="step-list__number">4</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Theo doi va danh gia lai</div>
                        <div class="step-list__desc">Theo doi nhiet do, SpO2, nhip tho moi 4h. Danh gia lai CURB-65 sau 48-72h. Xet nghiem CRP, Procalcitonin ngay 3.</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--normal">DD. Cham soc</span><span>48-72h</span></div>
                    </div>
                </div>
                <div class="step-list__item">
                    <span class="step-list__number">5</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Chuyen khang sinh uong va xuat vien</div>
                        <div class="step-list__desc">Khi: Het sot >= 48h, CRP giam > 50%, uong duoc. Chuyen Amoxicillin/Clavulanate PO. Hen tai kham 7 ngay.</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--normal">BS. Dieu tri</span><span>Ngay 5-7</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 3: Dieu kien ap dung -->
    <div class="tabs-animated__content" data-tab="conditions" style="display:none;">
        <div class="glass-card" style="padding:1.5rem; margin-bottom:1.5rem;">
            <h3 style="margin-bottom:1rem;">Dieu kien ap dung</h3>
            <table class="data-table">
                <thead><tr><th>Ma ICD</th><th>Ten benh</th><th>Nhom tuoi</th><th>Dieu kien</th></tr></thead>
                <tbody>
                    <tr><td>J15.0</td><td>Viem phoi do Klebsiella</td><td>>= 18 tuoi</td><td>Khong di ung Penicillin</td></tr>
                    <tr><td>J18.1</td><td>Viem phoi thuy khong xac dinh</td><td>>= 18 tuoi</td><td>Khong suy gan nang</td></tr>
                    <tr><td>J15.9</td><td>Viem phoi do vi khuan khac</td><td>>= 18 tuoi</td><td>eGFR > 30 ml/phut</td></tr>
                </tbody>
            </table>
        </div>
        <div class="glass-card" style="padding:1.5rem;">
            <h3 style="margin-bottom:1rem; color:var(--color-danger);">Chong chi dinh</h3>
            <div style="display:flex; flex-direction:column; gap:0.5rem;">
                <div style="display:flex; align-items:center; gap:0.5rem; font-size:0.8125rem;">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="var(--color-danger)" stroke-width="1.2"/><path d="M4.5 4.5l5 5" stroke="var(--color-danger)" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Di ung nang voi Penicillin (phan ve)
                </div>
                <div style="display:flex; align-items:center; gap:0.5rem; font-size:0.8125rem;">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="var(--color-danger)" stroke-width="1.2"/><path d="M4.5 4.5l5 5" stroke="var(--color-danger)" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Suy gan nang (Child-Pugh C)
                </div>
                <div style="display:flex; align-items:center; gap:0.5rem; font-size:0.8125rem;">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="var(--color-danger)" stroke-width="1.2"/><path d="M4.5 4.5l5 5" stroke="var(--color-danger)" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Phu nu co thai (3 thang dau)
                </div>
                <div style="display:flex; align-items:center; gap:0.5rem; font-size:0.8125rem;">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="var(--color-danger)" stroke-width="1.2"/><path d="M4.5 4.5l5 5" stroke="var(--color-danger)" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Suy than man GDD V (eGFR &lt; 15)
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 4: Lich su ap dung -->
    <div class="tabs-animated__content" data-tab="history" style="display:none;">
        <div class="glass-card" style="padding:1.5rem;">
            <div style="background:rgba(59,130,246,0.05); border-radius:var(--radius-md); padding:0.75rem; margin-bottom:1rem; font-size:0.75rem; color:var(--color-info);">
                Du lieu benh nhan duoc bao mat theo quy dinh
            </div>
            <table class="data-table" aria-label="Lich su ap dung">
                <thead><tr><th>Ma BN</th><th>Ho ten</th><th>Ngay ap dung</th><th>Bac si</th><th>Ket qua</th></tr></thead>
                <tbody class="stagger-children">
                    <tr><td>BN-2024-1045</td><td>Nguyen V. H***</td><td>10/04/2024</td><td>BS. Tran Van Duc</td><td><span class="status-badge status-badge--active">Thanh cong</span></td></tr>
                    <tr><td>BN-2024-0987</td><td>Tran T. M***</td><td>05/04/2024</td><td>BS. Le Minh Tuan</td><td><span class="status-badge status-badge--active">Thanh cong</span></td></tr>
                    <tr><td>BN-2024-0932</td><td>Pham V. D***</td><td>01/04/2024</td><td>BS. Tran Van Duc</td><td><span class="status-badge status-badge--pending">Dang dieu tri</span></td></tr>
                    <tr><td>BN-2024-0890</td><td>Le T. A***</td><td>28/03/2024</td><td>BS. Hoang Nam</td><td><span class="status-badge status-badge--active">Thanh cong</span></td></tr>
                    <tr><td>BN-2024-0845</td><td>Vo V. T***</td><td>22/03/2024</td><td>BS. Tran Van Duc</td><td><span class="status-badge status-badge--draft">Chuyen phac do</span></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab 5: Phien ban -->
    <div class="tabs-animated__content" data-tab="versions" style="display:none;">
        <div class="status-timeline stagger-children">
            <div class="status-timeline__item status-timeline__item--success">
                <div><strong>v2.1</strong> - 01/02/2024 - BS. Tran Van Duc</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Cap nhat lieu Ceftriaxone theo khang sinh do 2024. <span class="status-badge status-badge--active">Hoat dong</span></div>
            </div>
            <div class="status-timeline__item">
                <div><strong>v2.0</strong> - 15/09/2023 - BS. Tran Van Duc</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Them tieu chi CURB-65 va phan loai muc do</div>
            </div>
            <div class="status-timeline__item">
                <div><strong>v1.0</strong> - 01/03/2023 - BS. Nguyen Van An</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Phien ban khoi tao theo Huong dan BYT 2022</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; }
    private string activeTab = "overview";
}
