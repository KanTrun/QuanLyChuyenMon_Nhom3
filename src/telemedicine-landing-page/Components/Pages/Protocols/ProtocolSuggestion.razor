@page "/protocols/suggestion"
@layout AppLayout

<PageTitle>Goi y Phac do theo ICD - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <h1 style="margin-bottom:1.5rem;">Goi y Phac do theo ICD</h1>

    <!-- Patient Info Card -->
    <div class="glass-card" style="padding:1.25rem; margin-bottom:1.5rem; display:grid; grid-template-columns:repeat(5,1fr); gap:1rem;">
        <div><span style="font-size:0.6875rem; color:var(--text-muted); display:block;">Ma BN</span><strong style="font-size:0.875rem;">BN-2024-1102</strong></div>
        <div><span style="font-size:0.6875rem; color:var(--text-muted); display:block;">Ho ten</span><strong style="font-size:0.875rem;">Nguyen Van Thanh</strong></div>
        <div><span style="font-size:0.6875rem; color:var(--text-muted); display:block;">Tuoi</span><strong style="font-size:0.875rem;">58</strong></div>
        <div><span style="font-size:0.6875rem; color:var(--text-muted); display:block;">Gioi tinh</span><strong style="font-size:0.875rem;">Nam</strong></div>
        <div><span style="font-size:0.6875rem; color:var(--text-muted); display:block;">Khoa dieu tri</span><strong style="font-size:0.875rem;">Noi tong hop</strong></div>
    </div>

    <!-- ICD Input Section -->
    <div class="glass-card" style="padding:1.5rem; margin-bottom:1.5rem;">
        <h3 style="font-size:0.9375rem; margin-bottom:1rem;">Nhap ma ICD chan doan</h3>
        <div style="display:flex; gap:0.75rem; align-items:flex-start;">
            <div style="flex:1; position:relative;">
                <input type="text" class="form-input" placeholder="Nhap ma ICD hoac ten benh..." aria-label="Tim kiem ICD" value="J18" />
                <!-- Autocomplete dropdown -->
                <div style="position:absolute; top:100%; left:0; right:0; background:var(--surface-primary); border:1px solid var(--border-color); border-radius:var(--radius-md); box-shadow:var(--shadow-md); z-index:10; margin-top:4px;">
                    <div style="padding:0.5rem 0.75rem; cursor:pointer; font-size:0.8125rem; border-bottom:1px solid var(--border-color);">
                        <strong>J18.0</strong> - Viem phoi thuy khong xac dinh co quan
                    </div>
                    <div style="padding:0.5rem 0.75rem; cursor:pointer; font-size:0.8125rem; border-bottom:1px solid var(--border-color); background:rgba(59,130,246,0.04);">
                        <strong>J18.1</strong> - Viem phoi thuy khong xac dinh
                    </div>
                    <div style="padding:0.5rem 0.75rem; cursor:pointer; font-size:0.8125rem;">
                        <strong>J18.9</strong> - Viem phoi khong xac dinh
                    </div>
                </div>
            </div>
            <button class="btn-primary">Tim phac do</button>
        </div>
        <div style="margin-top:0.75rem; display:flex; gap:0.375rem;">
            <span class="multi-select__tag">J18.1 <span class="multi-select__tag-remove">&times;</span></span>
            <span class="multi-select__tag">I10 <span class="multi-select__tag-remove">&times;</span></span>
        </div>
    </div>

    <!-- Suggested Protocols -->
    <div class="stagger-children">
        <h3 style="font-size:0.9375rem; margin-bottom:1rem;">Phac do goi y (4 ket qua)</h3>

        <!-- Suggestion 1 -->
        <div class="glass-card" style="padding:1.25rem; margin-bottom:1rem; border-left:4px solid var(--color-success);">
            <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                <div style="flex:1;">
                    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
                        <span style="background:var(--color-success); color:#fff; font-size:0.75rem; font-weight:700; padding:0.25rem 0.625rem; border-radius:999px;">95%</span>
                        <h4 style="font-size:0.9375rem;">Phac do dieu tri viem phoi cong dong</h4>
                    </div>
                    <p style="font-size:0.8125rem; color:var(--text-secondary); margin-bottom:0.375rem;">Phu hop voi: J18.1 (Viem phoi thuy) - Benh nhan nam, 58 tuoi, khoa Noi</p>
                    <p style="font-size:0.75rem; color:var(--text-muted);">ICD phu hop: J18.1 | Tuoi: >= 18 | Khoa: Noi tong hop</p>
                </div>
                <button class="btn-primary" style="white-space:nowrap;">Ap dung</button>
            </div>
        </div>

        <!-- Suggestion 2 -->
        <div class="glass-card" style="padding:1.25rem; margin-bottom:1rem; border-left:4px solid var(--color-info);">
            <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                <div style="flex:1;">
                    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
                        <span style="background:var(--color-info); color:#fff; font-size:0.75rem; font-weight:700; padding:0.25rem 0.625rem; border-radius:999px;">87%</span>
                        <h4 style="font-size:0.9375rem;">Phac do dieu tri tang huyet ap</h4>
                    </div>
                    <p style="font-size:0.8125rem; color:var(--text-secondary); margin-bottom:0.375rem;">Phu hop voi: I10 (Tang huyet ap) - Benh kem theo</p>
                    <p style="font-size:0.75rem; color:var(--text-muted);">ICD phu hop: I10 | Tuoi: >= 18 | Khoa: Noi tong hop, Tim mach</p>
                </div>
                <button class="btn-primary" style="white-space:nowrap;">Ap dung</button>
            </div>
        </div>

        <!-- Suggestion 3 -->
        <div class="glass-card" style="padding:1.25rem; margin-bottom:1rem; border-left:4px solid var(--color-warning);">
            <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                <div style="flex:1;">
                    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
                        <span style="background:var(--color-warning); color:#fff; font-size:0.75rem; font-weight:700; padding:0.25rem 0.625rem; border-radius:999px;">72%</span>
                        <h4 style="font-size:0.9375rem;">Phac do dieu tri nhiem trung huyet</h4>
                    </div>
                    <p style="font-size:0.8125rem; color:var(--text-secondary); margin-bottom:0.375rem;">Lien quan: J18.1 co the tien trien thanh nhiem trung huyet</p>
                    <p style="font-size:0.75rem; color:var(--text-muted);">ICD lien quan: A41.9 | Canh bao: Chi ap dung khi co dau hieu sepsis</p>
                </div>
                <button class="btn-secondary" style="white-space:nowrap;">Ap dung</button>
            </div>
        </div>

        <!-- Suggestion 4 with contraindication -->
        <div class="glass-card" style="padding:1.25rem; margin-bottom:1rem; border-left:4px solid var(--color-gray-400, #9ca3af);">
            <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                <div style="flex:1;">
                    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
                        <span style="background:var(--color-gray-500, #64748b); color:#fff; font-size:0.75rem; font-weight:700; padding:0.25rem 0.625rem; border-radius:999px;">45%</span>
                        <h4 style="font-size:0.9375rem;">Phac do khang sinh lieu cao (COPD boi nhiem)</h4>
                    </div>
                    <p style="font-size:0.8125rem; color:var(--text-secondary); margin-bottom:0.375rem;">Lien quan: J18 + benh phoi man tinh</p>
                    <!-- Contraindication warning -->
                    <div style="background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.2); border-radius:var(--radius-sm); padding:0.5rem 0.75rem; margin-top:0.5rem; font-size:0.75rem; color:var(--color-danger);">
                        Canh bao: Can kiem tra chuc nang than truoc khi ap dung (eGFR > 30 ml/phut). BN co tang huyet ap - tuong tac thuoc co the xay ra.
                    </div>
                </div>
                <button class="btn-secondary" disabled style="white-space:nowrap; opacity:0.5;">Ap dung</button>
            </div>
        </div>
    </div>

    <!-- Success confirmation (hidden by default) -->
    <div style="display:none; text-align:center; padding:3rem;" data-success-state>
        <div style="font-size:3rem; margin-bottom:1rem;">&#10003;</div>
        <h2 style="color:var(--color-success); margin-bottom:0.5rem;">Da ap dung phac do thanh cong</h2>
        <p style="color:var(--text-secondary);">Phac do dieu tri viem phoi cong dong da duoc ap dung cho benh nhan BN-2024-1102</p>
    </div>
</div>

@code {
    private string searchIcd = "";
    private List<string> selectedIcds = new() { "J18.1", "I10" };
}
