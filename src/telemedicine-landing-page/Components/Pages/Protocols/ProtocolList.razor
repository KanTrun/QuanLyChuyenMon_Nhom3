@page "/protocols"
@layout AppLayout

<PageTitle>Phac do Lam sang - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <div class="module-page__header">
        <div class="module-page__header-left">
            <h1>Phac do Lam sang</h1>
            <p>Quan ly phac do dieu tri, cham soc va thu thuat</p>
        </div>
        <div class="module-page__actions">
            <div class="view-toggle">
                <button class="view-toggle__btn view-toggle__btn--active" aria-label="Luoi">Luoi</button>
                <button class="view-toggle__btn" aria-label="Danh sach">Danh sach</button>
            </div>
            <button class="btn-primary">+ Tao phac do</button>
        </div>
    </div>

    <!-- Protocol Type Tabs -->
    <div class="tabs-animated" style="margin-bottom:1.5rem;">
        <button class="tabs-animated__tab tabs-animated__tab--active">Tat ca</button>
        <button class="tabs-animated__tab">Dieu tri</button>
        <button class="tabs-animated__tab">Cham soc</button>
        <button class="tabs-animated__tab">Phau thuat</button>
        <button class="tabs-animated__tab">Thu thuat</button>
    </div>

    <!-- Search & Filters -->
    <div class="filter-panel">
        <input type="text" class="filter-panel__input" placeholder="Tim kiem theo ten hoac ma ICD..." aria-label="Tim kiem" style="flex:1;" />
        <select class="filter-panel__input" aria-label="Khoa">
            <option>Tat ca khoa</option>
            <option>Noi tong hop</option>
            <option>Ngoai tong hop</option>
            <option>Nhi khoa</option>
            <option>San khoa</option>
        </select>
        <select class="filter-panel__input" aria-label="Trang thai">
            <option>Tat ca trang thai</option>
            <option>Hoat dong</option>
            <option>Nhap</option>
            <option>Luu tru</option>
        </select>
    </div>

    <!-- Grid View (default) -->
    <div class="protocol-grid stagger-children" style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem;" data-view-content="grid">
        <!-- Card 1 -->
        <div class="glass-card tilt-card" style="padding:1.25rem; cursor:pointer;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem;">
                <span style="font-size:0.6875rem; font-weight:600; padding:0.125rem 0.5rem; border-radius:4px; background:rgba(59,130,246,0.1); color:var(--color-info);">Dieu tri</span>
                <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span>
            </div>
            <h3 style="font-size:0.9375rem; font-weight:700; margin-bottom:0.5rem;">Phac do dieu tri viem phoi cong dong</h3>
            <div style="display:flex; flex-wrap:wrap; gap:0.25rem; margin-bottom:0.5rem;">
                <span style="font-size:0.625rem; padding:0.0625rem 0.375rem; border-radius:3px; background:var(--surface-secondary); color:var(--text-secondary);">J15.0</span>
                <span style="font-size:0.625rem; padding:0.0625rem 0.375rem; border-radius:3px; background:var(--surface-secondary); color:var(--text-secondary);">J18.1</span>
            </div>
            <div style="display:flex; gap:0.375rem; margin-bottom:0.5rem;">
                <span style="font-size:0.625rem; padding:0.125rem 0.375rem; border-radius:999px; background:rgba(16,185,129,0.1); color:var(--color-success);">Nguoi lon</span>
            </div>
            <div style="display:flex; align-items:center; justify-content:space-between; font-size:0.75rem; color:var(--text-muted);">
                <span>v2.1</span>
                <span>Noi tong hop</span>
            </div>
        </div>
        <!-- Card 2 -->
        <div class="glass-card tilt-card" style="padding:1.25rem; cursor:pointer;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem;">
                <span style="font-size:0.6875rem; font-weight:600; padding:0.125rem 0.5rem; border-radius:4px; background:rgba(245,158,11,0.1); color:var(--color-warning);">Cham soc</span>
                <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span>
            </div>
            <h3 style="font-size:0.9375rem; font-weight:700; margin-bottom:0.5rem;">Phac do cham soc benh nhan sau mo</h3>
            <div style="display:flex; flex-wrap:wrap; gap:0.25rem; margin-bottom:0.5rem;">
                <span style="font-size:0.625rem; padding:0.0625rem 0.375rem; border-radius:3px; background:var(--surface-secondary); color:var(--text-secondary);">Z48.0</span>
