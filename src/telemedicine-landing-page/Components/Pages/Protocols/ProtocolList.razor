@page "/protocols"
@layout AppLayout

<PageTitle>Phác đồ và Quy trình Lâm sàng - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <h1>Phác đồ &amp; Quy trình Lâm sàng</h1>
        <p>Quản lý phác đồ điều trị, chăm sóc, phẫu thuật và thủ thuật</p>
    </div>
    <div class="module-page__actions">
        <button class="btn-primary" aria-label="Thêm phác đồ mới">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Thêm phác đồ
        </button>
    </div>
</div>

<!-- Type Tabs -->
<div class="category-tabs" role="tablist" aria-label="Lọc loại phác đồ">
    <button class="category-tab @(activeType == "all" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeType == "all" ? "true" : "false")" @onclick='() => activeType = "all"' >Tất cả <span class="category-tab__count">8</span></button>
    <button class="category-tab @(activeType == "treatment" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeType == "treatment" ? "true" : "false")" @onclick='() => activeType = "treatment"' >Phác đồ điều trị <span class="category-tab__count">3</span></button>
    <button class="category-tab @(activeType == "care" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeType == "care" ? "true" : "false")" @onclick='() => activeType = "care"' >Chăm sóc <span class="category-tab__count">2</span></button>
    <button class="category-tab @(activeType == "surgery" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeType == "surgery" ? "true" : "false")" @onclick='() => activeType = "surgery"' >Phẫu thuật <span class="category-tab__count">1</span></button>
    <button class="category-tab @(activeType == "procedure" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeType == "procedure" ? "true" : "false")" @onclick='() => activeType = "procedure"' >Thủ thuật <span class="category-tab__count">2</span></button>
</div>

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="filter-bar__search">
        <span class="filter-bar__search-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <input type="text" placeholder="Tìm kiếm phác đồ..." aria-label="Tìm kiếm phác đồ" />
    </div>
    <select class="filter-bar__select" aria-label="Lọc ICD">
        <option>Tất cả ICD</option>
        <option>J18.9 - Viêm phổi</option>
        <option>E11.9 - ĐTĐ type 2</option>
        <option>C34.9 - Ung thư phổi</option>
    </select>
    <select class="filter-bar__select" aria-label="Lọc khoa">
        <option>Tất cả khoa</option>
        <option>Nội khoa</option>
        <option>Ngoại khoa</option>
        <option>Ung bướu</option>
        <option>Hồi sức</option>
    </select>
    <select class="filter-bar__select" aria-label="Trạng thái">
        <option>Tất cả</option>
        <option>Active</option>
        <option>Draft</option>
    </select>
</div>

<!-- Protocol Cards Grid -->
<div class="protocol-grid">
    <!-- Card 1 -->
    <div class="protocol-card card-hover">
        <div class="protocol-card__header">
            <span class="protocol-card__type-badge protocol-card__type-badge--treatment">Phác đồ</span>
            <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Active</span>
        </div>
        <div class="protocol-card__name">Phác đồ điều trị viêm phổi cộng đồng</div>
        <div class="protocol-card__icd">
            <span class="icd-chip">J18.9</span>
        </div>
        <div class="protocol-card__meta">
            <span class="protocol-card__meta-item">Nội khoa</span>
            <span class="protocol-card__meta-item">v2.0</span>
        </div>
        <div class="protocol-card__footer">
            <span class="protocol-card__usage">Áp dụng: 128 lần</span>
            <a href="/protocols/PD-001" class="protocol-card__link">Xem chi tiết &rarr;</a>
        </div>
    </div>

    <!-- Card 2 -->
    <div class="protocol-card card-hover">
        <div class="protocol-card__header">
            <span class="protocol-card__type-badge protocol-card__type-badge--care">Chăm sóc</span>
            <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Active</span>
        </div>
        <div class="protocol-card__name">Quy trình chăm sóc sau mổ tim</div>
        <div class="protocol-card__icd">
            <span class="icd-chip">I25.1</span>
        </div>
        <div class="protocol-card__meta">
            <span class="protocol-card__meta-item">Ngoại tim mạch</span>
            <span class="protocol-card__meta-item">v1.2</span>
        </div>
        <div class="protocol-card__footer">
            <span class="protocol-card__usage">Áp dụng: 45 lần</span>
            <a href="/protocols/PD-002" class="protocol-card__link">Xem chi tiết &rarr;</a>
        </div>
    </div>

    <!-- Card 3 -->
    <div class="protocol-card card-hover">
        <div class="protocol-card__header">
            <span class="protocol-card__type-badge protocol-card__type-badge--treatment">Phác đồ</span>
            <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Active</span>
        </div>
        <div class="protocol-card__name">Phác đồ hóa trị ung thư phổi</div>
        <div class="protocol-card__icd">
            <span class="icd-chip">C34.9</span>
        </div>
        <div class="protocol-card__meta">
            <span class="protocol-card__meta-item">Ung bướu</span>
            <span class="protocol-card__meta-item">v3.0</span>
        </div>
        <div class="protocol-card__footer">
            <span class="protocol-card__usage">Áp dụng: 67 lần</span>
            <a href="/protocols/PD-003" class="protocol-card__link">Xem chi tiết &rarr;</a>
        </div>
    </div>

    <!-- Card 4 -->
    <div class="protocol-card card-hover">
        <div class="protocol-card__header">
            <span class="protocol-card__type-badge protocol-card__type-badge--surgery">Phẫu thuật</span>
            <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Active</span>
        </div>
        <div class="protocol-card__name">Quy trình mổ nội soi cắt túi mật</div>
        <div class="protocol-card__icd">
            <span class="icd-chip">K80.2</span>
        </div>
        <div class="protocol-card__meta">
            <span class="protocol-card__meta-item">Ngoại khoa</span>
            <span class="protocol-card__meta-item">v2.1</span>
        </div>
        <div class="protocol-card__footer">
            <span class="protocol-card__usage">Áp dụng: 89 lần</span>
            <a href="/protocols/PD-004" class="protocol-card__link">Xem chi tiết &rarr;</a>
        </div>
    </div>

    <!-- Card 5 -->
    <div class="protocol-card card-hover">
        <div class="protocol-card__header">
            <span class="protocol-card__type-badge protocol-card__type-badge--treatment">Phác đồ</span>
            <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Active</span>
        </div>
        <div class="protocol-card__name">Phác đồ điều trị đái tháo đường type 2</div>
        <div class="protocol-card__icd">
            <span class="icd-chip">E11.9</span>
        </div>
        <div class="protocol-card__meta">
            <span class="protocol-card__meta-item">Nội tiết</span>
            <span class="protocol-card__meta-item">v1.5</span>
        </div>
        <div class="protocol-card__footer">
            <span class="protocol-card__usage">Áp dụng: 256 lần</span>
