        </div>
    </div>

    <!-- Card 8 -->
    <div class="protocol-card card-hover">
        <div class="protocol-card__header">
            <span class="protocol-card__type-badge protocol-card__type-badge--treatment">Phác đồ</span>
            <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Active</span>
        </div>
        <div class="protocol-card__name">Phác đồ kháng sinh kinh nghiệm</div>
        <div class="protocol-card__icd">
            <span class="icd-chip">A41.9</span>
        </div>
        <div class="protocol-card__meta">
            <span class="protocol-card__meta-item">Truyền nhiễm</span>
            <span class="protocol-card__meta-item">v4.0</span>
        </div>
        <div class="protocol-card__footer">
            <span class="protocol-card__usage">Áp dụng: 312 lần</span>
            <a href="/protocols/PD-008" class="protocol-card__link">Xem chi tiết &rarr;</a>
