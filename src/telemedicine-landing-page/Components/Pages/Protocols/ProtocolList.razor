        </div>
    </div>

    <!-- Card 6 -->
    <div class="protocol-card card-hover">
        <div class="protocol-card__header">
            <span class="protocol-card__type-badge protocol-card__type-badge--procedure">Thủ thuật</span>
            <span class="status-badge status-badge--draft"><span class="status-badge__dot"></span>Draft</span>
        </div>
        <div class="protocol-card__name">Thủ thuật sinh thiết tuyến giáp</div>
        <div class="protocol-card__icd">
            <span class="icd-chip">E04.1</span>
        </div>
        <div class="protocol-card__meta">
            <span class="protocol-card__meta-item">Nội tiết</span>
            <span class="protocol-card__meta-item">v1.0</span>
        </div>
        <div class="protocol-card__footer">
            <span class="protocol-card__usage">Áp dụng: 12 lần</span>
            <a href="/protocols/PD-006" class="protocol-card__link">Xem chi tiết &rarr;</a>
        </div>
    </div>

    <!-- Card 7 -->
    <div class="protocol-card card-hover">
        <div class="protocol-card__header">
            <span class="protocol-card__type-badge protocol-card__type-badge--care">Chăm sóc</span>
            <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Active</span>
        </div>
        <div class="protocol-card__name">Chăm sóc bệnh nhân thở máy</div>
        <div class="protocol-card__icd">
            <span class="icd-chip">J96.0</span>
        </div>
        <div class="protocol-card__meta">
            <span class="protocol-card__meta-item">Hồi sức</span>
