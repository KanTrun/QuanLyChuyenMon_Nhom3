@page "/phe-duyet"
@layout AdminLayout
@using TelemedicineLandingPage.Services.Admin.Sql
@using TelemedicineLandingPage.Models.Admin.Sql
@inject PermissionChangeRequestService RequestService
@inject ICurrentUserContext UserContext
@inject IMedDataStore Store
@inject IToastService Toast
@inject AdminActionGuard Guard
@implements IDisposable

<PageTitle>Hộp phê duyệt | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Phê duyệt quyền</span>
            <h1 class="admin-page-title">Hộp yêu cầu chờ phê duyệt</h1>
            <p class="admin-page-subtitle">Xem xét và phê duyệt hoặc từ chối các yêu cầu thay đổi quyền.</p>
        </div>
    </header>

    <AdminDataTable TItem="PermissionChangeRequest"
                    Items="_pending"
                    ColumnCount="5"
                    CurrentPage="1"
                    PageSize="50"
                    TotalItems="_pending.Count"
                    EmptyTitle="Không có yêu cầu"
                    EmptyBody="Hiện tại không có yêu cầu nào đang chờ phê duyệt.">
        <HeaderTemplate>
            <th>Người yêu cầu</th>
            <th>Loại đối tượng</th>
            <th>Lý do</th>
            <th>Ngày yêu cầu</th>
            <th>Thao tác</th>
        </HeaderTemplate>
        <RowTemplate Context="req">
            <tr>
                <td>@GetUserName(req.RequestedBy)</td>
                <td>
                    <AdminBadge Tone="tone-secondary">@TargetTypeLabel(req.TargetType)</AdminBadge>
                </td>
                <td>@req.Reason</td>
                <td>@req.RequestedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td style="display:flex;gap:0.5rem;">
                    <button class="admin-btn admin-btn-sm admin-btn-primary" @onclick="() => Approve(req.PermissionChangeRequestId)">
                        Phê duyệt
                    </button>
                    <button class="admin-btn admin-btn-sm admin-btn-ghost" @onclick="() => Reject(req.PermissionChangeRequestId)">
                        Từ chối
                    </button>
                </td>
            </tr>
        </RowTemplate>
    </AdminDataTable>
</section>

<AdminModal IsOpen="_rejectModalOpen" IsOpenChanged="v => _rejectModalOpen = v" Title="Từ chối yêu cầu">
    <ChildContent>
        <div class="admin-form-field">
            <label class="admin-form-field-label">Lý do từ chối</label>
            <textarea class="admin-textarea" rows="4" @bind="_rejectReason"></textarea>
        </div>
    </ChildContent>
    <FooterContent>
        <button class="admin-btn admin-btn-ghost" @onclick="() => _rejectModalOpen = false">Hủy</button>
        <button class="admin-btn admin-btn-danger" @onclick="ConfirmReject">Từ chối</button>
    </FooterContent>
</AdminModal>

@code {
    private IReadOnlyList<PermissionChangeRequest> _pending = Array.Empty<PermissionChangeRequest>();
    private bool _rejectModalOpen;
    private Guid? _rejectRequestId;
    private string _rejectReason = string.Empty;

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
        Refresh();
    }

    private void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Refresh()
    {
        _pending = RequestService.GetByStatus("pending_approval");
    }

    private string GetUserName(Guid userId)
        => Store.Users.FirstOrDefault(u => u.UserId == userId)?.FullName ?? "Không xác định";

    private void Approve(Guid requestId)
    {
        if (!Guard.CanDo("SCR_PERMISSION_APPROVAL:APPROVE", "phê duyệt yêu cầu quyền"))
        {
            return;
        }

        try
        {
            var actor = UserContext.CurrentUser?.UserId ?? Guid.Empty;
            RequestService.Approve(requestId, actor);
            Toast.Show("Đã phê duyệt yêu cầu", "Thay đổi quyền đã được áp dụng.", ToastVariant.Success);
        }
        catch (MedDomainException ex) { Toast.Show("Không thể phê duyệt", ex.Message, ToastVariant.Error); }
    }

    private void Reject(Guid requestId)
    {
        if (!Guard.CanDo("SCR_PERMISSION_APPROVAL:APPROVE", "từ chối yêu cầu quyền"))
        {
            return;
        }

        _rejectRequestId = requestId;
        _rejectReason = string.Empty;
        _rejectModalOpen = true;
    }

    private void ConfirmReject()
    {
        if (_rejectRequestId is null)
        {
            return;
        }

        if (!Guard.CanDo("SCR_PERMISSION_APPROVAL:APPROVE", "từ chối yêu cầu quyền"))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            Toast.Show("Thiếu lý do", "Vui lòng nhập lý do từ chối.", ToastVariant.Warning);
            return;
        }

        try
        {
            var actor = UserContext.CurrentUser?.UserId ?? Guid.Empty;
            RequestService.Reject(_rejectRequestId.Value, actor, _rejectReason.Trim());
            _rejectModalOpen = false;
            _rejectRequestId = null;
            _rejectReason = string.Empty;
            Toast.Show("Đã từ chối yêu cầu", "Yêu cầu đã được chuyển sang trạng thái từ chối.", ToastVariant.Warning);
        }
        catch (MedDomainException ex) { Toast.Show("Không thể từ chối", ex.Message, ToastVariant.Error); }
    }

    private static string TargetTypeLabel(string targetType) => targetType switch
    {
        "role_permission" => "Quyền vai trò",
        "user_permission_override" => "Ghi đè quyền người dùng",
        "user_role" => "Vai trò người dùng",
        "group_permission" => "Quyền nhóm",
        _ => targetType
    };

    public void Dispose() => Store.StateChanged -= OnChanged;
}
