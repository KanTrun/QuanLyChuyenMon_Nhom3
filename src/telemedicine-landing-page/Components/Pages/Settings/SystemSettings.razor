                    <span class="log-entry__level log-entry__level--info">Info</span>
                    <span class="log-entry__module">Auth</span>
                    <span class="log-entry__detail">Dang nhap thanh cong: Admin Tran Van A</span>
                </div>
                <div class="log-entry">
                    <span class="log-entry__time">2024-03-15 09:00</span>
                    <span class="log-entry__level log-entry__level--error">Error</span>
                    <span class="log-entry__module">Email</span>
