@page "/settings"
@layout AppLayout

<PageTitle>Cai dat He thong - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <h1 style="margin-bottom:1.5rem;">Cai dat He thong</h1>

    <!-- Tab Navigation -->
    <div class="tabs-animated" role="tablist" style="margin-bottom:2rem;">
        <button class="tabs-animated__tab tabs-animated__tab--active" role="tab">Ho so</button>
        <button class="tabs-animated__tab" role="tab">Bao mat</button>
        <button class="tabs-animated__tab" role="tab">Thong bao</button>
        <button class="tabs-animated__tab" role="tab">Giao dien</button>
        <button class="tabs-animated__tab" role="tab">He thong</button>
    </div>

    <!-- Tab 1: Ho so (Profile) -->
    <div class="tabs-animated__content" data-tab="profile">
        <div class="glass-card" style="padding:2rem; max-width:640px;">
            <!-- Avatar Upload -->
            <div style="display:flex; align-items:center; gap:1.5rem; margin-bottom:2rem;">
                <div style="width:80px; height:80px; border-radius:50%; background:var(--color-primary-100); display:flex; align-items:center; justify-content:center; font-size:1.5rem; font-weight:700; color:var(--color-primary); position:relative; cursor:pointer;" aria-label="Thay doi anh dai dien">
                    NA
                    <div style="position:absolute; bottom:0; right:0; width:24px; height:24px; border-radius:50%; background:var(--color-primary); display:flex; align-items:center; justify-content:center;">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 3v6M3 6h6" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </div>
                </div>
                <div>
                    <div style="font-weight:700;">BS. Nguyen Van An</div>
                    <div style="font-size:0.8125rem; color:var(--text-secondary);">Quan tri vien - Ngoai tong hop</div>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Ho ten</label>
                <input type="text" class="form-input" value="Nguyen Van An" aria-label="Ho ten" />
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" class="form-input" value="nguyenvanan@benhvien.vn" aria-label="Email" />
            </div>
            <div class="form-group">
                <label class="form-label">So dien thoai</label>
                <input type="tel" class="form-input" value="0912 345 678" aria-label="So dien thoai" />
            </div>
            <div class="form-group">
                <label class="form-label">Chuc vu</label>
                <input type="text" class="form-input" value="Bac si - Truong khoa" aria-label="Chuc vu" />
            </div>
            <div class="form-group">
                <label class="form-label">Khoa/Phong</label>
                <select class="form-input" aria-label="Khoa phong">
                    <option selected>Ngoai tong hop</option>
                    <option>Noi tong hop</option>
                    <option>Xet nghiem</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Gioi thieu</label>
                <textarea class="form-input form-textarea" rows="3" aria-label="Gioi thieu">Bac si chuyen khoa Ngoai tong hop, 15 nam kinh nghiem phau thuat noi soi.</textarea>
            </div>
            <div style="display:flex; gap:0.75rem; margin-top:1.5rem;">
                <button class="btn-primary">Luu thay doi</button>
                <button class="btn-secondary">Huy bo</button>
            </div>
        </div>
    </div>

    <!-- Tab 2: Bao mat (Security) -->
    <div class="tabs-animated__content" data-tab="security" style="display:none;">
        <div class="glass-card" style="padding:2rem; max-width:640px; margin-bottom:1.5rem;">
            <h3 style="margin-bottom:1.25rem;">Doi mat khau</h3>
            <div class="form-group">
                <label class="form-label">Mat khau hien tai</label>
                <input type="password" class="form-input" placeholder="Nhap mat khau hien tai" aria-label="Mat khau hien tai" />
            </div>
            <div class="form-group">
                <label class="form-label">Mat khau moi</label>
                <input type="password" class="form-input" placeholder="Nhap mat khau moi" aria-label="Mat khau moi" />
                <div class="strength-meter"><div class="strength-meter__fill strength-meter__fill--medium"></div></div>
                <span style="font-size:0.6875rem; color:var(--color-warning);">Trung binh</span>
            </div>
            <div class="form-group">
                <label class="form-label">Xac nhan mat khau</label>
                <input type="password" class="form-input" placeholder="Nhap lai mat khau moi" aria-label="Xac nhan mat khau" />
            </div>
            <button class="btn-primary">Cap nhat mat khau</button>
        </div>

        <div class="glass-card" style="padding:2rem; max-width:640px; margin-bottom:1.5rem;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
                <div>
                    <h3>Xac thuc hai yeu to (2FA)</h3>
                    <p style="font-size:0.8125rem; color:var(--text-secondary);">Tang cuong bao mat tai khoan</p>
                </div>
                <label style="position:relative; display:inline-block; width:48px; height:26px; cursor:pointer;">
                    <input type="checkbox" style="opacity:0; width:0; height:0;" aria-label="Bat 2FA" />
                    <span style="position:absolute; inset:0; background:var(--border-color); border-radius:13px; transition:0.3s;"></span>
                </label>
            </div>
            <div style="background:var(--surface-secondary); border-radius:var(--radius-md); padding:1rem; text-align:center;">
                <p style="font-size:0.8125rem; color:var(--text-muted);">Quet ma QR bang ung dung Authenticator</p>
                <div style="width:120px; height:120px; background:var(--border-color); margin:1rem auto; border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; color:var(--text-muted); font-size:0.75rem;">[QR Code]</div>
            </div>
        </div>

        <div class="glass-card" style="padding:2rem; max-width:640px;">
            <h3 style="margin-bottom:1rem;">Phien dang nhap</h3>
            <table class="data-table" aria-label="Phien dang nhap">
                <thead><tr><th>Thiet bi</th><th>IP</th><th>Lan cuoi</th><th></th></tr></thead>
                <tbody>
                    <tr><td>Chrome - Windows 11</td><td>192.168.1.45</td><td>Dang hoat dong</td><td><span class="status-badge status-badge--active" style="font-size:0.625rem;">Hien tai</span></td></tr>
                    <tr><td>Safari - iPhone 15</td><td>10.0.0.23</td><td>2 gio truoc</td><td><button class="action-btn action-btn--danger" title="Thu hoi">Thu hoi</button></td></tr>
                    <tr><td>Firefox - MacOS</td><td>172.16.0.8</td><td>1 ngay truoc</td><td><button class="action-btn action-btn--danger" title="Thu hoi">Thu hoi</button></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab 3: Thong bao (Notifications) -->
    <div class="tabs-animated__content" data-tab="notifications" style="display:none;">
        <div class="glass-card" style="padding:2rem; max-width:640px;">
            <h3 style="margin-bottom:1.25rem;">Tuy chon thong bao</h3>
            <table class="data-table" aria-label="Tuy chon thong bao">
                <thead><tr><th>Loai</th><th>Email</th><th>Push</th><th>In-app</th></tr></thead>
                <tbody>
                    <tr><td style="font-weight:500;">Quy trinh</td><td><input type="checkbox" checked /></td><td><input type="checkbox" checked /></td><td><input type="checkbox" checked /></td></tr>
                    <tr><td style="font-weight:500;">Phan quyen</td><td><input type="checkbox" checked /></td><td><input type="checkbox" /></td><td><input type="checkbox" checked /></td></tr>
                    <tr><td style="font-weight:500;">Phac do</td><td><input type="checkbox" /></td><td><input type="checkbox" checked /></td><td><input type="checkbox" checked /></td></tr>
                    <tr><td style="font-weight:500;">He thong</td><td><input type="checkbox" checked /></td><td><input type="checkbox" /></td><td><input type="checkbox" checked /></td></tr>
                </tbody>
            </table>
            <div style="margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--border-color);">
                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <div>
                        <div style="font-weight:600; font-size:0.875rem;">Gio im lang</div>
                        <div style="font-size:0.75rem; color:var(--text-muted);">Khong gui thong bao push trong khung gio nay</div>
                    </div>
                    <label style="position:relative; display:inline-block; width:48px; height:26px; cursor:pointer;">
                        <input type="checkbox" checked style="opacity:0; width:0; height:0;" aria-label="Bat gio im lang" />
                        <span style="position:absolute; inset:0; background:var(--color-primary); border-radius:13px;"></span>
                    </label>
                </div>
                <div style="display:flex; gap:0.75rem; margin-top:0.75rem;">
                    <input type="time" class="form-input" value="22:00" style="width:120px;" aria-label="Tu gio" />
                    <span style="align-self:center; color:var(--text-muted);">den</span>
                    <input type="time" class="form-input" value="07:00" style="width:120px;" aria-label="Den gio" />
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 4: Giao dien (Display) -->
    <div class="tabs-animated__content" data-tab="display" style="display:none;">
        <div class="glass-card" style="padding:2rem; max-width:640px;">
            <!-- Dark Mode -->
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
                <div>
                    <div style="font-weight:600; font-size:0.875rem;">Che do toi (Dark mode)</div>
                    <div style="font-size:0.75rem; color:var(--text-muted);">Chuyen giao dien sang che do toi</div>
                </div>
                <label style="position:relative; display:inline-block; width:48px; height:26px; cursor:pointer;">
                    <input type="checkbox" style="opacity:0; width:0; height:0;" aria-label="Bat che do toi" data-dark-toggle />
                    <span style="position:absolute; inset:0; background:var(--border-color); border-radius:13px; transition:0.3s;"></span>
                </label>
            </div>
            <!-- Language -->
            <div style="margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
                <label class="form-label">Ngon ngu</label>
                <select class="form-input" style="max-width:200px;" aria-label="Ngon ngu">
                    <option selected>Tieng Viet</option>
                    <option>English</option>
                </select>
            </div>
            <!-- Font Size -->
            <div style="margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
                <label class="form-label">Co chu</label>
                <div style="display:flex; gap:1rem; align-items:center;">
                    <span style="font-size:0.75rem; color:var(--text-muted);">Nho</span>
                    <input type="range" min="12" max="18" value="14" style="flex:1;" aria-label="Co chu" />
                    <span style="font-size:0.75rem; color:var(--text-muted);">Lon</span>
                </div>
            </div>
            <!-- Sidebar Position -->
            <div style="margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
                <label class="form-label">Vi tri thanh ben</label>
                <div style="display:flex; gap:1rem;">
                    <label style="display:flex; align-items:center; gap:0.375rem; font-size:0.8125rem; cursor:pointer;">
                        <input type="radio" name="sidebar" checked /> Trai
                    </label>
                    <label style="display:flex; align-items:center; gap:0.375rem; font-size:0.8125rem; cursor:pointer;">
                        <input type="radio" name="sidebar" /> Phai
                    </label>
                </div>
            </div>
            <!-- Reduce Motion -->
            <div style="display:flex; align-items:center; justify-content:space-between;">
                <div>
                    <div style="font-weight:600; font-size:0.875rem;">Giam chuyen dong</div>
                    <div style="font-size:0.75rem; color:var(--text-muted);">Tat hieu ung animation</div>
                </div>
                <label style="position:relative; display:inline-block; width:48px; height:26px; cursor:pointer;">
                    <input type="checkbox" style="opacity:0; width:0; height:0;" aria-label="Giam chuyen dong" />
                    <span style="position:absolute; inset:0; background:var(--border-color); border-radius:13px; transition:0.3s;"></span>
                </label>
            </div>
        </div>
    </div>

    <!-- Tab 5: He thong (System - Admin only) -->
    <div class="tabs-animated__content" data-tab="system" style="display:none;">
        <div class="glass-card" style="padding:2rem; max-width:640px;">
            <!-- Maintenance mode -->
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
                <div>
                    <div style="font-weight:600; font-size:0.875rem;">Che do bao tri</div>
                    <div style="font-size:0.75rem; color:var(--text-muted);">Tam thoi khoa he thong de bao tri</div>
                </div>
                <label style="position:relative; display:inline-block; width:48px; height:26px; cursor:pointer;">
                    <input type="checkbox" style="opacity:0; width:0; height:0;" aria-label="Bat bao tri" />
                    <span style="position:absolute; inset:0; background:var(--border-color); border-radius:13px; transition:0.3s;"></span>
                </label>
            </div>
            <div style="background:rgba(245,158,11,0.05); border:1px solid rgba(245,158,11,0.2); border-radius:var(--radius-md); padding:0.75rem; margin-bottom:1.5rem; font-size:0.8125rem; color:var(--color-warning);">
                Canh bao: Bat che do bao tri se khoa truy cap cho tat ca nguoi dung ngoai tru Admin.
            </div>
            <!-- Backup -->
            <div style="margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem;">
                    <div style="font-weight:600; font-size:0.875rem;">Sao luu du lieu</div>
                    <button class="btn-secondary" style="font-size:0.75rem; padding:0.25rem 0.75rem;">Sao luu ngay</button>
                </div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">
                    <p>Lan sao luu cuoi: 10/04/2024 02:00 AM</p>
                    <p>Dung luong: 2.3 GB | Trang thai: <span style="color:var(--color-success);">Thanh cong</span></p>
                </div>
            </div>
            <!-- Version info -->
            <div style="margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
                <div style="font-weight:600; font-size:0.875rem; margin-bottom:0.5rem;">Thong tin he thong</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">
                    <p>Phien ban: QLCM Pro v3.2.1</p>
                    <p>Server: .NET 9.0 | Database: SQL Server 2022</p>
                    <p>Uptime: 45 ngay 12 gio</p>
                </div>
            </div>
            <!-- Cache -->
            <div style="margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <div>
                        <div style="font-weight:600; font-size:0.875rem;">Xoa cache</div>
                        <div style="font-size:0.75rem; color:var(--text-muted);">Giai phong bo nho dem he thong</div>
                    </div>
                    <button class="btn-secondary" style="font-size:0.75rem; padding:0.25rem 0.75rem;">Xoa cache</button>
                </div>
            </div>
            <!-- Database status -->
            <div>
                <div style="font-weight:600; font-size:0.875rem; margin-bottom:0.5rem;">Trang thai Database</div>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <div style="width:10px; height:10px; border-radius:50%; background:var(--color-success);"></div>
                    <span style="font-size:0.8125rem; color:var(--color-success);">Hoat dong binh thuong</span>
                </div>
                <div style="font-size:0.75rem; color:var(--text-muted); margin-top:0.25rem;">Ket noi: 12/100 | Dung luong: 45.2 GB / 100 GB</div>
            </div>
        </div>
    </div>
</div>

@code {
    private string activeTab = "profile";
}
