@page "/dieu-phoi"
@layout PersonaLayout
@using TelemedicineLandingPage.Services.Admin.Sql
@using TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@implements IDisposable

<PageTitle>Điều phối kỹ thuật | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Điều phối</span>
            <h1 class="admin-page-title">Chỉ định kỹ thuật</h1>
            <p class="admin-page-subtitle">Theo dõi phiếu chỉ định kỹ thuật và trạng thái thực hiện.</p>
        </div>
    </header>

    <AdminDataTable TItem="TechnicalOrder"
                    Items="_pagedItems"
                    ColumnCount="5"
                    CurrentPage="_page"
                    PageSize="_pageSize"
                    TotalItems="_total"
                    CurrentPageChanged="p => { _page = p; Paginate(); }">
        <HeaderTemplate>
            <th>Dịch vụ</th>
            <th>Bệnh nhân</th>
            <th>Khoa chỉ định</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
        </HeaderTemplate>
        <RowTemplate Context="order">
            <tr>
                <td>@GetServiceName(order.TechnicalServiceId)</td>
                <td>@GetPatientName(order.PatientRefId)</td>
                <td>@GetDeptName(order.OrderingDepartmentId)</td>
                <td>
                    <AdminBadge Tone="@GetOrderTone(order.OrderStatus)">
                        @GetOrderLabel(order.OrderStatus)
                    </AdminBadge>
                </td>
                <td>@order.OrderedAt.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        </RowTemplate>
    </AdminDataTable>
</section>

@code {
    private int _page = 1;
    private const int _pageSize = 10;
    private int _total;
    private IReadOnlyList<TechnicalOrder> _pagedItems = Array.Empty<TechnicalOrder>();

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
        Paginate();
    }

    private void OnChanged() => InvokeAsync(() => { Paginate(); StateHasChanged(); });

    private void Paginate()
    {
        var all = Store.TechnicalOrders.OrderByDescending(o => o.OrderedAt).ToList();
        _total = all.Count;
        _pagedItems = all.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    }

    private string GetServiceName(Guid svcId)
        => Store.TechnicalServices.FirstOrDefault(s => s.TechnicalServiceId == svcId)?.Name ?? "—";

    private string GetPatientName(Guid? patientId)
        => patientId.HasValue
            ? Store.PatientRefs.FirstOrDefault(p => p.PatientRefId == patientId.Value)?.DisplayName ?? "—"
            : "—";

    private string GetDeptName(Guid? deptId)
        => deptId.HasValue
            ? Store.Departments.FirstOrDefault(d => d.DepartmentId == deptId.Value)?.Name ?? "—"
            : "—";

    private static string GetOrderTone(string status) => status switch
    {
        "completed" => "tone-success",
        "pending" => "tone-warning",
        "cancelled" => "tone-danger",
        _ => "tone-muted"
    };

    private static string GetOrderLabel(string status) => status switch
    {
        "completed" => "Hoàn thành",
        "pending" => "Đang chờ",
        "in_progress" => "Đang thực hiện",
        "cancelled" => "Đã hủy",
        _ => status
    };

    public void Dispose() => Store.StateChanged -= OnChanged;
}
