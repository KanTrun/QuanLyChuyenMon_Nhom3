@page "/admin/to-chuc/nguoi-dung"
@layout AdminLayout
@using TelemedicineLandingPage.Services.Admin.Sql
@using TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@inject ICurrentUserContext UserContext
@inject IToastService Toast
@inject AdminActionGuard Guard
@inject IConfirmDialogService Confirm
@implements IDisposable

<PageTitle>Người dùng | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Tổ chức</span>
            <h1 class="admin-page-title">Quản lý người dùng</h1>
            <p class="admin-page-subtitle">Tạo, xem chi tiết, chỉnh sửa, gán vai trò/nhóm và lưu trữ mềm tài khoản.</p>
        </div>
        <button class="admin-btn admin-btn-primary" @onclick="OpenCreate">Thêm người dùng</button>
    </header>

    <div class="admin-filter-bar">
        <div class="admin-filter-field">
            <label class="admin-filter-label">Tìm kiếm</label>
            <input class="admin-input" placeholder="Tên, username, email..." @bind="_search" @bind:after="ResetAndPaginate" />
        </div>
        <div class="admin-filter-field">
            <label class="admin-filter-label">Trạng thái</label>
            <select class="admin-select" @bind="_statusFilter" @bind:after="ResetAndPaginate">
                <option value="all">Tất cả</option>
                <option value="active">Đang hoạt động</option>
                <option value="inactive">Lưu trữ/vô hiệu</option>
            </select>
        </div>
        <div class="admin-filter-field">
            <label class="admin-filter-label">Khoa/phòng</label>
            <select class="admin-select" @bind="_departmentFilter" @bind:after="ResetAndPaginate">
                <option value="">Tất cả</option>
                @foreach (var d in DepartmentOptions())
                {
                    <option value="@d.DepartmentId">@DepartmentOptionLabel(d)</option>
                }
            </select>
        </div>
        <div class="admin-filter-field" style="align-self:end;">
            <span class="admin-table-cell-muted">@_total tài khoản</span>
        </div>
    </div>

    <AdminDataTable TItem="AppUser"
                    Items="_pagedItems"
                    ColumnCount="7"
                    CurrentPage="_page"
                    PageSize="_pageSize"
                    TotalItems="_total"
                    CurrentPageChanged="p => { _page = p; Paginate(); }">
        <HeaderTemplate>
            <th>Họ tên</th>
            <th>Tên đăng nhập</th>
            <th>Email</th>
            <th>Khoa/phòng</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </HeaderTemplate>
        <RowTemplate Context="user">
            <tr>
                <td>
                    <div class="admin-table-cell-strong">@user.FullName</div>
                    <div class="admin-table-cell-muted">@AdminDateTimeDisplay.ShortDateTime(user.UpdatedAt)</div>
                </td>
                <td>@user.Username</td>
                <td>@(user.Email ?? "—")</td>
                <td>@GetDeptName(user.PrimaryDepartmentId)</td>
                <td>@RoleSummary(user.UserId)</td>
                <td><AdminBadge Tone="@StatusTone(user.Status)">@StatusLabel(user.Status)</AdminBadge></td>
                <td>
                    <div class="admin-row-actions">
                        <button class="admin-btn admin-btn-sm admin-btn-ghost" @onclick="() => OpenDetails(user)">Xem</button>
                        <button class="admin-btn admin-btn-sm admin-btn-ghost" @onclick="() => OpenEdit(user)">Sửa</button>
                        @if (user.Status == "active")
                        {
                            <button class="admin-btn admin-btn-sm admin-btn-ghost"
                                    disabled="@IsCurrentUser(user)"
                                    title="@(IsCurrentUser(user) ? "Không thể tự vô hiệu hóa tài khoản đang dùng" : "Lưu trữ/vô hiệu hóa")"
                                    @onclick="() => ArchiveUser(user)">
                                Lưu trữ
                            </button>
                        }
                        else
                        {
                            <button class="admin-btn admin-btn-sm admin-btn-primary" @onclick="() => RestoreUser(user)">Khôi phục</button>
                        }
                    </div>
                </td>
            </tr>
        </RowTemplate>
    </AdminDataTable>

    <AdminDrawer IsOpen="_drawerOpen" IsOpenChanged="v => _drawerOpen = v" SizeClass="admin-drawer-wide"
                 Eyebrow="Người dùng"
                 Title="@(_mode == FormMode.Create ? "Thêm người dùng" : _fullName)"
                 Subtitle="@(_selectedUser is null ? null : $"{_selectedUser.Username} • {StatusLabel(_selectedUser.Status)}")">
        <ChildContent>
            @if (IsReadonly && _selectedUser is not null)
            {
                <dl class="admin-detail-grid">
                    <dt>Họ tên</dt>
                    <dd>@_selectedUser.FullName</dd>
                    <dt>Tên đăng nhập</dt>
                    <dd>@_selectedUser.Username</dd>
                    <dt>Email</dt>
                    <dd>@(_selectedUser.Email ?? "—")</dd>
                    <dt>Khoa/phòng chính</dt>
                    <dd>@GetDeptName(_selectedUser.PrimaryDepartmentId)</dd>
                    <dt>Trạng thái</dt>
                    <dd><AdminBadge Tone="@StatusTone(_selectedUser.Status)">@StatusLabel(_selectedUser.Status)</AdminBadge></dd>
                    <dt>Cập nhật gần nhất</dt>
                    <dd>@AdminDateTimeDisplay.ShortDateTime(_selectedUser.UpdatedAt)</dd>
                </dl>
            }
            else
            {
            <div class="admin-form-grid">
                <div class="admin-form-field">
                    <label class="admin-form-field-label is-required">Họ tên</label>
                    <input class="admin-input" @bind="_fullName" disabled="@IsReadonly" />
                </div>
                <div class="admin-form-field">
                    <label class="admin-form-field-label is-required">Tên đăng nhập</label>
                    <input class="admin-input" @bind="_username" disabled="@(_mode != FormMode.Create)" />
                </div>
                <div class="admin-form-field">
                    <label class="admin-form-field-label">Email</label>
                    <input class="admin-input" type="email" @bind="_email" disabled="@IsReadonly" />
                </div>
                <div class="admin-form-field">
                    <label class="admin-form-field-label">Khoa/phòng chính</label>
                    <select class="admin-select" @bind="_deptId" disabled="@IsReadonly">
                        <option value="">Không chọn</option>
                        @foreach (var d in DepartmentOptions())
                        {
                            <option value="@d.DepartmentId">@DepartmentOptionLabel(d)</option>
                        }
                    </select>
                </div>
                <div class="admin-form-field">
                    <label class="admin-form-field-label is-required">Trạng thái</label>
                    <select class="admin-select" @bind="_status" disabled="@IsReadonly">
                        <option value="active">Đang hoạt động</option>
                        <option value="inactive">Lưu trữ/vô hiệu</option>
                    </select>
                </div>
            </div>
            }

            @if (_selectedUser is not null)
            {
                <div class="admin-panel" style="padding:14px;margin-top:14px;">
                    <header class="admin-panel-head">
                        <h3 class="admin-panel-title">Vai trò</h3>
                        <div style="display:flex;gap:8px;">
                            <select class="admin-select" style="min-width:220px;" @bind="_roleToAdd">
                                <option value="">Chọn vai trò</option>
                                @foreach (var role in Store.Roles.Where(r => r.Status == "active").OrderBy(r => r.Name))
                                {
                                    <option value="@role.RoleId">@role.Name</option>
                                }
                            </select>
                            <button type="button" class="admin-btn admin-btn-ghost" @onclick="AddRole" disabled="@IsReadonly">Gán</button>
                        </div>
                    </header>
                    <div class="admin-row-actions">
                        @foreach (var ur in ActiveRoles(_selectedUser.UserId))
                        {
                            var role = Store.Roles.FirstOrDefault(r => r.RoleId == ur.RoleId);
                            <span class="admin-filter-chip">
                                @(role?.Name ?? "Vai trò không còn tồn tại")
                                @if (!IsReadonly)
                                {
                                    <button type="button" class="admin-icon-btn" title="Gỡ vai trò" @onclick="() => RemoveRole(ur)">×</button>
                                }
                            </span>
                        }
                    </div>
                </div>

                <div class="admin-panel" style="padding:14px;margin-top:14px;">
                    <header class="admin-panel-head">
                        <h3 class="admin-panel-title">Nhóm</h3>
                        <div style="display:flex;gap:8px;">
                            <select class="admin-select" style="min-width:220px;" @bind="_groupToAdd">
                                <option value="">Chọn nhóm</option>
                                @foreach (var group in Store.Groups.Where(g => g.Status == "active").OrderBy(g => g.Name))
                                {
                                    <option value="@group.GroupId">@group.Name</option>
                                }
                            </select>
                            <button type="button" class="admin-btn admin-btn-ghost" @onclick="AddGroup" disabled="@IsReadonly">Gán</button>
                        </div>
                    </header>
                    <div class="admin-row-actions">
                        @foreach (var member in ActiveGroups(_selectedUser.UserId))
                        {
                            var group = Store.Groups.FirstOrDefault(g => g.GroupId == member.GroupId);
                            <span class="admin-filter-chip">
                                @(group?.Name ?? "Nhóm không còn tồn tại")
                                @if (!IsReadonly)
                                {
                                    <button type="button" class="admin-icon-btn" title="Gỡ nhóm" @onclick="() => RemoveGroup(member)">×</button>
                                }
                            </span>
                        }
                    </div>
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (_selectedUser is not null && !IsCurrentUser(_selectedUser))
            {
                <button class="admin-btn admin-btn-ghost" @onclick="() => ResetPassword(_selectedUser)">Đặt lại mật khẩu</button>
            }
            @if (!IsReadonly)
            {
                <button class="admin-btn admin-btn-primary" @onclick="SaveUser">Lưu</button>
            }
            <button class="admin-btn admin-btn-ghost" @onclick="() => _drawerOpen = false">Đóng</button>
        </FooterContent>
    </AdminDrawer>
</section>

@code {
    private enum FormMode { Create, View, Edit }

    private int _page = 1;
    private const int _pageSize = 10;
    private int _total;
    private IReadOnlyList<AppUser> _pagedItems = Array.Empty<AppUser>();
    private bool _drawerOpen;
    private FormMode _mode = FormMode.Create;
    private AppUser? _selectedUser;
    private string _search = string.Empty;
    private string _statusFilter = "all";
    private string _departmentFilter = string.Empty;
    private string _fullName = string.Empty;
    private string _username = string.Empty;
    private string _email = string.Empty;
    private string _deptId = string.Empty;
    private string _status = "active";
    private string _roleToAdd = string.Empty;
    private string _groupToAdd = string.Empty;

    private bool IsReadonly => _mode == FormMode.View;

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
        Paginate();
    }

    private void OnChanged() => InvokeAsync(() =>
    {
        RefreshSelected();
        Paginate();
        StateHasChanged();
    });

    private void ResetAndPaginate()
    {
        _page = 1;
        Paginate();
    }

    private void Paginate()
    {
        var deptId = ParseGuid(_departmentFilter);
        var all = Store.Users
            .Where(u => _statusFilter == "all" || u.Status == _statusFilter)
            .Where(u => !deptId.HasValue || u.PrimaryDepartmentId == deptId.Value)
            .Where(MatchesSearch)
            .OrderBy(u => u.FullName)
            .ToList();
        _total = all.Count;
        var totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
        _page = Math.Clamp(_page, 1, totalPages);
        _pagedItems = all.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    }

    private bool MatchesSearch(AppUser user)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var key = _search.Trim();
        return user.FullName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || user.Username.Contains(key, StringComparison.OrdinalIgnoreCase)
            || (user.Email?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void OpenCreate()
    {
        if (!Guard.CanDo("SCR_ORG_USERS:CREATE", "thêm người dùng"))
        {
            return;
        }

        _mode = FormMode.Create;
        _selectedUser = null;
        _fullName = _username = _email = _deptId = _roleToAdd = _groupToAdd = string.Empty;
        _status = "active";
        _drawerOpen = true;
    }

    private void OpenDetails(AppUser user)
    {
        LoadUser(user, FormMode.View);
    }

    private void OpenEdit(AppUser user)
    {
        if (!Guard.CanDo("SCR_ORG_USERS:UPDATE", "sửa người dùng"))
        {
            return;
        }

        LoadUser(user, FormMode.Edit);
    }

    private void LoadUser(AppUser user, FormMode mode)
    {
        _mode = mode;
        _selectedUser = user;
        _fullName = user.FullName;
        _username = user.Username;
        _email = user.Email ?? string.Empty;
        _deptId = user.PrimaryDepartmentId?.ToString() ?? string.Empty;
        _status = user.Status;
        _roleToAdd = _groupToAdd = string.Empty;
        _drawerOpen = true;
    }

    private void SaveUser()
    {
        var permission = _mode == FormMode.Create ? "SCR_ORG_USERS:CREATE" : "SCR_ORG_USERS:UPDATE";
        var action = _mode == FormMode.Create ? "thêm người dùng" : "sửa người dùng";
        if (!Guard.CanDo(permission, action))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_fullName) || string.IsNullOrWhiteSpace(_username))
        {
            Toast.Show("Thiếu thông tin", "Vui lòng nhập họ tên và tên đăng nhập.", ToastVariant.Warning);
            return;
        }

        if (_selectedUser is not null && IsCurrentUser(_selectedUser) && _status != "active")
        {
            Toast.Show("Không thể tự vô hiệu hóa", "Bạn đang dùng tài khoản này.", ToastVariant.Warning);
            return;
        }

        try
        {
            var dept = ParseGuid(_deptId);
            if (_mode == FormMode.Create)
            {
                Store.AddUser(new AppUser
                {
                    Username = _username.Trim(),
                    FullName = _fullName.Trim(),
                    Email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                    PrimaryDepartmentId = dept,
                    Status = "inactive"
                });
                Toast.Show("Đã thêm người dùng", _fullName.Trim(), ToastVariant.Success);
            }
            else if (_selectedUser is not null)
            {
                Store.UpdateUser(_selectedUser with
                {
                    FullName = _fullName.Trim(),
                    Email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                    PrimaryDepartmentId = dept,
                    Status = _status,
                    DeletedAt = _status == "active" ? null : (_selectedUser.DeletedAt ?? DateTime.UtcNow),
                    UpdatedAt = DateTime.UtcNow
                });
                Toast.Show("Đã cập nhật người dùng", _fullName.Trim(), ToastVariant.Success);
            }

            _drawerOpen = false;
        }
        catch (Exception ex)
        {
            Toast.Show("Không thể lưu người dùng", ex.Message, ToastVariant.Error);
        }
    }

    private async Task ArchiveUser(AppUser user)
    {
        if (!Guard.CanDo("SCR_ORG_USERS:DELETE", "lưu trữ người dùng"))
        {
            return;
        }

        if (IsCurrentUser(user))
        {
            Toast.Show("Không thể tự vô hiệu hóa", "Bạn đang dùng tài khoản này. Hãy dùng tài khoản quản trị khác nếu cần khóa.", ToastVariant.Warning);
            return;
        }

        var ok = await Confirm.ShowAsync(
            "Lưu trữ tài khoản",
            $"Lưu trữ/vô hiệu hóa tài khoản \"{user.FullName}\"?",
            confirmText: "Lưu trữ",
            isDanger: true);
        if (!ok)
        {
            return;
        }

        try
        {
            Store.UpdateUser(user with { Status = "inactive", DeletedAt = DateTime.UtcNow, UpdatedAt = DateTime.UtcNow });
            Toast.Show("Đã lưu trữ tài khoản", user.FullName, ToastVariant.Success);
        }
        catch (Exception ex) { Toast.Show("Không thể lưu trữ", ex.Message, ToastVariant.Error); }
    }

    private async Task RestoreUser(AppUser user)
    {
        if (!Guard.CanDo("SCR_ORG_USERS:UPDATE", "khôi phục người dùng"))
        {
            return;
        }

        var ok = await Confirm.ShowAsync(
            "Khôi phục tài khoản",
            $"Khôi phục tài khoản \"{user.FullName}\"?",
            confirmText: "Khôi phục");
        if (!ok)
        {
            return;
        }

        try
        {
            Store.UpdateUser(user with { Status = "active", DeletedAt = null, UpdatedAt = DateTime.UtcNow });
            Toast.Show("Đã khôi phục tài khoản", user.FullName, ToastVariant.Success);
        }
        catch (Exception ex) { Toast.Show("Không thể khôi phục", ex.Message, ToastVariant.Error); }
    }

    private async Task ResetPassword(AppUser user)
    {
        if (!Guard.CanDo("SCR_ORG_USERS:UPDATE", "đặt lại mật khẩu người dùng"))
        {
            return;
        }

        if (IsCurrentUser(user))
        {
            Toast.Show("Không thể đặt lại", "Không đặt lại mật khẩu của chính tài khoản đang dùng tại đây.", ToastVariant.Warning);
            return;
        }

        var ok = await Confirm.ShowAsync(
            "Đặt lại mật khẩu",
            $"Xóa mật khẩu hiện tại của \"{user.FullName}\"? Người dùng sẽ cần thiết lập lại mật khẩu.",
            confirmText: "Đặt lại",
            isDanger: true);
        if (!ok)
        {
            return;
        }

        try
        {
            Store.UpdateUser(user with { PasswordHash = null, UpdatedAt = DateTime.UtcNow });
            Toast.Show("Đã đặt lại mật khẩu", user.FullName, ToastVariant.Success);
        }
        catch (Exception ex)
        {
            Toast.Show("Không thể đặt lại mật khẩu", ex.Message, ToastVariant.Error);
        }
    }

    private void AddRole()
    {
        if (_selectedUser is null || !Guid.TryParse(_roleToAdd, out var roleId)) return;
        if (!Guard.CanDo("SCR_ORG_USERS:UPDATE", "gán vai trò người dùng"))
        {
            return;
        }

        if (ActiveRoles(_selectedUser.UserId).Any(r => r.RoleId == roleId))
        {
            Toast.Show("Vai trò đã tồn tại", "Người dùng đã có vai trò này.", ToastVariant.Warning);
            return;
        }

        Store.AddUserRole(new UserRole { UserId = _selectedUser.UserId, RoleId = roleId, DepartmentId = ParseGuid(_deptId) });
        _roleToAdd = string.Empty;
    }

    private void RemoveRole(UserRole role)
    {
        if (!Guard.CanDo("SCR_ORG_USERS:UPDATE", "gỡ vai trò người dùng"))
        {
            return;
        }

        Store.RemoveUserRole(role.UserRoleId);
    }

    private void AddGroup()
    {
        if (_selectedUser is null || !Guid.TryParse(_groupToAdd, out var groupId)) return;
        if (!Guard.CanDo("SCR_ORG_USERS:UPDATE", "gán nhóm người dùng"))
        {
            return;
        }

        if (ActiveGroups(_selectedUser.UserId).Any(g => g.GroupId == groupId))
        {
            Toast.Show("Nhóm đã tồn tại", "Người dùng đã thuộc nhóm này.", ToastVariant.Warning);
            return;
        }

        Store.AddUserGroupMember(new UserGroupMember { UserId = _selectedUser.UserId, GroupId = groupId });
        _groupToAdd = string.Empty;
    }

    private void RemoveGroup(UserGroupMember member)
    {
        if (!Guard.CanDo("SCR_ORG_USERS:UPDATE", "gỡ nhóm người dùng"))
        {
            return;
        }

        Store.RemoveUserGroupMember(member.UserGroupMemberId);
    }

    private void RefreshSelected()
    {
        if (_selectedUser is null) return;
        _selectedUser = Store.Users.FirstOrDefault(u => u.UserId == _selectedUser.UserId);
    }

    private IReadOnlyList<UserRole> ActiveRoles(Guid userId)
        => Store.UserRoles.Where(r => r.UserId == userId && r.EffectiveTo is null).OrderBy(r => RoleName(r.RoleId)).ToList();

    private IReadOnlyList<UserGroupMember> ActiveGroups(Guid userId)
        => Store.UserGroupMembers.Where(g => g.UserId == userId && g.EffectiveTo is null).OrderBy(g => GroupName(g.GroupId)).ToList();

    private string RoleSummary(Guid userId)
    {
        var names = ActiveRoles(userId).Select(r => RoleName(r.RoleId)).Where(n => !string.IsNullOrWhiteSpace(n)).Take(2).ToList();
        return names.Count == 0 ? "—" : string.Join(", ", names) + (ActiveRoles(userId).Count > 2 ? "..." : string.Empty);
    }

    private string RoleName(Guid roleId) => Store.Roles.FirstOrDefault(r => r.RoleId == roleId)?.Name ?? string.Empty;
    private string GroupName(Guid groupId) => Store.Groups.FirstOrDefault(g => g.GroupId == groupId)?.Name ?? string.Empty;
    private IReadOnlyList<TelemedicineLandingPage.Models.Admin.Sql.Department> DepartmentOptions()
        => AdminBusinessDisplay.ActiveDepartmentsForSelection(Store.Departments);

    private string DepartmentOptionLabel(TelemedicineLandingPage.Models.Admin.Sql.Department? dept)
        => AdminBusinessDisplay.DepartmentLabel(dept, Store.Departments);

    private string GetDeptName(Guid? deptId) => deptId.HasValue ? DepartmentOptionLabel(Store.Departments.FirstOrDefault(d => d.DepartmentId == deptId.Value)) : "—";
    private bool IsCurrentUser(AppUser user) => UserContext.CurrentUser?.UserId == user.UserId;
    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static string StatusTone(string status) => status == "active" ? "tone-success" : "tone-muted";
    private static string StatusLabel(string status) => status == "active" ? "Hoạt động" : "Lưu trữ/vô hiệu";

    public void Dispose() => Store.StateChanged -= OnChanged;
}
