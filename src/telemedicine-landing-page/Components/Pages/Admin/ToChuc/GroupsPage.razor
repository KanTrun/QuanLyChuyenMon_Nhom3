@page "/admin/to-chuc/nhom"
@layout AdminLayout
@using TelemedicineLandingPage.Services.Admin.Sql
@using TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@inject IToastService Toast
@implements IDisposable

<PageTitle>Nhóm người dùng | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Tổ chức</span>
            <h1 class="admin-page-title">Quản lý nhóm người dùng</h1>
            <p class="admin-page-subtitle">Tạo nhóm để gán quyền tập thể cho nhiều người dùng.</p>
        </div>
        <button class="admin-btn admin-btn-primary" @onclick="OpenCreate">Thêm nhóm</button>
    </header>

    <AdminDataTable TItem="Group"
                    Items="_pagedItems"
                    ColumnCount="4"
                    CurrentPage="_page"
                    PageSize="_pageSize"
                    TotalItems="_total"
                    CurrentPageChanged="p => { _page = p; Paginate(); }">
        <HeaderTemplate>
            <th>Mã</th>
            <th>Tên nhóm</th>
            <th>Khoa/phòng</th>
            <th>Số thành viên</th>
        </HeaderTemplate>
        <RowTemplate Context="grp">
            <tr>
                <td>@grp.Code</td>
                <td>@grp.Name</td>
                <td>@(GetDeptName(grp.DepartmentId))</td>
                <td>@Store.UserGroupMembers.Count(m => m.GroupId == grp.GroupId)</td>
            </tr>
        </RowTemplate>
    </AdminDataTable>

    <AdminDrawer IsOpen="_drawerOpen" IsOpenChanged="v => _drawerOpen = v" Title="Thêm nhóm">
        <ChildContent>
            <div class="admin-form-group">
                <label class="admin-label">Mã nhóm</label>
                <input class="admin-input" @bind="_code" placeholder="VD: NHOM-BS-NOI" />
            </div>
            <div class="admin-form-group">
                <label class="admin-label">Tên nhóm</label>
                <input class="admin-input" @bind="_name" placeholder="VD: Nhóm bác sĩ nội" />
            </div>
            <div class="admin-form-group">
                <label class="admin-label">Khoa/phòng</label>
                <select class="admin-select" @bind="_deptId">
                    <option value="">— Không gắn khoa —</option>
                    @foreach (var d in Store.Departments.Where(d => d.Status == "active"))
                    {
                        <option value="@d.DepartmentId">@d.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-group">
                <label class="admin-label">Mô tả</label>
                <textarea class="admin-input" @bind="_desc" rows="2"></textarea>
            </div>
        </ChildContent>
        <FooterContent>
            <button class="admin-btn admin-btn-primary" @onclick="SaveGroup">Lưu</button>
            <button class="admin-btn admin-btn-ghost" @onclick="() => _drawerOpen = false">Hủy</button>
        </FooterContent>
    </AdminDrawer>
</section>

@code {
    private int _page = 1;
    private const int _pageSize = 10;
    private int _total;
    private IReadOnlyList<Group> _pagedItems = Array.Empty<Group>();
    private bool _drawerOpen;
    private string _code = "", _name = "", _desc = "", _deptId = "";

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
        Paginate();
    }

    private void OnChanged() => InvokeAsync(() => { Paginate(); StateHasChanged(); });

    private void Paginate()
    {
        var all = Store.Groups.OrderBy(g => g.Name).ToList();
        _total = all.Count;
        _pagedItems = all.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    }

    private string GetDeptName(Guid? deptId)
        => deptId.HasValue
            ? Store.Departments.FirstOrDefault(d => d.DepartmentId == deptId.Value)?.Name ?? "—"
            : "—";

    private void OpenCreate()
    {
        _code = _name = _desc = _deptId = "";
        _drawerOpen = true;
    }

    private void SaveGroup()
    {
        try
        {
            Guid? dept = string.IsNullOrEmpty(_deptId) ? null : Guid.Parse(_deptId);
            Store.AddGroup(new Group { Code = _code, Name = _name, DepartmentId = dept, Description = _desc });
            _drawerOpen = false;
            Toast.Show("Đã thêm nhóm thành công.", "success");
        }
        catch (MedDomainException ex) { Toast.Show(ex.Message, "error"); }
    }

    public void Dispose() => Store.StateChanged -= OnChanged;
}
