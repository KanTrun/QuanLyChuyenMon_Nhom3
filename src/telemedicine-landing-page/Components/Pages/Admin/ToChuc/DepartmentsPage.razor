@page "/admin/to-chuc/khoa-phong"
@layout AdminLayout
@using TelemedicineLandingPage.Services.Admin.Sql
@using Sql = TelemedicineLandingPage.Models.Admin.Sql
@using Dept = TelemedicineLandingPage.Models.Admin.Sql.Department
@inject IMedDataStore Store
@inject IToastService Toast
@implements IDisposable

<PageTitle>Khoa/Phòng | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Tổ chức</span>
            <h1 class="admin-page-title">Quản lý khoa/phòng</h1>
            <p class="admin-page-subtitle">Cấu trúc cây tổ chức, di chuyển và lưu trữ đơn vị.</p>
        </div>
        <button class="admin-btn admin-btn-primary" @onclick="OpenCreate">Thêm khoa/phòng</button>
    </header>

    <div class="admin-filter-bar">
        <div class="admin-filter-field">
            <label class="admin-filter-label">Trạng thái</label>
            <select class="admin-select" @bind="_statusFilter">
                <option value="active">Đang hoạt động</option>
                <option value="archived">Lưu trữ</option>
                <option value="all">Tất cả</option>
            </select>
        </div>
    </div>

    <div class="admin-panel" style="padding:16px;">
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khoa/phòng</th>
                        <th>Đơn vị cha</th>
                        <th>Cấp</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FlattenDepartments())
                    {
                        <tr>
                            <td class="admin-table-cell-muted">@row.Department.Code</td>
                            <td class="admin-table-cell-strong">
                                <span style="display:inline-block;width:@(row.Depth * 20)px"></span>@row.Department.Name
                            </td>
                            <td>@GetDeptName(row.Department.ParentDepartmentId)</td>
                            <td>@row.Depth</td>
                            <td><AdminBadge Tone="@(row.Department.Status == "active" ? "tone-success" : "tone-muted")">@LookupStatus(row.Department.Status)</AdminBadge></td>
                            <td style="text-align:right;">
                                <div class="admin-row-actions">
                                    <button class="admin-btn admin-btn-sm admin-btn-ghost" @onclick="() => OpenEdit(row.Department)">Sửa</button>
                                    @if (row.Department.Status == "active")
                                    {
                                        <button class="admin-btn admin-btn-sm admin-btn-ghost" @onclick="() => Archive(row.Department.DepartmentId)">Lưu trữ</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <AdminDrawer IsOpen="_drawerOpen" IsOpenChanged="v => _drawerOpen = v" Title="@_drawerTitle">
        <ChildContent>
            <div class="admin-form-group">
                <label class="admin-label">Mã khoa/phòng</label>
                <input class="admin-input" @bind="_editCode" placeholder="VD: KHOA-TIM" />
            </div>
            <div class="admin-form-group">
                <label class="admin-label">Tên khoa/phòng</label>
                <input class="admin-input" @bind="_editName" placeholder="VD: Khoa Tim mạch" />
            </div>
            <div class="admin-form-group">
                <label class="admin-label">Đơn vị cha</label>
                <select class="admin-select" @bind="_editParentId">
                    <option value="">— Gốc —</option>
                    @foreach (var d in GetAvailableParents())
                    {
                        <option value="@d.DepartmentId">@d.Name</option>
                    }
                </select>
            </div>
        </ChildContent>
        <FooterContent>
            <button class="admin-btn admin-btn-primary" @onclick="Save">Lưu</button>
            <button class="admin-btn admin-btn-ghost" @onclick="() => _drawerOpen = false">Hủy</button>
        </FooterContent>
    </AdminDrawer>
</section>

@code {
    private bool _drawerOpen;
    private string _drawerTitle = "Thêm khoa/phòng";
    private Guid? _editingDepartmentId;
    private string _editCode = "";
    private string _editName = "";
    private string _editParentId = "";
    private string _statusFilter = "active";

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private IEnumerable<DepartmentRow> FlattenDepartments()
    {
        var all = Store.Departments
            .Where(d => _statusFilter == "all" || (_statusFilter == "archived" ? d.Status != "active" : d.Status == "active"))
            .OrderBy(d => d.Code)
            .ToList();
        foreach (var root in all.Where(d => d.ParentDepartmentId is null))
        {
            foreach (var row in FlattenFrom(root, 0, all))
            {
                yield return row;
            }
        }
    }

    private static IEnumerable<DepartmentRow> FlattenFrom(Dept department, int depth, IReadOnlyList<Dept> all)
    {
        yield return new DepartmentRow(department, depth);
        foreach (var child in all.Where(d => d.ParentDepartmentId == department.DepartmentId).OrderBy(d => d.Code))
        {
            foreach (var row in FlattenFrom(child, depth + 1, all))
            {
                yield return row;
            }
        }
    }

    private void OpenCreate()
    {
        _drawerTitle = "Thêm khoa/phòng";
        _editingDepartmentId = null;
        _editCode = "";
        _editName = "";
        _editParentId = "";
        _drawerOpen = true;
    }

    private void OpenEdit(Dept dept)
    {
        _drawerTitle = "Sửa khoa/phòng";
        _editingDepartmentId = dept.DepartmentId;
        _editCode = dept.Code;
        _editName = dept.Name;
        _editParentId = dept.ParentDepartmentId?.ToString() ?? "";
        _drawerOpen = true;
    }

    private void Archive(Guid deptId)
    {
        try
        {
            Store.ArchiveDepartment(deptId);
            Toast.Show("Đã lưu trữ khoa/phòng thành công.", "success");
        }
        catch (MedDomainException ex)
        {
            Toast.Show(ex.Message, "error");
        }
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_editCode) || string.IsNullOrWhiteSpace(_editName))
        {
            Toast.Show("Vui lòng nhập mã và tên khoa/phòng.", "warning");
            return;
        }

        try
        {
            Guid? parentId = string.IsNullOrEmpty(_editParentId) ? null : Guid.Parse(_editParentId);
            var dept = new Dept
            {
                DepartmentId = _editingDepartmentId ?? Guid.NewGuid(),
                Code = _editCode.Trim(),
                Name = _editName.Trim(),
                ParentDepartmentId = parentId
            };

            if (_editingDepartmentId.HasValue)
            {
                var current = Store.Departments.First(d => d.DepartmentId == _editingDepartmentId.Value);
                Store.UpdateDepartment(dept with
                {
                    Status = current.Status,
                    CreatedAt = current.CreatedAt
                });
            }
            else
            {
                Store.AddDepartment(dept);
            }
            _drawerOpen = false;
            Toast.Show("Đã lưu khoa/phòng thành công.", "success");
        }
        catch (MedDomainException ex)
        {
            Toast.Show(ex.Message, "error");
        }
    }

    private IEnumerable<Dept> GetAvailableParents()
    {
        var active = Store.Departments.Where(d => d.Status == "active");
        if (!_editingDepartmentId.HasValue)
        {
            return active.OrderBy(d => d.Code);
        }

        var blocked = Store.DepartmentClosure
            .Where(e => e.AncestorDepartmentId == _editingDepartmentId.Value)
            .Select(e => e.DescendantDepartmentId)
            .ToHashSet();

        return active
            .Where(d => !blocked.Contains(d.DepartmentId))
            .OrderBy(d => d.Code);
    }

    private string GetDeptName(Guid? deptId)
        => deptId.HasValue ? Store.Departments.FirstOrDefault(d => d.DepartmentId == deptId.Value)?.Name ?? "—" : "—";

    private static string LookupStatus(string status)
        => Sql.MedLookups.RecordStatuses.FirstOrDefault(s => s.Code == status)?.Name ?? status;

    private sealed record DepartmentRow(Dept Department, int Depth);

    public void Dispose() => Store.StateChanged -= OnChanged;
}
