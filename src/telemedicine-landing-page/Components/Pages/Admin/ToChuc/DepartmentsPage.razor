@page "/admin/to-chuc/khoa-phong"
@layout AdminLayout
@using TelemedicineLandingPage.Services.Admin.Sql
@using Dept = TelemedicineLandingPage.Models.Admin.Sql.Department
@inject IMedDataStore Store
@inject IToastService Toast
@implements IDisposable

<PageTitle>Khoa/Phòng | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Tổ chức</span>
            <h1 class="admin-page-title">Quản lý khoa/phòng</h1>
            <p class="admin-page-subtitle">Cấu trúc cây tổ chức, di chuyển và lưu trữ đơn vị.</p>
        </div>
        <button class="admin-btn admin-btn-primary" @onclick="OpenCreate">Thêm khoa/phòng</button>
    </header>

    <div class="admin-panel">
        <ul class="admin-tree" role="tree" aria-label="Cây tổ chức">
            @foreach (var root in GetRoots())
            {
                <li role="treeitem" style="padding:0.5rem 0;">
                    <div style="display:flex;align-items:center;gap:0.5rem;">
                        <strong>@root.Name</strong>
                        <code style="font-size:0.75rem;">@root.Code</code>
                        <button class="admin-btn admin-btn-sm admin-btn-ghost" @onclick="() => Archive(root.DepartmentId)">Lưu trữ</button>
                    </div>
                    @{ RenderChildren(root.DepartmentId, 1); }
                </li>
            }
        </ul>
    </div>

    <AdminDrawer IsOpen="_drawerOpen" IsOpenChanged="v => _drawerOpen = v" Title="@_drawerTitle">
        <ChildContent>
            <div class="admin-form-group">
                <label class="admin-label">Mã khoa/phòng</label>
                <input class="admin-input" @bind="_editCode" placeholder="VD: KHOA-TIM" />
            </div>
            <div class="admin-form-group">
                <label class="admin-label">Tên khoa/phòng</label>
                <input class="admin-input" @bind="_editName" placeholder="VD: Khoa Tim mạch" />
            </div>
            <div class="admin-form-group">
                <label class="admin-label">Đơn vị cha</label>
                <select class="admin-select" @bind="_editParentId">
                    <option value="">— Gốc —</option>
                    @foreach (var d in Store.Departments.Where(d => d.Status == "active"))
                    {
                        <option value="@d.DepartmentId">@d.Name</option>
                    }
                </select>
            </div>
        </ChildContent>
        <FooterContent>
            <button class="admin-btn admin-btn-primary" @onclick="Save">Lưu</button>
            <button class="admin-btn admin-btn-ghost" @onclick="() => _drawerOpen = false">Hủy</button>
        </FooterContent>
    </AdminDrawer>
</section>

@code {
    private bool _drawerOpen;
    private string _drawerTitle = "Thêm khoa/phòng";
    private string _editCode = "";
    private string _editName = "";
    private string _editParentId = "";

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private IEnumerable<Dept> GetRoots()
        => Store.Departments.Where(d => d.ParentDepartmentId == null && d.Status == "active");

    private IEnumerable<Dept> GetChildren(Guid parentId)
        => Store.Departments.Where(d => d.ParentDepartmentId == parentId && d.Status == "active");

    private void RenderChildren(Guid parentId, int depth)
    {
        // Rendered inline via the tree markup
    }

    private void OpenCreate()
    {
        _drawerTitle = "Thêm khoa/phòng";
        _editCode = "";
        _editName = "";
        _editParentId = "";
        _drawerOpen = true;
    }

    private void Archive(Guid deptId)
    {
        try
        {
            Store.ArchiveDepartment(deptId);
            Toast.Show("Đã lưu trữ khoa/phòng thành công.", "success");
        }
        catch (MedDomainException ex)
        {
            Toast.Show(ex.Message, "error");
        }
    }

    private void Save()
    {
        try
        {
            Guid? parentId = string.IsNullOrEmpty(_editParentId) ? null : Guid.Parse(_editParentId);
            Store.AddDepartment(new Dept
            {
                Code = _editCode,
                Name = _editName,
                ParentDepartmentId = parentId
            });
            _drawerOpen = false;
            Toast.Show("Đã thêm khoa/phòng thành công.", "success");
        }
        catch (MedDomainException ex)
        {
            Toast.Show(ex.Message, "error");
        }
    }

    public void Dispose() => Store.StateChanged -= OnChanged;
}
