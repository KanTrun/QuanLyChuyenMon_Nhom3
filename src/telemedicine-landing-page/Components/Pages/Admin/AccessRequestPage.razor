@page "/admin/yeu-cau-quyen"
@layout AdminLayout
@using System.Text.Json
@using TelemedicineLandingPage.Models.Admin.Sql
@using TelemedicineLandingPage.Services.Admin.Sql
@inject IMedDataStore Store
@inject ICurrentUserContext UserContext
@inject NavigationManager Navigation
@inject PermissionChangeRequestService RequestService
@inject IToastService Toasts
@implements IDisposable

<PageTitle>Yêu cầu quyền truy cập | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Quyền truy cập</span>
            <h1 class="admin-page-title">Gửi yêu cầu cấp quyền cho admin</h1>
            <p class="admin-page-subtitle">Chọn màn hình hoặc hành động bạn cần truy cập, nêu rõ lý do và gửi cho quản trị viên phê duyệt.</p>
        </div>
    </header>

    <section class="admin-panel" style="padding:16px;">
        <div class="admin-form-grid">
            <div class="admin-form-field">
                <label class="admin-form-field-label">Tài khoản yêu cầu</label>
                <input class="admin-input" value="@GetCurrentUserLabel()" disabled />
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Quyền cần cấp</label>
                <select class="admin-select" @bind="_permissionId">
                    <option value="">Chọn quyền cần truy cập</option>
                    @foreach (var permission in _requestablePermissions)
                    {
                        <option value="@permission.PermissionId">@FormatPermissionLabel(permission)</option>
                    }
                </select>
            </div>
            <div class="admin-form-field admin-form-field-full">
                <label class="admin-form-field-label">Lý do yêu cầu</label>
                <textarea class="admin-input" rows="4" @bind="_reason" placeholder="Ví dụ: Cần vào màn hình Lâm sàng để xử lý hồ sơ bệnh nhân của khoa trong ca trực."></textarea>
            </div>
        </div>

        <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:16px;flex-wrap:wrap;">
            <p style="margin:0;color:var(--text-muted,#64748b);font-size:0.95rem;">
                Yêu cầu sẽ được gửi vào hộp phê duyệt của admin và áp dụng ngay sau khi được duyệt.
            </p>
            <button type="button" class="admin-btn admin-btn-primary" @onclick="SubmitRequest">
                Gửi yêu cầu cho admin
            </button>
        </div>
    </section>

    <section class="admin-panel" style="padding:16px;margin-top:16px;">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Lịch sử yêu cầu của tôi</h2>
                <p class="admin-panel-subtitle">Theo dõi trạng thái các yêu cầu đã gửi và kết quả phê duyệt từ admin.</p>
            </div>
        </header>

        <AdminDataTable TItem="RequestRow"
                        Items="_requestRows"
                        ColumnCount="5"
                        CurrentPage="1"
                        PageSize="20"
                        TotalItems="_requestRows.Count"
                        EmptyTitle="Chưa có yêu cầu nào"
                        EmptyBody="Khi bạn gửi yêu cầu cấp quyền, lịch sử sẽ hiển thị tại đây.">
            <HeaderTemplate>
                <th>Quyền yêu cầu</th>
                <th>Trạng thái</th>
                <th>Lý do</th>
                <th>Ngày gửi</th>
                <th>Cập nhật</th>
            </HeaderTemplate>
            <RowTemplate Context="row">
                <tr>
                    <td class="admin-table-cell-strong">@row.PermissionLabel</td>
                    <td><AdminBadge Tone="@GetStatusTone(row.StatusCode)">@Lookup(MedLookups.PermissionChangeStatuses, row.StatusCode)</AdminBadge></td>
                    <td>@row.Reason</td>
                    <td>@row.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@row.LastUpdateLabel</td>
                </tr>
            </RowTemplate>
        </AdminDataTable>
    </section>
</section>

@code {
    private string _permissionId = string.Empty;
    private string _reason = string.Empty;
    private IReadOnlyList<MedPermission> _requestablePermissions = Array.Empty<MedPermission>();
    private IReadOnlyList<RequestRow> _requestRows = Array.Empty<RequestRow>();

    private sealed record RequestRow(
        Guid RequestId,
        string PermissionLabel,
        string StatusCode,
        string Reason,
        DateTime RequestedAt,
        string LastUpdateLabel);

    protected override void OnInitialized()
    {
        if (IsPrivilegedAdmin())
        {
            Navigation.NavigateTo("/admin", forceLoad: false);
            return;
        }

        Store.StateChanged += OnStoreChanged;
        Refresh();
    }

    private void OnStoreChanged() => InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void Refresh()
    {
        var currentUser = UserContext.CurrentUser;
        if (currentUser is null)
        {
            _requestablePermissions = Array.Empty<MedPermission>();
            _requestRows = Array.Empty<RequestRow>();
            return;
        }

        _requestablePermissions = Store.Permissions
            .Where(p => p.Status == "active" && !UserContext.HasPermission(p.PermissionCode))
            .OrderBy(p => GetScreenName(p.ScreenId))
            .ThenBy(p => p.ActionCode)
            .ToList();

        _requestRows = Store.PermissionChangeRequests
            .Where(r => r.RequestedBy == currentUser.UserId)
            .OrderByDescending(r => r.RequestedAt)
            .Select(r => new RequestRow(
                r.PermissionChangeRequestId,
                GetRequestPermissionLabel(r.PermissionChangeRequestId),
                r.ChangeStatus,
                r.Reason,
                r.RequestedAt,
                BuildLastUpdateLabel(r)))
            .ToList();
    }

    private void SubmitRequest()
    {
        var currentUser = UserContext.CurrentUser;
        if (currentUser is null)
        {
            Toasts.Show("Bạn chưa đăng nhập", "Vui lòng đăng nhập lại để gửi yêu cầu quyền.", ToastVariant.Error);
            return;
        }

        if (!Guid.TryParse(_permissionId, out var permissionId))
        {
            Toasts.Show("Thiếu quyền cần cấp", "Chọn một quyền truy cập trước khi gửi yêu cầu.", ToastVariant.Warning);
            return;
        }

        var permission = Store.Permissions.FirstOrDefault(p => p.PermissionId == permissionId);
        if (permission is null)
        {
            Toasts.Show("Quyền không tồn tại", "Không tìm thấy quyền được chọn trong hệ thống.", ToastVariant.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(_reason))
        {
            Toasts.Show("Thiếu lý do", "Mô tả ngắn gọn lý do cần cấp quyền để admin dễ phê duyệt.", ToastVariant.Warning);
            return;
        }

        var duplicatedPendingRequest = Store.PermissionChangeRequests.Any(r =>
            r.RequestedBy == currentUser.UserId &&
            r.ChangeStatus is "draft" or "pending_approval" or "scheduled" &&
            Store.PermissionChangeItems.Any(i =>
                i.PermissionChangeRequestId == r.PermissionChangeRequestId &&
                i.PermissionId == permissionId &&
                i.OperationCode == "grant"));

        if (duplicatedPendingRequest)
        {
            Toasts.Show("Yêu cầu đang chờ xử lý", "Bạn đã có yêu cầu cấp quyền này đang chờ admin xem xét.", ToastVariant.Info);
            return;
        }

        try
        {
            var request = RequestService.CreateDraft(
                currentUser.UserId,
                "user",
                targetRoleId: null,
                targetGroupId: null,
                targetUserId: currentUser.UserId,
                reason: _reason.Trim(),
                effectiveAt: DateTime.UtcNow);

            RequestService.AddItem(request.PermissionChangeRequestId, new PermissionChangeItem
            {
                PermissionChangeRequestId = request.PermissionChangeRequestId,
                PermissionId = permissionId,
                OperationCode = "grant",
                EffectCode = "allow",
                DepartmentScopeType = "global",
                AfterJson = JsonSerializer.Serialize(new
                {
                    permission.PermissionCode,
                    permission.ActionCode,
                    scope = "global",
                    effect = "allow"
                }),
                EffectiveFrom = DateTime.UtcNow
            });

            RequestService.SubmitForApproval(request.PermissionChangeRequestId, currentUser.UserId);

            _permissionId = string.Empty;
            _reason = string.Empty;
            Refresh();
            Toasts.Show("Đã gửi yêu cầu", "Admin sẽ xem xét và cấp quyền truy cập cho bạn nếu phù hợp.", ToastVariant.Success);
        }
        catch (MedDomainException ex)
        {
            Toasts.Show("Không thể gửi yêu cầu", ex.Message, ToastVariant.Error);
        }
        catch (Exception ex)
        {
            Toasts.Show("Không thể gửi yêu cầu", ex.Message, ToastVariant.Error);
        }
    }

    private string GetCurrentUserLabel()
    {
        var user = UserContext.CurrentUser;
        return user is null
            ? "Chưa đăng nhập"
            : $"{user.FullName} ({user.Email ?? user.Username})";
    }

    private string FormatPermissionLabel(MedPermission permission)
    {
        var screen = GetScreenName(permission.ScreenId);
        var action = Lookup(MedLookups.ActionCodes, permission.ActionCode);
        return $"{screen} - {action} ({permission.PermissionCode})";
    }

    private string GetScreenName(Guid screenId)
        => Store.Screens.FirstOrDefault(s => s.ScreenId == screenId)?.Name ?? "Màn hình";

    private string GetRequestPermissionLabel(Guid requestId)
    {
        var permissionCodes = Store.PermissionChangeItems
            .Where(i => i.PermissionChangeRequestId == requestId)
            .Select(i => Store.Permissions.FirstOrDefault(p => p.PermissionId == i.PermissionId))
            .Where(p => p is not null)
            .Select(p => FormatPermissionLabel(p!))
            .Distinct()
            .ToList();

        return permissionCodes.Count == 0 ? "—" : string.Join(", ", permissionCodes);
    }

    private static string Lookup(IReadOnlyList<LookupEntry> entries, string? code)
        => entries.FirstOrDefault(e => e.Code == code)?.Name ?? code ?? "—";

    private static string GetStatusTone(string statusCode) => statusCode switch
    {
        "applied" => "tone-success",
        "pending_approval" => "tone-warning",
        "scheduled" => "tone-primary",
        "rejected" or "failed" => "tone-danger",
        _ => "tone-muted"
    };

    private static string BuildLastUpdateLabel(PermissionChangeRequest request)
    {
        if (request.ChangeStatus == "applied" && request.AppliedAt.HasValue)
        {
            return $"Đã áp dụng lúc {request.AppliedAt.Value.ToLocalTime():dd/MM/yyyy HH:mm}";
        }

        if (request.ChangeStatus == "rejected" && request.ApprovedAt.HasValue)
        {
            return $"Bị từ chối lúc {request.ApprovedAt.Value.ToLocalTime():dd/MM/yyyy HH:mm}";
        }

        if (request.ChangeStatus == "scheduled" && request.ApprovedAt.HasValue)
        {
            return $"Đã duyệt, chờ áp dụng từ {request.EffectiveAt.ToLocalTime():dd/MM/yyyy HH:mm}";
        }

        if (request.ChangeStatus == "failed" && !string.IsNullOrWhiteSpace(request.ErrorMessage))
        {
            return request.ErrorMessage;
        }

        return "Đang chờ xử lý";
    }

    private bool IsPrivilegedAdmin()
    {
        var user = UserContext.CurrentUser;
        if (user is null)
        {
            return false;
        }

        return string.Equals(user.Username, "admin", StringComparison.OrdinalIgnoreCase) ||
               UserContext.HasPermission("SCR_PERMISSIONS:DELETE") ||
               UserContext.HasPermission("PERM_PERMISSIONS_delete");
    }

    public void Dispose()
    {
        Store.StateChanged -= OnStoreChanged;
    }
}
