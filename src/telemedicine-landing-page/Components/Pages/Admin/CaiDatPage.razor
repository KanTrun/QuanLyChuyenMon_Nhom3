@page "/admin/cai-dat"
@layout AdminLayout
@using TelemedicineLandingPage.Models.Admin.Sql
@using TelemedicineLandingPage.Services.Admin.Sql
@inject IUserPreferencesService Preferences
@inject ICurrentUserContext UserContext
@inject IMedDataStore Store
@inject IThemeBus ThemeBus
@inject IToastService Toasts
@inject BrowserSessionService BrowserSession
@inject IConfirmDialogService Confirm
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Cài đặt | QLCM Pro</PageTitle>

<section class="admin-page admin-settings">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Cài đặt</span>
            <h1 class="admin-page-title">Tùy chọn tài khoản và hệ thống</h1>
            <p class="admin-page-subtitle">Thông tin ở đây đồng bộ với tài khoản đang đăng nhập, khoa/phòng SQL và kênh thông báo.</p>
        </div>
    </header>

    <article class="admin-settings-section" id="ho-so">
        <h2>Hồ sơ cá nhân</h2>
        <dl class="admin-detail-grid">
            <dt>Họ và tên</dt>
            <dd>@(_fullName == string.Empty ? "—" : _fullName)</dd>
            <dt>Email công vụ</dt>
            <dd>@(_email == string.Empty ? "—" : _email)</dd>
            <dt>Khoa/phòng chính</dt>
            <dd>@CurrentDepartmentName()</dd>
        </dl>
        <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:14px;">
            <a class="admin-btn admin-btn-primary" href="/admin/ho-so">Mở hồ sơ cá nhân</a>
        </div>
    </article>

    <article class="admin-settings-section" id="giao-dien">
        <h2>Giao diện</h2>
        <div class="admin-toggle-row">
            <div class="admin-toggle-row-text">
                <span class="admin-toggle-row-title">Chế độ hiển thị</span>
                <span class="admin-toggle-row-body">Đồng bộ với nút sáng/tối trên thanh công cụ.</span>
            </div>
            <div class="admin-radio-group" role="group" aria-label="Chế độ hiển thị">
                <button type="button" class="admin-radio-pill @(IsTheme("light") ? "is-on" : null)" @onclick='() => SetTheme("light")'>Sáng</button>
                <button type="button" class="admin-radio-pill @(IsTheme("dark") ? "is-on" : null)" @onclick='() => SetTheme("dark")'>Tối</button>
            </div>
        </div>
        <div class="admin-toggle-row">
            <div class="admin-toggle-row-text">
                <span class="admin-toggle-row-title">Mật độ hiển thị</span>
                <span class="admin-toggle-row-body">Chọn bố cục gọn hoặc thoáng cho phiên hiện tại.</span>
            </div>
            <div class="admin-radio-group" role="group" aria-label="Mật độ hiển thị">
                <button type="button" class="admin-radio-pill @(_density == AdminDensity.Compact ? "is-on" : null)" @onclick="() => SetDensity(AdminDensity.Compact)">Gọn</button>
                <button type="button" class="admin-radio-pill @(_density == AdminDensity.Comfortable ? "is-on" : null)" @onclick="() => SetDensity(AdminDensity.Comfortable)">Thoáng</button>
            </div>
        </div>
        <div class="admin-toggle-row">
            <div class="admin-toggle-row-text">
                <span class="admin-toggle-row-title">Hiệu ứng chuyển động</span>
                <span class="admin-toggle-row-body">Bật hoặc tắt animation cho toàn bộ giao diện quản trị.</span>
            </div>
            <button type="button"
                    class="admin-switch @(_animationsEnabled ? "is-on" : null)"
                    aria-pressed="@(_animationsEnabled ? "true" : "false")"
                    @onclick="ToggleAnimations">
                <span class="visually-hidden">Bật hoặc tắt hiệu ứng chuyển động</span>
            </button>
        </div>
    </article>

    <article class="admin-settings-section" id="thong-bao">
        <h2>Thông báo</h2>
        @foreach (var channel in _channels)
        {
            <div class="admin-toggle-row">
                <div class="admin-toggle-row-text">
                    <span class="admin-toggle-row-title">@channel.Label</span>
                    <span class="admin-toggle-row-body">@channel.Description</span>
                </div>
                <button type="button"
                        class="admin-switch @(IsChannelEnabled(channel.Code) ? "is-on" : null)"
                        aria-pressed="@(IsChannelEnabled(channel.Code) ? "true" : "false")"
                        @onclick="() => ToggleChannel(channel.Code)">
                    <span class="visually-hidden">Bật hoặc tắt @channel.Label</span>
                </button>
            </div>
        }
    </article>

    <article class="admin-settings-section" id="tro-ly-ai">
        <h2>Trợ lý AI</h2>
        <div class="admin-form-grid">
            <div class="admin-form-field">
                <label class="admin-form-field-label" for="cd-ai-model">Mô hình</label>
                <select id="cd-ai-model" class="admin-select" @bind="_aiModel">
                    <option value="gemini-2.5-flash">Gemini 2.5 Flash</option>
                    <option value="gemini-2.5-flash-lite">Gemini 2.5 Flash Lite</option>
                    <option value="gemini-2.5-pro">Gemini 2.5 Pro</option>
                    <option value="claude-sonnet-4-5-20250929">Claude Sonnet 4.5</option>
                    <option value="gpt-4o-mini">GPT-4o mini</option>
                </select>
            </div>
            <div class="admin-form-field admin-form-field-full">
                <label class="admin-form-field-label" for="cd-ai-prompt">Câu lệnh hệ thống</label>
                <textarea id="cd-ai-prompt" class="admin-textarea" rows="5" @bind="_aiPrompt"></textarea>
            </div>
        </div>
        <div style="display:flex; justify-content:flex-end; gap:8px;">
            <button type="button" class="admin-btn admin-btn-primary" @onclick="SaveUiPreferences">Lưu cấu hình giao diện/AI</button>
        </div>
    </article>

    <div style="display:flex; justify-content:flex-end;">
        <button type="button" class="admin-btn admin-btn-danger" @onclick="OnLogout">
            <span aria-hidden="true">@Icon("logout")</span>
            Đăng xuất
        </button>
    </div>
</section>

@code {
    private const string GlobalNotificationType = "all";
    private string _fullName = string.Empty;
    private string _email = string.Empty;
    private string _departmentId = string.Empty;
    private string _theme = "light";
    private AdminDensity _density = AdminDensity.Comfortable;
    private bool _animationsEnabled = true;
    private string _aiModel = "gemini-2.5-flash";
    private string _aiPrompt = string.Empty;

    private static readonly ChannelRow[] _channels =
    [
        new("in_app", "Trên ứng dụng", "Hiển thị trong chuông thông báo trên thanh công cụ."),
        new("email", "Email công vụ", "Gửi tóm tắt thông báo quan trọng tới hộp thư."),
        new("sms", "Tin nhắn SMS", "Dùng cho cảnh báo khẩn hoặc trực gấp.")
    ];

    protected override void OnInitialized()
    {
        Preferences.StateChanged += OnPrefsChanged;
        UserContext.StateChanged += OnPrefsChanged;
        Store.StateChanged += OnPrefsChanged;
        LoadDraft();
    }

    private void OnPrefsChanged() => InvokeAsync(() => { LoadDraft(); StateHasChanged(); });

    private void LoadDraft()
    {
        var user = UserContext.CurrentUser;
        _fullName = user?.FullName ?? string.Empty;
        _email = user?.Email ?? string.Empty;
        _departmentId = user?.PrimaryDepartmentId?.ToString() ?? string.Empty;
        _theme = Preferences.Current.Theme;
        _density = Preferences.Current.Density;
        _animationsEnabled = Preferences.Current.AnimationsEnabled;
        _aiModel = Preferences.Current.AiModel;
        _aiPrompt = Preferences.Current.AiSystemPrompt;
    }

    private string CurrentDepartmentName()
        => Guid.TryParse(_departmentId, out var departmentId)
            ? Store.Departments.FirstOrDefault(d => d.DepartmentId == departmentId)?.Name ?? "—"
            : "—";

    private void SaveProfile()
    {
        var user = UserContext.CurrentUser;
        if (user is null) return;
        if (string.IsNullOrWhiteSpace(_fullName))
        {
            Toasts.Show("Thiếu họ tên", "Vui lòng nhập họ và tên người dùng.", ToastVariant.Warning);
            return;
        }

        var departmentId = Guid.TryParse(_departmentId, out var parsedDept) ? parsedDept : (Guid?)null;
        Store.UpdateUser(user with
        {
            FullName = _fullName.Trim(),
            Email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
            PrimaryDepartmentId = departmentId,
            UpdatedAt = DateTime.UtcNow
        });
        UserContext.SetCurrentUser(user.UserId);
        Toasts.Show("Đã lưu hồ sơ", "Thông tin đã đồng bộ với tài khoản hệ thống.", ToastVariant.Success);
    }

    private bool IsChannelEnabled(string channelCode)
    {
        var userId = UserContext.CurrentUser?.UserId;
        if (!userId.HasValue) return false;
        return Store.NotificationPreferences
            .FirstOrDefault(p => p.UserId == userId.Value && p.NotificationType == GlobalNotificationType && p.ChannelCode == channelCode)
            ?.IsEnabled ?? channelCode is "in_app" or "email";
    }

    private void ToggleChannel(string channelCode)
    {
        var userId = UserContext.CurrentUser?.UserId;
        if (!userId.HasValue) return;
        var enabled = !IsChannelEnabled(channelCode);
        var existing = Store.NotificationPreferences
            .FirstOrDefault(p => p.UserId == userId.Value && p.NotificationType == GlobalNotificationType && p.ChannelCode == channelCode);

        if (existing is null)
        {
            Store.AddNotificationPreference(new NotificationPreference
            {
                UserId = userId.Value,
                NotificationType = GlobalNotificationType,
                ChannelCode = channelCode,
                IsEnabled = enabled
            });
        }
        else
        {
            Store.UpdateNotificationPreference(existing with { IsEnabled = enabled, UpdatedAt = DateTime.UtcNow });
        }
        Toasts.Show("Đã cập nhật thông báo", $"{ChannelLabel(channelCode)}: {(enabled ? "Bật" : "Tắt")}", ToastVariant.Success);
    }

    private void SetTheme(string value)
    {
        if (!string.Equals(_theme, value, StringComparison.OrdinalIgnoreCase))
        {
            _theme = value == "dark" ? "dark" : "light";
            ThemeBus.SetTheme(_theme);
        }
    }

    private bool IsTheme(string value) => string.Equals(_theme, value, StringComparison.OrdinalIgnoreCase);
    private void SetDensity(AdminDensity value) => _density = value;
    private void ToggleAnimations()
    {
        _animationsEnabled = !_animationsEnabled;
        ThemeBus.SetMotion(_animationsEnabled);
    }

    private void SaveUiPreferences()
    {
        var current = Preferences.Current;
        Preferences.Update(current with
        {
            FullName = _fullName.Trim(),
            Email = _email.Trim(),
            Theme = _theme,
            Density = _density,
            AnimationsEnabled = _animationsEnabled,
            AiModel = _aiModel,
            AiSystemPrompt = string.IsNullOrWhiteSpace(_aiPrompt) ? current.AiSystemPrompt : _aiPrompt.Trim()
        });
        Toasts.Show("Đã lưu cấu hình", "Giao diện và trợ lý AI đã cập nhật cho phiên hiện tại.", ToastVariant.Success);
    }

    private async Task OnLogout()
    {
        var ok = await Confirm.ShowAsync(
            "Đăng xuất",
            "Bạn có chắc muốn đăng xuất khỏi phiên làm việc hiện tại?",
            confirmText: "Đăng xuất",
            isDanger: true);
        if (!ok)
        {
            return;
        }

        await BrowserSession.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    private static string ChannelLabel(string code) => _channels.First(c => c.Code == code).Label;
    private RenderFragment Icon(string name) => builder => AdminIcons.Render(builder, name);

    public void Dispose()
    {
        Preferences.StateChanged -= OnPrefsChanged;
        UserContext.StateChanged -= OnPrefsChanged;
        Store.StateChanged -= OnPrefsChanged;
    }

    private sealed record ChannelRow(string Code, string Label, string Description);
}
