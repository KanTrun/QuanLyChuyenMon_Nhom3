@page "/admin"
@layout AdminLayout
@inject IMedDataStore DataStore
@inject ICurrentUserContext UserContext
@implements IDisposable

<PageTitle>Tổng quan | QLCM Pro</PageTitle>

<section class="admin-dashboard">
    <header class="admin-greeting">
        <div>
            <span class="admin-greeting-eyebrow">Bảng điều khiển</span>
            <h1 class="admin-greeting-title">Xin chào, @_displayName</h1>
            <p class="admin-greeting-subtitle">Hôm nay là @_dateLine.</p>
        </div>
        <div class="admin-greeting-actions">
            <a class="admin-btn admin-btn-primary" href="/admin/quy-trinh/tao">
                <span aria-hidden="true">@Icon("plus")</span>
                Tạo quy trình mới
            </a>
        </div>
    </header>

    <div class="kpi-grid" role="list">
        <article class="kpi-card" role="listitem">
            <div class="kpi-card-head">
                <span class="kpi-icon tone-primary" aria-hidden="true">@Icon("clipboard")</span>
                <span class="kpi-label">Số quy trình</span>
            </div>
            <div class="kpi-value">@_procedureCount</div>
        </article>

        <article class="kpi-card" role="listitem">
            <div class="kpi-card-head">
                <span class="kpi-icon tone-success" aria-hidden="true">@Icon("check")</span>
                <span class="kpi-label">Số phiên bản đang hiệu lực</span>
            </div>
            <div class="kpi-value">@_publishedVersionCount</div>
        </article>

        <article class="kpi-card" role="listitem">
            <div class="kpi-card-head">
                <span class="kpi-icon tone-secondary" aria-hidden="true">@Icon("team")</span>
                <span class="kpi-label">Số người dùng</span>
            </div>
            <div class="kpi-value">@_activeUserCount</div>
        </article>

        <article class="kpi-card" role="listitem">
            <div class="kpi-card-head">
                <span class="kpi-icon tone-warning" aria-hidden="true">@Icon("building")</span>
                <span class="kpi-label">Số khoa/phòng</span>
            </div>
            <div class="kpi-value">@_activeDepartmentCount</div>
        </article>
    </div>

    <div class="admin-dashboard-grid">
        <section class="admin-panel admin-panel-trend">
            <header class="admin-panel-head">
                <div>
                    <h2 class="admin-panel-title">Thống kê</h2>
                    <p class="admin-panel-subtitle">Dữ liệu tổng hợp từ hệ thống.</p>
                </div>
            </header>
            <div class="admin-trend-chart" style="display:flex;align-items:center;justify-content:center;min-height:160px;">
                <p style="color:var(--color-muted);font-size:0.95rem;">Chưa có dữ liệu thống kê</p>
            </div>
        </section>

        <section class="admin-panel admin-panel-activity">
            <header class="admin-panel-head">
                <div>
                    <h2 class="admin-panel-title">Hoạt động gần đây</h2>
                    <p class="admin-panel-subtitle">Nhật ký kiểm toán từ hệ thống.</p>
                </div>
            </header>
            @if (_recentAuditLogs.Count == 0)
            {
                <div style="padding:1.5rem;text-align:center;color:var(--color-muted);">
                    <p>Chưa có hoạt động nào</p>
                </div>
            }
            else
            {
                <ol class="admin-activity-list">
                    @foreach (var log in _recentAuditLogs)
                    {
                        <li class="admin-activity-item">
                            <span class="admin-activity-dot tone-primary" aria-hidden="true"></span>
                            <div class="admin-activity-body">
                                <div class="admin-activity-headline">
                                    <span class="admin-activity-actor">@(log.ActorUsername ?? "Hệ thống")</span>
                                    <span class="admin-activity-action">@log.ActionCode</span>
                                    <span class="admin-activity-subject">@(log.TargetType)@(log.TargetId is not null ? $" #{log.TargetId[..Math.Min(8, log.TargetId.Length)]}" : "")</span>
                                </div>
                                <span class="admin-activity-time">@log.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>

    <section class="admin-panel admin-panel-quick">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Truy cập nhanh</h2>
                <p class="admin-panel-subtitle">Các tác vụ thường dùng cho quản trị viên.</p>
            </div>
        </header>
        <div class="admin-quick-grid">
            @foreach (var tile in _quickTiles)
            {
                <a class="admin-quick-tile" href="@tile.Url">
                    <span class="admin-quick-tile-icon @tile.Tone" aria-hidden="true">@Icon(tile.Icon)</span>
                    <span class="admin-quick-tile-text">
                        <span class="admin-quick-tile-title">@tile.Title</span>
                        <span class="admin-quick-tile-subtitle">@tile.Subtitle</span>
                    </span>
                </a>
            }
        </div>
    </section>
</section>

@code {
    private static readonly string[] _viDays = { "Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy" };

    private string _displayName = "Đang tải...";
    private string _dateLine = string.Empty;

    private int _procedureCount;
    private int _publishedVersionCount;
    private int _activeUserCount;
    private int _activeDepartmentCount;

    private IReadOnlyList<Models.Admin.Sql.AuditLog> _recentAuditLogs = Array.Empty<Models.Admin.Sql.AuditLog>();

    private readonly List<QuickTileViewModel> _quickTiles =
    [
        new("Tạo quy trình mới", "Khởi tạo quy trình kỹ thuật và gửi phê duyệt.", "/admin/quy-trinh/tao", "plus", "tone-primary"),
        new("Quản lý phân quyền", "Cập nhật vai trò và quyền truy cập.", "/admin/phan-quyen", "shield", "tone-secondary"),
        new("Phác đồ lâm sàng", "Tra cứu và cập nhật phác đồ điều trị.", "/admin/phac-do", "stethoscope", "tone-success"),
        new("Báo cáo tiêu thụ", "Theo dõi tiêu thụ vật tư so với định mức.", "/admin/bao-cao/tieu-thu", "package", "tone-warning"),
    ];

    protected override void OnInitialized()
    {
        var now = DateTime.Now;
        _dateLine = $"{_viDays[(int)now.DayOfWeek]}, ngày {now:dd/MM/yyyy}";

        UserContext.StateChanged += OnUserChanged;
        DataStore.StateChanged += OnDataChanged;

        RefreshUserDisplay();
        RefreshCounts();
    }

    private void OnUserChanged() => InvokeAsync(() =>
    {
        RefreshUserDisplay();
        StateHasChanged();
    });

    private void OnDataChanged() => InvokeAsync(() =>
    {
        RefreshCounts();
        StateHasChanged();
    });

    private void RefreshUserDisplay()
    {
        var user = UserContext.CurrentUser;
        _displayName = user is not null ? user.FullName : "Chưa đăng nhập";
    }

    private void RefreshCounts()
    {
        _procedureCount = DataStore.Procedures.Count;
        _publishedVersionCount = DataStore.ProcedureVersions
            .Count(v => v.StatusCode is "published" or "active");
        _activeUserCount = DataStore.Users
            .Count(u => u.Status == "active");
        _activeDepartmentCount = DataStore.Departments
            .Count(d => d.Status == "active");

        _recentAuditLogs = DataStore.AuditLogs
            .OrderByDescending(a => a.OccurredAt)
            .Take(8)
            .ToList();
    }

    private RenderFragment Icon(string name) => builder => AdminIcons.Render(builder, name);

    public void Dispose()
    {
        UserContext.StateChanged -= OnUserChanged;
        DataStore.StateChanged -= OnDataChanged;
    }

    private sealed record QuickTileViewModel(string Title, string Subtitle, string Url, string Icon, string Tone);
}
