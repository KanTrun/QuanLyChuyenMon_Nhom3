@page "/admin"
@page "/qlcm"
@layout AdminLayout
@inject IMedDataStore DataStore
@inject ICurrentUserContext UserContext
@implements IDisposable

<PageTitle>Tổng quan | QLCM Pro</PageTitle>

<section class="admin-dashboard">
    <header class="admin-greeting">
        <div>
            <span class="admin-greeting-eyebrow">Bảng điều khiển</span>
            <h1 class="admin-greeting-title">Xin chào, @_displayName</h1>
            <p class="admin-greeting-subtitle">Hôm nay là @_dateLine.</p>
        </div>
        <div class="admin-greeting-actions">
            <a class="admin-btn admin-btn-primary" href="/qlcm/quy-trinh/tao">
                <span aria-hidden="true">@Icon("plus")</span>
                Tạo quy trình mới
            </a>
        </div>
    </header>

    <div class="kpi-grid" role="list">
        <article class="kpi-card" role="listitem">
            <div class="kpi-card-head">
                <span class="kpi-icon tone-primary" aria-hidden="true">@Icon("clipboard")</span>
                <span class="kpi-label">Số quy trình</span>
            </div>
            <div class="kpi-value">@_procedureCount</div>
        </article>

        <article class="kpi-card" role="listitem">
            <div class="kpi-card-head">
                <span class="kpi-icon tone-success" aria-hidden="true">@Icon("check")</span>
                <span class="kpi-label">Số phiên bản đang hiệu lực</span>
            </div>
            <div class="kpi-value">@_publishedVersionCount</div>
        </article>

        <article class="kpi-card" role="listitem">
            <div class="kpi-card-head">
                <span class="kpi-icon tone-secondary" aria-hidden="true">@Icon("team")</span>
                <span class="kpi-label">Số người dùng</span>
            </div>
            <div class="kpi-value">@_activeUserCount</div>
        </article>

        <article class="kpi-card" role="listitem">
            <div class="kpi-card-head">
                <span class="kpi-icon tone-warning" aria-hidden="true">@Icon("building")</span>
                <span class="kpi-label">Số khoa/phòng</span>
            </div>
            <div class="kpi-value">@_activeDepartmentCount</div>
        </article>
    </div>

    <div class="admin-dashboard-grid">
        <section class="admin-panel admin-panel-trend">
            <header class="admin-panel-head">
                <div>
                    <h2 class="admin-panel-title">Quy trình theo tháng ban hành</h2>
                    <p class="admin-panel-subtitle">Cột biểu diễn số phiên bản quy trình được tạo/cập nhật theo từng tháng.</p>
                </div>
            </header>
            <div class="admin-trend-chart">
                <div class="admin-trend-bars" aria-label="Số quy trình tạo theo tháng">
                    @foreach (var point in _procedureTrend)
                    {
                        var height = Math.Max(10, point.Percent);
                        <div class="admin-trend-bar-item">
                            <div class="admin-trend-bar" title="@($"{point.Label}: {point.Count}")" style="height:@height%;"></div>
                            <span>@point.Label</span>
                        </div>
                    }
                </div>
                <div class="admin-status-distribution" aria-label="Phân bố trạng thái phiên bản quy trình">
                    <div class="admin-status-distribution-head">
                        <span>Phân bố trạng thái phiên bản</span>
                        <strong>@_versionStatusSegments.Sum(s => s.Count) phiên bản</strong>
                    </div>
                    <div class="admin-status-strip" aria-hidden="true">
                        @foreach (var segment in _versionStatusSegments)
                        {
                            var width = Math.Max(6, segment.Percent);
                            <span class="@segment.Tone" style="width:@width%;" title="@($"{segment.Label}: {segment.Count}")"></span>
                        }
                    </div>
                    <div class="admin-status-chips">
                        @foreach (var segment in _versionStatusSegments)
                        {
                            <span class="admin-filter-chip">@segment.Label: @segment.Count</span>
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="admin-panel admin-panel-activity">
            <header class="admin-panel-head">
                <div>
                    <h2 class="admin-panel-title">Hoạt động gần đây</h2>
                    <p class="admin-panel-subtitle">Nhật ký kiểm toán từ hệ thống.</p>
                </div>
            </header>
            @if (_recentAuditLogs.Count == 0)
            {
                <div style="padding:1.5rem;text-align:center;color:var(--color-muted);">
                    <p>Chưa có hoạt động nào</p>
                </div>
            }
            else
            {
                <ol class="admin-activity-list">
                    @foreach (var log in _recentAuditLogs)
                    {
                        <li class="admin-activity-item">
                            <span class="admin-activity-dot tone-primary" aria-hidden="true"></span>
                            <div class="admin-activity-body">
                                <div class="admin-activity-headline">
                                    <span class="admin-activity-headline-text">@FormatAuditAction(log)</span>
                                </div>
                                <span class="admin-activity-time">@log.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>

    <section class="admin-panel admin-panel-quick">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Truy cập nhanh</h2>
                <p class="admin-panel-subtitle">Các tác vụ thường dùng cho quản trị viên.</p>
            </div>
        </header>
        <div class="admin-quick-grid">
            @foreach (var tile in _quickTiles)
            {
                <a class="admin-quick-tile" href="@tile.Url">
                    <span class="admin-quick-tile-icon @tile.Tone" aria-hidden="true">@Icon(tile.Icon)</span>
                    <span class="admin-quick-tile-text">
                        <span class="admin-quick-tile-title">@tile.Title</span>
                        <span class="admin-quick-tile-subtitle">@tile.Subtitle</span>
                    </span>
                </a>
            }
        </div>
    </section>
</section>

@code {
    private static readonly string[] _viDays = { "Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy" };

    private string _displayName = "Đang tải...";
    private string _dateLine = string.Empty;

    private int _procedureCount;
    private int _publishedVersionCount;
    private int _activeUserCount;
    private int _activeDepartmentCount;

    private IReadOnlyList<Models.Admin.Sql.AuditLog> _recentAuditLogs = Array.Empty<Models.Admin.Sql.AuditLog>();
    private IReadOnlyList<TrendPoint> _procedureTrend = Array.Empty<TrendPoint>();
    private IReadOnlyList<StatusSegment> _versionStatusSegments = Array.Empty<StatusSegment>();

    private readonly List<QuickTileViewModel> _quickTiles =
    [
        new("Tạo quy trình mới", "Khởi tạo quy trình kỹ thuật và gửi phê duyệt.", "/qlcm/quy-trinh/tao", "plus", "tone-primary"),
        new("Quản lý phân quyền", "Cập nhật vai trò và quyền truy cập.", "/admin/phan-quyen", "shield", "tone-secondary"),
        new("Phác đồ lâm sàng", "Tra cứu và cập nhật phác đồ điều trị.", "/qlcm/phac-do", "stethoscope", "tone-success"),
        new("Báo cáo tiêu thụ", "Theo dõi tiêu thụ vật tư so với định mức.", "/qlcm/bao-cao/tieu-thu", "package", "tone-warning"),
    ];

    protected override void OnInitialized()
    {
        var now = DateTime.Now;
        _dateLine = $"{_viDays[(int)now.DayOfWeek]}, ngày {now:dd/MM/yyyy}";

        UserContext.StateChanged += OnUserChanged;
        DataStore.StateChanged += OnDataChanged;

        RefreshUserDisplay();
        RefreshCounts();
    }

    private void OnUserChanged() => InvokeAsync(() =>
    {
        RefreshUserDisplay();
        StateHasChanged();
    });

    private void OnDataChanged() => InvokeAsync(() =>
    {
        RefreshCounts();
        StateHasChanged();
    });

    private void RefreshUserDisplay()
    {
        var user = UserContext.CurrentUser;
        _displayName = user is not null ? user.FullName : "Chưa đăng nhập";
    }

    private void RefreshCounts()
    {
        _procedureCount = DataStore.Procedures.Count;
        _publishedVersionCount = DataStore.ProcedureVersions
            .Count(v => v.StatusCode == "active");
        _activeUserCount = DataStore.Users
            .Count(u => u.Status == "active");
        _activeDepartmentCount = DataStore.Departments
            .Count(d => d.Status == "active");

        _recentAuditLogs = DataStore.AuditLogs
            .OrderByDescending(a => a.OccurredAt)
            .Take(8)
            .ToList();

        var monthStarts = Enumerable.Range(0, 6)
            .Select(i => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(i - 5))
            .ToList();
        var monthlyCounts = monthStarts
            .Select(month => new
            {
                Label = month.ToString("MM/yy"),
                Count = DataStore.Procedures.Count(p => p.CreatedAt >= month && p.CreatedAt < month.AddMonths(1))
            })
            .ToList();
        var maxMonthlyCount = Math.Max(1, monthlyCounts.Max(p => p.Count));
        _procedureTrend = monthlyCounts
            .Select(p => new TrendPoint(p.Label, p.Count, (int)Math.Round(p.Count * 100.0 / maxMonthlyCount)))
            .ToList();

        var rawSegments = DataStore.ProcedureVersions
            .GroupBy(v => v.StatusCode)
            .Select(g => new { Status = g.Key, Label = FormatVersionStatus(g.Key), Count = g.Count() })
            .OrderByDescending(s => s.Count)
            .ToList();
        var totalSegments = Math.Max(1, rawSegments.Sum(s => s.Count));
        _versionStatusSegments = rawSegments
            .Select(s => new StatusSegment(
                s.Label,
                s.Count,
                (int)Math.Round(s.Count * 100.0 / totalSegments),
                StatusTone(s.Status)))
            .ToList();
    }

    private string FormatAuditAction(Models.Admin.Sql.AuditLog log)
    {
        var actor = log.ActorUsername ?? "Hệ thống";

        // Try to extract details from JSON
        string details = ExtractDetails(log);

        var action = log.ActionCode switch
        {
            "login" => "đã đăng nhập",
            "logout" => "đã đăng xuất",
            "create" => $"đã tạo mới {FormatTarget(log.TargetType)}{details}",
            "update" => $"đã cập nhật {FormatTarget(log.TargetType)}{details}",
            "delete" => $"đã xóa {FormatTarget(log.TargetType)}{details}",
            "assign_role" => $"đã gán vai trò{details}",
            "remove_role" => $"đã hủy vai trò{details}",
            "approve" => $"đã phê duyệt {FormatTarget(log.TargetType)}{details}",
            "reject" => $"đã từ chối {FormatTarget(log.TargetType)}{details}",
            "submit" => $"đã gửi duyệt {FormatTarget(log.TargetType)}{details}",
            "publish" => $"đã ban hành {FormatTarget(log.TargetType)}{details}",
            "archive" => $"đã lưu trữ {FormatTarget(log.TargetType)}{details}",
            _ => $"{AdminBusinessDisplay.Action(log.ActionCode)} {FormatTarget(log.TargetType)}{details}"
        };

        return $"{actor} {action}".Trim();
    }

    private static string FormatTarget(string targetType) => targetType switch
    {
        "session" => "",
        "user" => "tài khoản",
        "user_role" => "",
        "procedure" => "quy trình",
        "procedure_version" => "phiên bản quy trình",
        "department" => "khoa/phòng",
        "role_permission" => "quyền vai trò",
        _ => AdminBusinessDisplay.Target(targetType)
    };

    private static string FormatVersionStatus(string status) => status switch
    {
        "active" => "Đang hiệu lực",
        "pending_approval" => "Chờ duyệt",
        "draft" => "Nháp",
        "rejected" => "Từ chối",
        "superseded" => "Thay thế",
        _ => AdminBusinessDisplay.VersionStatus(status)
    };

    private static string StatusTone(string status) => status switch
    {
        "active" => "tone-success",
        "pending_approval" => "tone-warning",
        "draft" => "tone-primary",
        "rejected" => "tone-danger",
        "superseded" => "tone-muted",
        _ => "tone-secondary"
    };

    private static string ExtractDetails(Models.Admin.Sql.AuditLog log)
    {
        var json = log.AfterJson ?? log.BeforeJson;
        if (string.IsNullOrEmpty(json)) return "";

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            // For role assignment/removal: {"role":"...", "user":"..."}
            if (root.TryGetProperty("role", out var roleProp) && root.TryGetProperty("user", out var userProp))
            {
                var roleName = roleProp.GetString();
                var userName = userProp.GetString();
                return $" \"{roleName}\" cho {userName}";
            }

            // For user creation: {"username":"..."}
            if (root.TryGetProperty("username", out var unameProp))
            {
                return $" {unameProp.GetString()}";
            }

            // For profile update: {"field":"..."}
            if (root.TryGetProperty("field", out var fieldProp))
            {
                return $" ({fieldProp.GetString()})";
            }
        }
        catch { }

        return "";
    }

    private RenderFragment Icon(string name) => builder => AdminIcons.Render(builder, name);

    public void Dispose()
    {
        UserContext.StateChanged -= OnUserChanged;
        DataStore.StateChanged -= OnDataChanged;
    }

    private sealed record QuickTileViewModel(string Title, string Subtitle, string Url, string Icon, string Tone);
    private sealed record TrendPoint(string Label, int Count, int Percent);
    private sealed record StatusSegment(string Label, int Count, int Percent, string Tone);
}
