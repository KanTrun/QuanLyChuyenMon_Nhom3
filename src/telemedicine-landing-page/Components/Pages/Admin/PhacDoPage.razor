@page "/admin/phac-do"
@layout AdminLayout
@using System.Text.Json
@using Sql = TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@inject ICurrentUserContext UserContext
@inject IToastService Toasts
@inject AdminActionGuard Guard
@inject IConfirmDialogService Confirm
@inject AuditTrailService Audit
@implements IDisposable

<PageTitle>Phác đồ lâm sàng | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Phác đồ</span>
            <h1 class="admin-page-title">Phác đồ điều trị và chăm sóc</h1>
            <p class="admin-page-subtitle">Quản lý phác đồ, phiên bản, quy trình liên kết, quy tắc áp dụng và lịch sử áp dụng cho bệnh nhân.</p>
        </div>
        <button type="button" class="admin-btn admin-btn-primary" @onclick="OpenCreate">Tạo phác đồ mới</button>
    </header>

    <div class="admin-filter-bar is-compact">
        <div class="admin-filter-field">
            <label class="admin-filter-label" for="protocol-search">Tìm kiếm</label>
            <input id="protocol-search" class="admin-input" type="search" placeholder="Mã hoặc tên phác đồ" @bind="_search" @bind:event="oninput" @bind:after="Recompute" />
        </div>
        <div class="admin-filter-field">
            <label class="admin-filter-label" for="protocol-type">Loại phác đồ</label>
            <select id="protocol-type" class="admin-select" @bind="_typeFilter" @bind:after="Recompute">
                <option value="">Tất cả</option>
                @foreach (var type in Sql.MedLookups.ProtocolTypes)
                {
                    <option value="@type.Code">@type.Name</option>
                }
            </select>
        </div>
        <div class="admin-filter-field">
            <label class="admin-filter-label">Trạng thái</label>
            <select class="admin-select" @bind="_statusFilter" @bind:after="Recompute">
                <option value="active">Đang hoạt động</option>
                <option value="archived">Lưu trữ</option>
                <option value="all">Tất cả</option>
            </select>
        </div>
    </div>

    @if (_items.Count == 0)
    {
        <div class="admin-table-wrapper">
            <div class="admin-empty" style="padding:48px 16px;">
                <div class="admin-empty-title">Không tìm thấy phác đồ phù hợp</div>
                <div class="admin-empty-body">Hãy thử từ khóa khác hoặc tạo phác đồ mới.</div>
            </div>
        </div>
    }
    else
    {
        <div class="admin-card-grid">
            @foreach (var protocol in _items)
            {
                var latest = LatestVersion(protocol.ClinicalProtocolId);
                <article class="admin-card" @onclick="() => OpenDetail(protocol)" style="cursor:pointer;">
                    <div class="admin-card-tags">
                        <AdminBadge Tone="tone-primary">@Lookup(Sql.MedLookups.ProtocolTypes, protocol.ProtocolType)</AdminBadge>
                        <AdminBadge Tone="@StatusTone(protocol.Status)">@Lookup(Sql.MedLookups.RecordStatuses, protocol.Status)</AdminBadge>
                        @if (latest is not null)
                        {
                            <AdminBadge Tone="tone-secondary">@($"v{latest.VersionNo}") • @Lookup(Sql.MedLookups.VersionStatuses, latest.StatusCode)</AdminBadge>
                        }
                    </div>
                    <h2 class="admin-card-title">@protocol.Name</h2>
                    <p class="admin-card-meta">@protocol.ProtocolCode • @GetDeptName(protocol.OwnerDepartmentId)</p>
                    <p class="admin-card-meta">@protocol.Description</p>
                    <div class="admin-row-actions" @onclick:stopPropagation="true">
                        <button type="button" class="admin-btn admin-btn-sm admin-btn-ghost" @onclick="() => OpenEditProtocol(protocol)">Sửa</button>
                        @if (protocol.Status == "active")
                        {
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-ghost" @onclick="() => ArchiveProtocol(protocol)">Lưu trữ</button>
                        }
                        else
                        {
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-primary" @onclick="() => RestoreProtocol(protocol)">Khôi phục</button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<AdminDrawer IsOpen="_drawerOpen" IsOpenChanged="v => _drawerOpen = v" SizeClass="admin-drawer-wide"
             Eyebrow="Phác đồ"
             Title="@(_selected?.Name ?? string.Empty)"
             Subtitle="@(_selected is null ? null : $"{_selected.ProtocolCode} • {Lookup(Sql.MedLookups.ProtocolTypes, _selected.ProtocolType)}")">
    <ChildContent>
        @if (_selected is not null && _selectedVersion is not null)
        {
            <dl class="admin-detail-grid">
                <dt>Khoa chủ quản</dt>
                <dd>@GetDeptName(_selected.OwnerDepartmentId)</dd>
                <dt>Phiên bản</dt>
                <dd>@($"v{_selectedVersion.VersionNo}") - @_selectedVersion.Title</dd>
                <dt>Trạng thái phiên bản</dt>
                <dd><AdminBadge Tone="@VersionTone(_selectedVersion.StatusCode)">@Lookup(Sql.MedLookups.VersionStatuses, _selectedVersion.StatusCode)</AdminBadge></dd>
                <dt>Hiệu lực từ</dt>
                <dd>@(_selectedVersion.EffectiveFrom?.ToString("dd/MM/yyyy") ?? "—")</dd>
                <dt>Tóm tắt</dt>
                <dd>@(_selectedVersion.Summary ?? "—")</dd>
            </dl>

            <div class="admin-tabs" role="tablist" aria-label="Chi tiết phác đồ">
                <button type="button" class="@ProceduresTabClass" @onclick="ShowProcedures">Quy trình liên kết</button>
                <button type="button" class="@RulesTabClass" @onclick="ShowRules">Quy tắc áp dụng</button>
                <button type="button" class="@ApplicationsTabClass" @onclick="ShowApplications">Đã áp dụng</button>
            </div>

            @if (_activeTab == "procedures")
            {
                <div class="admin-panel" style="padding:14px;">
                    <h3 class="admin-panel-title">Quy trình liên kết</h3>
                    <div class="admin-table-wrapper">
                        <table class="admin-table">
                            <thead><tr><th>Quy trình phiên bản</th><th>Quan hệ</th><th>Thứ tự</th><th>Ghi chú</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var link in Store.ClinicalProtocolProcedures.Where(p => p.ClinicalProtocolVersionId == _selectedVersion.ClinicalProtocolVersionId).OrderBy(p => p.SequenceNo))
                                {
                                    <tr>
                                        <td>@GetProcedureVersionName(link.ProcedureVersionId)</td>
                                        <td>@Lookup(Sql.MedLookups.ProtocolRelationTypes, link.RelationType)</td>
                                        <td>@(link.SequenceNo?.ToString() ?? "—")</td>
                                        <td>@(link.Note ?? "—")</td>
                                        <td style="text-align:right;"><button type="button" class="admin-icon-btn is-danger" @onclick="() => RemoveProtocolProcedure(link)">×</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="admin-form-grid" style="margin-top:14px;">
                        <div class="admin-form-field">
                            <label class="admin-form-field-label">Phiên bản quy trình</label>
                            <select class="admin-select" @bind="_linkProcedureVersionId">
                                <option value="">Chọn quy trình</option>
                                @foreach (var version in Store.ProcedureVersions.OrderByDescending(v => v.CreatedAt))
                                {
                                    <option value="@version.ProcedureVersionId">@GetProcedureVersionName(version.ProcedureVersionId)</option>
                                }
                            </select>
                        </div>
                        <div class="admin-form-field">
                            <label class="admin-form-field-label">Quan hệ</label>
                            <select class="admin-select" @bind="_linkRelationType">
                                @foreach (var type in Sql.MedLookups.ProtocolRelationTypes)
                                {
                                    <option value="@type.Code">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div class="admin-form-field">
                            <label class="admin-form-field-label">Thứ tự</label>
                            <input class="admin-input" type="number" min="1" @bind="_linkSequence" />
                        </div>
                        <div class="admin-form-field admin-form-field-full">
                            <label class="admin-form-field-label">Ghi chú</label>
                            <input class="admin-input" @bind="_linkNote" />
                        </div>
                    </div>
                    <div style="display:flex;justify-content:flex-end;margin-top:10px;">
                        <button type="button" class="admin-btn admin-btn-primary" @onclick="AddProtocolProcedure">Thêm liên kết</button>
                    </div>
                </div>
            }
            else if (_activeTab == "rules")
            {
                <div class="admin-panel" style="padding:14px;">
                    <h3 class="admin-panel-title">Quy tắc áp dụng</h3>
                    <div class="admin-table-wrapper">
                        <table class="admin-table">
                            <thead><tr><th>Loại</th><th>Điều kiện áp dụng</th><th>Ưu tiên</th><th>Hoạt động</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var rule in Store.ProtocolApplicabilityRules.Where(r => r.ClinicalProtocolVersionId == _selectedVersion.ClinicalProtocolVersionId).OrderByDescending(r => r.Priority))
                                {
                                    <tr>
                                        <td>@Lookup(Sql.MedLookups.ProtocolRuleTypes, rule.RuleType)</td>
                                        <td>
                                            <div>@FormatRule(rule)</div>
                                            <details>
                                                <summary style="cursor:pointer;">Chi tiết kỹ thuật</summary>
                                                <code>@rule.RuleJson</code>
                                            </details>
                                        </td>
                                        <td>@rule.Priority</td>
                                        <td>@(rule.IsActive ? "Có" : "Không")</td>
                                        <td style="text-align:right;"><button type="button" class="admin-icon-btn is-danger" @onclick="() => RemoveRule(rule)">×</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="admin-form-grid" style="margin-top:14px;">
                        <div class="admin-form-field">
                            <label class="admin-form-field-label">Loại rule</label>
                            <select class="admin-select" @bind="_ruleType">
                                @foreach (var type in Sql.MedLookups.ProtocolRuleTypes)
                                {
                                    <option value="@type.Code">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div class="admin-form-field">
                            <label class="admin-form-field-label">Ưu tiên</label>
                            <input class="admin-input" type="number" min="1" @bind="_rulePriority" />
                        </div>
                        <div class="admin-form-field">
                            <label class="admin-form-field-label">Hoạt động</label>
                            <label class="admin-check-row"><input type="checkbox" @bind="_ruleActive" /> Có</label>
                        </div>
                        <div class="admin-form-field admin-form-field-full">
                            <label class="admin-form-field-label">Giá trị điều kiện</label>
                            <input class="admin-input" @bind="_ruleJson" placeholder="VD: I10, 18-65, Nam, Khoa Nội" />
                            <div class="admin-form-field-hint">Nhập nội dung nghiệp vụ; hệ thống sẽ lưu thành quy tắc kỹ thuật.</div>
                        </div>
                    </div>
                    <div style="display:flex;justify-content:flex-end;margin-top:10px;">
                        <button type="button" class="admin-btn admin-btn-primary" @onclick="AddRule">Thêm rule</button>
                    </div>
                </div>
            }
            else
            {
                <div class="admin-panel" style="padding:14px;">
                    <h3 class="admin-panel-title">Bệnh nhân đã áp dụng</h3>
                    <div class="admin-table-wrapper">
                        <table class="admin-table">
                            <thead><tr><th>Bệnh nhân</th><th>Lượt khám</th><th>Chẩn đoán</th><th>Trạng thái</th><th>Thời điểm</th></tr></thead>
                            <tbody>
                                @foreach (var app in Store.PatientProtocolApplications.Where(a => a.ClinicalProtocolVersionId == _selectedVersion.ClinicalProtocolVersionId).OrderByDescending(a => a.AppliedAt))
                                {
                                    <tr>
                                        <td>@GetPatientName(app.PatientRefId)</td>
                                        <td>@GetEncounterCode(app.EncounterRefId)</td>
                                        <td>@(app.DiagnosisCode ?? "—")</td>
                                        <td><AdminBadge Tone="@ApplicationTone(app.ApplicationStatus)">@Lookup(Sql.MedLookups.ProtocolApplicationStatuses, app.ApplicationStatus)</AdminBadge></td>
                                        <td>@app.AppliedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </ChildContent>
    <FooterContent>
        @if (_selectedVersion?.StatusCode == "draft")
        {
            <button type="button" class="admin-btn admin-btn-ghost" @onclick="SubmitProtocolVersion">Gửi phê duyệt</button>
        }
        @if (_selectedVersion?.StatusCode == "pending_approval")
        {
            <button type="button" class="admin-btn admin-btn-primary" @onclick="PublishProtocolVersion">Phê duyệt và ban hành</button>
        }
        <button type="button" class="admin-btn admin-btn-primary" @onclick="() => _drawerOpen = false">Đóng</button>
    </FooterContent>
</AdminDrawer>

<AdminModal IsOpen="_createOpen" IsOpenChanged="v => _createOpen = v" Title="Tạo phác đồ mới">
    <ChildContent>
        <div class="admin-form-grid">
            <div class="admin-form-field">
                <label class="admin-form-field-label is-required">Mã phác đồ</label>
                <input class="admin-input" @bind="_createCode" />
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label is-required">Tên phác đồ</label>
                <input class="admin-input" @bind="_createName" />
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label is-required">Loại</label>
                <select class="admin-select" @bind="_createType">
                    @foreach (var type in Sql.MedLookups.ProtocolTypes)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Khoa chủ quản</label>
                <select class="admin-select" @bind="_createDepartmentId">
                    <option value="">Không chọn</option>
                    @foreach (var dept in Store.Departments.Where(d => d.Status == "active").OrderBy(d => d.Code))
                    {
                        <option value="@dept.DepartmentId">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field admin-form-field-full">
                <label class="admin-form-field-label">Mô tả</label>
                <textarea class="admin-textarea" rows="3" @bind="_createDescription"></textarea>
            </div>
            <div class="admin-form-field admin-form-field-full">
                <label class="admin-form-field-label">Tóm tắt phiên bản đầu</label>
                <textarea class="admin-textarea" rows="3" @bind="_createSummary"></textarea>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="admin-btn admin-btn-ghost" @onclick="() => _createOpen = false">Hủy</button>
        <button type="button" class="admin-btn admin-btn-primary" @onclick="CreateProtocol">Lưu phác đồ</button>
    </FooterContent>
</AdminModal>

@code {
    private string _search = string.Empty;
    private string _typeFilter = string.Empty;
    private string _statusFilter = "active";
    private IReadOnlyList<Sql.ClinicalProtocol> _items = Array.Empty<Sql.ClinicalProtocol>();

    private bool _drawerOpen;
    private Sql.ClinicalProtocol? _selected;
    private Sql.ClinicalProtocolVersion? _selectedVersion;
    private string _activeTab = "procedures";

    private bool _createOpen;
    private Guid? _editingProtocolId;
    private string _createCode = string.Empty;
    private string _createName = string.Empty;
    private string _createType = "treatment_protocol";
    private string _createDepartmentId = string.Empty;
    private string _createDescription = string.Empty;
    private string _createSummary = string.Empty;

    private string _linkProcedureVersionId = string.Empty;
    private string _linkRelationType = "references";
    private int _linkSequence = 1;
    private string _linkNote = string.Empty;

    private string _ruleType = "icd";
    private int _rulePriority = 100;
    private bool _ruleActive = true;
    private string _ruleJson = "{\"icd\":\"I10\"}";

    private string ProceduresTabClass => _activeTab == "procedures" ? "admin-tab is-active" : "admin-tab";
    private string RulesTabClass => _activeTab == "rules" ? "admin-tab is-active" : "admin-tab";
    private string ApplicationsTabClass => _activeTab == "applications" ? "admin-tab is-active" : "admin-tab";

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
        Recompute();
    }

    private void OnChanged() => InvokeAsync(() =>
    {
        if (_selected is not null)
        {
            _selected = Store.ClinicalProtocols.FirstOrDefault(p => p.ClinicalProtocolId == _selected.ClinicalProtocolId);
            _selectedVersion = _selected is null ? null : LatestVersion(_selected.ClinicalProtocolId);
        }
        Recompute();
        StateHasChanged();
    });

    private void Recompute()
    {
        _items = Store.ClinicalProtocols
            .Where(p => string.IsNullOrEmpty(_typeFilter) || p.ProtocolType == _typeFilter)
            .Where(p => _statusFilter == "all" || (_statusFilter == "archived" ? p.Status != "active" : p.Status == "active"))
            .Where(p => string.IsNullOrWhiteSpace(_search)
                || p.ProtocolCode.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.ProtocolCode)
            .ToList();
    }

    private void OpenCreate()
    {
        if (!Guard.CanDo("SCR_PROTOCOLS:CREATE", "tạo phác đồ"))
        {
            return;
        }

        _editingProtocolId = null;
        _createCode = string.Empty;
        _createName = string.Empty;
        _createType = Sql.MedLookups.ProtocolTypes.First().Code;
        _createDepartmentId = string.Empty;
        _createDescription = string.Empty;
        _createSummary = string.Empty;
        _createOpen = true;
    }

    private void OpenEditProtocol(Sql.ClinicalProtocol protocol)
    {
        if (!Guard.CanDo("SCR_PROTOCOLS:UPDATE", "sửa phác đồ"))
        {
            return;
        }

        _editingProtocolId = protocol.ClinicalProtocolId;
        _createCode = protocol.ProtocolCode;
        _createName = protocol.Name;
        _createType = protocol.ProtocolType;
        _createDepartmentId = protocol.OwnerDepartmentId?.ToString() ?? string.Empty;
        _createDescription = protocol.Description ?? string.Empty;
        _createSummary = LatestVersion(protocol.ClinicalProtocolId)?.Summary ?? string.Empty;
        _createOpen = true;
    }

    private void CreateProtocol()
    {
        var permission = _editingProtocolId.HasValue ? "SCR_PROTOCOLS:UPDATE" : "SCR_PROTOCOLS:CREATE";
        var action = _editingProtocolId.HasValue ? "sửa phác đồ" : "tạo phác đồ";
        if (!Guard.CanDo(permission, action))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_createCode) || string.IsNullOrWhiteSpace(_createName))
        {
            Toasts.Show("Thiếu thông tin", "Vui lòng nhập mã và tên phác đồ.", ToastVariant.Warning);
            return;
        }

        try
        {
            if (_editingProtocolId.HasValue)
            {
                var current = Store.ClinicalProtocols.First(p => p.ClinicalProtocolId == _editingProtocolId.Value);
                var activeVersion = Store.ClinicalProtocolVersions
                    .Where(v => v.ClinicalProtocolId == current.ClinicalProtocolId && v.StatusCode == "active")
                    .OrderByDescending(v => v.VersionNo)
                    .FirstOrDefault();
                if (activeVersion is not null)
                {
                    CreateDraftProtocolVersionFromActive(current, activeVersion);
                    Toasts.Show("Đã tạo bản nháp cập nhật",
                        "Phác đồ đang hiệu lực không bị sửa trực tiếp. Vui lòng chỉnh bản nháp rồi gửi phê duyệt.",
                        ToastVariant.Success);
                    _createOpen = false;
                    Recompute();
                    return;
                }

                Store.UpdateClinicalProtocol(current with
                {
                    ProtocolCode = _createCode.Trim(),
                    Name = _createName.Trim(),
                    ProtocolType = _createType,
                    OwnerDepartmentId = ParseGuid(_createDepartmentId),
                    Description = string.IsNullOrWhiteSpace(_createDescription) ? null : _createDescription.Trim()
                });
                Toasts.Show("Đã cập nhật phác đồ", _createName.Trim(), ToastVariant.Success);
                _createOpen = false;
                return;
            }

            var protocol = new Sql.ClinicalProtocol
            {
                ProtocolCode = _createCode.Trim(),
                Name = _createName.Trim(),
                ProtocolType = _createType,
                OwnerDepartmentId = ParseGuid(_createDepartmentId),
                Description = string.IsNullOrWhiteSpace(_createDescription) ? null : _createDescription.Trim(),
                CreatedBy = UserContext.CurrentUser?.UserId
            };
            Store.AddClinicalProtocol(protocol);
            Store.AddClinicalProtocolVersion(new Sql.ClinicalProtocolVersion
            {
                ClinicalProtocolId = protocol.ClinicalProtocolId,
                VersionNo = 1,
                StatusCode = "draft",
                Title = $"{protocol.Name} - Phiên bản 1",
                Summary = string.IsNullOrWhiteSpace(_createSummary) ? null : _createSummary.Trim(),
                ContentJson = "{}",
                CreatedBy = UserContext.CurrentUser?.UserId
            });
            Toasts.Show("Đã tạo phác đồ", protocol.Name, ToastVariant.Success);
            _createOpen = false;
        }
        catch (Exception ex)
        {
            Toasts.Show("Không thể tạo phác đồ", ex.Message, ToastVariant.Error);
        }
    }

    private void CreateDraftProtocolVersionFromActive(Sql.ClinicalProtocol protocol, Sql.ClinicalProtocolVersion activeVersion)
    {
        var nextNo = Store.ClinicalProtocolVersions
            .Where(v => v.ClinicalProtocolId == protocol.ClinicalProtocolId)
            .Select(v => v.VersionNo)
            .DefaultIfEmpty(0)
            .Max() + 1;
        var draft = new Sql.ClinicalProtocolVersion
        {
            ClinicalProtocolId = protocol.ClinicalProtocolId,
            VersionNo = nextNo,
            StatusCode = "draft",
            Title = _createName.Trim(),
            Summary = string.IsNullOrWhiteSpace(_createSummary) ? activeVersion.Summary : _createSummary.Trim(),
            ContentJson = activeVersion.ContentJson,
            CreatedBy = UserContext.CurrentUser?.UserId
        };
        Store.AddClinicalProtocolVersion(draft);

        foreach (var link in Store.ClinicalProtocolProcedures.Where(p => p.ClinicalProtocolVersionId == activeVersion.ClinicalProtocolVersionId))
        {
            Store.AddClinicalProtocolProcedure(link with
            {
                ClinicalProtocolProcedureId = Guid.NewGuid(),
                ClinicalProtocolVersionId = draft.ClinicalProtocolVersionId,
                CreatedAt = DateTime.UtcNow
            });
        }

        foreach (var rule in Store.ProtocolApplicabilityRules.Where(r => r.ClinicalProtocolVersionId == activeVersion.ClinicalProtocolVersionId))
        {
            Store.AddProtocolApplicabilityRule(rule with
            {
                ProtocolApplicabilityRuleId = Guid.NewGuid(),
                ClinicalProtocolVersionId = draft.ClinicalProtocolVersionId,
                CreatedAt = DateTime.UtcNow
            });
        }
    }

    private async Task ArchiveProtocol(Sql.ClinicalProtocol protocol)
    {
        if (!Guard.CanDo("SCR_PROTOCOLS:DELETE", "lưu trữ phác đồ"))
        {
            return;
        }

        var ok = await Confirm.ShowAsync(
            "Lưu trữ phác đồ",
            $"Lưu trữ phác đồ \"{protocol.Name}\"?",
            confirmText: "Lưu trữ",
            isDanger: true);
        if (!ok)
        {
            return;
        }

        Store.UpdateClinicalProtocol(protocol with { Status = "archived" });
        AppendAudit("archive", "clinical_protocol", protocol.ClinicalProtocolId.ToString(), protocol.OwnerDepartmentId);
        Toasts.Show("Đã lưu trữ phác đồ", protocol.Name, ToastVariant.Info);
    }

    private async Task RestoreProtocol(Sql.ClinicalProtocol protocol)
    {
        if (!Guard.CanDo("SCR_PROTOCOLS:UPDATE", "khôi phục phác đồ"))
        {
            return;
        }

        var ok = await Confirm.ShowAsync(
            "Khôi phục phác đồ",
            $"Khôi phục phác đồ \"{protocol.Name}\"?",
            confirmText: "Khôi phục");
        if (!ok)
        {
            return;
        }

        Store.UpdateClinicalProtocol(protocol with { Status = "active" });
        AppendAudit("restore", "clinical_protocol", protocol.ClinicalProtocolId.ToString(), protocol.OwnerDepartmentId);
        Toasts.Show("Đã khôi phục phác đồ", protocol.Name, ToastVariant.Success);
    }

    private void OpenDetail(Sql.ClinicalProtocol protocol)
    {
        _selected = protocol;
        _selectedVersion = LatestVersion(protocol.ClinicalProtocolId);
        _activeTab = "procedures";
        ResetLinkForm();
        ResetRuleForm();
        _drawerOpen = true;
    }

    private void AddProtocolProcedure()
    {
        if (!Guard.CanDo("SCR_PROTOCOLS:UPDATE", "thêm liên kết quy trình"))
        {
            return;
        }

        if (_selectedVersion is null || !Guid.TryParse(_linkProcedureVersionId, out var procedureVersionId))
        {
            Toasts.Show("Thiếu quy trình", "Vui lòng chọn phiên bản quy trình.", ToastVariant.Warning);
            return;
        }
        if (_selectedVersion.StatusCode != "draft")
        {
            Toasts.Show("Không thể sửa bản đã ban hành", "Hãy tạo bản nháp mới rồi chỉnh liên kết quy trình.", ToastVariant.Warning);
            return;
        }

        try
        {
            Store.AddClinicalProtocolProcedure(new Sql.ClinicalProtocolProcedure
            {
                ClinicalProtocolVersionId = _selectedVersion.ClinicalProtocolVersionId,
                ProcedureVersionId = procedureVersionId,
                RelationType = _linkRelationType,
                SequenceNo = _linkSequence <= 0 ? null : _linkSequence,
                Note = string.IsNullOrWhiteSpace(_linkNote) ? null : _linkNote.Trim()
            });
            Toasts.Show("Đã thêm liên kết quy trình", GetProcedureVersionName(procedureVersionId), ToastVariant.Success);
            ResetLinkForm();
        }
        catch (Exception ex)
        {
            Toasts.Show("Không thể thêm liên kết", ex.Message, ToastVariant.Error);
        }
    }

    private void RemoveProtocolProcedure(Sql.ClinicalProtocolProcedure link)
    {
        if (!Guard.CanDo("SCR_PROTOCOLS:UPDATE", "xóa liên kết quy trình"))
        {
            return;
        }

        try
        {
            Store.RemoveClinicalProtocolProcedure(link.ClinicalProtocolProcedureId);
            Toasts.Show("Đã xóa liên kết", GetProcedureVersionName(link.ProcedureVersionId), ToastVariant.Info);
        }
        catch (Exception ex)
        {
            Toasts.Show("Không thể xóa liên kết", ex.Message, ToastVariant.Error);
        }
    }

    private void AddRule()
    {
        if (!Guard.CanDo("SCR_PROTOCOLS:UPDATE", "thêm rule phác đồ"))
        {
            return;
        }

        if (_selectedVersion is null || string.IsNullOrWhiteSpace(_ruleJson))
        {
            Toasts.Show("Thiếu điều kiện", "Vui lòng nhập giá trị điều kiện áp dụng.", ToastVariant.Warning);
            return;
        }
        if (_selectedVersion.StatusCode != "draft")
        {
            Toasts.Show("Không thể sửa bản đã ban hành", "Hãy tạo bản nháp mới rồi chỉnh quy tắc áp dụng.", ToastVariant.Warning);
            return;
        }

        try
        {
            Store.AddProtocolApplicabilityRule(new Sql.ProtocolApplicabilityRule
            {
                ClinicalProtocolVersionId = _selectedVersion.ClinicalProtocolVersionId,
                RuleType = _ruleType,
                RuleJson = BuildRuleJson(_ruleType, _ruleJson),
                Priority = _rulePriority,
                IsActive = _ruleActive
            });
            Toasts.Show("Đã thêm rule", Lookup(Sql.MedLookups.ProtocolRuleTypes, _ruleType), ToastVariant.Success);
            ResetRuleForm();
        }
        catch (Exception ex)
        {
            Toasts.Show("Không thể thêm rule", ex.Message, ToastVariant.Error);
        }
    }

    private void RemoveRule(Sql.ProtocolApplicabilityRule rule)
    {
        if (!Guard.CanDo("SCR_PROTOCOLS:UPDATE", "xóa rule phác đồ"))
        {
            return;
        }

        try
        {
            Store.RemoveProtocolApplicabilityRule(rule.ProtocolApplicabilityRuleId);
            Toasts.Show("Đã xóa rule", Lookup(Sql.MedLookups.ProtocolRuleTypes, rule.RuleType), ToastVariant.Info);
        }
        catch (Exception ex)
        {
            Toasts.Show("Không thể xóa rule", ex.Message, ToastVariant.Error);
        }
    }

    private async Task SubmitProtocolVersion()
    {
        if (_selectedVersion is null)
        {
            return;
        }

        if (!Guard.CanDo("SCR_PROTOCOLS:UPDATE", "gửi phê duyệt phác đồ"))
        {
            return;
        }

        if (_selectedVersion.StatusCode != "draft")
        {
            Toasts.Show("Không thể gửi phê duyệt", "Chỉ phiên bản nháp mới được gửi phê duyệt.", ToastVariant.Warning);
            return;
        }

        var ok = await Confirm.ShowAsync(
            "Gửi phê duyệt",
            $"Gửi phiên bản \"{_selectedVersion.Title}\" để phê duyệt?",
            confirmText: "Gửi");
        if (!ok)
        {
            return;
        }

        Store.UpdateClinicalProtocolVersion(_selectedVersion with { StatusCode = "pending_approval" });
        AppendAudit("submit", "clinical_protocol_version", _selectedVersion.ClinicalProtocolVersionId.ToString(), _selected?.OwnerDepartmentId);
        Toasts.Show("Đã gửi phê duyệt", _selectedVersion.Title, ToastVariant.Success);
    }

    private async Task PublishProtocolVersion()
    {
        if (_selectedVersion is null || _selected is null)
        {
            return;
        }

        if (!Guard.CanDo("SCR_PROTOCOLS:APPROVE", "ban hành phác đồ"))
        {
            return;
        }

        if (_selectedVersion.StatusCode != "pending_approval")
        {
            Toasts.Show("Không thể ban hành", "Chỉ phiên bản đang chờ phê duyệt mới được ban hành.", ToastVariant.Warning);
            return;
        }

        var ok = await Confirm.ShowAsync(
            "Ban hành phác đồ",
            $"Phê duyệt và ban hành \"{_selectedVersion.Title}\"?",
            confirmText: "Ban hành");
        if (!ok)
        {
            return;
        }

        var now = DateTime.UtcNow;
        foreach (var active in Store.ClinicalProtocolVersions
            .Where(v => v.ClinicalProtocolId == _selectedVersion.ClinicalProtocolId
                && v.ClinicalProtocolVersionId != _selectedVersion.ClinicalProtocolVersionId
                && v.StatusCode == "active")
            .ToList())
        {
            Store.UpdateClinicalProtocolVersion(active with { StatusCode = "superseded", EffectiveTo = now });
        }

        Store.UpdateClinicalProtocolVersion(_selectedVersion with
        {
            StatusCode = "active",
            ApprovedBy = UserContext.CurrentUser?.UserId,
            PublishedBy = UserContext.CurrentUser?.UserId,
            ApprovedAt = now,
            PublishedAt = now,
            EffectiveFrom = now,
            EffectiveTo = null
        });
        AppendAudit("publish", "clinical_protocol_version", _selectedVersion.ClinicalProtocolVersionId.ToString(), _selected.OwnerDepartmentId);
        Toasts.Show("Đã ban hành phác đồ", _selectedVersion.Title, ToastVariant.Success);
    }

    private void ResetLinkForm()
    {
        _linkProcedureVersionId = string.Empty;
        _linkRelationType = "references";
        _linkSequence = 1;
        _linkNote = string.Empty;
    }

    private void ResetRuleForm()
    {
        _ruleType = "icd";
        _rulePriority = 100;
        _ruleActive = true;
        _ruleJson = "{\"icd\":\"I10\"}";
    }

    private void ShowProcedures() => _activeTab = "procedures";
    private void ShowRules() => _activeTab = "rules";
    private void ShowApplications() => _activeTab = "applications";

    private Sql.ClinicalProtocolVersion? LatestVersion(Guid protocolId)
        => Store.ClinicalProtocolVersions.Where(v => v.ClinicalProtocolId == protocolId).OrderByDescending(v => v.VersionNo).FirstOrDefault();

    private string GetDeptName(Guid? deptId) => deptId.HasValue ? Store.Departments.FirstOrDefault(d => d.DepartmentId == deptId.Value)?.Name ?? "—" : "—";
    private string GetPatientName(Guid patientId) => Store.PatientRefs.FirstOrDefault(p => p.PatientRefId == patientId)?.DisplayName ?? "—";
    private string GetEncounterCode(Guid? encounterId) => encounterId.HasValue ? Store.EncounterRefs.FirstOrDefault(e => e.EncounterRefId == encounterId.Value)?.ExternalEncounterId ?? "—" : "—";
    private string GetProcedureVersionName(Guid versionId)
    {
        var version = Store.ProcedureVersions.FirstOrDefault(v => v.ProcedureVersionId == versionId);
        if (version is null) return "—";
        var proc = Store.Procedures.FirstOrDefault(p => p.ProcedureId == version.ProcedureId);
        return $"{proc?.ProcedureCode ?? "QT"} v{version.VersionNo} - {version.Title}";
    }

    private static string BuildRuleJson(string ruleType, string value)
    {
        var trimmed = value.Trim();
        if (trimmed.StartsWith("{", StringComparison.Ordinal))
        {
            return trimmed;
        }

        var payload = ruleType switch
        {
            "icd" => new Dictionary<string, string> { ["icd"] = trimmed },
            "age" => new Dictionary<string, string> { ["age"] = trimmed },
            "gender" => new Dictionary<string, string> { ["gender"] = trimmed },
            "department" => new Dictionary<string, string> { ["department"] = trimmed },
            "contraindication" => new Dictionary<string, string> { ["contraindication"] = trimmed },
            _ => new Dictionary<string, string> { ["value"] = trimmed }
        };
        return JsonSerializer.Serialize(payload);
    }

    private static string FormatRule(Sql.ProtocolApplicabilityRule rule)
    {
        if (string.IsNullOrWhiteSpace(rule.RuleJson))
        {
            return Lookup(Sql.MedLookups.ProtocolRuleTypes, rule.RuleType);
        }

        try
        {
            using var doc = JsonDocument.Parse(rule.RuleJson);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
            {
                return Lookup(Sql.MedLookups.ProtocolRuleTypes, rule.RuleType);
            }

            var parts = new List<string>();
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                if (prop.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
                {
                    continue;
                }

                parts.Add($"{RuleFieldLabel(prop.Name)}: {JsonValueText(prop.Value)}");
            }

            return parts.Count == 0
                ? Lookup(Sql.MedLookups.ProtocolRuleTypes, rule.RuleType)
                : string.Join("; ", parts);
        }
        catch (JsonException)
        {
            return "Rule JSON chưa hợp lệ";
        }
    }

    private static string RuleFieldLabel(string field) => field switch
    {
        "icd" or "diagnosisCode" => "ICD",
        "ageFrom" => "Tuổi từ",
        "ageTo" => "Tuổi đến",
        "gender" => "Giới tính",
        "department" or "departmentCode" => "Khoa",
        "description" or "note" => "Mô tả",
        _ => field
    };

    private static string JsonValueText(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.String => value.GetString() ?? string.Empty,
        JsonValueKind.Array => string.Join(", ", value.EnumerateArray().Select(JsonValueText)),
        _ => value.ToString()
    };

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static string Lookup(IReadOnlyList<Sql.LookupEntry> entries, string? code) => entries.FirstOrDefault(e => e.Code == code)?.Name ?? code ?? "—";
    private static string StatusTone(string status) => status == "active" ? "tone-success" : "tone-muted";
    private static string VersionTone(string status) => status switch
    {
        "active" => "tone-success",
        "pending_approval" => "tone-warning",
        "rejected" => "tone-danger",
        _ => "tone-muted"
    };
    private static string ApplicationTone(string status) => status switch
    {
        "applied" => "tone-success",
        "suggested" => "tone-primary",
        "skipped" => "tone-warning",
        "cancelled" => "tone-danger",
        _ => "tone-muted"
    };

    private void AppendAudit(string actionCode, string targetType, string targetId, Guid? departmentId)
    {
        Audit.Append(new Sql.AuditLog
        {
            CorrelationId = Guid.NewGuid(),
            ActorUserId = UserContext.CurrentUser?.UserId,
            ActorUsername = UserContext.CurrentUser?.Username,
            ActionCode = actionCode,
            TargetType = targetType,
            TargetId = targetId,
            DepartmentId = departmentId
        });
    }

    public void Dispose() => Store.StateChanged -= OnChanged;
}
