    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static string? NullIfWhiteSpace(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string FormatBytes(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.##} MB" : $"{bytes / 1024d:0.##} KB";
    private static string AttachmentTypeName(string code) => Sql.MedLookups.AttachmentTypes.FirstOrDefault(item => item.Code == code)?.Name ?? code;
    private string DisplayDepartment(Sql.Department? department) => AdminBusinessDisplay.DepartmentLabel(department, ActiveDepartments);

    private sealed class PendingAttachment(Guid clientId, string fileName, string contentType, byte[] content, string attachmentType)
    {
        public Guid ClientId { get; } = clientId;
        public string FileName { get; } = fileName;
        public string ContentType { get; } = contentType;
        public byte[] Content { get; } = content;
        public long Size => Content.LongLength;
        public string AttachmentType { get; set; } = attachmentType;
    }

    private sealed record ExistingAttachmentEntry(Guid ClientId, Sql.ProcedureAttachment Attachment);
