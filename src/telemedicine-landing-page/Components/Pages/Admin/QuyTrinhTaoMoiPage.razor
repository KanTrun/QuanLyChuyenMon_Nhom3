@page "/admin/quy-trinh/tao"
@page "/qlcm/quy-trinh/tao"
@layout AdminLayout
@using System.Text.Json
@using Sql = TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@inject ICurrentUserContext UserContext
@inject IToastService Toasts
@inject AdminActionGuard Guard
@inject ProcedureLifecycleService Lifecycle
@inject ProcedureSignoffService Signoffs
@inject IProcedureAttachmentStorageService AttachmentStorage
@inject NavigationManager Navigation

<PageTitle>Tạo quy trình y tế | QLCM Pro</PageTitle>

<section class="admin-page procedure-authoring-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Quy trình kỹ thuật</span>
            <h1 class="admin-page-title">Soạn quy trình y tế mới</h1>
            <p class="admin-page-subtitle">Tạo hồ sơ có cấu trúc, lưu đồ, kiểm soát sửa đổi, tệp nguồn và chuỗi ký nội bộ.</p>
        </div>
        <a class="admin-btn admin-btn-ghost" href="/qlcm/quy-trinh">Hủy và quay lại</a>
    </header>

    <article class="admin-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Thông tin kiểm soát và ban hành</h2>
                <p class="admin-form-field-hint">Thông tin này xuất hiện trên bìa và đầu trang bản in.</p>
            </div>
        </header>
        <div class="admin-form-grid">
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Mã quy trình</span>
                <input class="admin-input" @bind="_code" placeholder="VD: QT.KSNK.18" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Tên quy trình</span>
                <input class="admin-input" @bind="_name" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Loại quy trình</span>
                <select class="admin-select" @bind="_procedureType">
                    @foreach (var type in Sql.MedLookups.ProcedureTypes)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Khoa/phòng chủ trì</span>
                <select class="admin-select" @bind="_departmentId">
                    <option value="">Chọn khoa/phòng</option>
                    @foreach (var department in Store.Departments.Where(item => item.Status == "active").OrderBy(item => item.Code))
                    {
                        <option value="@department.DepartmentId">@department.Code - @department.Name</option>
                    }
                </select>
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Phiên bản</span>
                <input class="admin-input" @bind="_versionLabel" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Lần ban hành</span>
                <input class="admin-input" type="number" min="1" @bind="_issueNumber" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Ngày dự kiến ban hành</span>
                <input class="admin-input" type="date" @bind="_issueDate" />
            </label>
            <label class="admin-form-field admin-form-field-full">
                <span class="admin-form-field-label">Mô tả quản trị</span>
                <textarea class="admin-textarea" rows="2" @bind="_description"></textarea>
            </label>
            <label class="admin-form-field admin-form-field-full">
                <span class="admin-form-field-label">Tóm tắt phiên bản / lý do xây dựng</span>
                <textarea class="admin-textarea" rows="3" @bind="_summary"></textarea>
            </label>
        </div>
    </article>

    <ProcedureGovernanceEditor Recipients="_recipients" Revisions="_revisions" />
    <ProcedureDocumentSectionsEditor Sections="_sections" />
    <ProcedureFlowEditor Steps="_steps" Roles="ActiveRoles" />

    <article class="admin-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Tệp gắn kèm</h2>
                <p class="admin-form-field-hint">Tệp được lưu nội bộ, tính SHA-256 và chỉ tải xuống qua phiên đăng nhập.</p>
            </div>
            <InputFile OnChange="OnFilesSelected" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
        </header>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead><tr><th>Tệp</th><th>Loại</th><th>Dung lượng</th><th></th></tr></thead>
                <tbody>
                    @if (_attachments.Count == 0)
                    {
                        <tr><td colspan="4">Chưa chọn tệp. Cần ít nhất một PDF nguồn trước khi gửi kiểm tra.</td></tr>
                    }
                    @foreach (var attachment in _attachments)
                    {
                        <tr @key="attachment">
                            <td>@attachment.File.Name</td>
                            <td>
                                <select class="admin-select" @bind="attachment.AttachmentType">
                                    @foreach (var type in Sql.MedLookups.AttachmentTypes)
                                    {
                                        <option value="@type.Code">@type.Name</option>
                                    }
                                </select>
                            </td>
                            <td>@FormatBytes(attachment.File.Size)</td>
                            <td><button type="button" class="admin-icon-btn is-danger" title="Xóa tệp" @onclick="() => _attachments.Remove(attachment)">×</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <aside class="admin-callout">
        <strong>Chuỗi xác nhận nội bộ:</strong> người soạn ký trên hash hiện tại khi gửi; người kiểm tra ký ở hàng chờ duyệt; người phê duyệt ký khi ban hành. Mọi chỉnh sửa nội dung làm chữ ký cũ hết hiệu lực.
    </aside>

    <div class="procedure-authoring-actions">
        <button type="button" class="admin-btn admin-btn-ghost" disabled="@_isSaving" @onclick="SaveDraftAsync">Lưu bản nháp</button>
        <button type="button" class="admin-btn admin-btn-primary" disabled="@_isSaving" @onclick="SignAndSubmitAsync">Ký người soạn và gửi kiểm tra</button>
    </div>
</section>

@code {
    private string _code = string.Empty;
    private string _name = string.Empty;
    private string _procedureType = "technical";
    private string _departmentId = string.Empty;
    private string _versionLabel = "v1.0";
    private int _issueNumber = 1;
    private DateTime? _issueDate = DateTime.Today;
    private string _description = string.Empty;
    private string _summary = string.Empty;
    private bool _isSaving;

    private readonly List<ProcedureSectionDraft> _sections = CreateSections();
    private readonly List<ProcedureFlowStepDraft> _steps =
    [
        new() { Code = "BUOC-01", Name = "Bắt đầu", ShapeCode = "terminator", DetailSectionNumber = "VIII" },
        new() { Code = "BUOC-02", Name = "Thực hiện", ShapeCode = "process", DetailSectionNumber = "VIII" },
        new() { Code = "BUOC-03", Name = "Kết thúc và lưu hồ sơ", ShapeCode = "terminator", DetailSectionNumber = "X" }
    ];
    private readonly List<ProcedureRecipientDraft> _recipients = [new()];
    private readonly List<ProcedureRevisionDraft> _revisions = [new() { Summary = "Ban hành lần đầu" }];
    private readonly List<PendingAttachment> _attachments = [];

    private IReadOnlyList<Sql.Role> ActiveRoles => Store.Roles.Where(item => item.Status == "active").OrderBy(item => item.Code).ToList();

    private void OnFilesSelected(InputFileChangeEventArgs args)
    {
        foreach (var file in args.GetMultipleFiles(10))
        {
            var isFirstPdf = !_attachments.Any(item => item.AttachmentType == "source_pdf") &&
                             file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
            _attachments.Add(new PendingAttachment(file, isFirstPdf ? "source_pdf" : "other"));
        }
    }

    private Task SaveDraftAsync() => SaveAsync(submit: false);
    private Task SignAndSubmitAsync() => SaveAsync(submit: true);

    private async Task SaveAsync(bool submit)
    {
        if (_isSaving || !Guard.CanDo("SCR_PROCEDURES:CREATE", "tạo quy trình")) return;
        var validationMessage = Validate(submit);
        if (validationMessage is not null)
        {
            Toasts.Show("Chưa thể lưu quy trình", validationMessage, ToastVariant.Warning);
            return;
        }

        var user = UserContext.CurrentUser;
        if (user is null)
        {
            Toasts.Show("Phiên đăng nhập không hợp lệ", "Vui lòng đăng nhập lại trước khi lưu.", ToastVariant.Error);
            return;
        }

        _isSaving = true;
        try
        {
            var procedure = new Sql.ProfessionalProcedure
            {
                ProcedureCode = _code.Trim(),
                Name = _name.Trim(),
                ProcedureType = _procedureType,
                OwnerDepartmentId = ParseGuid(_departmentId),
                Description = NullIfWhiteSpace(_description),
                CreatedBy = user.UserId
            };
            var versionId = Guid.NewGuid();
            var storedAttachments = new List<(PendingAttachment Draft, StoredProcedureAttachment Stored)>();
            foreach (var attachment in _attachments)
            {
                storedAttachments.Add((attachment, await AttachmentStorage.SaveAsync(versionId, attachment.File)));
            }
            var source = storedAttachments.FirstOrDefault(item => item.Draft.AttachmentType == "source_pdf").Stored;

            Store.AddProcedure(procedure);

            var version = new Sql.ProcedureVersion
            {
                ProcedureVersionId = versionId,
                ProcedureId = procedure.ProcedureId,
                VersionNo = 1,
                VersionLabel = _versionLabel.Trim(),
                StatusCode = "draft",
                DepartmentId = ParseGuid(_departmentId),
                Title = $"{procedure.Name} - {_versionLabel.Trim()}",
                Summary = JsonSerializer.Serialize(new { note = NullIfWhiteSpace(_summary) ?? "Khởi tạo quy trình" }),
                EffectiveFrom = _issueDate,
                IssueDate = _issueDate,
                IssueNumber = _issueNumber,
                SourcePdfFileName = source?.FileName,
                SourcePdfChecksumSha256 = source?.ChecksumSha256,
                CreatedBy = user.UserId
            };
            Store.AddProcedureVersion(version);
            PersistDocument(version, user.UserId, storedAttachments);

            if (submit)
            {
                Signoffs.Sign(versionId, "writer", user.UserId, user.Username, user.FullName, note: "Xác nhận nội dung do người soạn lập");
                Lifecycle.Submit(versionId, user.UserId);
            }

            Toasts.Show(submit ? "Đã ký và gửi kiểm tra" : "Đã lưu bản nháp", procedure.Name, ToastVariant.Success);
            Navigation.NavigateTo("/qlcm/quy-trinh");
        }
        catch (Exception exception)
        {
            Toasts.Show("Không thể lưu quy trình", exception.Message, ToastVariant.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void PersistDocument(
        Sql.ProcedureVersion version,
        Guid userId,
        IReadOnlyList<(PendingAttachment Draft, StoredProcedureAttachment Stored)> storedAttachments)
    {
        foreach (var section in _sections)
            Store.AddProcedureDocumentSection(new Sql.ProcedureDocumentSection
            {
                ProcedureVersionId = version.ProcedureVersionId,
                SectionOrder = section.Order,
                SectionNumber = section.Number,
                Title = section.Title,
                SectionKind = section.Kind,
                ContentText = NullIfWhiteSpace(section.Content),
                IsRequired = section.IsRequired
            });

        foreach (var item in _recipients.Where(item => !string.IsNullOrWhiteSpace(item.Name)).Select((item, index) => (item, index)))
            Store.AddProcedureDistributionRecipient(new Sql.ProcedureDistributionRecipient
            {
                ProcedureVersionId = version.ProcedureVersionId,
                DisplayOrder = item.index + 1,
                RecipientName = item.item.Name.Trim(),
                IsMarked = item.item.IsMarked
            });

        foreach (var item in _revisions.Where(item => !string.IsNullOrWhiteSpace(item.Summary)).Select((item, index) => (item, index)))
            Store.AddProcedureRevisionEntry(new Sql.ProcedureRevisionEntry
            {
                ProcedureVersionId = version.ProcedureVersionId,
                DisplayOrder = item.index + 1,
                RevisionDate = item.item.RevisionDate,
                PageRef = NullIfWhiteSpace(item.item.PageReference),
                SectionRef = NullIfWhiteSpace(item.item.SectionReference),
                Summary = item.item.Summary.Trim()
            });

        foreach (var item in _steps.Where(item => !string.IsNullOrWhiteSpace(item.Name)).Select((item, index) => (item, index)))
            Store.AddProcedureStep(new Sql.ProcedureStep
            {
                ProcedureVersionId = version.ProcedureVersionId,
                StepNo = item.index + 1,
                StepCode = NullIfWhiteSpace(item.item.Code) ?? $"BUOC-{item.index + 1:00}",
                Name = item.item.Name.Trim(),
                Description = NullIfWhiteSpace(item.item.Description),
                ActorRoleId = ParseGuid(item.item.RoleId),
                ResponsibilityText = NullIfWhiteSpace(item.item.Responsibility),
                FlowShapeCode = item.item.ShapeCode,
                FormReferenceText = NullIfWhiteSpace(item.item.FormReference),
                DetailSectionNumber = NullIfWhiteSpace(item.item.DetailSectionNumber),
                StandardDurationMinutes = item.item.Minutes
            });

        foreach (var item in storedAttachments)
            Store.AddProcedureAttachment(new Sql.ProcedureAttachment
            {
                ProcedureVersionId = version.ProcedureVersionId,
                AttachmentType = item.Draft.AttachmentType,
                FileName = item.Stored.FileName,
                FileUri = item.Stored.FileUri,
                MimeType = item.Stored.MimeType,
                FileSizeBytes = item.Stored.FileSizeBytes,
                ChecksumSha256 = item.Stored.ChecksumSha256,
                UploadedBy = userId
            });
    }

    private string? Validate(bool submit)
    {
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_versionLabel))
            return "Nhập mã, tên và phiên bản quy trình.";
        if (Store.Procedures.Any(item => string.Equals(item.ProcedureCode, _code.Trim(), StringComparison.OrdinalIgnoreCase)))
            return "Mã quy trình đã tồn tại. Vui lòng dùng mã khác.";
        if (!Guid.TryParse(_departmentId, out _)) return "Chọn khoa/phòng chủ trì.";
        if (_issueDate is null || _issueNumber < 1) return "Nhập ngày và lần ban hành hợp lệ.";
        if (!submit) return null;
        if (_sections.Any(item => item.IsRequired && string.IsNullOrWhiteSpace(item.Content))) return "Hoàn thiện tất cả mục La Mã bắt buộc.";
        if (_steps.Count == 0 || _steps.Any(item => string.IsNullOrWhiteSpace(item.Name) || string.IsNullOrWhiteSpace(item.Responsibility) || string.IsNullOrWhiteSpace(item.Description)))
            return "Mỗi bước phải có tên, trách nhiệm và diễn giải thao tác.";
        if (!_recipients.Any(item => !string.IsNullOrWhiteSpace(item.Name))) return "Thêm ít nhất một nơi nhận.";
        if (!_revisions.Any(item => !string.IsNullOrWhiteSpace(item.Summary))) return "Thêm ít nhất một dòng theo dõi sửa đổi.";
        if (!_attachments.Any(item => item.AttachmentType == "source_pdf" && item.File.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)))
            return "Chọn một tệp PDF và đặt loại là PDF nguồn.";
        return null;
    }

    private static List<ProcedureSectionDraft> CreateSections() =>
    [
        new() { Order = 1, Number = "I", Title = "Mục đích", Kind = "purpose" },
        new() { Order = 2, Number = "II", Title = "Phạm vi áp dụng", Kind = "scope" },
        new() { Order = 3, Number = "III", Title = "Căn cứ và tài liệu viện dẫn", Kind = "basis" },
        new() { Order = 4, Number = "IV", Title = "Thuật ngữ và định nghĩa", Kind = "definitions" },
        new() { Order = 5, Number = "V", Title = "Trách nhiệm", Kind = "responsibilities" },
        new() { Order = 6, Number = "VI", Title = "Nơi nhận và phân phối", Kind = "distribution" },
        new() { Order = 7, Number = "VII", Title = "Theo dõi sửa đổi", Kind = "revision" },
        new() { Order = 8, Number = "VIII", Title = "Nội dung quy trình", Kind = "procedure" },
        new() { Order = 9, Number = "IX", Title = "Lưu đồ", Kind = "flowchart" },
        new() { Order = 10, Number = "X", Title = "Hồ sơ, biểu mẫu và phụ lục", Kind = "records" },
        new() { Order = 11, Number = "XI", Title = "Tệp đính kèm", Kind = "appendices" }
    ];

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static string? NullIfWhiteSpace(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string FormatBytes(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.##} MB" : $"{bytes / 1024d:0.##} KB";

    private sealed class PendingAttachment(IBrowserFile file, string attachmentType)
    {
        public IBrowserFile File { get; } = file;
        public string AttachmentType { get; set; } = attachmentType;
    }
}
