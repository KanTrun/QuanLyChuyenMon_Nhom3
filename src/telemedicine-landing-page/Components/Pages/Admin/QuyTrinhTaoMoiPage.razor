    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static string? NullIfWhiteSpace(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string FormatBytes(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.##} MB" : $"{bytes / 1024d:0.##} KB";
    private static string AttachmentTypeName(string code) => Sql.MedLookups.AttachmentTypes.FirstOrDefault(item => item.Code == code)?.Name ?? code;

    private sealed class PendingAttachment(IBrowserFile file, string attachmentType)
    {
        public IBrowserFile File { get; } = file;
        public string AttachmentType { get; set; } = attachmentType;
    }

    // #region agent log
    private void AgentLog(string location, string message, object? data, string hypothesisId)
    {
        try
        {
            var line = JsonSerializer.Serialize(new
            {
                sessionId = "c592a1",
                hypothesisId,
                location,
                message,
                data,
                timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()
            }) + Environment.NewLine;
            var candidates = new[]
            {
                Path.Combine(HostEnvironment.ContentRootPath, "App_Data", "procedure-attachments", "uploads", "debug-c592a1.log"),
                Path.GetFullPath(Path.Combine(HostEnvironment.ContentRootPath, "..", "..", "..", "..", "debug-c592a1.log"))
            };
            foreach (var path in candidates)
            {
                try
                {
                    var dir = Path.GetDirectoryName(path);
                    if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
                    File.AppendAllText(path, line);
                }
                catch { /* ignore path */ }
            }
        }
        catch { /* ignore logging */ }
    }
    // #endregion
}
