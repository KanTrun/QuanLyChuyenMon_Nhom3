@page "/admin/quy-trinh/tao"
@page "/qlcm/quy-trinh/tao"
@page "/qlcm/quy-trinh/{ProcedureId:guid}/cap-nhat"
@page "/qlcm/quy-trinh/{ProcedureId:guid}/phien-ban/{VersionId:guid}"
@page "/qlcm/quy-trinh/{ProcedureId:guid}/phien-ban/{VersionId:guid}/chinh-sua"
@layout AdminLayout
@using TelemedicineLandingPage.Models.Admin
@using Sql = TelemedicineLandingPage.Models.Admin.Sql
@using TelemedicineLandingPage.Services.Admin
@inject IMedDataStore Store
@inject ICurrentUserContext UserContext
@inject IToastService Toasts
@inject AdminActionGuard Guard
@inject ProcedureLifecycleService Lifecycle
@inject ProcedureAuthoringService Authoring
@inject ProcedureSignoffService Signoffs
@inject ProcedureDocumentSnapshotService Snapshots
@inject IProcedureAttachmentStorageService AttachmentStorage
@inject NavigationManager Navigation

<PageTitle>@(IsUpdateMode ? "Cập nhật quy trình y tế" : "Tạo quy trình y tế") | QLCM Pro</PageTitle>

<section class="admin-page procedure-authoring-page @(IsReviewMode ? "is-review-mode" : IsEditDraftMode ? "is-edit-draft-mode" : null)">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">@(IsEditDraftMode ? $"Chỉnh sửa bản nháp {_versionLabel}" : IsReviewMode ? $"Xem & ký {_versionLabel}" : IsUpdateMode ? $"Phiên bản nguồn {SourceVersionLabel}" : "Quy trình kỹ thuật")</span>
            <h1 class="admin-page-title">@(IsEditDraftMode ? $"Tiếp tục soạn bản nháp {_versionLabel}" : IsReviewMode ? $"Xem và ký phiên bản nháp {_versionLabel}" : IsUpdateMode ? $"Cập nhật quy trình lên {_versionLabel}" : "Soạn quy trình y tế mới")</h1>
            <p class="admin-page-subtitle">@(IsEditDraftMode
                ? "Người viết được phân công có thể tiếp tục chỉnh sửa nội dung trước khi ký. Mọi thay đổi làm chữ ký cũ hết hiệu lực."
                : IsReviewMode
                ? "Toàn bộ nội dung quy trình hiển thị ở chế độ chỉ đọc. Người viết được phân công ký sau khi rà soát."
                : IsUpdateMode
                    ? $"Nội dung được sao chép từ {SourceVersionLabel}. Phiên bản cũ được giữ nguyên trong lịch sử."
                    : "Tạo hồ sơ có cấu trúc, lưu đồ, kiểm soát sửa đổi, tệp nguồn và chuỗi ký nội bộ.")</p>
        </div>
        <a class="admin-btn admin-btn-ghost" href="/qlcm/quy-trinh">@(IsReviewMode || IsEditDraftMode ? "Quay lại danh sách" : "Hủy và quay lại")</a>
    </header>

    <fieldset class="procedure-authoring-fieldset" disabled="@IsReviewMode">
    <article class="admin-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Thông tin kiểm soát và ban hành</h2>
                <p class="admin-form-field-hint">Thông tin này xuất hiện trên bìa và đầu trang bản in.</p>
            </div>
        </header>
        <div class="admin-form-grid">
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Mã quy trình</span>
                <input class="admin-input" @bind="_code" placeholder="VD: QT.KSNK.18" readonly="@IsUpdateMode" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Tên quy trình</span>
                <input class="admin-input" @bind="_name" readonly="@IsUpdateMode" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Loại quy trình</span>
                <select class="admin-select" @bind="_procedureType" disabled="@IsUpdateMode">
                    @foreach (var type in Sql.MedLookups.ProcedureTypes)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Khoa/phòng chủ trì</span>
                <select class="admin-select" @bind="_departmentId">
                    <option value="">Chọn khoa/phòng</option>
                    @foreach (var department in ActiveDepartments)
                    {
                        <option value="@department.DepartmentId">@DisplayDepartment(department)</option>
                    }
                </select>
                <span class="admin-form-field-hint">Tên khoa bị trùng sẽ tự hiển thị kèm mã để tránh chọn nhầm.</span>
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Phiên bản</span>
                <input class="admin-input" value="@_versionLabel" readonly />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Lần ban hành</span>
                <input class="admin-input" type="number" min="1" @bind="_issueNumber" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Ngày dự kiến ban hành</span>
                <input class="admin-input" type="date" @bind="_issueDate" />
            </label>
            <label class="admin-form-field admin-form-field-full">
                <span class="admin-form-field-label">Mô tả quản trị</span>
                <textarea class="admin-textarea" rows="2" @bind="_description"></textarea>
            </label>
            <label class="admin-form-field admin-form-field-full">
                <span class="admin-form-field-label">Tóm tắt phiên bản / lý do xây dựng</span>
                <textarea class="admin-textarea" rows="3" @bind="_summary"></textarea>
            </label>
        </div>
    </article>

    <ProcedureAuthoringGuidePanel />

    <article class="admin-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Người viết quy trình</h2>
                <p class="admin-form-field-hint">Có thể gán nhiều người viết. Người viết 1 luôn là người đang soạn/cập nhật. Mỗi người được phân công phải tự ký bằng tài khoản của mình trước khi bản nháp được gửi kiểm tra.</p>
            </div>
            <button type="button" class="admin-btn admin-btn-ghost" @onclick="AddWriterAssignment">Thêm người viết</button>
        </header>
        <div class="admin-step-rows">
            @for (var writerIndex = 0; writerIndex < _writerAssignments.Count; writerIndex++)
            {
                var writer = _writerAssignments[writerIndex];
                <article class="admin-step-row" @key="writer">
                    <div class="admin-step-row-bullet">@(writerIndex + 1)</div>
                    <div class="procedure-flow-step-fields">
                        <label class="admin-form-field">
                            <span class="admin-form-field-label is-required">Người viết @(writerIndex + 1)</span>
                            @if (IsPrimaryWriterSlotLocked(writerIndex))
                            {
                                <input class="admin-input" value="@WriterDisplayName(writer.UserId)" readonly />
                            }
                            else
                            {
                                var takenIds = _writerAssignments
                                    .Where(w => w != writer && !string.IsNullOrEmpty(w.UserId))
                                    .Select(w => w.UserId)
                                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
                                <select class="admin-select" @bind="writer.UserId">
                                    <option value="">Chọn người viết</option>
                                    @foreach (var user in ActiveUsers.Where(u => !takenIds.Contains(u.UserId.ToString())))
                                    {
                                        <option value="@user.UserId">@user.FullName (@user.Username)</option>
                                    }
                                </select>
                            }
                        </label>
                    </div>
                    <button type="button" class="admin-icon-btn is-danger" title="Xóa người viết" @onclick="() => RemoveWriterAssignment(writer)" disabled="@(_writerAssignments.Count <= 1)">×</button>
                </article>
            }
        </div>
    </article>

    <article class="admin-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Tệp gắn kèm</h2>
                <p class="admin-form-field-hint">Upload trước khi soạn lưu đồ. Cần ít nhất một PDF nguồn; biểu mẫu/hướng dẫn có thể gắn vào từng bước.</p>
            </div>
            <InputFile OnChange="OnFilesSelectedAsync" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
        </header>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead><tr><th>Tệp</th><th>Loại</th><th>Dung lượng</th><th></th></tr></thead>
                <tbody>
                    @foreach (var attachment in _existingAttachments)
                    {
                        <tr @key="attachment.ClientId">
                            <td>@attachment.Attachment.FileName <span class="admin-table-cell-muted">(từ @SourceVersionLabel)</span></td>
                            <td>@AttachmentTypeName(attachment.Attachment.AttachmentType)</td>
                            <td>@FormatBytes(attachment.Attachment.FileSizeBytes ?? 0)</td>
                            <td></td>
                        </tr>
                    }
                    @if (_attachments.Count == 0 && _existingAttachments.Count == 0)
                    {
                        <tr><td colspan="4">Chưa chọn tệp. Cần ít nhất một PDF nguồn trước khi gửi kiểm tra.</td></tr>
                    }
                    @foreach (var attachment in _attachments)
                    {
                        <tr @key="attachment.ClientId">
                            <td>@attachment.FileName</td>
                            <td>
                                <select class="admin-select" @bind="attachment.AttachmentType">
                                    @foreach (var type in Sql.MedLookups.AttachmentTypes)
                                    {
                                        <option value="@type.Code">@type.Name</option>
                                    }
                                </select>
                            </td>
                            <td>@FormatBytes(attachment.Size)</td>
                            <td><button type="button" class="admin-icon-btn is-danger" title="Xóa tệp" @onclick="() => _attachments.Remove(attachment)">×</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <ProcedureGovernanceEditor Recipients="_recipients" Revisions="_revisions" />
    <ProcedureDocumentSectionsEditor Sections="_sections" />
    <ProcedureFlowEditor Steps="_steps" Roles="ActiveRoles" Departments="ActiveDepartments" AvailableAttachments="AvailableAttachments" />

    <article class="admin-panel procedure-signoff-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Chữ ký nội bộ trực tiếp</h2>
                <p class="admin-form-field-hint">Người dùng ký bằng tay trong khung vẽ; hệ thống lưu ảnh chữ ký, tài khoản, thời điểm và hash nội dung tại lúc ký. Nếu có nhiều người viết, mỗi người viết cần ký riêng bằng chính tài khoản của mình.</p>
            </div>
        </header>
        <div class="admin-table-wrapper">
            <table class="admin-table procedure-signoff-table">
                <thead><tr><th>Vai trò</th><th>Trạng thái</th><th>Nơi thực hiện</th><th>Hành động</th></tr></thead>
                <tbody>
                    <tr>
                        <td><strong>Người viết (@RequiredWriterCount)</strong></td>
                        <td><AdminBadge Tone="tone-warning">Ký đủ trước khi gửi kiểm tra</AdminBadge></td>
                        <td>
                            Người viết đầu tiên ký tại đây khi lưu.
                            @if (RequiredWriterCount > 1)
                            {
                                <span class="admin-table-cell-muted"> Người viết còn lại mở <strong>Quy trình kỹ thuật → Chi tiết → Soạn thảo &amp; ký</strong> để chỉnh sửa và ký trên bản nháp.</span>
                            }
                        </td>
                        <td>
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-primary" disabled="@_isSaving" @onclick="OpenWriterSignature">
                                Ký người viết hiện tại
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Người kiểm tra</strong></td>
                        <td><AdminBadge Tone="tone-muted">Sau khi gửi kiểm tra</AdminBadge></td>
                        <td>Trang Phê duyệt hoặc chi tiết phiên bản chờ duyệt</td>
                        <td><span class="admin-table-cell-muted">Ký khi phiên bản ở trạng thái chờ duyệt</span></td>
                    </tr>
                    <tr>
                        <td><strong>Người phê duyệt</strong></td>
                        <td><AdminBadge Tone="tone-muted">Ký khi ban hành</AdminBadge></td>
                        <td>Trang Phê duyệt, ngay trước khi xuất bản phiên bản</td>
                        <td><span class="admin-table-cell-muted">Chỉ mở sau khi có chữ ký kiểm tra hợp lệ</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>

    <aside class="admin-callout">
        <strong>@(IsUpdateMode ? "Nguyên tắc phiên bản:" : "Chuỗi xác nhận nội bộ:")</strong>
        @(IsUpdateMode
            ? $"{SourceVersionLabel} không bị ghi đè. Hệ thống tạo {_versionLabel} độc lập; chữ ký cũ không được sao chép và phiên bản đang hiệu lực chỉ chuyển thành đã thay thế sau khi bản mới được ban hành."
            : "Mỗi người viết được phân công ký trên hash hiện tại. Chỉ khi đủ chữ ký người viết thì bản nháp mới được gửi kiểm tra; sau đó người kiểm tra và người phê duyệt tiếp tục ký. Mọi chỉnh sửa nội dung làm chữ ký cũ hết hiệu lực.")
    </aside>

    </fieldset>

    @if (IsReviewMode)
    {
        <div class="procedure-authoring-actions procedure-authoring-actions-review">
            @if (CanSignReviewDraft)
            {
                <button type="button" class="admin-btn admin-btn-primary" disabled="@_isSaving" @onclick="OpenWriterSignature">
                    Ký người viết sau khi rà soát
                </button>
            }
            else if (CanRevokeWriterSignature)
            {
                <button type="button" class="admin-btn admin-btn-ghost is-danger" disabled="@_isSaving" @onclick="OpenRevokeWriterSignature">
                    Hủy chữ ký người viết
                </button>
            }
            else if (CanSubmitReviewDraft)
            {
                <button type="button" class="admin-btn admin-btn-primary" disabled="@_isSaving" @onclick="SubmitReviewDraftAsync">
                    Gửi duyệt
                </button>
            }
            else if (CanReturnToDraftFromPending)
            {
                <button type="button" class="admin-btn admin-btn-ghost is-danger" disabled="@_isSaving" @onclick="OpenReturnToDraftModal">
                    Rút lại gửi duyệt
                </button>
            }
            else if (ReviewDraftSubmitted)
            {
                <a class="admin-btn admin-btn-primary" href="/qlcm/quy-trinh/phe-duyet">Mở Phê duyệt quy trình</a>
            }
            else
            {
                <span class="admin-table-cell-muted">Tài khoản hiện tại không còn hành động ký trên bản nháp này.</span>
            }
        </div>
    }
    else
    {
    <div class="procedure-authoring-actions">
        <button type="button" class="admin-btn admin-btn-ghost" disabled="@_isSaving" @onclick="SaveDraftAsync">@(IsEditDraftMode ? $"Lưu bản nháp {_versionLabel}" : IsUpdateMode ? $"Cập nhật thành {_versionLabel}" : "Tạo bản v01")</button>
        <button type="button" class="admin-btn admin-btn-primary" disabled="@_isSaving" @onclick="OpenWriterSignature">@(IsEditDraftMode ? $"Lưu {_versionLabel}, ký người viết" : IsUpdateMode ? $"Cập nhật {_versionLabel}, ký người viết" : "Tạo v01, ký người viết")</button>
    </div>
    }
</section>

<ProcedureSignatureModal IsOpen="_writerSignOpen"
                         IsOpenChanged="v => _writerSignOpen = v"
                         CanvasId="procedure-author-signature-pad"
                         RoleLabel="Người viết"
                         DocumentLabel="@($"{_code} - {_name} - {_versionLabel}")"
                         SignerName="@(UserContext.CurrentUser?.FullName ?? UserContext.CurrentUser?.Username ?? string.Empty)"
                         SignerUsername="@(UserContext.CurrentUser?.Username ?? string.Empty)"
                         ConfirmText="Ký người viết"
                         SignatureConfirmed="SaveSignedVersionAsync" />

<AdminModal IsOpen="_revokeWriterOpen" IsOpenChanged="v => _revokeWriterOpen = v" Title="Hủy chữ ký người viết">
    <ChildContent>
        <p style="margin:0 0 0.75rem;">Chữ ký của bạn trên phiên bản <strong>@_versionLabel</strong> sẽ bị thu hồi. Bạn có thể ký lại sau khi rà soát.</p>
        <label class="admin-form-field-label" for="revoke-writer-reason-tao">Lý do hủy (tùy chọn)</label>
        <textarea id="revoke-writer-reason-tao" class="admin-textarea" rows="2" placeholder="VD: Cần chỉnh sửa lại phần bước quy trình." @bind="_revokeWriterReason"></textarea>
    </ChildContent>
    <FooterContent>
        <button type="button" class="admin-btn admin-btn-ghost" @onclick="() => _revokeWriterOpen = false">Hủy bỏ</button>
        <button type="button" class="admin-btn admin-btn-danger" disabled="@_isSaving" @onclick="ConfirmRevokeWriterSignatureAsync">Xác nhận hủy chữ ký</button>
    </FooterContent>
</AdminModal>

<AdminModal IsOpen="_returnToDraftOpen" IsOpenChanged="v => _returnToDraftOpen = v" Title="Rút lại gửi duyệt — Hoàn về soạn thảo">
    <ChildContent>
        <p style="margin:0 0 0.75rem;">Phiên bản <strong>@_versionLabel</strong> sẽ được chuyển về <strong>bản nháp</strong>. Tất cả chữ ký hiện tại sẽ không còn hiệu lực; các người viết cần ký lại sau khi chỉnh sửa.</p>
        <label class="admin-form-field-label" for="return-draft-reason-tao">Lý do rút lại (bắt buộc)</label>
        <textarea id="return-draft-reason-tao" class="admin-textarea" rows="3" placeholder="VD: Cần bổ sung thêm bước kiểm soát nhiễm khuẩn." @bind="_returnToDraftReason"></textarea>
    </ChildContent>
    <FooterContent>
        <button type="button" class="admin-btn admin-btn-ghost" @onclick="() => _returnToDraftOpen = false">Hủy bỏ</button>
        <button type="button" class="admin-btn admin-btn-danger" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_returnToDraftReason))" @onclick="ConfirmReturnToDraftAsync">Hoàn về soạn thảo</button>
    </FooterContent>
</AdminModal>

@code {
    [Parameter] public Guid? ProcedureId { get; set; }
    [Parameter] public Guid? VersionId { get; set; }

    private string _code = string.Empty;
    private string _name = string.Empty;
    private string _procedureType = "technical";
    private string _departmentId = string.Empty;
    private string _versionLabel = "v01";
    private int _issueNumber = 1;
    private DateTime? _issueDate = DateTime.Today;
    private string _description = string.Empty;
    private string _summary = string.Empty;
    private bool _isSaving;
    private bool _writerSignOpen;
    private bool _revokeWriterOpen;
    private string _revokeWriterReason = string.Empty;
    private bool _returnToDraftOpen;
    private string _returnToDraftReason = string.Empty;
    private Sql.ProcedureVersion? _sourceVersion;
    private Sql.ProcedureVersion? _reviewVersion;
    private Sql.ProcedureVersion? _editDraftVersion;

    private readonly List<ProcedureSectionDraft> _sections = CreateSections();
    private readonly List<ProcedureFlowStepDraft> _steps =
    [
        new() { Code = "BUOC-01", Name = "Bắt đầu", ShapeCode = "terminator", DetailSectionNumber = "VIII" },
        new() { Code = "BUOC-02", Name = "Thực hiện", ShapeCode = "process", DetailSectionNumber = "VIII" },
        new() { Code = "BUOC-03", Name = "Kết thúc và lưu hồ sơ", ShapeCode = "terminator", DetailSectionNumber = "X" }
    ];
    private readonly List<ProcedureRecipientDraft> _recipients = [new()];
    private readonly List<ProcedureRevisionDraft> _revisions = [new() { Summary = "Ban hành lần đầu" }];
    private readonly List<PendingAttachment> _attachments = [];
    private readonly List<ExistingAttachmentEntry> _existingAttachments = [];
    private readonly List<ProcedureWriterAssignmentDraft> _writerAssignments = [new()];

    private IReadOnlyList<ProcedureAuthoringAttachmentOption> AvailableAttachments =>
        _existingAttachments
            .Select(item => new ProcedureAuthoringAttachmentOption(item.ClientId, item.Attachment.FileName, item.Attachment.AttachmentType))
            .Concat(_attachments.Select(item => new ProcedureAuthoringAttachmentOption(item.ClientId, item.FileName, item.AttachmentType)))
            .ToList();

    private IReadOnlyList<Sql.Role> ActiveRoles => Store.Roles.Where(item => item.Status == "active").OrderBy(item => item.Code).ToList();
    private IReadOnlyList<Sql.Department> ActiveDepartments => AdminBusinessDisplay.ActiveDepartmentsForSelection(Store.Departments);
    private IReadOnlyList<Sql.AppUser> ActiveUsers => Store.Users.Where(item => item.Status == "active").OrderBy(item => item.FullName).ToList();
    private bool IsUpdateMode => ProcedureId.HasValue && _sourceVersion is not null && !IsReviewMode && !IsEditDraftMode;
    private bool IsReviewMode => _reviewVersion is not null;
    private bool IsEditDraftMode => _editDraftVersion is not null;
    private bool IsEditDraftRoute => Navigation.Uri.Contains("/chinh-sua", StringComparison.OrdinalIgnoreCase);
    private string ActionVerb => IsEditDraftMode ? "cập nhật bản nháp" : IsReviewMode ? "ký phiên bản nháp" : IsUpdateMode ? "cập nhật quy trình" : "tạo quy trình";
    private string SourceVersionLabel => _sourceVersion?.VersionLabel ?? (_sourceVersion is null ? "phiên bản trước" : ProcedureAuthoringService.FormatVersionLabel(_sourceVersion.VersionNo));
    private bool CanSignReviewDraft => IsReviewMode
        && _reviewVersion?.StatusCode == "draft"
        && UserContext.CurrentUser is { UserId: var userId }
        && Signoffs.CanUserSign(_reviewVersion.ProcedureVersionId, "writer", userId, out _);
    private bool CanSubmitReviewDraft => IsReviewMode
        && _reviewVersion?.StatusCode == "draft"
        && Signoffs.GetOutstandingWriterSignatures(_reviewVersion.ProcedureVersionId) == 0;
    private bool ReviewDraftSubmitted => IsReviewMode && _reviewVersion?.StatusCode == "pending_approval";

    // Người viết đã ký và có thể hủy chữ ký của mình (trên bản nháp)
    private bool CanRevokeWriterSignature => IsReviewMode
        && _reviewVersion?.StatusCode == "draft"
        && UserContext.CurrentUser is { UserId: var revUid }
        && Signoffs.GetActiveWriterSignoff(_reviewVersion.ProcedureVersionId, revUid) is not null;

    // Người viết có thể rút lại gửi duyệt (pending_approval, checker chưa ký)
    private bool CanReturnToDraftFromPending => IsReviewMode
        && _reviewVersion?.StatusCode == "pending_approval"
        && UserContext.CurrentUser is { UserId: var retUid }
        && !Signoffs.HasCurrentSignoff(_reviewVersion.ProcedureVersionId, "checker")
        && Signoffs.GetCurrentSignerUserId(_reviewVersion.ProcedureVersionId, "writer") == retUid;
    private int RequiredWriterCount => _writerAssignments
        .Select(item => ParseGuid(item.UserId))
        .Where(item => item.HasValue)
        .Select(item => item!.Value)
        .Distinct()
        .Count();

    protected override void OnInitialized()
    {
        if (ProcedureId.HasValue && VersionId.HasValue)
        {
            if (IsEditDraftRoute)
            {
                LoadEditDraftVersion();
                return;
            }

            LoadReviewVersion();
            return;
        }

        EnsureCurrentUserWriterAssignment();
        if (ProcedureId.HasValue) LoadSourceVersion();
    }

    private bool IsPrimaryWriterSlotLocked(int writerIndex) => writerIndex == 0;

    private string WriterDisplayName(string? userId)
    {
        if (string.IsNullOrWhiteSpace(userId))
            return UserContext.CurrentUser is { } current
                ? $"{current.FullName} ({current.Username})"
                : "—";

        var user = ActiveUsers.FirstOrDefault(item => item.UserId.ToString() == userId);
        return user is null ? userId : $"{user.FullName} ({user.Username})";
    }

    private void EnsurePrimaryWriterIsCurrentUser()
    {
        if (IsEditDraftMode)
            return;

        if (_writerAssignments.Count == 0)
            _writerAssignments.Add(new ProcedureWriterAssignmentDraft());

        var currentUserId = UserContext.CurrentUser?.UserId.ToString();
        if (!string.IsNullOrWhiteSpace(currentUserId))
            _writerAssignments[0].UserId = currentUserId;
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        foreach (var file in args.GetMultipleFiles(10))
        {
            await using var stream = file.OpenReadStream(ProcedureAttachmentStorageService.MaxFileSizeBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var content = buffer.ToArray();
            if (content.Length == 0 || content.Length > ProcedureAttachmentStorageService.MaxFileSizeBytes)
            {
                Toasts.Show("Tệp không hợp lệ", "Mỗi tệp phải có dung lượng từ 1 byte đến 50 MB.", ToastVariant.Warning);
                continue;
            }

            var isFirstPdf = !_attachments.Any(item => item.AttachmentType == "source_pdf") &&
                             !_existingAttachments.Any(item => item.Attachment.AttachmentType == "source_pdf") &&
                             file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
            _attachments.Add(new PendingAttachment(
                Guid.NewGuid(),
                file.Name,
                string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                content,
                isFirstPdf ? "source_pdf" : "other"));
        }
    }

    private Task SaveDraftAsync() => SaveAsync(submit: false);

    private void OpenWriterSignature()
    {
        if (IsReviewMode)
        {
            if (UserContext.CurrentUser is null)
            {
                Toasts.Show("Phiên đăng nhập không hợp lệ", "Vui lòng đăng nhập lại trước khi ký.", ToastVariant.Error);
                return;
            }

            if (!CanSignReviewDraft)
            {
                Toasts.Show("Không thể ký", "Tài khoản hiện tại không còn được phép ký trên bản nháp này.", ToastVariant.Warning);
                return;
            }

            _writerSignOpen = true;
            return;
        }

        var permission = IsEditDraftMode || IsUpdateMode ? "SCR_PROCEDURES:UPDATE" : "SCR_PROCEDURES:CREATE";
        if (!Guard.CanDo(permission, IsEditDraftMode ? "chỉnh sửa bản nháp" : IsUpdateMode ? "cập nhật quy trình" : "tạo quy trình")) return;
        var validationMessage = Validate(submit: true);
        if (validationMessage is not null)
        {
            Toasts.Show("Chưa thể ký quy trình", validationMessage, ToastVariant.Warning);
            return;
        }
        if (UserContext.CurrentUser is null)
        {
            Toasts.Show("Phiên đăng nhập không hợp lệ", "Vui lòng đăng nhập lại trước khi ký.", ToastVariant.Error);
            return;
        }
        _writerSignOpen = true;
    }

    private Task SaveSignedVersionAsync(string signatureImageDataUrl)
        => IsReviewMode || IsEditDraftMode
            ? SignDraftAfterSaveAsync(signatureImageDataUrl)
            : SaveAsync(submit: true, signatureImageDataUrl);

    private async Task SignDraftAfterSaveAsync(string signatureImageDataUrl)
    {
        if (IsEditDraftMode)
        {
            await SaveAsync(
                submit: false,
                navigateOnSuccess: false,
                persistDraftSnapshot: false,
                signWriterAfterSave: true,
                signatureImageDataUrl: signatureImageDataUrl);
            return;
        }

        if (IsReviewMode)
            await SignReviewDraftAsync(signatureImageDataUrl);
    }

    private Task SignReviewDraftAsync(string signatureImageDataUrl)
    {
        if (_reviewVersion is null || UserContext.CurrentUser is not { UserId: var userId })
            return Task.CompletedTask;

        _isSaving = true;
        Sql.ProcedureSignoffRecord? signoff = null;
        try
        {
            Store.Refresh();
            Store.RunProcedureWriteBatch(() =>
            {
                signoff = Signoffs.Sign(
                    _reviewVersion.ProcedureVersionId,
                    "writer",
                    userId,
                    UserContext.CurrentUser.Username,
                    UserContext.CurrentUser.FullName ?? UserContext.CurrentUser.Username,
                    signatureImageDataUrl,
                    "Chữ ký tay trực tiếp sau khi rà soát toàn bộ quy trình");
                Snapshots.PersistSnapshot(_reviewVersion.ProcedureVersionId, "draft_signed", userId);
            });
            if (signoff is not null)
                Signoffs.RecordSignoffAudit(_reviewVersion.ProcedureVersionId, signoff);

            var outstandingWriters = Signoffs.GetOutstandingWriterSignatures(_reviewVersion.ProcedureVersionId);
            if (outstandingWriters == 0)
            {
                Lifecycle.Submit(_reviewVersion.ProcedureVersionId, userId);
                _reviewVersion = Store.ProcedureVersions.First(item => item.ProcedureVersionId == _reviewVersion.ProcedureVersionId);
                Toasts.Show("Đã ký và gửi kiểm tra", _reviewVersion.Title, ToastVariant.Success);
                Navigation.NavigateTo("/qlcm/quy-trinh/phe-duyet");
            }
            else
            {
                Toasts.Show("Đã ký người viết", $"Còn thiếu {outstandingWriters} chữ ký người viết.", ToastVariant.Info);
                Navigation.NavigateTo("/qlcm/quy-trinh");
            }
        }
        catch (Exception exception)
        {
            Toasts.Show("Không thể ký", exception.Message, ToastVariant.Error);
        }
        finally
        {
            _isSaving = false;
        }

        return Task.CompletedTask;
    }

    private void OpenRevokeWriterSignature()
