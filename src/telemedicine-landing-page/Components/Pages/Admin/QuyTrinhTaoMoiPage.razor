            Store.Refresh();
            _reviewVersion = Store.ProcedureVersions.First(v => v.ProcedureVersionId == _reviewVersion.ProcedureVersionId);
            Toasts.Show("Đã hủy chữ ký người viết", "Bạn có thể chỉnh sửa và ký lại khi cần.", ToastVariant.Info);
