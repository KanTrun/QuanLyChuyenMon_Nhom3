@page "/admin/quy-trinh/tao"
@page "/qlcm/quy-trinh/tao"
@layout AdminLayout
@using Sql = TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@inject ICurrentUserContext UserContext
@inject IToastService Toasts
@inject AdminActionGuard Guard
@inject NavigationManager Navigation

<PageTitle>Tạo quy trình mới | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Quy trình</span>
            <h1 class="admin-page-title">Tạo quy trình kỹ thuật mới</h1>
            <p class="admin-page-subtitle">Khai báo quy trình, phiên bản, bước thực hiện, định mức nguồn lực, ánh xạ màn hình và tệp đính kèm.</p>
        </div>
        <a class="admin-btn admin-btn-ghost" href="/qlcm/quy-trinh">Hủy và quay lại</a>
    </header>

    <article class="admin-panel">
        <h2 class="admin-panel-title">Thông tin chung</h2>
        <div class="admin-form-grid">
            <div class="admin-form-field">
                <label class="admin-form-field-label is-required">Mã quy trình</label>
                <input class="admin-input" @bind="_code" placeholder="VD: QT-XN-CTM-02" />
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label is-required">Tên quy trình</label>
                <input class="admin-input" @bind="_name" placeholder="VD: Quy trình xét nghiệm công thức máu" />
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label is-required">Loại quy trình</label>
                <select class="admin-select" @bind="_procedureType">
                    @foreach (var type in Sql.MedLookups.ProcedureTypes)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Khoa chủ quản</label>
                <select class="admin-select" @bind="_departmentId">
                    <option value="">Không chọn</option>
                    @foreach (var dept in Store.Departments.Where(d => d.Status == "active").OrderBy(d => d.Code))
                    {
                        <option value="@dept.DepartmentId">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label is-required">Nhãn phiên bản</label>
                <input class="admin-input" @bind="_versionLabel" />
            </div>
            <div class="admin-form-field admin-form-field-full">
                <label class="admin-form-field-label">Mô tả quy trình</label>
                <textarea class="admin-textarea" rows="3" @bind="_description"></textarea>
            </div>
            <div class="admin-form-field admin-form-field-full">
                <label class="admin-form-field-label">Tóm tắt phiên bản</label>
                <textarea class="admin-textarea" rows="3" @bind="_summary"></textarea>
            </div>
        </div>
    </article>

    <article class="admin-panel">
        <header class="admin-panel-head">
            <h2 class="admin-panel-title">Các bước thực hiện</h2>
            <button type="button" class="admin-btn admin-btn-ghost" @onclick="AddStep">Thêm bước</button>
        </header>
        <div class="admin-step-rows">
            @for (var i = 0; i < _steps.Count; i++)
            {
                var index = i;
                var step = _steps[index];
                <div class="admin-step-row">
                    <div class="admin-step-row-bullet">B@(index + 1)</div>
                    <input class="admin-input" placeholder="Mã bước" value="@step.Code" @oninput="e => UpdateStep(index, code: e.Value?.ToString())" />
                    <input class="admin-input" placeholder="Tên bước" value="@step.Name" @oninput="e => UpdateStep(index, name: e.Value?.ToString())" />
                    <select class="admin-select" value="@step.RoleId" @onchange="e => UpdateStep(index, roleId: e.Value?.ToString())">
                        <option value="">Không chọn vai trò</option>
                        @foreach (var role in Store.Roles.Where(r => r.Status == "active").OrderBy(r => r.Code))
                        {
                            <option value="@role.RoleId">@role.Name</option>
                        }
                    </select>
                    <input class="admin-input" type="number" min="0" value="@step.Minutes" @oninput="e => UpdateStep(index, minutes: ParseInt(e.Value?.ToString()))" />
                    <button type="button" class="admin-icon-btn is-danger" @onclick="() => RemoveStep(index)">×</button>
                </div>
                <textarea class="admin-textarea" rows="2" placeholder="Mô tả / điều kiện chuyển bước JSON hoặc ghi chú" value="@step.Description" @oninput="e => UpdateStep(index, description: e.Value?.ToString())"></textarea>
            }
        </div>
    </article>

    <article class="admin-panel">
        <h2 class="admin-panel-title">Định mức nguồn lực theo phiên bản</h2>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead><tr><th>Tài nguyên</th><th>Số lượng</th><th>Đơn vị</th><th>Bắt buộc</th><th>Ghi chú</th><th></th></tr></thead>
                <tbody>
                    @foreach (var norm in _resourceNorms)
                    {
                        <tr>
                            <td>@GetResourceName(norm.ResourceId)</td>
                            <td>@norm.Quantity.ToString("0.##")</td>
                            <td>@LookupUnit(norm.UnitCode)</td>
                            <td>@(norm.IsRequired ? "Có" : "Không")</td>
                            <td>@norm.Note</td>
                            <td style="text-align:right;"><button type="button" class="admin-icon-btn is-danger" @onclick="() => _resourceNorms.Remove(norm)">×</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="admin-form-grid" style="margin-top:14px;">
            <div class="admin-form-field">
                <label class="admin-form-field-label">Tài nguyên</label>
                <select class="admin-select" @bind="_normResourceId" @bind:after="SyncNormUnit">
                    <option value="">Chọn tài nguyên</option>
                    @foreach (var resource in Store.ResourceCatalog.Where(r => r.Status == "active").OrderBy(r => r.ResourceCode))
                    {
                        <option value="@resource.ResourceId">@resource.ResourceCode - @resource.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Số lượng</label>
                <input class="admin-input" type="number" min="0" step="0.01" @bind="_normQuantity" />
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Đơn vị</label>
                <select class="admin-select" @bind="_normUnit">
                    @foreach (var unit in Sql.MedLookups.UnitCatalog)
                    {
                        <option value="@unit.Code">@unit.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Bắt buộc</label>
                <label class="admin-check-row"><input type="checkbox" @bind="_normRequired" /> Có</label>
            </div>
            <div class="admin-form-field admin-form-field-full">
                <label class="admin-form-field-label">Ghi chú</label>
                <input class="admin-input" @bind="_normNote" />
            </div>
        </div>
        <div style="display:flex;justify-content:flex-end;margin-top:10px;">
            <button type="button" class="admin-btn admin-btn-ghost" @onclick="AddResourceNorm">Thêm định mức</button>
        </div>
    </article>

    <article class="admin-panel">
        <h2 class="admin-panel-title">Ánh xạ màn hình</h2>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead><tr><th>Màn hình</th><th>Tính năng</th><th>Hành động</th><th>Kiểm soát</th><th></th></tr></thead>
                <tbody>
                    @foreach (var mapping in _screenMappings)
                    {
                        <tr>
                            <td>@GetScreenName(mapping.ScreenId)</td>
                            <td>@GetFeatureName(mapping.FeatureId)</td>
                            <td>@AdminBusinessDisplay.Action(mapping.ActionCode)</td>
                            <td>@Lookup(Sql.MedLookups.EnforcementModes, mapping.EnforcementMode)</td>
                            <td style="text-align:right;"><button type="button" class="admin-icon-btn is-danger" @onclick="() => _screenMappings.Remove(mapping)">×</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="admin-form-grid" style="margin-top:14px;">
            <div class="admin-form-field">
                <label class="admin-form-field-label">Màn hình</label>
                <select class="admin-select" @bind="_mappingScreenId">
                    <option value="">Chọn màn hình</option>
                    @foreach (var screen in Store.Screens.Where(s => s.Status == "active").OrderBy(s => s.ScreenCode))
                    {
                        <option value="@screen.ScreenId">@screen.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Tính năng</label>
                <select class="admin-select" @bind="_mappingFeatureId">
                    <option value="">Không chọn</option>
                    @foreach (var feature in Store.Features.Where(f => f.Status == "active").OrderBy(f => f.FeatureCode))
                    {
                        <option value="@feature.FeatureId">@feature.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Hành động</label>
                <select class="admin-select" @bind="_mappingAction">
                    <option value="">Không chọn</option>
                    @foreach (var action in Sql.MedLookups.ActionCodes)
                    {
                        <option value="@action.Code">@action.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Kiểm soát</label>
                <select class="admin-select" @bind="_mappingEnforcement">
                    @foreach (var mode in Sql.MedLookups.EnforcementModes)
                    {
                        <option value="@mode.Code">@mode.Name</option>
                    }
                </select>
            </div>
            <div class="admin-form-field admin-form-field-full">
                <label class="admin-form-field-label">Ghi chú kiểm soát</label>
                <div class="admin-form-field-hint">Hệ thống tự lưu quy tắc theo màn hình, tác vụ và chế độ kiểm soát đã chọn. Chi tiết kỹ thuật không nhập ở đây.</div>
            </div>
        </div>
        <div style="display:flex;justify-content:flex-end;margin-top:10px;">
            <button type="button" class="admin-btn admin-btn-ghost" @onclick="AddScreenMapping">Thêm ánh xạ</button>
        </div>
    </article>

    <article class="admin-panel">
        <h2 class="admin-panel-title">Tệp đính kèm</h2>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead><tr><th>Tên file</th><th>Loại</th><th>URI</th><th></th></tr></thead>
                <tbody>
                    @foreach (var file in _attachments)
                    {
                        <tr>
                            <td>@file.FileName</td>
                            <td>@Lookup(Sql.MedLookups.AttachmentTypes, file.AttachmentType)</td>
                            <td>@file.FileUri</td>
                            <td style="text-align:right;"><button type="button" class="admin-icon-btn is-danger" @onclick="() => _attachments.Remove(file)">×</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="admin-form-grid" style="margin-top:14px;">
            <div class="admin-form-field">
                <label class="admin-form-field-label">Tên file</label>
                <input class="admin-input" @bind="_attachmentName" />
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">URI</label>
                <input class="admin-input" @bind="_attachmentUri" placeholder="/files/sop.pdf" />
            </div>
            <div class="admin-form-field">
                <label class="admin-form-field-label">Loại</label>
                <select class="admin-select" @bind="_attachmentType">
                    @foreach (var type in Sql.MedLookups.AttachmentTypes)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </div>
        </div>
        <div style="display:flex;justify-content:flex-end;margin-top:10px;">
            <button type="button" class="admin-btn admin-btn-ghost" @onclick="AddAttachment">Thêm tệp</button>
        </div>
    </article>

    <div style="display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="admin-btn admin-btn-ghost" @onclick="SaveDraft">Lưu bản nháp</button>
        <button type="button" class="admin-btn admin-btn-primary" @onclick="SavePendingApproval">Lưu và gửi phê duyệt</button>
    </div>
</section>

@code {
    private string _code = string.Empty;
    private string _name = string.Empty;
    private string _procedureType = "technical";
    private string _departmentId = string.Empty;
    private string _versionLabel = "v1.0";
    private string _description = string.Empty;
    private string _summary = string.Empty;

    private readonly List<StepDraft> _steps = new()
    {
        new("BUOC-01", "Chuẩn bị người bệnh", string.Empty, 5, "Kiểm tra hồ sơ và điều kiện thực hiện"),
        new("BUOC-02", "Thực hiện kỹ thuật", string.Empty, 15, "Thực hiện theo SOP")
    };

    private readonly List<ResourceNormDraft> _resourceNorms = new();
    private string _normResourceId = string.Empty;
    private decimal _normQuantity = 1;
    private string _normUnit = "piece";
    private bool _normRequired = true;
    private string _normNote = string.Empty;

    private readonly List<ScreenMappingDraft> _screenMappings = new();
    private string _mappingScreenId = string.Empty;
    private string _mappingFeatureId = string.Empty;
    private string _mappingAction = "execute";
    private string _mappingEnforcement = "warning";
    private string _mappingRuleJson = string.Empty;

    private readonly List<AttachmentDraft> _attachments = new();
    private string _attachmentName = string.Empty;
    private string _attachmentUri = string.Empty;
    private string _attachmentType = "sop";

    private void AddStep()
        => _steps.Add(new StepDraft($"BUOC-{_steps.Count + 1:00}", string.Empty, string.Empty, 5, string.Empty));

    private void RemoveStep(int index)
    {
        if (index >= 0 && index < _steps.Count) _steps.RemoveAt(index);
    }

    private void UpdateStep(int index, string? code = null, string? name = null, string? roleId = null, int? minutes = null, string? description = null)
    {
        if (index < 0 || index >= _steps.Count) return;
        var step = _steps[index];
        _steps[index] = step with
        {
            Code = code ?? step.Code,
            Name = name ?? step.Name,
            RoleId = roleId ?? step.RoleId,
            Minutes = minutes ?? step.Minutes,
            Description = description ?? step.Description
        };
    }

    private void AddResourceNorm()
    {
        if (!Guid.TryParse(_normResourceId, out var resourceId) || _normQuantity < 0)
        {
            Toasts.Show("Định mức chưa hợp lệ", "Chọn tài nguyên và nhập số lượng không âm.", ToastVariant.Warning);
            return;
        }
        _resourceNorms.Add(new ResourceNormDraft(resourceId, _normQuantity, _normUnit, _normRequired, _normNote));
        _normResourceId = string.Empty;
        _normQuantity = 1;
        _normUnit = "piece";
        _normRequired = true;
        _normNote = string.Empty;
    }

    private void AddScreenMapping()
    {
        if (!Guid.TryParse(_mappingScreenId, out var screenId))
        {
            Toasts.Show("Thiếu màn hình", "Vui lòng chọn màn hình cần ánh xạ.", ToastVariant.Warning);
            return;
        }
        _screenMappings.Add(new ScreenMappingDraft(
            screenId,
            ParseGuid(_mappingFeatureId),
            string.IsNullOrWhiteSpace(_mappingAction) ? null : _mappingAction,
            _mappingEnforcement,
            null));
        _mappingScreenId = string.Empty;
        _mappingFeatureId = string.Empty;
        _mappingAction = "execute";
        _mappingEnforcement = "warning";
        _mappingRuleJson = string.Empty;
    }

    private void AddAttachment()
    {
        if (string.IsNullOrWhiteSpace(_attachmentName) || string.IsNullOrWhiteSpace(_attachmentUri))
        {
            Toasts.Show("Thiếu tệp đính kèm", "Nhập tên file và URI.", ToastVariant.Warning);
            return;
        }
        _attachments.Add(new AttachmentDraft(_attachmentName.Trim(), _attachmentUri.Trim(), _attachmentType));
        _attachmentName = string.Empty;
        _attachmentUri = string.Empty;
        _attachmentType = "sop";
    }

    private void SaveDraft() => SaveProcedure("draft");
    private void SavePendingApproval() => SaveProcedure("pending_approval");

    private void SaveProcedure(string status)
    {
        if (!Guard.CanDo("SCR_PROCEDURES:CREATE", "tạo quy trình"))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))
        {
            Toasts.Show("Thiếu thông tin quy trình", "Vui lòng nhập mã và tên quy trình.", ToastVariant.Warning);
            return;
        }
        if (_steps.Count == 0 || _steps.Any(s => string.IsNullOrWhiteSpace(s.Name)))
        {
            Toasts.Show("Thiếu bước thực hiện", "Quy trình cần ít nhất một bước có tên rõ ràng.", ToastVariant.Warning);
            return;
        }

        try
        {
            var now = DateTime.UtcNow;
            var proc = new Sql.ProfessionalProcedure
            {
                ProcedureCode = _code.Trim(),
                Name = _name.Trim(),
                ProcedureType = _procedureType,
                OwnerDepartmentId = ParseGuid(_departmentId),
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                CreatedBy = UserContext.CurrentUser?.UserId
            };
            Store.AddProcedure(proc);

            var version = new Sql.ProcedureVersion
            {
                ProcedureId = proc.ProcedureId,
                VersionNo = 1,
                VersionLabel = _versionLabel.Trim(),
                StatusCode = status,
                DepartmentId = ParseGuid(_departmentId),
                Title = $"{proc.Name} - {_versionLabel.Trim()}",
                Summary = string.IsNullOrWhiteSpace(_summary) ? "Phiên bản khởi tạo" : _summary.Trim(),
                CreatedBy = UserContext.CurrentUser?.UserId,
                SubmittedBy = status == "pending_approval" ? UserContext.CurrentUser?.UserId : null,
                SubmittedAt = status == "pending_approval" ? now : null,
                EffectiveFrom = now
            };
            Store.AddProcedureVersion(version);

            for (var i = 0; i < _steps.Count; i++)
            {
                var step = _steps[i];
                Store.AddProcedureStep(new Sql.ProcedureStep
                {
                    ProcedureVersionId = version.ProcedureVersionId,
                    StepNo = i + 1,
                    StepCode = string.IsNullOrWhiteSpace(step.Code) ? $"BUOC-{i + 1:00}" : step.Code.Trim(),
                    Name = step.Name.Trim(),
                    Description = string.IsNullOrWhiteSpace(step.Description) ? null : step.Description.Trim(),
                    ActorRoleId = ParseGuid(step.RoleId),
                    StandardDurationMinutes = step.Minutes
                });
            }

            foreach (var norm in _resourceNorms)
            {
                Store.AddProcedureVersionResourceNorm(new Sql.ProcedureVersionResourceNorm
                {
                    ProcedureVersionId = version.ProcedureVersionId,
                    ResourceId = norm.ResourceId,
                    StandardQuantity = norm.Quantity,
                    UnitCode = norm.UnitCode,
                    IsRequired = norm.IsRequired,
                    Note = string.IsNullOrWhiteSpace(norm.Note) ? null : norm.Note.Trim()
                });
            }

            foreach (var mapping in _screenMappings)
            {
                Store.AddProcedureScreenMapping(new Sql.ProcedureScreenMapping
                {
                    ProcedureVersionId = version.ProcedureVersionId,
                    ScreenId = mapping.ScreenId,
                    FeatureId = mapping.FeatureId,
                    ActionCode = mapping.ActionCode,
                    EnforcementMode = mapping.EnforcementMode,
                    RuleJson = mapping.RuleJson
                });
            }

            foreach (var attachment in _attachments)
            {
                Store.AddProcedureAttachment(new Sql.ProcedureAttachment
                {
                    ProcedureVersionId = version.ProcedureVersionId,
                    AttachmentType = attachment.AttachmentType,
                    FileName = attachment.FileName,
                    FileUri = attachment.FileUri,
                    UploadedBy = UserContext.CurrentUser?.UserId
                });
            }

            Toasts.Show(status == "pending_approval" ? "Đã gửi phê duyệt" : "Đã lưu bản nháp", proc.Name, ToastVariant.Success);
            Navigation.NavigateTo("/qlcm/quy-trinh");
        }
        catch (Exception ex)
        {
            Toasts.Show("Không thể lưu quy trình", ex.Message, ToastVariant.Error);
        }
    }

    private void SyncNormUnit()
    {
        if (Guid.TryParse(_normResourceId, out var resourceId))
        {
            _normUnit = Store.ResourceCatalog.FirstOrDefault(r => r.ResourceId == resourceId)?.DefaultUnitCode ?? "piece";
        }
    }

    private string GetResourceName(Guid id) => Store.ResourceCatalog.FirstOrDefault(r => r.ResourceId == id)?.Name ?? "—";
    private string GetScreenName(Guid id) => Store.Screens.FirstOrDefault(s => s.ScreenId == id)?.Name ?? "—";
    private string GetFeatureName(Guid? id) => id.HasValue ? Store.Features.FirstOrDefault(f => f.FeatureId == id.Value)?.Name ?? "—" : "—";
    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static int ParseInt(string? value) => int.TryParse(value, out var parsed) ? parsed : 0;
    private static string Lookup(IReadOnlyList<Sql.LookupEntry> entries, string? code) => entries.FirstOrDefault(e => e.Code == code)?.Name ?? code ?? "—";
    private static string LookupUnit(string? code) => Sql.MedLookups.UnitCatalog.FirstOrDefault(u => u.Code == code)?.Name ?? code ?? "—";

    private sealed record StepDraft(string Code, string Name, string RoleId, int Minutes, string Description);
    private sealed record ResourceNormDraft(Guid ResourceId, decimal Quantity, string UnitCode, bool IsRequired, string Note);
    private sealed record ScreenMappingDraft(Guid ScreenId, Guid? FeatureId, string? ActionCode, string EnforcementMode, string? RuleJson);
    private sealed record AttachmentDraft(string FileName, string FileUri, string AttachmentType);
}
