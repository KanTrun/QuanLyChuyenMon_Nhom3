@page "/admin/quy-trinh/tao"
@page "/qlcm/quy-trinh/tao"
@page "/qlcm/quy-trinh/{ProcedureId:guid}/cap-nhat"
@layout AdminLayout
@using Sql = TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@inject ICurrentUserContext UserContext
@inject IToastService Toasts
@inject AdminActionGuard Guard
@inject ProcedureLifecycleService Lifecycle
@inject ProcedureAuthoringService Authoring
@inject ProcedureSignoffService Signoffs
@inject IProcedureAttachmentStorageService AttachmentStorage
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment
@using System.Text.Json

<PageTitle>@(IsUpdateMode ? "Cập nhật quy trình y tế" : "Tạo quy trình y tế") | QLCM Pro</PageTitle>

<section class="admin-page procedure-authoring-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">@(IsUpdateMode ? $"Phiên bản nguồn {SourceVersionLabel}" : "Quy trình kỹ thuật")</span>
            <h1 class="admin-page-title">@(IsUpdateMode ? $"Cập nhật quy trình lên {_versionLabel}" : "Soạn quy trình y tế mới")</h1>
            <p class="admin-page-subtitle">@(IsUpdateMode
                ? $"Nội dung được sao chép từ {SourceVersionLabel}. Phiên bản cũ được giữ nguyên trong lịch sử."
                : "Tạo hồ sơ có cấu trúc, lưu đồ, kiểm soát sửa đổi, tệp nguồn và chuỗi ký nội bộ.")</p>
        </div>
        <a class="admin-btn admin-btn-ghost" href="/qlcm/quy-trinh">Hủy và quay lại</a>
    </header>

    <article class="admin-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Thông tin kiểm soát và ban hành</h2>
                <p class="admin-form-field-hint">Thông tin này xuất hiện trên bìa và đầu trang bản in.</p>
            </div>
        </header>
        <div class="admin-form-grid">
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Mã quy trình</span>
                <input class="admin-input" @bind="_code" placeholder="VD: QT.KSNK.18" readonly="@IsUpdateMode" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Tên quy trình</span>
                <input class="admin-input" @bind="_name" readonly="@IsUpdateMode" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Loại quy trình</span>
                <select class="admin-select" @bind="_procedureType" disabled="@IsUpdateMode">
                    @foreach (var type in Sql.MedLookups.ProcedureTypes)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Khoa/phòng chủ trì</span>
                <select class="admin-select" @bind="_departmentId">
                    <option value="">Chọn khoa/phòng</option>
                    @foreach (var department in Store.Departments.Where(item => item.Status == "active").OrderBy(item => item.Code))
                    {
                        <option value="@department.DepartmentId">@department.Code - @department.Name</option>
                    }
                </select>
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Phiên bản</span>
                <input class="admin-input" value="@_versionLabel" readonly />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Lần ban hành</span>
                <input class="admin-input" type="number" min="1" @bind="_issueNumber" />
            </label>
            <label class="admin-form-field">
                <span class="admin-form-field-label is-required">Ngày dự kiến ban hành</span>
                <input class="admin-input" type="date" @bind="_issueDate" />
            </label>
            <label class="admin-form-field admin-form-field-full">
                <span class="admin-form-field-label">Mô tả quản trị</span>
                <textarea class="admin-textarea" rows="2" @bind="_description"></textarea>
            </label>
            <label class="admin-form-field admin-form-field-full">
                <span class="admin-form-field-label">Tóm tắt phiên bản / lý do xây dựng</span>
                <textarea class="admin-textarea" rows="3" @bind="_summary"></textarea>
            </label>
        </div>
    </article>

    <ProcedureGovernanceEditor Recipients="_recipients" Revisions="_revisions" />
    <ProcedureDocumentSectionsEditor Sections="_sections" />
    <ProcedureFlowEditor Steps="_steps" Roles="ActiveRoles" />

    <article class="admin-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Tệp gắn kèm</h2>
                <p class="admin-form-field-hint">Tệp được lưu nội bộ, tính SHA-256 và chỉ tải xuống qua phiên đăng nhập.</p>
            </div>
            <InputFile OnChange="OnFilesSelected" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
        </header>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead><tr><th>Tệp</th><th>Loại</th><th>Dung lượng</th><th></th></tr></thead>
                <tbody>
                    @foreach (var attachment in _existingAttachments)
                    {
                        <tr @key="attachment.ProcedureAttachmentId">
                            <td>@attachment.FileName <span class="admin-table-cell-muted">(từ @SourceVersionLabel)</span></td>
                            <td>@AttachmentTypeName(attachment.AttachmentType)</td>
                            <td>@FormatBytes(attachment.FileSizeBytes ?? 0)</td>
                            <td></td>
                        </tr>
                    }
                    @if (_attachments.Count == 0 && _existingAttachments.Count == 0)
                    {
                        <tr><td colspan="4">Chưa chọn tệp. Cần ít nhất một PDF nguồn trước khi gửi kiểm tra.</td></tr>
                    }
                    @foreach (var attachment in _attachments)
                    {
                        <tr @key="attachment">
                            <td>@attachment.File.Name</td>
                            <td>
                                <select class="admin-select" @bind="attachment.AttachmentType">
                                    @foreach (var type in Sql.MedLookups.AttachmentTypes)
                                    {
                                        <option value="@type.Code">@type.Name</option>
                                    }
                                </select>
                            </td>
                            <td>@FormatBytes(attachment.File.Size)</td>
                            <td><button type="button" class="admin-icon-btn is-danger" title="Xóa tệp" @onclick="() => _attachments.Remove(attachment)">×</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <article class="admin-panel procedure-signoff-panel">
        <header class="admin-panel-head">
            <div>
                <h2 class="admin-panel-title">Chữ ký nội bộ trực tiếp</h2>
                <p class="admin-form-field-hint">Người dùng ký bằng tay trong khung vẽ; hệ thống lưu ảnh chữ ký, tài khoản, thời điểm và hash nội dung tại lúc ký.</p>
            </div>
        </header>
        <div class="admin-table-wrapper">
            <table class="admin-table procedure-signoff-table">
                <thead><tr><th>Vai trò</th><th>Trạng thái</th><th>Nơi thực hiện</th><th>Hành động</th></tr></thead>
                <tbody>
                    <tr>
                        <td><strong>Người viết</strong></td>
                        <td><AdminBadge Tone="tone-warning">Ký trước khi gửi kiểm tra</AdminBadge></td>
                        <td>Trang tạo/cập nhật quy trình hiện tại</td>
                        <td>
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-primary" disabled="@_isSaving" @onclick="OpenWriterSignature">
                                Mở khung ký tay
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Người kiểm tra</strong></td>
                        <td><AdminBadge Tone="tone-muted">Sau khi gửi kiểm tra</AdminBadge></td>
                        <td>Trang Phê duyệt hoặc chi tiết phiên bản chờ duyệt</td>
                        <td><span class="admin-table-cell-muted">Ký khi phiên bản ở trạng thái chờ duyệt</span></td>
                    </tr>
                    <tr>
                        <td><strong>Người phê duyệt</strong></td>
                        <td><AdminBadge Tone="tone-muted">Ký khi ban hành</AdminBadge></td>
                        <td>Trang Phê duyệt, ngay trước khi xuất bản phiên bản</td>
                        <td><span class="admin-table-cell-muted">Chỉ mở sau khi có chữ ký kiểm tra hợp lệ</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>

    <aside class="admin-callout">
        <strong>@(IsUpdateMode ? "Nguyên tắc phiên bản:" : "Chuỗi xác nhận nội bộ:")</strong>
        @(IsUpdateMode
            ? $"{SourceVersionLabel} không bị ghi đè. Hệ thống tạo {_versionLabel} độc lập; chữ ký cũ không được sao chép và phiên bản đang hiệu lực chỉ chuyển thành đã thay thế sau khi bản mới được ban hành."
            : "Người soạn ký trên hash hiện tại khi gửi; người kiểm tra ký ở hàng chờ duyệt; người phê duyệt ký khi ban hành. Mọi chỉnh sửa nội dung làm chữ ký cũ hết hiệu lực.")
    </aside>

    <div class="procedure-authoring-actions">
        <button type="button" class="admin-btn admin-btn-ghost" disabled="@_isSaving" @onclick="SaveDraftAsync">@(IsUpdateMode ? $"Cập nhật thành {_versionLabel}" : "Tạo bản v01")</button>
        <button type="button" class="admin-btn admin-btn-primary" disabled="@_isSaving" @onclick="OpenWriterSignature">@(IsUpdateMode ? $"Cập nhật {_versionLabel}, ký và gửi kiểm tra" : "Tạo v01, ký và gửi kiểm tra")</button>
    </div>
</section>

<ProcedureSignatureModal IsOpen="_writerSignOpen"
                         IsOpenChanged="v => _writerSignOpen = v"
                         CanvasId="procedure-author-signature-pad"
                         RoleLabel="Người viết"
                         DocumentLabel="@($"{_code} - {_name} - {_versionLabel}")"
                         SignerName="@(UserContext.CurrentUser?.FullName ?? UserContext.CurrentUser?.Username ?? string.Empty)"
                         SignerUsername="@(UserContext.CurrentUser?.Username ?? string.Empty)"
                         ConfirmText="Ký và gửi kiểm tra"
                         SignatureConfirmed="SaveSignedVersionAsync" />

@code {
    [Parameter] public Guid? ProcedureId { get; set; }

    private string _code = string.Empty;
    private string _name = string.Empty;
    private string _procedureType = "technical";
    private string _departmentId = string.Empty;
    private string _versionLabel = "v01";
    private int _issueNumber = 1;
    private DateTime? _issueDate = DateTime.Today;
    private string _description = string.Empty;
    private string _summary = string.Empty;
    private bool _isSaving;
    private bool _writerSignOpen;
    private Sql.ProcedureVersion? _sourceVersion;

    private readonly List<ProcedureSectionDraft> _sections = CreateSections();
    private readonly List<ProcedureFlowStepDraft> _steps =
    [
        new() { Code = "BUOC-01", Name = "Bắt đầu", ShapeCode = "terminator", DetailSectionNumber = "VIII" },
        new() { Code = "BUOC-02", Name = "Thực hiện", ShapeCode = "process", DetailSectionNumber = "VIII" },
        new() { Code = "BUOC-03", Name = "Kết thúc và lưu hồ sơ", ShapeCode = "terminator", DetailSectionNumber = "X" }
    ];
    private readonly List<ProcedureRecipientDraft> _recipients = [new()];
    private readonly List<ProcedureRevisionDraft> _revisions = [new() { Summary = "Ban hành lần đầu" }];
    private readonly List<PendingAttachment> _attachments = [];
    private readonly List<Sql.ProcedureAttachment> _existingAttachments = [];

    private IReadOnlyList<Sql.Role> ActiveRoles => Store.Roles.Where(item => item.Status == "active").OrderBy(item => item.Code).ToList();
    private bool IsUpdateMode => ProcedureId.HasValue && _sourceVersion is not null;
    private string ActionVerb => IsUpdateMode ? "cập nhật quy trình" : "tạo quy trình";
    private string SourceVersionLabel => _sourceVersion?.VersionLabel ?? (_sourceVersion is null ? "phiên bản trước" : ProcedureAuthoringService.FormatVersionLabel(_sourceVersion.VersionNo));

    protected override void OnInitialized()
    {
        if (ProcedureId.HasValue) LoadSourceVersion();
    }

    private void OnFilesSelected(InputFileChangeEventArgs args)
    {
        foreach (var file in args.GetMultipleFiles(10))
        {
            var isFirstPdf = !_attachments.Any(item => item.AttachmentType == "source_pdf") &&
                             file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
            _attachments.Add(new PendingAttachment(file, isFirstPdf ? "source_pdf" : "other"));
        }
        // #region agent log
        AgentLog("QuyTrinhTaoMoiPage.OnFilesSelected", "files selected", new { count = _attachments.Count, names = _attachments.Select(a => a.File.Name).ToArray() }, "D");
        // #endregion
    }

    private Task SaveDraftAsync() => SaveAsync(submit: false);

    private void OpenWriterSignature()
    {
        var permission = IsUpdateMode ? "SCR_PROCEDURES:UPDATE" : "SCR_PROCEDURES:CREATE";
        if (!Guard.CanDo(permission, IsUpdateMode ? "cập nhật quy trình" : "tạo quy trình")) return;
        var validationMessage = Validate(submit: true);
        if (validationMessage is not null)
        {
            Toasts.Show("Chưa thể ký quy trình", validationMessage, ToastVariant.Warning);
            return;
        }
        if (UserContext.CurrentUser is null)
        {
            Toasts.Show("Phiên đăng nhập không hợp lệ", "Vui lòng đăng nhập lại trước khi ký.", ToastVariant.Error);
            return;
        }
        // #region agent log
        AgentLog("QuyTrinhTaoMoiPage.OpenWriterSignature", "opening signature modal", new { attachmentCount = _attachments.Count, writerSignOpen = _writerSignOpen }, "A");
        // #endregion
        _writerSignOpen = true;
    }

    private Task SaveSignedVersionAsync(string signatureImageDataUrl)
        => SaveAsync(submit: true, signatureImageDataUrl);

    private async Task SaveAsync(bool submit, string? signatureImageDataUrl = null)
    {
        var permission = IsUpdateMode ? "SCR_PROCEDURES:UPDATE" : "SCR_PROCEDURES:CREATE";
        if (_isSaving || !Guard.CanDo(permission, IsUpdateMode ? "cập nhật quy trình" : "tạo quy trình")) return;
        var validationMessage = Validate(submit);
        if (validationMessage is not null)
        {
            Toasts.Show($"Chưa thể {ActionVerb}", validationMessage, ToastVariant.Warning);
            return;
        }

        var user = UserContext.CurrentUser;
        if (user is null)
        {
            Toasts.Show("Phiên đăng nhập không hợp lệ", $"Vui lòng đăng nhập lại trước khi {ActionVerb}.", ToastVariant.Error);
            return;
        }

        _isSaving = true;
        try
        {
            // #region agent log
            AgentLog("QuyTrinhTaoMoiPage.SaveAsync", "save started", new { submit, attachmentCount = _attachments.Count, isSaving = _isSaving, writerSignOpen = _writerSignOpen }, "C");
            // #endregion
            var versionId = Guid.NewGuid();
            var storedAttachments = new List<(PendingAttachment Draft, StoredProcedureAttachment Stored)>();
            foreach (var attachment in _attachments)
            {
                // #region agent log
                AgentLog("QuyTrinhTaoMoiPage.SaveAsync", "before OpenReadStream", new { fileName = attachment.File.Name, fileSize = attachment.File.Size, attachmentType = attachment.AttachmentType }, "A");
                try
                {
                    await using var probe = attachment.File.OpenReadStream(ProcedureAttachmentStorageService.MaxFileSizeBytes);
                    AgentLog("QuyTrinhTaoMoiPage.SaveAsync", "OpenReadStream probe ok", new { fileName = attachment.File.Name, canRead = probe.CanRead }, "B");
                }
                catch (Exception probeEx)
                {
                    AgentLog("QuyTrinhTaoMoiPage.SaveAsync", "OpenReadStream probe failed", new { fileName = attachment.File.Name, error = probeEx.Message }, "A");
                    throw;
                }
                // #endregion
                storedAttachments.Add((attachment, await AttachmentStorage.SaveAsync(versionId, attachment.File)));
            }
            var hasNewSourcePdf = storedAttachments.Any(item => item.Draft.AttachmentType == "source_pdf");
            var attachments = _existingAttachments
                .Where(item => !hasNewSourcePdf || item.AttachmentType != "source_pdf")
                .Select(item => new ProcedureStoredAttachmentDraft(
                    item.AttachmentType, item.FileName, item.FileUri, item.MimeType, item.FileSizeBytes, item.ChecksumSha256))
                .Concat(storedAttachments.Select(item => new ProcedureStoredAttachmentDraft(
                    item.Draft.AttachmentType, item.Stored.FileName, item.Stored.FileUri, item.Stored.MimeType,
                    item.Stored.FileSizeBytes, item.Stored.ChecksumSha256)))
                .ToList();

            var result = Authoring.CreateVersion(new ProcedureAuthoringCommand(
                versionId,
                ProcedureId,
                _sourceVersion?.ProcedureVersionId,
                _code.Trim(),
                _name.Trim(),
                _procedureType,
                ParseGuid(_departmentId)!.Value,
                NullIfWhiteSpace(_description),
                NullIfWhiteSpace(_summary),
                _issueDate!.Value,
                _issueNumber,
                user.UserId,
                _sections,
                _recipients,
                _revisions,
                _steps,
                attachments));

            if (submit)
            {
                Signoffs.Sign(
                    versionId,
                    "writer",
                    user.UserId,
                    user.Username,
                    user.FullName,
                    signatureImageDataUrl,
                    "Chữ ký tay trực tiếp của người soạn");
                Lifecycle.Submit(versionId, user.UserId);
            }

            var title = IsUpdateMode ? $"Đã cập nhật thành {result.Version.VersionLabel}" : "Đã tạo bản v01";
            Toasts.Show(submit ? $"{title}, đã ký và gửi kiểm tra" : title, result.Procedure.Name, ToastVariant.Success);
            Navigation.NavigateTo("/qlcm/quy-trinh");
        }
        catch (Exception exception)
        {
            // #region agent log
            AgentLog("QuyTrinhTaoMoiPage.SaveAsync", "save failed", new { error = exception.Message, type = exception.GetType().Name }, "E");
            // #endregion
            Toasts.Show($"Không thể {ActionVerb}", exception.Message, ToastVariant.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void LoadSourceVersion()
    {
        var procedure = Store.Procedures.FirstOrDefault(item => item.ProcedureId == ProcedureId);
        var source = Store.ProcedureVersions
            .Where(item => item.ProcedureId == ProcedureId)
            .OrderByDescending(item => item.VersionNo)
            .FirstOrDefault();
        if (procedure is null || source is null)
        {
            Toasts.Show("Không thể cập nhật", "Không tìm thấy quy trình hoặc phiên bản nguồn.", ToastVariant.Error);
            Navigation.NavigateTo("/qlcm/quy-trinh");
            return;
        }

        _sourceVersion = source;
        _code = procedure.ProcedureCode;
        _name = procedure.Name;
        _procedureType = procedure.ProcedureType;
        _departmentId = (source.DepartmentId ?? procedure.OwnerDepartmentId)?.ToString() ?? string.Empty;
        _description = procedure.Description ?? string.Empty;
        _summary = $"Cập nhật từ {SourceVersionLabel}";
        _versionLabel = ProcedureAuthoringService.FormatVersionLabel(Authoring.GetNextVersionNo(procedure.ProcedureId));
        _issueNumber = (source.IssueNumber ?? source.VersionNo) + 1;
        _issueDate = DateTime.Today;

        var sourceSections = Store.ProcedureDocumentSections.Where(item => item.ProcedureVersionId == source.ProcedureVersionId).ToList();
        foreach (var section in _sections)
        {
            section.Content = sourceSections.FirstOrDefault(item => item.SectionKind == section.Kind)?.ContentText ?? string.Empty;
        }

        _recipients.Clear();
        _recipients.AddRange(Store.ProcedureDistributionRecipients
            .Where(item => item.ProcedureVersionId == source.ProcedureVersionId)
            .OrderBy(item => item.DisplayOrder)
            .Select(item => new ProcedureRecipientDraft { Name = item.RecipientName, IsMarked = item.IsMarked }));
        if (_recipients.Count == 0) _recipients.Add(new ProcedureRecipientDraft());

        _revisions.Clear();
        _revisions.AddRange(Store.ProcedureRevisionEntries
            .Where(item => item.ProcedureVersionId == source.ProcedureVersionId)
            .OrderBy(item => item.DisplayOrder)
            .Select(item => new ProcedureRevisionDraft
            {
                RevisionDate = item.RevisionDate,
                PageReference = item.PageRef ?? string.Empty,
                SectionReference = item.SectionRef ?? string.Empty,
                Summary = item.Summary
            }));
        _revisions.Add(new ProcedureRevisionDraft
        {
            RevisionDate = DateTime.Today,
            Summary = $"Cập nhật từ {SourceVersionLabel} lên {_versionLabel}"
        });

        _steps.Clear();
        _steps.AddRange(Store.ProcedureSteps
            .Where(item => item.ProcedureVersionId == source.ProcedureVersionId)
            .OrderBy(item => item.StepNo)
            .Select(item => new ProcedureFlowStepDraft
            {
                Code = item.StepCode ?? string.Empty,
                Name = item.Name,
                RoleId = item.ActorRoleId?.ToString() ?? string.Empty,
                Responsibility = item.ResponsibilityText ?? string.Empty,
                ShapeCode = item.FlowShapeCode,
                FormReference = item.FormReferenceText ?? string.Empty,
                DetailSectionNumber = item.DetailSectionNumber ?? string.Empty,
                Minutes = item.StandardDurationMinutes ?? 5,
                Description = item.Description ?? string.Empty
            }));

        _existingAttachments.Clear();
        _existingAttachments.AddRange(Store.ProcedureAttachments
            .Where(item => item.ProcedureVersionId == source.ProcedureVersionId)
            .OrderBy(item => item.UploadedAt));
    }

    private string? Validate(bool submit)
    {
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_versionLabel))
            return "Nhập mã, tên và phiên bản quy trình.";
        if (!IsUpdateMode && Store.Procedures.Any(item => string.Equals(item.ProcedureCode, _code.Trim(), StringComparison.OrdinalIgnoreCase)))
            return "Mã quy trình đã tồn tại. Vui lòng dùng mã khác.";
        if (IsUpdateMode && _sourceVersion?.StatusCode == "pending_approval")
            return "Phiên bản mới nhất đang chờ phê duyệt. Hãy hoàn tất hoặc từ chối trước khi tạo bản kế tiếp.";
        if (!Guid.TryParse(_departmentId, out _)) return "Chọn khoa/phòng chủ trì.";
        if (_issueDate is null || _issueNumber < 1) return "Nhập ngày và lần ban hành hợp lệ.";
        if (!submit) return null;
        if (_sections.Any(item => item.IsRequired && string.IsNullOrWhiteSpace(item.Content))) return "Hoàn thiện tất cả mục La Mã bắt buộc.";
        if (_steps.Count == 0 || _steps.Any(item => string.IsNullOrWhiteSpace(item.Name) || string.IsNullOrWhiteSpace(item.Responsibility) || string.IsNullOrWhiteSpace(item.Description)))
            return "Mỗi bước phải có tên, trách nhiệm và diễn giải thao tác.";
        if (!_recipients.Any(item => !string.IsNullOrWhiteSpace(item.Name))) return "Thêm ít nhất một nơi nhận.";
        if (!_revisions.Any(item => !string.IsNullOrWhiteSpace(item.Summary))) return "Thêm ít nhất một dòng theo dõi sửa đổi.";
        if (!_existingAttachments.Any(item => item.AttachmentType == "source_pdf") &&
            !_attachments.Any(item => item.AttachmentType == "source_pdf" && item.File.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)))
            return "Chọn một tệp PDF và đặt loại là PDF nguồn.";
        return null;
    }

    private static List<ProcedureSectionDraft> CreateSections() =>
    [
