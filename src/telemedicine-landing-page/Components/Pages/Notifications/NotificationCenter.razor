@page "/notifications"
@layout AppLayout

<PageTitle>Trung tam Thong bao - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <div class="module-page__header">
        <div class="module-page__header-left">
            <h1>Trung tam Thong bao <span style="background:var(--color-danger); color:#fff; font-size:0.75rem; font-weight:700; padding:0.125rem 0.5rem; border-radius:999px; vertical-align:middle;">5</span></h1>
        </div>
        <div class="module-page__actions">
            <button class="btn-secondary" aria-label="Danh dau tat ca da doc">Danh dau tat ca da doc</button>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="tabs-animated" style="margin-bottom:1.5rem;">
        <button class="tabs-animated__tab tabs-animated__tab--active">Tat ca</button>
        <button class="tabs-animated__tab">Chua doc <span style="background:var(--color-danger); color:#fff; font-size:0.625rem; padding:0.0625rem 0.375rem; border-radius:999px; margin-left:0.25rem;">5</span></button>
        <button class="tabs-animated__tab">Phan quyen</button>
        <button class="tabs-animated__tab">Quy trinh</button>
        <button class="tabs-animated__tab">Phac do</button>
        <button class="tabs-animated__tab">He thong</button>
    </div>

    <!-- Notification List -->
    <div class="notification-list stagger-children" style="display:flex; flex-direction:column; gap:0.5rem;">
        <!-- Unread -->
        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; background:rgba(59,130,246,0.03); border-left:3px solid var(--color-info); cursor:pointer;" aria-label="Thong bao chua doc">
            <div style="width:10px; height:10px; border-radius:50%; background:var(--color-info); margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:rgba(59,130,246,0.1); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 7l2.5 2.5L10 5" stroke="var(--color-info)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700; font-size:0.875rem; margin-bottom:0.125rem;">Quy trinh QT-008 da duoc phe duyet</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Quy trinh sinh thiet gan v1.1 da duoc PGD. Vo Thi Lan phe duyet va ban hanh.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">2 phut truoc | <span style="color:var(--color-info);">Quy trinh</span></div>
            </div>
            <button class="action-btn" title="Luu tru" style="opacity:0;">&#128451;</button>
        </div>

        <!-- Unread -->
        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; background:rgba(245,158,11,0.03); border-left:3px solid var(--color-warning); cursor:pointer;">
            <div style="width:10px; height:10px; border-radius:50%; background:var(--color-warning); margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:rgba(245,158,11,0.1); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 4v5M8 11v.5" stroke="var(--color-warning)" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700; font-size:0.875rem; margin-bottom:0.125rem;">Canh bao: Vuot dinh muc tai nguyen</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Ky thuat KT-N001 vuot 28% dinh muc CO2 y te trong thang 04/2024.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">15 phut truoc | <span style="color:var(--color-warning);">He thong</span></div>
            </div>
            <button class="action-btn" title="Luu tru" style="opacity:0;">&#128451;</button>
        </div>

        <!-- Unread -->
        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; background:rgba(139,92,246,0.03); border-left:3px solid #7c3aed; cursor:pointer;">
            <div style="width:10px; height:10px; border-radius:50%; background:#7c3aed; margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:rgba(139,92,246,0.1); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="3" width="10" height="10" rx="2" stroke="#7c3aed" stroke-width="1.3"/><path d="M6 8h4" stroke="#7c3aed" stroke-width="1.3" stroke-linecap="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700; font-size:0.875rem; margin-bottom:0.125rem;">Quyen moi duoc cap: Them/Sua Quy trinh</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Ban da duoc cap them quyen Them va Sua cho module Quy trinh KT boi BS. Nguyen Van An.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">1 gio truoc | <span style="color:#7c3aed;">Phan quyen</span></div>
            </div>
            <button class="action-btn" title="Luu tru" style="opacity:0;">&#128451;</button>
        </div>

        <!-- Unread -->
        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; background:rgba(16,185,129,0.03); border-left:3px solid var(--color-success); cursor:pointer;">
            <div style="width:10px; height:10px; border-radius:50%; background:var(--color-success); margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:rgba(16,185,129,0.1); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 8l3 3 5-5" stroke="var(--color-success)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700; font-size:0.875rem; margin-bottom:0.125rem;">Phac do da duoc ap dung thanh cong</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Phac do dieu tri viem phoi da ap dung cho BN-2024-1045. Ket qua: Thanh cong.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">3 gio truoc | <span style="color:var(--color-success);">Phac do</span></div>
            </div>
            <button class="action-btn" title="Luu tru" style="opacity:0;">&#128451;</button>
        </div>

        <!-- Unread -->
        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; background:rgba(239,68,68,0.03); border-left:3px solid var(--color-danger); cursor:pointer;">
            <div style="width:10px; height:10px; border-radius:50%; background:var(--color-danger); margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:rgba(239,68,68,0.1); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="5.5" stroke="var(--color-danger)" stroke-width="1.3"/><path d="M6 6l4 4M10 6l-4 4" stroke="var(--color-danger)" stroke-width="1.3" stroke-linecap="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:700; font-size:0.875rem; margin-bottom:0.125rem;">Quy trinh QT-011 bi tu choi</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Quy trinh noi soi dai trang v1.0 bi tu choi boi PGD. Vo Thi Lan. Ly do: Thieu buoc sat khuan.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">5 gio truoc | <span style="color:var(--color-danger);">Quy trinh</span></div>
            </div>
            <button class="action-btn" title="Luu tru" style="opacity:0;">&#128451;</button>
        </div>

        <!-- Read notifications -->
        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; opacity:0.7; cursor:pointer;">
            <div style="width:10px; height:10px; margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:var(--surface-secondary); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 7l2.5 2.5L10 5" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:500; font-size:0.875rem; margin-bottom:0.125rem;">Bao cao thang 03/2024 da san sang</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Bao cao tuan thu quy trinh va tieu thu tai nguyen thang 3 da hoan tat.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">Hom qua | He thong</div>
            </div>
        </div>

        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; opacity:0.7; cursor:pointer;">
            <div style="width:10px; height:10px; margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:var(--surface-secondary); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 7l2.5 2.5L10 5" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:500; font-size:0.875rem; margin-bottom:0.125rem;">Cap nhat he thong v3.2.1</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">He thong da duoc nang cap len phien ban 3.2.1 voi cac cai tien hieu suat.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">2 ngay truoc | He thong</div>
            </div>
        </div>

        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; opacity:0.7; cursor:pointer;">
            <div style="width:10px; height:10px; margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:var(--surface-secondary); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 7l2.5 2.5L10 5" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:500; font-size:0.875rem; margin-bottom:0.125rem;">Nhac nho: Quy trinh QT-003 sap het hieu luc</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Quy trinh truyen mau v3.2 het hieu luc vao 22/05/2024. Can gia han hoac cap nhat.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">3 ngay truoc | Quy trinh</div>
            </div>
        </div>

        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; opacity:0.7; cursor:pointer;">
            <div style="width:10px; height:10px; margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:var(--surface-secondary); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 7l2.5 2.5L10 5" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:500; font-size:0.875rem; margin-bottom:0.125rem;">BS. Le Minh Tuan da gui quy trinh de duyet</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Quy trinh phau thuat noi soi khop goi v1.2 can xet duyet.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">4 ngay truoc | Quy trinh</div>
            </div>
        </div>

        <div class="glass-card" style="padding:1rem; display:flex; align-items:flex-start; gap:1rem; opacity:0.7; cursor:pointer;">
            <div style="width:10px; height:10px; margin-top:0.375rem; flex-shrink:0;"></div>
            <div style="width:36px; height:36px; border-radius:50%; background:var(--surface-secondary); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 7l2.5 2.5L10 5" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <div style="flex:1;">
                <div style="font-weight:500; font-size:0.875rem; margin-bottom:0.125rem;">Sao luu he thong hoan tat</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Sao luu tu dong ngay 10/04/2024 da hoan tat thanh cong. Dung luong: 2.3 GB.</div>
                <div style="font-size:0.6875rem; color:var(--text-muted); margin-top:0.25rem;">5 ngay truoc | He thong</div>
            </div>
        </div>
    </div>

    <!-- Slide-over panel for detail -->
    <div class="slide-over__backdrop" aria-hidden="true"></div>
    <div class="slide-over" aria-hidden="true" aria-label="Chi tiet thong bao">
        <div class="slide-over__header">
            <span class="slide-over__title">Chi tiet thong bao</span>
            <button class="slide-over__close" aria-label="Dong">&times;</button>
        </div>
        <div class="slide-over__body">
            <h3 style="margin-bottom:0.75rem;">Quy trinh QT-008 da duoc phe duyet</h3>
            <p style="font-size:0.875rem; color:var(--text-secondary); margin-bottom:1rem;">Quy trinh sinh thiet gan duoi huong dan sieu am phien ban 1.1 da duoc PGD. Vo Thi Lan phe duyet va ban hanh ngay 15/04/2024.</p>
            <div style="margin-bottom:1rem;">
                <span style="font-size:0.75rem; color:var(--text-muted);">Thoi gian: 15/04/2024 14:30</span>
            </div>
            <a href="/procedures/QT-008" class="btn-primary">Xem quy trinh</a>
        </div>
    </div>
</div>

@code {
    private string activeFilter = "all";
}
