@page "/reports"
@layout AppLayout

<PageTitle>Bao cao & Thong ke - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <div class="module-page__header">
        <div class="module-page__header-left">
            <h1>Bao cao & Thong ke</h1>
            <p>Tong hop bao cao va thong ke he thong</p>
        </div>
        <div class="module-page__actions">
            <div class="date-range-picker">
                <input type="date" class="date-range-picker__input" value="2024-03-01" aria-label="Tu ngay" />
                <span class="date-range-picker__sep">-</span>
                <input type="date" class="date-range-picker__input" value="2024-04-15" aria-label="Den ngay" />
            </div>
            <button class="btn-secondary" aria-label="Xuat tat ca">Xuat tat ca</button>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-bottom:2rem;" class="stagger-children">
        <div class="glass-card" style="padding:1.25rem; text-align:center;">
            <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">Tuan thu quy trinh</div>
            <div style="font-size:1.75rem; font-weight:700; color:var(--color-success);" class="counter-animate" data-target="96" data-suffix=".5%">0</div>
        </div>
        <div class="glass-card" style="padding:1.25rem; text-align:center;">
            <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">Thay doi quyen</div>
            <div style="font-size:1.75rem; font-weight:700; color:var(--text-primary);" class="counter-animate" data-target="23">0</div>
        </div>
        <div class="glass-card" style="padding:1.25rem; text-align:center;">
            <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">Tieu thu vuot muc</div>
            <div style="font-size:1.75rem; font-weight:700; color:var(--color-danger);" class="counter-animate" data-target="12" data-suffix="%">0</div>
        </div>
        <div class="glass-card" style="padding:1.25rem; text-align:center;">
            <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">Phac do ap dung</div>
            <div style="font-size:1.75rem; font-weight:700; color:var(--color-primary);" class="counter-animate" data-target="156">0</div>
        </div>
    </div>

    <!-- Report Category Cards (2x3 Grid) -->
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem;" class="stagger-children">
        <!-- Card 1: Tuan thu Quy trinh -->
        <div class="glass-card tilt-card" style="padding:1.5rem; display:flex; flex-direction:column;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                <div style="width:40px; height:40px; border-radius:var(--radius-md); background:rgba(16,185,129,0.1); display:flex; align-items:center; justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M6 10l3 3 5-5" stroke="var(--color-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><rect x="2" y="2" width="16" height="16" rx="3" stroke="var(--color-success)" stroke-width="1.5"/></svg>
                </div>
                <h3 style="font-size:0.9375rem; font-weight:700;">Tuan thu Quy trinh</h3>
            </div>
            <p style="font-size:0.8125rem; color:var(--text-secondary); flex:1; margin-bottom:1rem;">Phan tich muc do tuan thu quy trinh ky thuat chuyen mon tai cac khoa/phong.</p>
            <div style="height:32px; display:flex; align-items:flex-end; gap:3px; margin-bottom:0.75rem;">
                <div style="width:12%; height:60%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                <div style="width:12%; height:80%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                <div style="width:12%; height:70%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                <div style="width:12%; height:90%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                <div style="width:12%; height:95%; background:var(--color-success); border-radius:2px;"></div>
                <div style="width:12%; height:85%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
            </div>
            <a href="/reports/compliance" style="font-size:0.8125rem; font-weight:600; color:var(--color-primary);">Xem bao cao &rarr;</a>
        </div>

        <!-- Card 2: Thay doi Phan quyen -->
        <div class="glass-card tilt-card" style="padding:1.5rem; display:flex; flex-direction:column;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                <div style="width:40px; height:40px; border-radius:var(--radius-md); background:rgba(139,92,246,0.1); display:flex; align-items:center; justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="14" height="14" rx="3" stroke="#7c3aed" stroke-width="1.5"/><path d="M7 10h6M10 7v6" stroke="#7c3aed" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <h3 style="font-size:0.9375rem; font-weight:700;">Thay doi Phan quyen</h3>
            </div>
            <p style="font-size:0.8125rem; color:var(--text-secondary); flex:1; margin-bottom:1rem;">Theo doi cac thay doi phan quyen va vai tro nguoi dung trong he thong.</p>
            <div style="height:32px; display:flex; flex-direction:column; justify-content:space-between; margin-bottom:0.75rem;">
                <div style="height:3px; background:var(--border-color); border-radius:2px; position:relative;"><div style="position:absolute; left:20%; width:8px; height:8px; border-radius:50%; background:#7c3aed; top:-2.5px;"></div><div style="position:absolute; left:55%; width:8px; height:8px; border-radius:50%; background:#7c3aed; top:-2.5px;"></div><div style="position:absolute; left:80%; width:8px; height:8px; border-radius:50%; background:#7c3aed; top:-2.5px;"></div></div>
            </div>
            <a href="/permissions/audit-log" style="font-size:0.8125rem; font-weight:600; color:var(--color-primary);">Xem bao cao &rarr;</a>
        </div>

        <!-- Card 3: Tieu thu Tai nguyen -->
        <div class="glass-card tilt-card" style="padding:1.5rem; display:flex; flex-direction:column;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                <div style="width:40px; height:40px; border-radius:var(--radius-md); background:rgba(245,158,11,0.1); display:flex; align-items:center; justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 15h2V8H3v7zM7 15h2V5H7v10zM11 15h2V10h-2v5zM15 15h2V3h-2v12z" stroke="var(--color-warning)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h3 style="font-size:0.9375rem; font-weight:700;">Tieu thu Tai nguyen</h3>
            </div>
            <p style="font-size:0.8125rem; color:var(--text-secondary); flex:1; margin-bottom:1rem;">So sanh muc tieu thu thuc te voi dinh muc, phat hien vuot muc.</p>
            <div style="height:32px; display:flex; flex-direction:column; gap:4px; margin-bottom:0.75rem;">
                <div style="display:flex; gap:2px; align-items:center;"><div style="height:6px; width:60%; background:var(--color-primary); border-radius:2px; opacity:0.6;"></div><div style="height:6px; width:72%; background:var(--color-danger); border-radius:2px; opacity:0.6; margin-left:-60%;"></div></div>
                <div style="display:flex; gap:2px; align-items:center;"><div style="height:6px; width:50%; background:var(--color-primary); border-radius:2px; opacity:0.6;"></div><div style="height:6px; width:45%; background:var(--color-success); border-radius:2px; opacity:0.6; margin-left:-50%;"></div></div>
            </div>
            <a href="/catalog/consumption-report" style="font-size:0.8125rem; font-weight:600; color:var(--color-primary);">Xem bao cao &rarr;</a>
        </div>

        <!-- Card 4: Su dung Phac do -->
        <div class="glass-card tilt-card" style="padding:1.5rem; display:flex; flex-direction:column;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                <div style="width:40px; height:40px; border-radius:var(--radius-md); background:rgba(59,130,246,0.1); display:flex; align-items:center; justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="var(--color-info)" stroke-width="1.5"/><path d="M10 6v4l3 2" stroke="var(--color-info)" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <h3 style="font-size:0.9375rem; font-weight:700;">Su dung Phac do</h3>
            </div>
            <p style="font-size:0.8125rem; color:var(--text-secondary); flex:1; margin-bottom:1rem;">Thong ke tan suat ap dung phac do lam sang theo khoa va loai benh.</p>
            <div style="height:32px; display:flex; align-items:center; justify-content:center; margin-bottom:0.75rem;">
                <svg width="32" height="32" viewBox="0 0 32 32"><circle cx="16" cy="16" r="12" fill="none" stroke="var(--border-color)" stroke-width="6"/><circle cx="16" cy="16" r="12" fill="none" stroke="var(--color-info)" stroke-width="6" stroke-dasharray="50 75" transform="rotate(-90 16 16)"/></svg>
            </div>
            <a href="/protocols" style="font-size:0.8125rem; font-weight:600; color:var(--color-primary);">Xem bao cao &rarr;</a>
        </div>

        <!-- Card 5: Kiem toan He thong -->
        <div class="glass-card tilt-card" style="padding:1.5rem; display:flex; flex-direction:column;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                <div style="width:40px; height:40px; border-radius:var(--radius-md); background:rgba(100,116,139,0.1); display:flex; align-items:center; justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 5h12M4 9h8M4 13h10M4 17h6" stroke="var(--color-gray-600, #475569)" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <h3 style="font-size:0.9375rem; font-weight:700;">Kiem toan He thong</h3>
            </div>
            <p style="font-size:0.8125rem; color:var(--text-secondary); flex:1; margin-bottom:1rem;">Ghi nhan toan bo hoat dong va thay doi trong he thong de kiem toan.</p>
            <div style="height:32px; display:flex; flex-direction:column; gap:3px; margin-bottom:0.75rem;">
                <div style="height:2px; background:var(--border-color); border-radius:1px; width:90%;"></div>
                <div style="height:2px; background:var(--border-color); border-radius:1px; width:75%;"></div>
                <div style="height:2px; background:var(--border-color); border-radius:1px; width:85%;"></div>
                <div style="height:2px; background:var(--border-color); border-radius:1px; width:60%;"></div>
            </div>
            <a href="/permissions/audit-log" style="font-size:0.8125rem; font-weight:600; color:var(--color-primary);">Xem bao cao &rarr;</a>
        </div>

        <!-- Card 6: Hieu suat Nhan vien -->
        <div class="glass-card tilt-card" style="padding:1.5rem; display:flex; flex-direction:column;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                <div style="width:40px; height:40px; border-radius:var(--radius-md); background:rgba(236,72,153,0.1); display:flex; align-items:center; justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3" stroke="#ec4899" stroke-width="1.5"/><path d="M4 17c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="#ec4899" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <h3 style="font-size:0.9375rem; font-weight:700;">Hieu suat Nhan vien</h3>
            </div>
            <p style="font-size:0.8125rem; color:var(--text-secondary); flex:1; margin-bottom:1rem;">Danh gia hieu suat lam viec cua nhan vien theo cac chi so KPI.</p>
            <div style="height:32px; position:relative; margin-bottom:0.75rem;">
                <svg width="100%" height="32" viewBox="0 0 120 32" fill="none" preserveAspectRatio="none"><polyline points="0,28 20,22 40,24 60,18 80,12 100,15 120,8" stroke="#ec4899" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
            </div>
            <a href="/reports/staff" style="font-size:0.8125rem; font-weight:600; color:var(--color-primary);">Xem bao cao &rarr;</a>
        </div>
    </div>

    <!-- Scheduled report indicator -->
    <div style="margin-top:1.5rem; display:flex; align-items:center; gap:0.75rem; padding:0.875rem 1.25rem; background:var(--surface-secondary); border-radius:var(--radius-md);">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="var(--text-muted)" stroke-width="1.3"/><path d="M8 5v3l2 1.5" stroke="var(--text-muted)" stroke-width="1.3" stroke-linecap="round"/></svg>
        <span style="font-size:0.8125rem; color:var(--text-secondary);">Bao cao tu dong: Gui email moi Thu 2 luc 08:00 cho ban giam doc</span>
        <button class="btn-secondary" style="margin-left:auto; font-size:0.75rem; padding:0.25rem 0.75rem;">Cai dat</button>
    </div>
</div>

@code {
    private string dateRange = "2024-03-01 - 2024-04-15";
}
