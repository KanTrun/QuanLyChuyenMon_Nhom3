@page "/reports"
@layout AppLayout

<PageTitle>Bao cao va Phan tich - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <h1>Bao cao &amp; Phan tich</h1>
        <p>Tong hop bao cao hoat dong he thong</p>
    </div>
</div>

<!-- Summary Cards -->
<div class="stats-row">
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Quy trinh Active</div>
        <div class="stat-card-mini__value stat-card-mini__value--primary">128</div>
        <span class="trend-indicator trend-indicator--up" style="margin-top:var(--space-2);">&#8593; +5%</span>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Ty le tuan thu</div>
        <div class="stat-card-mini__value stat-card-mini__value--success">94.2%</div>
        <span class="trend-indicator trend-indicator--up" style="margin-top:var(--space-2);">&#8593; +2.1%</span>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Thay doi quyen</div>
        <div class="stat-card-mini__value">23</div>
        <span class="trend-indicator trend-indicator--down" style="margin-top:var(--space-2);">&#8595; -3</span>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Vuot SLA</div>
        <div class="stat-card-mini__value stat-card-mini__value--danger">7</div>
        <span class="trend-indicator trend-indicator--down" style="margin-top:var(--space-2);">&#8595; -2</span>
    </div>
</div>

<!-- Reports Grid -->
<div class="reports-grid">
    <!-- Report 1 -->
    <a href="/catalog/reports" class="report-card">
        <div class="report-card__icon">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M3 19V8l4-4h6l4 4v11a1 1 0 01-1 1H4a1 1 0 01-1-1z" stroke="currentColor" stroke-width="1.5"/><path d="M8 13v5M11 10v8M14 12v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <div class="report-card__title">Tieu thu Tai nguyen</div>
        <div class="report-card__desc">So sanh dinh muc va thuc te su dung vat tu, thuoc, thiet bi</div>
        <div class="report-card__arrow">Xem bao cao &rarr;</div>
    </a>

    <!-- Report 2 -->
    <a href="/permissions/audit" class="report-card">
        <div class="report-card__icon" style="background:var(--color-lavender);color:#7c3aed;">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2l8 4.5v5.5c0 4-3.2 7.5-8 9.5-4.8-2-8-5.5-8-9.5V6.5L11 2z" stroke="currentColor" stroke-width="1.5"/><path d="M8 11l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="report-card__title">Thay doi Phan quyen</div>
        <div class="report-card__desc">Lich su va xu huong thay doi quyen truy cap he thong</div>
        <div class="report-card__arrow">Xem bao cao &rarr;</div>
    </a>

    <!-- Report 3 -->
    <a href="/procedures/publish" class="report-card">
        <div class="report-card__icon" style="background:var(--color-secondary-50);color:var(--color-secondary);">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4 4h14v14H4z" stroke="currentColor" stroke-width="1.5" rx="2"/><path d="M4 9h14M9 9v9" stroke="currentColor" stroke-width="1.5"/></svg>
        </div>
        <div class="report-card__title">Phien ban Quy trinh</div>
        <div class="report-card__desc">Theo doi phien ban va quy trinh ban hanh</div>
        <div class="report-card__arrow">Xem bao cao &rarr;</div>
    </a>

    <!-- Report 4 -->
    <div class="report-card">
        <div class="report-card__icon" style="background:var(--color-accent-50);color:var(--color-accent);">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M3 3v16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M7 15l4-5 3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="report-card__title">Hoat dong He thong</div>
        <div class="report-card__desc">Log hoat dong, truy cap, va loi he thong</div>
        <div class="report-card__arrow">Xem bao cao &rarr;</div>
    </div>

    <!-- Report 5 -->
    <div class="report-card">
        <div class="report-card__icon" style="background:#ecfdf5;color:#059669;">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2l8 4.5v5.5c0 4-3.2 7.5-8 9.5-4.8-2-8-5.5-8-9.5V6.5L11 2z" stroke="currentColor" stroke-width="1.5"/><path d="M8 11l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="report-card__title">Tuan thu Quy trinh</div>
        <div class="report-card__desc">Ty le tuan thu theo khoa, thoi gian va loai quy trinh</div>
        <div class="report-card__arrow">Xem bao cao &rarr;</div>
    </div>

    <!-- Report 6 -->
    <div class="report-card">
        <div class="report-card__icon" style="background:#fef2f2;color:#dc2626;">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2a4 4 0 014 4v1h1a2 2 0 012 2v7a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h1V6a4 4 0 014-4z" stroke="currentColor" stroke-width="1.5"/><path d="M9 13h4M11 11v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <div class="report-card__title">Ap dung Phac do</div>
        <div class="report-card__desc">Thong ke ap dung phac do lam sang va hieu qua dieu tri</div>
        <div class="report-card__arrow">Xem bao cao &rarr;</div>
    </div>
</div>

<!-- Quick Insights -->
<h2 style="font-size:var(--text-lg);font-weight:600;color:var(--color-ink);margin-bottom:var(--space-5);">Thong tin nhanh</h2>
<div class="insights-section">
    <!-- Bar Chart: Quy trinh theo Khoa -->
    <div class="insight-card">
        <div class="insight-card__title">Quy trinh theo Khoa</div>
        <div class="mini-bar-chart">
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Ngoai khoa</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:85%;"></div></div>
                <span class="mini-bar-chart__value">34</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Noi khoa</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:70%;"></div></div>
                <span class="mini-bar-chart__value">28</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Xet nghiem</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:55%;"></div></div>
                <span class="mini-bar-chart__value">22</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">CDHA</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:45%;"></div></div>
                <span class="mini-bar-chart__value">18</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Hoi suc</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:35%;"></div></div>
                <span class="mini-bar-chart__value">14</span>
            </div>
        </div>
    </div>

    <!-- Progress: Top 5 Quy trinh -->
    <div class="insight-card">
        <div class="insight-card__title">Top 5 Quy trinh duoc ap dung nhieu nhat</div>
        <div class="mini-bar-chart">
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Mo noi soi</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:95%;"></div></div>
                <span class="mini-bar-chart__value">312</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">XN Cong thuc mau</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:82%;"></div></div>
                <span class="mini-bar-chart__value">267</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Tham kham ngoai tru</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:70%;"></div></div>
                <span class="mini-bar-chart__value">230</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Cap cuu tim mach</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:55%;"></div></div>
                <span class="mini-bar-chart__value">178</span>
            </div>
            <div class="mini-bar-chart__row">
                <span class="mini-bar-chart__label">Cham soc sau mo</span>
                <div class="mini-bar-chart__track"><div class="mini-bar-chart__fill" style="width:45%;"></div></div>
                <span class="mini-bar-chart__value">145</span>
            </div>
        </div>
    </div>
</div>
