@page "/permissions/adjust"
@layout AppLayout

<PageTitle>Dieu chinh Phan quyen - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <h1 style="margin-bottom:1.5rem;">Dieu chinh Phan quyen</h1>

    <!-- Target Selector -->
    <div class="filter-panel" style="margin-bottom:1.5rem;">
        <div class="form-group" style="margin-bottom:0; flex:1;">
            <label class="form-label" style="margin-bottom:0.25rem;">Doi tuong dieu chinh</label>
            <input type="text" class="form-input" value="DD. Nguyen Thi Mai" aria-label="Doi tuong" />
        </div>
        <div class="form-group" style="margin-bottom:0;">
            <label class="form-label" style="margin-bottom:0.25rem;">Vai tro hien tai</label>
            <span class="priority-badge priority-badge--normal">Dieu duong</span>
        </div>
    </div>

    <!-- Current permissions summary -->
    <div class="glass-card" style="padding:1rem; margin-bottom:1.5rem; background:var(--surface-secondary);">
        <h3 style="font-size:0.875rem; margin-bottom:0.5rem;">Quyen hien tai</h3>
        <p style="font-size:0.8125rem; color:var(--text-secondary);">Xem: Quy trinh, Phac do, Bao cao, Thong bao | Them/Sua: Khong | Phe duyet: Khong | Thuc hien: Quy trinh, Phac do</p>
    </div>

    <!-- Comparison Table -->
    <div class="glass-card" style="padding:1.5rem; margin-bottom:1.5rem;">
        <h3 style="font-size:0.9375rem; margin-bottom:1rem;">So sanh quyen Truoc/Sau</h3>
        <table class="comparison-table" aria-label="So sanh phan quyen">
            <thead>
                <tr><th>Chuc nang</th><th>Truoc (Hien tai)</th><th>Sau (Moi)</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>Quy trinh KT</td>
                    <td style="opacity:0.6;">Xem, Thuc hien</td>
                    <td class="comparison-table__changed">Xem, Them, Sua, Thuc hien</td>
                </tr>
                <tr>
                    <td>Phac do</td>
                    <td style="opacity:0.6;">Xem, Thuc hien</td>
                    <td>Xem, Thuc hien</td>
                </tr>
                <tr>
                    <td>Danh muc</td>
                    <td style="opacity:0.6;">Xem</td>
                    <td class="comparison-table__changed">Xem, Them</td>
                </tr>
                <tr>
                    <td>Bao cao</td>
                    <td style="opacity:0.6;">Xem</td>
                    <td>Xem</td>
                </tr>
                <tr>
                    <td>Thong bao</td>
                    <td style="opacity:0.6;">Xem</td>
                    <td>Xem</td>
                </tr>
                <tr>
                    <td>Ban hanh</td>
                    <td style="opacity:0.6;">Khong</td>
                    <td class="comparison-table__changed">Xem</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Reason & Effective Date -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:1.5rem;">
        <div class="glass-card" style="padding:1.5rem;">
            <div class="form-group">
                <label class="form-label">Ly do dieu chinh <span class="form-required">*</span></label>
                <textarea class="form-input form-textarea" rows="4" placeholder="Nhap ly do..." aria-label="Ly do dieu chinh" aria-required="true">DD. Nguyen Thi Mai duoc bo nhiem lam Truong nhom Dieu duong, can quyen Them/Sua quy trinh de cap nhat quy trinh cham soc.</textarea>
                <span class="form-hint">156/500 ky tu</span>
            </div>
        </div>
        <div class="glass-card" style="padding:1.5rem;">
            <div class="form-group">
                <label class="form-label">Thoi gian hieu luc</label>
                <div style="display:flex; gap:1rem; margin-bottom:0.75rem;">
                    <label style="display:flex; align-items:center; gap:0.375rem; font-size:0.8125rem; cursor:pointer;">
                        <input type="radio" name="effective" checked /> Ap dung ngay
                    </label>
                    <label style="display:flex; align-items:center; gap:0.375rem; font-size:0.8125rem; cursor:pointer;">
                        <input type="radio" name="effective" /> Hen gio
                    </label>
                </div>
                <input type="datetime-local" class="form-input" aria-label="Thoi gian hieu luc" disabled />
            </div>
        </div>
    </div>

    <!-- Impact Preview -->
    <div class="glass-card" style="padding:1.25rem; margin-bottom:1.5rem; border-left:4px solid var(--color-info);">
        <h3 style="font-size:0.875rem; margin-bottom:0.5rem;">Anh huong</h3>
        <p style="font-size:0.8125rem; color:var(--text-secondary); margin-bottom:0.5rem;">3 tai khoan, 12 chuc nang bi tac dong</p>
        <div style="font-size:0.75rem; color:var(--text-muted);">
            <p>- DD. Nguyen Thi Mai (truc tiep)</p>
            <p>- Nhom Dieu duong Khoa Ngoai (ke thua)</p>
            <p>- Nhom Dieu duong Khoa Noi (ke thua)</p>
        </div>
    </div>

    <!-- Actions -->
    <div style="display:flex; gap:0.75rem; justify-content:flex-end;">
        <button class="btn-secondary">Huy bo</button>
        <button class="btn-primary" aria-label="Xac nhan thay doi">Xac nhan thay doi</button>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal-dialog" aria-hidden="true" data-modal="confirm">
        <div class="modal-dialog__backdrop"></div>
        <div class="modal-dialog__content">
            <div class="modal-dialog__header">
                <span class="modal-dialog__title">Xac nhan dieu chinh phan quyen</span>
                <button class="slide-over__close" aria-label="Dong">&times;</button>
            </div>
            <div class="modal-dialog__body">
                <p style="margin-bottom:0.75rem;"><strong>Doi tuong:</strong> DD. Nguyen Thi Mai</p>
                <p style="margin-bottom:0.75rem;"><strong>Thay doi:</strong> Them quyen Them/Sua cho Quy trinh KT, Them cho Danh muc, Xem cho Ban hanh</p>
                <p style="margin-bottom:0.75rem;"><strong>Hieu luc:</strong> Ngay lap tuc</p>
                <p><strong>Ly do:</strong> Bo nhiem Truong nhom Dieu duong</p>
            </div>
            <div class="modal-dialog__footer">
                <button class="btn-secondary">Huy bo</button>
                <button class="btn-primary">Xac nhan thay doi</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string targetUser = "DD. Nguyen Thi Mai";
}
