@page "/permissions/adjust"
@layout AppLayout

<PageTitle>Dieu chinh Phan quyen - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <h1>Dieu chinh Phan quyen</h1>
        <p>Tao yeu cau thay doi quyen truy cap cho nguoi dung hoac nhom</p>
    </div>
</div>

<div class="glass-card" style="padding: var(--space-8); border-radius: var(--radius-card);">

    <!-- Section 1: Doi tuong -->
    <div class="form-section">
        <h2 class="form-section__title">1. Doi tuong</h2>
        <div class="radio-group">
            <label class="radio-item"><input type="radio" name="target-type" checked /> Tai khoan ca nhan</label>
            <label class="radio-item"><input type="radio" name="target-type" /> Nhom tai khoan</label>
        </div>
        <div class="form-group">
            <label>Tim kiem doi tuong</label>
            <div class="filter-bar__search" style="max-width: 100%;">
                <span class="filter-bar__search-icon">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                <input type="text" value="BS. Tran Minh Duc" style="width: 100%; padding: var(--space-3) var(--space-3) var(--space-3) var(--space-10); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: var(--text-sm);" />
            </div>
        </div>
    </div>

    <!-- Section 2: Quyen hien tai (read-only) -->
    <div class="form-section">
        <h2 class="form-section__title">2. Quyen hien tai</h2>
        <div class="data-table-container" style="max-height: 200px; overflow-y: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Chuc nang</th>
                        <th>Quyen hien tai</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Xem quy trinh</td><td><span class="status-badge status-badge--active">Co</span></td></tr>
                    <tr><td>Tao quy trinh</td><td><span class="status-badge status-badge--active">Co</span></td></tr>
                    <tr><td>Sua quy trinh</td><td><span class="status-badge status-badge--active">Co</span></td></tr>
                    <tr><td>Xoa quy trinh</td><td><span class="status-badge status-badge--draft">Khong</span></td></tr>
                    <tr><td>Gui duyet</td><td><span class="status-badge status-badge--active">Co</span></td></tr>
                    <tr><td>Phe duyet</td><td><span class="status-badge status-badge--draft">Khong</span></td></tr>
                    <tr><td>Xem phac do</td><td><span class="status-badge status-badge--active">Co</span></td></tr>
                    <tr><td>Tao phac do</td><td><span class="status-badge status-badge--active">Co</span></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section 3: Quyen moi -->
    <div class="form-section">
        <h2 class="form-section__title">3. Quyen moi (thay doi)</h2>
        <div class="data-table-container" style="max-height: 240px; overflow-y: auto;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Chuc nang</th>
                        <th>Quyen</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Xem quy trinh</td><td><input type="checkbox" checked style="accent-color: var(--color-primary);" /></td></tr>
                    <tr><td>Tao quy trinh</td><td><input type="checkbox" checked style="accent-color: var(--color-primary);" /></td></tr>
                    <tr><td>Sua quy trinh</td><td><input type="checkbox" checked style="accent-color: var(--color-primary);" /></td></tr>
                    <tr><td>Xoa quy trinh</td><td><input type="checkbox" checked style="accent-color: var(--color-primary);" /></td></tr>
                    <tr><td>Gui duyet</td><td><input type="checkbox" checked style="accent-color: var(--color-primary);" /></td></tr>
                    <tr><td>Phe duyet</td><td><input type="checkbox" checked style="accent-color: var(--color-primary);" /></td></tr>
                    <tr><td>Xem phac do</td><td><input type="checkbox" checked style="accent-color: var(--color-primary);" /></td></tr>
                    <tr><td>Tao phac do</td><td><input type="checkbox" style="accent-color: var(--color-primary);" /></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section 4: Diff Preview -->
    <div class="form-section">
        <h2 class="form-section__title">4. Xem truoc thay doi</h2>
        <div class="diff-preview">
            <div class="diff-preview__summary">
                <span class="diff-preview__added">+3 quyen moi</span>
                <span class="diff-preview__removed">-1 quyen bi thu hoi</span>
            </div>
            <table class="diff-preview__table">
                <tbody>
                    <tr class="diff-preview__row--added">
                        <td class="diff-preview__indicator diff-preview__indicator--add">+</td>
                        <td>Xoa quy trinh</td>
                        <td><span class="status-badge status-badge--active">Them moi</span></td>
                    </tr>
                    <tr class="diff-preview__row--added">
                        <td class="diff-preview__indicator diff-preview__indicator--add">+</td>
                        <td>Phe duyet</td>
                        <td><span class="status-badge status-badge--active">Them moi</span></td>
                    </tr>
                    <tr class="diff-preview__row--added">
                        <td class="diff-preview__indicator diff-preview__indicator--add">+</td>
                        <td>Xem quyen</td>
                        <td><span class="status-badge status-badge--active">Them moi</span></td>
                    </tr>
                    <tr class="diff-preview__row--removed">
                        <td class="diff-preview__indicator diff-preview__indicator--remove">-</td>
                        <td>Tao phac do</td>
                        <td><span class="status-badge status-badge--archived">Thu hoi</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section 5: Ly do -->
    <div class="form-section">
        <h2 class="form-section__title">5. Ly do dieu chinh</h2>
        <div class="form-group">
            <textarea class="form-input form-input--textarea" placeholder="Nhap ly do dieu chinh quyen...">Bac si Tran Minh Duc duoc bo nhiem lam Pho khoa Ngoai, can bo sung quyen phe duyet va quan ly quy trinh.</textarea>
        </div>
    </div>

    <!-- Section 6: Hieu luc -->
    <div class="form-section">
        <h2 class="form-section__title">6. Thoi gian hieu luc</h2>
        <div class="radio-group">
            <label class="radio-item"><input type="radio" name="effective" checked /> Ap dung ngay</label>
            <label class="radio-item"><input type="radio" name="effective" /> Hen gio</label>
        </div>
        <div class="form-group">
            <label>Thoi gian ap dung (neu hen gio)</label>
            <input type="datetime-local" class="form-input" style="max-width: 300px;" />
        </div>
    </div>

    <!-- Section 7: Xac nhan -->
    <div class="confirm-checkbox">
        <input type="checkbox" id="confirm-check" />
        <label for="confirm-check">Toi xac nhan da kiem tra cac thay doi tren va chiu trach nhiem ve yeu cau nay</label>
    </div>

    <!-- Actions -->
    <div style="display: flex; gap: var(--space-4); justify-content: flex-end; margin-top: var(--space-6);">
        <button class="btn-secondary">Huy bo</button>
        <button class="btn-primary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7l3.5 3.5L12 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Gui yeu cau
        </button>
    </div>
</div>
