@page "/permissions"
@layout AppLayout

<PageTitle>Thiết lập Phân quyền - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <h1>Thiết lập Phân quyền</h1>
        <p>Quản lý quyền truy cập theo vai trò va chuc nang</p>
    </div>
    <div class="module-page__actions">
        <button class="btn-primary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 11V3h10v8a1 1 0 01-1 1H3a1 1 0 01-1-1z" stroke="currentColor" stroke-width="1.5"/><path d="M5 6h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Lưu thay đổi
        </button>
        <button class="btn-secondary">Huy</button>
    </div>
</div>

<!-- Filter Section -->
<div class="filter-bar">
    <div class="tab-toggle" role="tablist">
        <button class="tab-toggle__btn tab-toggle__btn--active" role="tab" aria-selected="true">Theo Vai trò</button>
        <button class="tab-toggle__btn" role="tab" aria-selected="false">Theo Người dùng</button>
    </div>
    <select class="filter-bar__select">
        <option>Tất cả khoa/phòng</option>
        <option>Ngoại tổng hợp</option>
        <option>Nội tổng hợp</option>
        <option>Xét nghiệm</option>
        <option>Chẩn đoán hình ảnh</option>
    </select>
    <div class="filter-bar__search">
        <span class="filter-bar__search-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <input type="text" placeholder="Tìm vai trò hoặc người dùng..." />
    </div>
</div>

