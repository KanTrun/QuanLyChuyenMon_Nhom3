<!-- Legend -->
<div class="matrix-legend">
    <div class="matrix-legend__item">
        <input type="checkbox" checked disabled style="width: 14px; height: 14px; accent-color: var(--color-primary);" />
        <span>Có quyền</span>
    </div>
    <div class="matrix-legend__item">
        <input type="checkbox" disabled style="width: 14px; height: 14px;" />
        <span>Không có quyền</span>
    </div>
    <div class="matrix-legend__item">
        <span style="display: inline-block; width: 14px; height: 14px; background: var(--color-border); border-radius: 3px;"></span>
        <span>Kế thừa từ nhóm</span>
    </div>
</div>
