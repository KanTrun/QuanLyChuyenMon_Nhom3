                <th>Quản trị</th>
                <th>Lãnh đạo</th>
                <th>QA</th>
            </tr>
        </thead>
        <tbody>
            <!-- Group: Quy trình F01 -->
            <tr class="permission-matrix__group-row">
                <td colspan="8">Quy trình (F01)</td>
            </tr>
            <tr>
                <td>Xem quy trình</td>
                <td><input type="checkbox" checked /></td>
                <td><input type="checkbox" checked /></td>
                <td><input type="checkbox" checked /></td>
                <td><input type="checkbox" checked /></td>
                <td><input type="checkbox" checked /></td>
                <td><input type="checkbox" checked /></td>
                <td><input type="checkbox" checked /></td>
