@page "/permissions/audit"
@layout AppLayout

<PageTitle>Nhat ky Phan quyen - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <h1>Nhat ky Phan quyen</h1>
        <p>Lich su thay doi quyen truy cap trong he thong</p>
    </div>
    <div class="module-page__actions">
        <button class="btn-secondary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 9v3h10V9M7 2v7M4 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Xuat Excel
        </button>
    </div>
</div>

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="date-range">
        <input type="date" value="2024-01-01" />
        <span class="date-range__sep">den</span>
        <input type="date" value="2024-04-15" />
    </div>
    <div class="filter-bar__search" style="min-width: 160px;">
        <span class="filter-bar__search-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <input type="text" placeholder="Tim nguoi dung..." />
    </div>
    <select class="filter-bar__select">
        <option>Tat ca hanh dong</option>
        <option>Gan quyen</option>
        <option>Thu hoi</option>
        <option>Dieu chinh</option>
    </select>
</div>

<!-- Audit Log Table -->
<div class="data-table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th style="width: 30px;"></th>
                <th>Thoi gian</th>
                <th>Nguoi thuc hien</th>
                <th>Doi tuong</th>
                <th>Hanh dong</th>
                <th>Ly do</th>
                <th>Trang thai</th>
            </tr>
        </thead>
        <tbody>
            <tr class="audit-log__expandable" @onclick="() => ToggleRow(1)">
                <td><span class="audit-log__expand-icon @(expandedRow == 1 ? "audit-log__expand-icon--open" : "")"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 3l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span></td>
                <td>15/04/2024 09:30</td>
                <td>Admin Nguyen</td>
                <td>BS. Tran Minh Duc</td>
                <td>Gan quyen</td>
                <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Bo nhiem Pho khoa Ngoai</td>
                <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Da ap dung</span></td>
            </tr>
            @if (expandedRow == 1)
            {
                <tr>
                    <td colspan="7" style="padding: 0;">
                        <div class="audit-log__detail">
                            <div class="audit-log__diff">
                                <div>
                                    <div class="audit-log__diff-label" style="color: var(--color-danger);">Truoc</div>
                                    <div class="audit-log__diff-before">Xem QT: Co
Tao QT: Co
Sua QT: Co
Xoa QT: Khong
Phe duyet: Khong</div>
                                </div>
                                <div>
                                    <div class="audit-log__diff-label" style="color: #059669;">Sau</div>
                                    <div class="audit-log__diff-after">Xem QT: Co
Tao QT: Co
Sua QT: Co
Xoa QT: Co (+)
Phe duyet: Co (+)</div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            <tr class="audit-log__expandable" @onclick="() => ToggleRow(2)">
                <td><span class="audit-log__expand-icon @(expandedRow == 2 ? "audit-log__expand-icon--open" : "")"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 3l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span></td>
                <td>14/04/2024 14:15</td>
                <td>Admin Nguyen</td>
                <td>DD. Le Thi Hoa</td>
                <td>Dieu chinh</td>
                <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Chuyen sang khoa Nhi</td>
                <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Da ap dung</span></td>
            </tr>
            @if (expandedRow == 2)
            {
                <tr>
                    <td colspan="7" style="padding: 0;">
                        <div class="audit-log__detail">
                            <div class="audit-log__diff">
                                <div>
                                    <div class="audit-log__diff-label" style="color: var(--color-danger);">Truoc</div>
                                    <div class="audit-log__diff-before">Khoa: Ngoai TH
Xem DM Ngoai: Co
Ghi nhan CS: Co</div>
                                </div>
                                <div>
                                    <div class="audit-log__diff-label" style="color: #059669;">Sau</div>
                                    <div class="audit-log__diff-after">Khoa: Nhi (+)
Xem DM Nhi: Co (+)
Ghi nhan CS Nhi: Co (+)</div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            <tr class="audit-log__expandable" @onclick="() => ToggleRow(3)">
                <td><span class="audit-log__expand-icon @(expandedRow == 3 ? "audit-log__expand-icon--open" : "")"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 3l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span></td>
                <td>12/04/2024 10:00</td>
                <td>Admin Le</td>
                <td>Nhom: Duoc si</td>
                <td>Gan quyen</td>
                <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Them quyen xem phac do</td>
                <td><span class="status-badge status-badge--pending"><span class="status-badge__dot"></span>Cho ap dung</span></td>
            </tr>
            @if (expandedRow == 3)
            {
                <tr>
                    <td colspan="7" style="padding: 0;">
                        <div class="audit-log__detail">
                            <div class="audit-log__diff">
                                <div>
                                    <div class="audit-log__diff-label" style="color: var(--color-danger);">Truoc</div>
                                    <div class="audit-log__diff-before">Xem PD: Khong
Ap dung PD: Khong</div>
                                </div>
                                <div>
                                    <div class="audit-log__diff-label" style="color: #059669;">Sau</div>
                                    <div class="audit-log__diff-after">Xem PD: Co (+)
Ap dung PD: Co (+)</div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            <tr class="audit-log__expandable" @onclick="() => ToggleRow(4)">
                <td><span class="audit-log__expand-icon @(expandedRow == 4 ? "audit-log__expand-icon--open" : "")"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 3l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span></td>
                <td>10/04/2024 16:45</td>
                <td>System</td>
                <td>KTV. Pham Van C</td>
                <td>Thu hoi</td>
                <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Nghi viec - vo hieu hoa</td>
                <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Da ap dung</span></td>
            </tr>
            @if (expandedRow == 4)
            {
                <tr>
                    <td colspan="7" style="padding: 0;">
                        <div class="audit-log__detail">
                            <div class="audit-log__diff">
                                <div>
                                    <div class="audit-log__diff-label" style="color: var(--color-danger);">Truoc</div>
                                    <div class="audit-log__diff-before">Trang thai: Active
Xem QT: Co
XN mau: Co
Nhap KQ: Co</div>
                                </div>
                                <div>
                                    <div class="audit-log__diff-label" style="color: #059669;">Sau</div>
                                    <div class="audit-log__diff-after">Trang thai: Inactive
Tat ca quyen: Thu hoi</div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            <tr class="audit-log__expandable" @onclick="() => ToggleRow(5)">
                <td><span class="audit-log__expand-icon @(expandedRow == 5 ? "audit-log__expand-icon--open" : "")"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 3l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span></td>
                <td>08/04/2024 08:00</td>
                <td>Admin Nguyen</td>
                <td>BS. Hoang Van D</td>
                <td>Gan quyen</td>
                <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Phe duyet QT cap cuu</td>
                <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Da ap dung</span></td>
            </tr>
            @if (expandedRow == 5)
            {
                <tr>
                    <td colspan="7" style="padding: 0;">
                        <div class="audit-log__detail">
                            <div class="audit-log__diff">
                                <div>
                                    <div class="audit-log__diff-label" style="color: var(--color-danger);">Truoc</div>
                                    <div class="audit-log__diff-before">Phe duyet QT: Khong</div>
                                </div>
                                <div>
                                    <div class="audit-log__diff-label" style="color: #059669;">Sau</div>
                                    <div class="audit-log__diff-after">Phe duyet QT: Co (+)</div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            <tr class="audit-log__expandable" @onclick="() => ToggleRow(6)">
                <td><span class="audit-log__expand-icon @(expandedRow == 6 ? "audit-log__expand-icon--open" : "")"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 3l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span></td>
                <td>05/04/2024 11:20</td>
                <td>Admin Le</td>
                <td>Nhom: QA</td>
                <td>Dieu chinh</td>
                <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Cap nhat quyen kiem soat CL</td>
                <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Da ap dung</span></td>
            </tr>
            @if (expandedRow == 6)
            {
                <tr>
                    <td colspan="7" style="padding: 0;">
                        <div class="audit-log__detail">
                            <div class="audit-log__diff">
                                <div>
                                    <div class="audit-log__diff-label" style="color: var(--color-danger);">Truoc</div>
                                    <div class="audit-log__diff-before">KSCL: Xem
Bao cao CL: Khong</div>
                                </div>
                                <div>
                                    <div class="audit-log__diff-label" style="color: #059669;">Sau</div>
                                    <div class="audit-log__diff-after">KSCL: Xem + Sua (+)
Bao cao CL: Co (+)</div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            <tr class="audit-log__expandable" @onclick="() => ToggleRow(7)">
                <td><span class="audit-log__expand-icon @(expandedRow == 7 ? "audit-log__expand-icon--open" : "")"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 3l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span></td>
                <td>01/04/2024 09:00</td>
                <td>Admin Nguyen</td>
                <td>BS. Vu Thi E</td>
                <td>Gan quyen</td>
                <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Nhan viec moi - Khoa Tim</td>
                <td><span class="status-badge status-badge--archived"><span class="status-badge__dot"></span>Huy</span></td>
            </tr>
            @if (expandedRow == 7)
            {
                <tr>
                    <td colspan="7" style="padding: 0;">
                        <div class="audit-log__detail">
                            <div class="audit-log__diff">
                                <div>
                                    <div class="audit-log__diff-label" style="color: var(--color-danger);">Truoc</div>
                                    <div class="audit-log__diff-before">(khong co quyen)</div>
                                </div>
                                <div>
                                    <div class="audit-log__diff-label" style="color: #059669;">Sau (da huy)</div>
                                    <div class="audit-log__diff-after">Xem QT Tim: Co
Tao QT: Co
-- DA HUY --</div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            <tr class="audit-log__expandable" @onclick="() => ToggleRow(8)">
                <td><span class="audit-log__expand-icon @(expandedRow == 8 ? "audit-log__expand-icon--open" : "")"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4 3l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></span></td>
                <td>28/03/2024 15:30</td>
                <td>System</td>
                <td>Nhom: Dieu duong</td>
                <td>Dieu chinh</td>
                <td style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Cap nhat quyen theo QD moi</td>
                <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Da ap dung</span></td>
            </tr>
            @if (expandedRow == 8)
            {
                <tr>
                    <td colspan="7" style="padding: 0;">
                        <div class="audit-log__detail">
                            <div class="audit-log__diff">
                                <div>
                                    <div class="audit-log__diff-label" style="color: var(--color-danger);">Truoc</div>
                                    <div class="audit-log__diff-before">Ghi nhan CS: Co
Bao cao DD: Khong
Xem PD: Khong</div>
                                </div>
                                <div>
                                    <div class="audit-log__diff-label" style="color: #059669;">Sau</div>
                                    <div class="audit-log__diff-after">Ghi nhan CS: Co
Bao cao DD: Co (+)
Xem PD: Co (+)</div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <!-- Pagination -->
    <div class="pagination">
        <span class="pagination__info">Hien thi 1-8 / 156 ban ghi</span>
        <div class="pagination__buttons">
            <button class="pagination__btn" disabled>&laquo;</button>
            <button class="pagination__btn pagination__btn--active">1</button>
            <button class="pagination__btn">2</button>
            <button class="pagination__btn">3</button>
            <button class="pagination__btn">...</button>
            <button class="pagination__btn">20</button>
            <button class="pagination__btn">&raquo;</button>
        </div>
    </div>
</div>

@code {
    private int? expandedRow = null;

    private void ToggleRow(int rowId)
    {
        expandedRow = expandedRow == rowId ? null : rowId;
    }
}
