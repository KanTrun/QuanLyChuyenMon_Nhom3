@page "/permissions/audit-log"
@layout AppLayout

<PageTitle>Nhat ky Thay doi Phan quyen - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <h1 style="margin-bottom:1.5rem;">Nhat ky Thay doi Phan quyen</h1>

    <!-- Filter Bar -->
    <div class="filter-panel">
        <div class="date-range-picker">
            <input type="date" class="date-range-picker__input" value="2024-03-01" aria-label="Tu ngay" />
            <span class="date-range-picker__sep">-</span>
            <input type="date" class="date-range-picker__input" value="2024-04-15" aria-label="Den ngay" />
        </div>
        <input type="text" class="filter-panel__input" placeholder="Tim nguoi thuc hien..." aria-label="Tim nguoi thuc hien" />
        <select class="filter-panel__input" aria-label="Loai hanh dong">
            <option>Tat ca hanh dong</option>
            <option>Them quyen</option>
            <option>Sua quyen</option>
            <option>Xoa quyen</option>
        </select>
        <select class="filter-panel__input" aria-label="Khoa phong">
            <option>Tat ca khoa</option>
            <option>Ngoai tong hop</option>
            <option>Noi tong hop</option>
            <option>Xet nghiem</option>
        </select>
        <div class="view-toggle" style="margin-left:auto;">
            <button class="view-toggle__btn view-toggle__btn--active">Bang</button>
            <button class="view-toggle__btn">Timeline</button>
        </div>
        <button class="btn-icon" title="Xuat bao cao" aria-label="Xuat bao cao">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2v8M5 7l3 3 3-3M3 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    </div>

    <!-- Search within logs -->
    <div style="margin-bottom:1rem;">
        <input type="text" class="form-input" placeholder="Tim kiem trong nhat ky..." aria-label="Tim kiem nhat ky" style="max-width:300px;" />
    </div>

    <!-- Table View -->
    <div class="glass-card" style="padding:1.25rem;" data-view-content="table">
        <table class="data-table" aria-label="Nhat ky phan quyen">
            <thead>
                <tr><th>Thoi gian</th><th>Nguoi thuc hien</th><th>Doi tuong</th><th>Hanh dong</th><th>Hieu luc</th><th></th></tr>
            </thead>
            <tbody class="stagger-children">
                <tr>
                    <td>15/04/2024 14:30</td>
                    <td><div style="display:flex;align-items:center;gap:0.5rem;"><span class="avatar-circle avatar-circle--sm">NA</span>BS. Nguyen Van An</div></td>
                    <td>DD. Nguyen Thi Mai</td>
                    <td><span class="status-badge status-badge--active">Them quyen</span></td>
                    <td>Ngay lap tuc</td>
                    <td><button class="action-btn" title="Xem chi tiet">+</button></td>
                </tr>
                <tr>
                    <td>12/04/2024 09:15</td>
                    <td><div style="display:flex;align-items:center;gap:0.5rem;"><span class="avatar-circle avatar-circle--sm">NA</span>BS. Nguyen Van An</div></td>
                    <td>Nhom Bac si Ngoai</td>
                    <td><span class="status-badge status-badge--pending">Sua quyen</span></td>
                    <td>15/04/2024</td>
                    <td><button class="action-btn" title="Xem chi tiet">+</button></td>
                </tr>
                <tr>
                    <td>10/04/2024 16:00</td>
                    <td><div style="display:flex;align-items:center;gap:0.5rem;"><span class="avatar-circle avatar-circle--sm">VL</span>PGD. Vo Thi Lan</div></td>
                    <td>KTV. Le Van Hung</td>
                    <td><span class="status-badge status-badge--active">Them quyen</span></td>
                    <td>Ngay lap tuc</td>
                    <td><button class="action-btn" title="Xem chi tiet">+</button></td>
                </tr>
                <tr>
                    <td>08/04/2024 11:20</td>
                    <td><div style="display:flex;align-items:center;gap:0.5rem;"><span class="avatar-circle avatar-circle--sm">NA</span>BS. Nguyen Van An</div></td>
                    <td>BS. Hoang Nam</td>
                    <td><span class="status-badge status-badge--draft">Xoa quyen</span></td>
                    <td>Ngay lap tuc</td>
                    <td><button class="action-btn" title="Xem chi tiet">+</button></td>
                </tr>
                <tr>
                    <td>05/04/2024 08:45</td>
                    <td><div style="display:flex;align-items:center;gap:0.5rem;"><span class="avatar-circle avatar-circle--sm">AD</span>Admin</div></td>
                    <td>Nhom Ky thuat vien</td>
                    <td><span class="status-badge status-badge--pending">Sua quyen</span></td>
                    <td>Ngay lap tuc</td>
                    <td><button class="action-btn" title="Xem chi tiet">+</button></td>
                </tr>
                <tr>
                    <td>01/04/2024 14:10</td>
                    <td><div style="display:flex;align-items:center;gap:0.5rem;"><span class="avatar-circle avatar-circle--sm">VL</span>PGD. Vo Thi Lan</div></td>
                    <td>DD. Tran Thi Hoa</td>
                    <td><span class="status-badge status-badge--active">Them quyen</span></td>
                    <td>05/04/2024</td>
                    <td><button class="action-btn" title="Xem chi tiet">+</button></td>
                </tr>
                <tr>
                    <td>28/03/2024 10:30</td>
                    <td><div style="display:flex;align-items:center;gap:0.5rem;"><span class="avatar-circle avatar-circle--sm">NA</span>BS. Nguyen Van An</div></td>
                    <td>BS. Pham Quoc Bao</td>
                    <td><span class="status-badge status-badge--active">Them quyen</span></td>
                    <td>Ngay lap tuc</td>
                    <td><button class="action-btn" title="Xem chi tiet">+</button></td>
                </tr>
                <tr>
                    <td>25/03/2024 15:00</td>
                    <td><div style="display:flex;align-items:center;gap:0.5rem;"><span class="avatar-circle avatar-circle--sm">AD</span>Admin</div></td>
                    <td>Nhom Dieu duong</td>
                    <td><span class="status-badge status-badge--pending">Sua quyen</span></td>
                    <td>01/04/2024</td>
                    <td><button class="action-btn" title="Xem chi tiet">+</button></td>
                </tr>
            </tbody>
        </table>

        <!-- Expanded row example -->
        <div class="diff-view" style="margin:0.75rem 0 1.5rem; font-size:0.75rem;">
            <div class="diff-view__header"><span>Truoc</span><span>Sau</span></div>
            <div class="diff-view__panel diff-view__panel--before">
                <div class="diff-view__line diff-view__line--removed">Quy trinh KT: Xem</div>
                <div class="diff-view__line">Phac do: Xem, Thuc hien</div>
            </div>
            <div class="diff-view__panel diff-view__panel--after">
                <div class="diff-view__line diff-view__line--added">Quy trinh KT: Xem, Them, Sua</div>
                <div class="diff-view__line">Phac do: Xem, Thuc hien</div>
            </div>
        </div>

        <div class="pagination">
            <span class="pagination__info">Hien thi 1-8 / 45 ban ghi</span>
            <div class="pagination__buttons">
                <button class="pagination__btn" disabled>&laquo;</button>
                <button class="pagination__btn pagination__btn--active">1</button>
                <button class="pagination__btn">2</button>
                <button class="pagination__btn">3</button>
                <button class="pagination__btn">...</button>
                <button class="pagination__btn">6</button>
                <button class="pagination__btn">&raquo;</button>
            </div>
        </div>
    </div>

    <!-- Timeline View (hidden by default) -->
    <div class="timeline-view" data-view-content="timeline" style="display:none;">
        <div class="timeline-view__item">
            <span class="timeline-view__date">15/04</span>
            <div class="timeline-view__content"><div class="timeline-view__content-title">Them quyen cho DD. Nguyen Thi Mai</div><div class="timeline-view__content-desc">Them quyen Them/Sua Quy trinh KT - BS. Nguyen Van An</div></div>
        </div>
        <div class="timeline-view__item">
            <span class="timeline-view__date">12/04</span>
            <div class="timeline-view__content"><div class="timeline-view__content-title">Sua quyen Nhom Bac si Ngoai</div><div class="timeline-view__content-desc">Cap nhat quyen Phe duyet cho module Ban hanh - BS. Nguyen Van An</div></div>
        </div>
        <div class="timeline-view__item">
            <span class="timeline-view__date">10/04</span>
            <div class="timeline-view__content"><div class="timeline-view__content-title">Them quyen cho KTV. Le Van Hung</div><div class="timeline-view__content-desc">Them quyen Thuc hien Danh muc - PGD. Vo Thi Lan</div></div>
        </div>
        <div class="timeline-view__item">
            <span class="timeline-view__date">08/04</span>
            <div class="timeline-view__content"><div class="timeline-view__content-title">Xoa quyen BS. Hoang Nam</div><div class="timeline-view__content-desc">Go quyen Xoa Quy trinh (chuyen khoa) - BS. Nguyen Van An</div></div>
        </div>
    </div>
</div>

@code {
    private string viewMode = "table";
}
