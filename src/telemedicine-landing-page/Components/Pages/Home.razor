        <div class="welcome-stats-grid stagger-children">
            <div class="welcome-stat-item">
                <span class="welcome-stat-value">500+</span>
                <span class="welcome-stat-label">Quy trình kỹ thuật</span>
            </div>
            <div class="welcome-stat-item">
                <span class="welcome-stat-value">50+</span>
                <span class="welcome-stat-label">Khoa / Phòng ban</span>
            </div>
            <div class="welcome-stat-item">
                <span class="welcome-stat-value">2,000+</span>
                <span class="welcome-stat-label">Nhân viên y tế</span>
