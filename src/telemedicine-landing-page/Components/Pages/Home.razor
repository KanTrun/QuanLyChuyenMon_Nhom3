    <!-- Hero Section -->
    <section class="welcome-hero" aria-labelledby="hero-heading">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="orb orb-4"></div>

        <div class="welcome-hero-content reveal">
            <div class="welcome-hero-eyebrow">
                <span class="welcome-hero-eyebrow-dot"></span>
                Hệ thống quản lý chuyên môn bệnh viện
            </div>
            <h1 id="hero-heading">
                Chuẩn hóa Quy trình. <span class="text-gradient">Nâng tầm Chuyên môn.</span>
            </h1>
            <p class="welcome-hero-description">
                Nền tảng quản lý quy trình kỹ thuật, phân quyền RBAC đa tầng, kiểm soát chất lượng 
                và tuân thủ chuyên môn toàn diện cho bệnh viện. Số hóa mọi quy trình, 
                từ ban hành đến giám sát thực hiện.
            </p>
            <div class="welcome-hero-actions">
                <a href="/login" class="button button-glow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
