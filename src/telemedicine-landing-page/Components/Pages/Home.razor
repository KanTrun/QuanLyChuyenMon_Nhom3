@page "/"

<PageTitle>QLCM Pro | Hệ thống Quản lý Quy trình Kỹ thuật Chuyên môn</PageTitle>

<HeadContent>
    <meta property="og:title" content="QLCM Pro - Hệ thống Quản lý Quy trình Kỹ thuật Chuyên môn" />
    <meta property="og:description" content="Chuẩn hóa quy trình, phân quyền, kiểm soát chất lượng và tuân thủ cho bệnh viện." />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow" />
