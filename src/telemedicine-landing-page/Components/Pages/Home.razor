            <div class="welcome-cta-actions">
                <a href="/login" class="button button-glow">Đăng nhập hệ thống</a>
                <a href="/register" class="button button-outline" style="border-color: rgba(255,255,255,0.3); color: white;">Tạo tài khoản mới</a>
            </div>
