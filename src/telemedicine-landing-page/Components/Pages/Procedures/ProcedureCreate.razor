@page "/procedures/create"
@layout AppLayout

<PageTitle>Tao Quy trinh moi - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/dashboard" class="breadcrumb__item">Dashboard</a>
        <span class="breadcrumb__sep">/</span>
        <a href="/procedures" class="breadcrumb__item">Quy trinh</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__item breadcrumb__item--current">Tao moi</span>
    </nav>

    <h1 style="margin-bottom:1.5rem;">Tao Quy trinh moi</h1>

    <!-- Wizard Stepper -->
    <div class="wizard">
        <div class="wizard__stepper">
            <div class="wizard__step wizard__step--active">
                <span class="wizard__step-circle">1</span>
                <span class="wizard__step-label">Thong tin co ban</span>
            </div>
            <div class="wizard__connector"></div>
            <div class="wizard__step">
                <span class="wizard__step-circle">2</span>
                <span class="wizard__step-label">Cac buoc thuc hien</span>
            </div>
            <div class="wizard__connector"></div>
            <div class="wizard__step">
                <span class="wizard__step-circle">3</span>
                <span class="wizard__step-label">Anh xa chuc nang</span>
            </div>
            <div class="wizard__connector"></div>
            <div class="wizard__step">
                <span class="wizard__step-circle">4</span>
                <span class="wizard__step-label">Xac nhan & Gui</span>
            </div>
        </div>

        <p class="wizard__indicator" style="text-align:center; color:var(--text-secondary); font-size:0.875rem; margin-bottom:1.5rem;">Buoc 1/4</p>

        <!-- Step 1: Thong tin co ban -->
        <div class="wizard__body glass-card" style="padding:2rem;" data-wizard-step="1">
            <h2 style="margin-bottom:1.5rem; font-size:1.125rem;">Thong tin co ban</h2>
            <div class="form-group">
                <label class="form-label">Ma quy trinh</label>
                <input type="text" class="form-input" value="QT-AUTO-011" readonly aria-label="Ma quy trinh" />
                <span class="form-hint">Tu dong tao boi he thong</span>
            </div>
            <div class="form-group">
                <label class="form-label">Ten quy trinh <span class="form-required">*</span></label>
                <input type="text" class="form-input" placeholder="Nhap ten quy trinh..." aria-label="Ten quy trinh" aria-required="true" />
            </div>
            <div class="form-group">
                <label class="form-label">Loai quy trinh</label>
                <select class="form-input" aria-label="Loai quy trinh">
                    <option>Chon loai...</option>
                    <option>Phau thuat</option>
                    <option>Thu thuat</option>
                    <option>Chan doan</option>
                    <option>Dieu tri</option>
                    <option>Cham soc</option>
                    <option>Xet nghiem</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Khoa/Phong ap dung</label>
                <div class="multi-select" aria-label="Chon khoa phong">
                    <span class="multi-select__tag">Ngoai tong hop <span class="multi-select__tag-remove">&times;</span></span>
                    <input type="text" class="multi-select__input" placeholder="Them khoa/phong..." />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Mo ta</label>
                <textarea class="form-input form-textarea" rows="4" placeholder="Mo ta chi tiet quy trinh..." aria-label="Mo ta"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Ngay hieu luc</label>
                <input type="date" class="form-input" aria-label="Ngay hieu luc" />
            </div>
        </div>

        <!-- Step 2: Cac buoc thuc hien -->
        <div class="wizard__body glass-card" style="padding:2rem; display:none;" data-wizard-step="2">
            <h2 style="margin-bottom:1.5rem; font-size:1.125rem;">Cac buoc thuc hien</h2>
            <div class="step-builder">
                <div class="step-builder__item">
                    <span class="step-list__grip" aria-hidden="true">&#8942;&#8942;</span>
                    <span class="step-list__number">1</span>
                    <input type="text" class="form-input" placeholder="Ten buoc..." value="Tiep nhan benh nhan" />
                    <select class="form-input" style="width:140px;" aria-label="Vai tro"><option>BS. Phau thuat</option><option>Dieu duong</option><option>KTV</option></select>
                    <input type="text" class="form-input" style="width:100px;" placeholder="Dieu kien" />
                    <input type="text" class="form-input" style="width:80px;" placeholder="TG" value="30p" />
                    <button class="action-btn action-btn--danger" title="Xoa buoc">&times;</button>
                </div>
                <div class="step-builder__item">
                    <span class="step-list__grip" aria-hidden="true">&#8942;&#8942;</span>
                    <span class="step-list__number">2</span>
                    <input type="text" class="form-input" placeholder="Ten buoc..." value="Chuan bi phong mo" />
                    <select class="form-input" style="width:140px;" aria-label="Vai tro"><option>KTV</option><option>BS. Phau thuat</option><option>Dieu duong</option></select>
                    <input type="text" class="form-input" style="width:100px;" placeholder="Dieu kien" />
                    <input type="text" class="form-input" style="width:80px;" placeholder="TG" value="45p" />
                    <button class="action-btn action-btn--danger" title="Xoa buoc">&times;</button>
                </div>
                <div class="step-builder__item">
                    <span class="step-list__grip" aria-hidden="true">&#8942;&#8942;</span>
                    <span class="step-list__number">3</span>
                    <input type="text" class="form-input" placeholder="Ten buoc..." value="Thuc hien phau thuat" />
                    <select class="form-input" style="width:140px;" aria-label="Vai tro"><option>BS. Phau thuat</option><option>KTV</option><option>Dieu duong</option></select>
                    <input type="text" class="form-input" style="width:100px;" placeholder="Dieu kien" value="Da gay me" />
                    <input type="text" class="form-input" style="width:80px;" placeholder="TG" value="90p" />
                    <button class="action-btn action-btn--danger" title="Xoa buoc">&times;</button>
                </div>
            </div>
            <button class="btn-secondary" style="margin-top:1rem;">+ Them buoc</button>
        </div>

        <!-- Step 3: Anh xa chuc nang -->
        <div class="wizard__body glass-card" style="padding:2rem; display:none;" data-wizard-step="3">
            <h2 style="margin-bottom:1.5rem; font-size:1.125rem;">Anh xa chuc nang</h2>
            <table class="data-table">
                <thead><tr><th>Ma man hinh</th><th>Ten chuc nang</th><th>Che do kiem soat</th><th></th></tr></thead>
                <tbody>
                    <tr>
                        <td><input type="text" class="form-input" value="SCR-PT-001" /></td>
                        <td><input type="text" class="form-input" value="Lap lich phau thuat" /></td>
                        <td><select class="form-input"><option>Chan</option><option>Canh bao</option></select></td>
                        <td><button class="action-btn action-btn--danger">&times;</button></td>
                    </tr>
                    <tr>
                        <td><input type="text" class="form-input" value="SCR-PT-002" /></td>
                        <td><input type="text" class="form-input" value="Kiem tra thiet bi" /></td>
                        <td><select class="form-input"><option>Canh bao</option><option>Chan</option></select></td>
                        <td><button class="action-btn action-btn--danger">&times;</button></td>
                    </tr>
                </tbody>
            </table>
            <button class="btn-secondary" style="margin-top:1rem;">+ Them anh xa</button>
            <div class="file-upload-zone" style="margin-top:1.5rem;" aria-label="Dinh kem tai lieu">
                <div class="file-upload-zone__icon">
                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><path d="M20 26V14M14 20l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="6" y="6" width="28" height="28" rx="4" stroke="currentColor" stroke-width="2"/></svg>
                </div>
                <div class="file-upload-zone__text">Keo tha tai lieu dinh kem</div>
                <div class="file-upload-zone__hint">PDF, DOC, XLS - Toi da 10MB</div>
            </div>
        </div>

        <!-- Step 4: Xac nhan -->
        <div class="wizard__body glass-card" style="padding:2rem; display:none;" data-wizard-step="4">
            <h2 style="margin-bottom:1.5rem; font-size:1.125rem;">Xac nhan & Gui duyet</h2>
            <div class="glass-card" style="padding:1rem; margin-bottom:1rem; background:var(--surface-secondary);">
                <h4>Thong tin co ban</h4>
                <p><strong>Ten:</strong> Quy trinh mo noi soi o bung</p>
                <p><strong>Loai:</strong> Phau thuat</p>
                <p><strong>Khoa:</strong> Ngoai tong hop</p>
            </div>
            <div class="glass-card" style="padding:1rem; margin-bottom:1rem; background:var(--surface-secondary);">
                <h4>Cac buoc: 3 buoc</h4>
                <p>1. Tiep nhan benh nhan (30p)</p>
                <p>2. Chuan bi phong mo (45p)</p>
                <p>3. Thuc hien phau thuat (90p)</p>
            </div>
            <div class="glass-card" style="padding:1rem; background:var(--surface-secondary);">
                <h4>Anh xa: 2 man hinh</h4>
                <p>SCR-PT-001 - Lap lich phau thuat (Chan)</p>
                <p>SCR-PT-002 - Kiem tra thiet bi (Canh bao)</p>
            </div>
        </div>

        <!-- Wizard Actions -->
        <div class="wizard__actions">
            <button class="btn-secondary" disabled>Quay lai</button>
            <div>
                <button class="btn-secondary" style="margin-right:0.5rem;">Luu nhap</button>
                <button class="btn-primary">Tiep theo</button>
            </div>
        </div>
    </div>
</div>

@code {
    private int currentStep = 1;
}
