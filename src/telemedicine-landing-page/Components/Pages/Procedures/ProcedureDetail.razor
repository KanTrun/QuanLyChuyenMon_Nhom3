@page "/procedures/{Id}"
@layout AppLayout

<PageTitle>Chi tiết Quy trình - QLCM Pro</PageTitle>

<!-- Breadcrumb -->
<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/dashboard">Dashboard</a>
    <span class="breadcrumb__sep">&rsaquo;</span>
    <a href="/procedures">Quy trình</a>
    <span class="breadcrumb__sep">&rsaquo;</span>
    <span class="breadcrumb__current">QT-001</span>
</nav>

<!-- Detail Header -->
<div class="detail-header">
    <div>
        <div class="detail-header__title">
            <h1>Quy trình mổ nội soi ổ bụng</h1>
            <div class="detail-header__badges">
                <span class="code-badge">QT-001</span>
                <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoạt động</span>
            </div>
        </div>
    </div>
    <div class="module-page__actions">
        <button class="btn-secondary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M10 1.5l2.5 2.5L5 11.5H2.5V9L10 1.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            Chỉnh sửa
        </button>
        <button class="btn-primary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7l3.5 3.5L12 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Gửi duyệt
        </button>
        <button class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 4h12v8a1 1 0 01-1 1H2a1 1 0 01-1-1V4zM3 4V2.5A1.5 1.5 0 014.5 1h5A1.5 1.5 0 0111 2.5V4" stroke="currentColor" stroke-width="1.5"/></svg>
            Lưu trữ
        </button>
        <button class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11V3h5l3 3v5a1 1 0 01-1 1H4a1 1 0 01-1-1z" stroke="currentColor" stroke-width="1.5"/><path d="M8 3v3h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Xuất PDF
        </button>
    </div>
</div>

<!-- Tab Navigation -->
<div class="tab-nav" role="tablist">
    <button class="tab-nav__item @(activeTab == "overview" ? "tab-nav__item--active" : "")" @onclick='() => activeTab = "overview"' role="tab" aria-selected="@(activeTab == "overview" ? "true" : "false")">Tổng quan</button>
    <button class="tab-nav__item @(activeTab == "steps" ? "tab-nav__item--active" : "")" @onclick='() => activeTab = "steps"' role="tab" aria-selected="@(activeTab == "steps" ? "true" : "false")">Các bước</button>
    <button class="tab-nav__item @(activeTab == "mapping" ? "tab-nav__item--active" : "")" @onclick='() => activeTab = "mapping"' role="tab" aria-selected="@(activeTab == "mapping" ? "true" : "false")">Ánh xạ chức năng</button>
    <button class="tab-nav__item @(activeTab == "versions" ? "tab-nav__item--active" : "")" @onclick='() => activeTab = "versions"' role="tab" aria-selected="@(activeTab == "versions" ? "true" : "false")">Lịch sử phiên bản</button>
    <button class="tab-nav__item @(activeTab == "docs" ? "tab-nav__item--active" : "")" @onclick='() => activeTab = "docs"' role="tab" aria-selected="@(activeTab == "docs" ? "true" : "false")">Tài liệu</button>
</div>

<!-- Tab: Tổng quan -->
@if (activeTab == "overview")
{
    <div class="metadata-grid">
        <div class="metadata-item">
            <span class="metadata-item__label">Mã quy trình</span>
            <span class="metadata-item__value">QT-001</span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Tên quy trình</span>
            <span class="metadata-item__value">Quy trình mổ nội soi ổ bụng</span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Loại quy trình</span>
            <span class="metadata-item__value">Phẫu thuật</span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Khoa/Phòng áp dụng</span>
            <span class="metadata-item__value">Ngoại tổng hợp, Phẫu thuật</span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Ngày tạo</span>
            <span class="metadata-item__value">15/06/2023</span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Người tạo</span>
            <span class="metadata-item__value">PGS.TS. Nguyen Van Hung</span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Trạng thái</span>
            <span class="metadata-item__value"><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoạt động</span></span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Phiên bản hiện tại</span>
            <span class="metadata-item__value">v2.1</span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Thời gian hiệu lực</span>
            <span class="metadata-item__value">15/03/2024 - 15/03/2025</span>
        </div>
        <div class="metadata-item">
            <span class="metadata-item__label">Mô tả</span>
            <span class="metadata-item__value">Quy trình chuẩn hóa các bước thực hiện phẫu thuật nội soi ổ bụng, bao gồm từ khâu chuẩn bị bệnh nhân, gây mê, thực hiện phẫu thuật đến theo dõi hậu phẫu.</span>
        </div>
    </div>
}

<!-- Tab: Các bước -->
@if (activeTab == "steps")
{
    <div class="timeline">
        <div class="timeline__item">
            <div class="timeline__node timeline__node--completed">1</div>
            <div class="timeline__card">
                <div class="timeline__card-title">Tiếp nhận bệnh nhân</div>
                <div class="timeline__card-meta">
                    <span class="timeline__meta-item"><span class="role-badge">Điều dưỡng</span></span>
                    <span class="timeline__meta-item">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 4v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        SLA: 15 phút
                    </span>
                    <span class="timeline__meta-item">ĐK: Bệnh nhân có giấy giới thiệu</span>
                </div>
            </div>
        </div>
        <div class="timeline__item">
            <div class="timeline__node timeline__node--completed">2</div>
            <div class="timeline__card">
                <div class="timeline__card-title">Khám lâm sàng</div>
                <div class="timeline__card-meta">
                    <span class="timeline__meta-item"><span class="role-badge">Bác sĩ</span></span>
                    <span class="timeline__meta-item">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 4v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        SLA: 30 phút
                    </span>
                    <span class="timeline__meta-item">ĐK: Hoàn thành tiếp nhận</span>
                </div>
            </div>
        </div>
        <div class="timeline__item">
            <div class="timeline__node timeline__node--completed">3</div>
            <div class="timeline__card">
                <div class="timeline__card-title">Chi dinh xét nghiệm</div>
                <div class="timeline__card-meta">
                    <span class="timeline__meta-item"><span class="role-badge">Bác sĩ</span></span>
                    <span class="timeline__meta-item">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 4v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        SLA: 10 phút
                    </span>
                </div>
            </div>
        </div>
        <div class="timeline__item">
            <div class="timeline__node">4</div>
            <div class="timeline__card">
                <div class="timeline__card-title">Thực hiện xét nghiệm</div>
                <div class="timeline__card-meta">
                    <span class="timeline__meta-item"><span class="role-badge">Kỹ thuật viên</span></span>
                    <span class="timeline__meta-item">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 4v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        SLA: 60 phút
                    </span>
                    <span class="timeline__meta-item">ĐK: Chỉ định được duyệt</span>
                </div>
            </div>
        </div>
        <div class="timeline__item">
            <div class="timeline__node">5</div>
            <div class="timeline__card">
                <div class="timeline__card-title">Đọc kết quả và kết luận</div>
                <div class="timeline__card-meta">
                    <span class="timeline__meta-item"><span class="role-badge">Bác sĩ</span></span>
                    <span class="timeline__meta-item">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 4v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        SLA: 20 phút
                    </span>
                    <span class="timeline__meta-item">ĐK: Hoàn thành xét nghiệm</span>
                </div>
            </div>
        </div>
    </div>
}

<!-- Tab: Ánh xạ chức năng -->
@if (activeTab == "mapping")
{
    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã màn hình</th>
                    <th>Tên chức năng</th>
                    <th>Chế độ</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="data-table__code">SCR-001</span></td>
                    <td>Màn hình tiếp nhận bệnh nhân</td>
                    <td><span class="status-badge status-badge--pending">Chặn cứng</span></td>
                    <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Đang kích hoạt</span></td>
                </tr>
                <tr>
                    <td><span class="data-table__code">SCR-002</span></td>
                    <td>Màn hình ke don thuốc</td>
                    <td><span class="status-badge status-badge--draft">Cảnh báo</span></td>
                    <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Đang kích hoạt</span></td>
                </tr>
                <tr>
                    <td><span class="data-table__code">SCR-003</span></td>
                    <td>Màn hình chi dinh xét nghiệm</td>
                    <td><span class="status-badge status-badge--pending">Chặn cứng</span></td>
                    <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Đang kích hoạt</span></td>
                </tr>
                <tr>
                    <td><span class="data-table__code">SCR-004</span></td>
                    <td>Màn hình kết luận ca khám</td>
                    <td><span class="status-badge status-badge--draft">Cảnh báo</span></td>
                    <td><span class="status-badge status-badge--superseded"><span class="status-badge__dot"></span>Tạm dừng</span></td>
                </tr>
            </tbody>
        </table>
    </div>
}

<!-- Tab: Lịch sử phiên bản -->
@if (activeTab == "versions")
{
    <div class="version-timeline">
        <div class="version-timeline__item version-timeline__item--active">
            <div class="version-timeline__dot"></div>
            <div class="version-timeline__content">
                <div class="version-timeline__header">
                    <span class="version-timeline__version">v2.1</span>
                    <span class="status-badge status-badge--active">Hiện tại</span>
                </div>
                <div class="version-timeline__desc">Cập nhật bước 3 và 4 - thêm kiểm tra chất lượng mẫu bệnh phẩm</div>
                <div class="version-timeline__meta">15/03/2024 - BS. Nguyen Van A</div>
            </div>
        </div>
        <div class="version-timeline__item version-timeline__item--old">
            <div class="version-timeline__dot"></div>
            <div class="version-timeline__content">
                <div class="version-timeline__header">
                    <span class="version-timeline__version">v2.0</span>
                    <span class="status-badge status-badge--superseded">Đã thay thế</span>
                </div>
                <div class="version-timeline__desc">Thêm bước kiểm tra chất lượng - áp dụng quy trình 5S</div>
                <div class="version-timeline__meta">01/01/2024 - PGS.TS. Tran Thi B</div>
            </div>
        </div>
        <div class="version-timeline__item version-timeline__item--old">
            <div class="version-timeline__dot"></div>
            <div class="version-timeline__content">
                <div class="version-timeline__header">
                    <span class="version-timeline__version">v1.0</span>
                    <span class="status-badge status-badge--archived">Lưu trữ</span>
                </div>
                <div class="version-timeline__desc">Phiên bản đầu tiên - xây dựng theo hướng dẫn của Bộ Y tế</div>
                <div class="version-timeline__meta">15/06/2023 - PGS.TS. Nguyen Van Hung</div>
            </div>
        </div>
    </div>
}

<!-- Tab: Tài liệu -->
@if (activeTab == "docs")
{
    <div class="file-list">
        <div class="file-list__item">
            <div class="file-list__icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 2h5l4 4v8a1 1 0 01-1 1H4a1 1 0 01-1-1V3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.5"/><path d="M9 2v4h4" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <div>
                <div class="file-list__name">SOP_Mo_Noi_Soi_v2.1.pdf</div>
                <div style="font-size: var(--text-xs); color: var(--color-muted);">Quy trình thao tác chuẩn</div>
            </div>
            <span class="file-list__size">2.4 MB</span>
        </div>
        <div class="file-list__item">
            <div class="file-list__icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 2h5l4 4v8a1 1 0 01-1 1H4a1 1 0 01-1-1V3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.5"/><path d="M9 2v4h4" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <div>
                <div class="file-list__name">Huong_Dan_Ky_Thuat_Noi_Soi.pdf</div>
                <div style="font-size: var(--text-xs); color: var(--color-muted);">Tài liệu hướng dẫn kỹ thuật chi tiết</div>
            </div>
            <span class="file-list__size">5.1 MB</span>
        </div>
        <div class="file-list__item">
            <div class="file-list__icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 2h5l4 4v8a1 1 0 01-1 1H4a1 1 0 01-1-1V3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.5"/><path d="M9 2v4h4" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <div>
                <div class="file-list__name">Bieu_Mau_Kiem_Soat_Chat_Luong.docx</div>
                <div style="font-size: var(--text-xs); color: var(--color-muted);">Biểu mẫu kiểm soát và báo cáo</div>
            </div>
            <span class="file-list__size">340 KB</span>
        </div>
    </div>

    <div class="upload-area">
        <div class="upload-area__icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none"><path d="M20 8v16M14 14l6-6 6 6M8 28v4a2 2 0 002 2h20a2 2 0 002-2v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="upload-area__text">Kéo thả tài liệu vào đây hoặc click để tải lên</div>
        <div class="upload-area__hint">Hỗ trợ: PDF, DOCX, XLSX (tối đa 20MB)</div>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }
    private string activeTab = "overview";
}
