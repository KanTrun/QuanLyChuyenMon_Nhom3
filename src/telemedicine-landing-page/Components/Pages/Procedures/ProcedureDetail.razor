@page "/procedures/{Id}"
@layout AppLayout

<PageTitle>Chi tiet Quy trinh - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/dashboard" class="breadcrumb__item">Dashboard</a>
        <span class="breadcrumb__sep">/</span>
        <a href="/procedures" class="breadcrumb__item">Quy trinh</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__item breadcrumb__item--current">Quy trinh mo noi soi o bung</span>
    </nav>

    <!-- Header -->
    <div class="module-page__header">
        <div class="module-page__header-left">
            <h1>Quy trinh mo noi soi o bung</h1>
            <div class="module-page__meta">
                <span class="data-table__code">QT-001</span>
                <span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span>
                <span class="priority-badge priority-badge--normal">v2.1</span>
                <span class="kanban__card-dept">Ngoai tong hop</span>
            </div>
        </div>
        <div class="module-page__actions">
            <button class="btn-secondary" aria-label="Chinh sua">Chinh sua</button>
            <button class="btn-secondary" aria-label="Gui duyet">Gui duyet</button>
            <button class="btn-primary" aria-label="Ban hanh">Ban hanh</button>
            <button class="btn-icon" title="Luu tru" aria-label="Luu tru">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 5h12v8a1 1 0 01-1 1H3a1 1 0 01-1-1V5zM4 5V3.5A1.5 1.5 0 015.5 2h5A1.5 1.5 0 0112 3.5V5" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-animated" role="tablist">
        <button class="tabs-animated__tab tabs-animated__tab--active" role="tab" aria-selected="true">Tong quan</button>
        <button class="tabs-animated__tab" role="tab">Cac buoc</button>
        <button class="tabs-animated__tab" role="tab">Phien ban</button>
        <button class="tabs-animated__tab" role="tab">Tai lieu</button>
        <button class="tabs-animated__tab" role="tab">Nhat ky</button>
    </div>

    <!-- Tab 1: Tong quan -->
    <div class="tabs-animated__content" data-tab="overview">
        <div class="glass-card" style="padding:1.5rem; margin-bottom:1.5rem;">
            <h3 style="margin-bottom:1rem;">Thong tin chung</h3>
            <div class="detail-grid">
                <div class="detail-grid__item"><span class="detail-grid__label">Ma quy trinh</span><span class="detail-grid__value">QT-001</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Loai</span><span class="detail-grid__value">Phau thuat</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Khoa/Phong</span><span class="detail-grid__value">Ngoai tong hop</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Nguoi tao</span><span class="detail-grid__value">BS. Nguyen Van An</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Ngay tao</span><span class="detail-grid__value">10/01/2024</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Hieu luc tu</span><span class="detail-grid__value">15/03/2024</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Hieu luc den</span><span class="detail-grid__value">15/03/2025</span></div>
                <div class="detail-grid__item"><span class="detail-grid__label">Lan cap nhat cuoi</span><span class="detail-grid__value">15/03/2024</span></div>
            </div>
        </div>
        <div class="glass-card" style="padding:1.5rem; margin-bottom:1.5rem;">
            <h3 style="margin-bottom:1rem;">Mo ta</h3>
            <p>Quy trinh ky thuat mo noi soi o bung ap dung cho cac truong hop can phau thuat noi soi chan doan va dieu tri cac benh ly vung bung. Quy trinh bao gom cac buoc tu chuan bi benh nhan, tien me, thuc hien phau thuat, den theo doi hau phau.</p>
        </div>
        <div class="glass-card" style="padding:1.5rem;">
            <h3 style="margin-bottom:1rem;">Anh xa chuc nang</h3>
            <table class="data-table">
                <thead><tr><th>Ma man hinh</th><th>Ten chuc nang</th><th>Che do kiem soat</th></tr></thead>
                <tbody>
                    <tr><td>SCR-PT-001</td><td>Lap lich phau thuat</td><td><span class="status-badge status-badge--active">Chan</span></td></tr>
                    <tr><td>SCR-PT-002</td><td>Kiem tra thiet bi</td><td><span class="status-badge status-badge--pending">Canh bao</span></td></tr>
                    <tr><td>SCR-PT-003</td><td>Bien ban phau thuat</td><td><span class="status-badge status-badge--active">Chan</span></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab 2: Cac buoc -->
    <div class="tabs-animated__content" data-tab="steps" style="display:none;">
        <div class="glass-card" style="padding:1.5rem;">
            <div class="step-list stagger-children">
                <div class="step-list__item">
                    <span class="step-list__grip" aria-hidden="true">&#8942;&#8942;</span>
                    <span class="step-list__number">1</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Tiep nhan va danh gia benh nhan</div>
                        <div class="step-list__desc">Kiem tra ho so, xac nhan chi dinh phau thuat, danh gia tien me ASA</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--normal">BS. Phau thuat</span><span>SLA: 30 phut</span></div>
                    </div>
                </div>
                <div class="step-list__item">
                    <span class="step-list__grip" aria-hidden="true">&#8942;&#8942;</span>
                    <span class="step-list__number">2</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Chuan bi phong mo va thiet bi</div>
                        <div class="step-list__desc">Kiem tra he thong noi soi, khi CO2, dung cu phau thuat, monitor</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--normal">KTV. Phong mo</span><span>SLA: 45 phut</span></div>
                    </div>
                </div>
                <div class="step-list__item">
                    <span class="step-list__grip" aria-hidden="true">&#8942;&#8942;</span>
                    <span class="step-list__number">3</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Gay me - Gay te</div>
                        <div class="step-list__desc">Tien hanh gay me noi khi quan theo phac do, dat duong truyen TM</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--normal">BS. Gay me</span><span>SLA: 20 phut</span></div>
                    </div>
                </div>
                <div class="step-list__item">
                    <span class="step-list__grip" aria-hidden="true">&#8942;&#8942;</span>
                    <span class="step-list__number">4</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Thuc hien phau thuat noi soi</div>
                        <div class="step-list__desc">Bom hoi o bung, dat trocar, tham sat va thuc hien phau thuat theo ke hoach</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--urgent">BS. Phau thuat chinh</span><span>SLA: 90 phut</span></div>
                    </div>
                </div>
                <div class="step-list__item">
                    <span class="step-list__grip" aria-hidden="true">&#8942;&#8942;</span>
                    <span class="step-list__number">5</span>
                    <div class="step-list__content">
                        <div class="step-list__name">Ket thuc va chuyen hoi tinh</div>
                        <div class="step-list__desc">Rut trocar, dong vet mo, chuyen phong hoi tinh, ban giao benh nhan</div>
                        <div class="step-list__meta"><span class="priority-badge priority-badge--normal">BS. Gay me + DD</span><span>SLA: 30 phut</span></div>
                    </div>
                </div>
            </div>
            <button class="btn-secondary" style="margin-top:1rem;">+ Them buoc</button>
        </div>
    </div>

    <!-- Tab 3: Phien ban -->
    <div class="tabs-animated__content" data-tab="versions" style="display:none;">
        <div class="status-timeline stagger-children">
            <div class="status-timeline__item status-timeline__item--success">
                <div><strong>v2.1</strong> - 15/03/2024 - BS. Nguyen Van An</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Bo sung buoc kiem tra thiet bi truoc PT. <span class="status-badge status-badge--active">Hoat dong</span></div>
            </div>
            <div class="status-timeline__item">
                <div><strong>v2.0</strong> - 01/02/2024 - BS. Nguyen Van An</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Cap nhat theo Thong tu 32/2023/TT-BYT</div>
            </div>
            <div class="status-timeline__item">
                <div><strong>v1.5</strong> - 15/10/2023 - BS. Tran Quoc Dat</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Chinh sua quy trinh tien me</div>
            </div>
            <div class="status-timeline__item">
                <div><strong>v1.0</strong> - 01/06/2023 - BS. Nguyen Van An</div>
                <div style="font-size:0.8125rem; color:var(--text-secondary);">Phien ban khoi tao</div>
            </div>
        </div>
        <div class="diff-view" style="margin-top:1.5rem;">
            <div class="diff-view__header"><span>v2.0</span><span>v2.1</span></div>
            <div class="diff-view__panel diff-view__panel--before">
                <div class="diff-view__line">Buoc 1: Tiep nhan benh nhan</div>
                <div class="diff-view__line">Buoc 2: Chuan bi phong mo</div>
                <div class="diff-view__line diff-view__line--removed">Buoc 3: Gay me</div>
            </div>
            <div class="diff-view__panel diff-view__panel--after">
                <div class="diff-view__line">Buoc 1: Tiep nhan benh nhan</div>
                <div class="diff-view__line diff-view__line--added">Buoc 2: Kiem tra thiet bi noi soi</div>
                <div class="diff-view__line">Buoc 3: Chuan bi phong mo</div>
            </div>
        </div>
    </div>

    <!-- Tab 4: Tai lieu -->
    <div class="tabs-animated__content" data-tab="attachments" style="display:none;">
        <div class="glass-card" style="padding:1.5rem; margin-bottom:1.5rem;">
            <table class="data-table">
                <thead><tr><th>Loai</th><th>Ten file</th><th>Kich thuoc</th><th>Nguoi tai</th><th>Ngay</th><th>Thao tac</th></tr></thead>
                <tbody>
                    <tr><td>PDF</td><td>Huong_dan_mo_noi_soi.pdf</td><td>2.4 MB</td><td>BS. Nguyen Van An</td><td>15/03/2024</td><td><button class="action-btn" title="Tai ve">&#8595;</button></td></tr>
                    <tr><td>DOC</td><td>Bien_ban_mau_phau_thuat.docx</td><td>156 KB</td><td>DD. Tran Thi Hoa</td><td>01/02/2024</td><td><button class="action-btn" title="Tai ve">&#8595;</button></td></tr>
                    <tr><td>XLS</td><td>Checklist_thiet_bi.xlsx</td><td>89 KB</td><td>KTV. Le Van Hung</td><td>10/01/2024</td><td><button class="action-btn" title="Tai ve">&#8595;</button></td></tr>
                </tbody>
            </table>
        </div>
        <div class="file-upload-zone" aria-label="Keo tha file">
            <div class="file-upload-zone__icon">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><path d="M24 32V16M18 22l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><rect x="8" y="8" width="32" height="32" rx="4" stroke="currentColor" stroke-width="2"/></svg>
            </div>
            <div class="file-upload-zone__text">Keo tha file vao day</div>
            <div class="file-upload-zone__hint">Hoac click de chon file (PDF, DOC, XLS - Toi da 10MB)</div>
        </div>
    </div>

    <!-- Tab 5: Nhat ky -->
    <div class="tabs-animated__content" data-tab="auditlog" style="display:none;">
        <div class="glass-card" style="padding:1.5rem;">
            <table class="data-table" aria-label="Nhat ky thay doi">
                <thead><tr><th>Thoi gian</th><th>Nguoi thuc hien</th><th>Hanh dong</th><th>Chi tiet</th></tr></thead>
                <tbody>
                    <tr><td>15/03/2024 14:30</td><td>BS. Nguyen Van An</td><td><span class="status-badge status-badge--active">Cap nhat</span></td><td>Cap nhat phien ban 2.1 - Bo sung buoc kiem tra thiet bi</td></tr>
                    <tr><td>15/03/2024 10:00</td><td>PGD. Vo Thi Lan</td><td><span class="status-badge status-badge--active">Phe duyet</span></td><td>Phe duyet ban hanh phien ban 2.1</td></tr>
                    <tr><td>10/03/2024 09:15</td><td>BS. Nguyen Van An</td><td><span class="status-badge status-badge--pending">Gui duyet</span></td><td>Gui phien ban 2.1 de xet duyet</td></tr>
                    <tr><td>01/02/2024 16:45</td><td>BS. Nguyen Van An</td><td><span class="status-badge status-badge--draft">Chinh sua</span></td><td>Sua doi noi dung buoc 2 va buoc 4</td></tr>
                    <tr><td>01/02/2024 08:30</td><td>Admin</td><td><span class="status-badge status-badge--active">Ban hanh</span></td><td>Ban hanh phien ban 2.0 toan benh vien</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; }
    private string activeTab = "overview";
}
