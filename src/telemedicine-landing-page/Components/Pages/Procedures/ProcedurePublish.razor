@page "/procedures/publish"
@layout AppLayout

<PageTitle>Ban hành Quy trình - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <h1>Ban hành Quy trình</h1>
        <p>Theo dõi trạng thái ban hành các phiên bản quy trình</p>
    </div>
    <div class="module-page__actions">
        <button class="btn-secondary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 2h10v10H2z" stroke="currentColor" stroke-width="1.5" rx="1"/><path d="M5 5h4M5 7h4M5 9h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Xem danh sách
        </button>
    </div>
</div>

<!-- Kanban Board -->
<div class="kanban-board">
    <!-- Column: Nhap (Draft) -->
    <div class="kanban-column kanban-column--draft">
        <div class="kanban-column__header">
            <span class="kanban-column__title">Nháp</span>
            <span class="kanban-column__count">2</span>
        </div>
        <div class="kanban-column__body">
            <div class="kanban-card">
                <div class="kanban-card__handle"></div>
                <div class="kanban-card__title">QT Mổ tim hở</div>
                <div class="kanban-card__meta">
                    <span class="kanban-card__version">v3.0</span>
                    <span class="kanban-card__tag">Tim mạch</span>
                </div>
                <div class="kanban-card__meta" style="margin-top: var(--space-2);">
                    <span>BS. Tran Van B</span>
                    <span>10/04/2024</span>
                </div>
            </div>
            <div class="kanban-card">
                <div class="kanban-card__handle"></div>
                <div class="kanban-card__title">QT Chăm sóc sau mổ</div>
                <div class="kanban-card__meta">
                    <span class="kanban-card__version">v2.0</span>
                    <span class="kanban-card__tag">Điều dưỡng</span>
                </div>
