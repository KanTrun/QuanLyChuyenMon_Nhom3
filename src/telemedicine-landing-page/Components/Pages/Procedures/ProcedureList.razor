            <div class="kanban__column-header"><span class="kanban__column-title">Cho duyet</span><span class="kanban__column-count">2</span></div>
            <div class="kanban__card tilt-card"><div class="kanban__card-title">Quy trinh phau thuat noi soi khop goi</div><span class="kanban__card-dept">Chinh hinh</span><div class="kanban__card-meta"><span class="kanban__card-version">v1.2</span><span class="kanban__card-avatar">DT</span></div></div>
