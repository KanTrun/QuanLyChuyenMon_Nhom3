        </div>
        <div class="kanban__column kanban__column--approved">
            <div class="kanban__column-header"><span class="kanban__column-title">Da duyet</span><span class="kanban__column-count">2</span></div>
            <div class="kanban__card tilt-card"><div class="kanban__card-title">Quy trinh CT-Scanner 128 lat</div><span class="kanban__card-dept">CDHA</span><div class="kanban__card-meta"><span class="kanban__card-version">v2.0</span><span class="kanban__card-avatar">PL</span></div></div>
            <div class="kanban__card tilt-card"><div class="kanban__card-title">Quy trinh MRI nao</div><span class="kanban__card-dept">CDHA</span><div class="kanban__card-meta"><span class="kanban__card-version">v1.5</span><span class="kanban__card-avatar">KA</span></div></div>
