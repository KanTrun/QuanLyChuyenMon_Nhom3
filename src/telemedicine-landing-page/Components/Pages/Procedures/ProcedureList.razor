@page "/procedures"
@layout AppLayout

<PageTitle>Quy trinh Ky thuat Chuyen mon - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <!-- Page Header -->
    <div class="module-page__header">
        <div class="module-page__header-left">
            <h1>Quy trinh Ky thuat Chuyen mon</h1>
            <p>Quan ly toan bo quy trinh hoat dong chuyen mon</p>
        </div>
        <div class="module-page__actions">
            <div class="view-toggle" role="tablist" aria-label="Che do xem">
                <button class="view-toggle__btn view-toggle__btn--active" aria-label="Bang" data-view="table">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="5" height="3" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="1" y="6" width="5" height="3" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="8" y="1" width="5" height="3" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="8" y="6" width="5" height="3" rx="0.5" stroke="currentColor" stroke-width="1.2"/></svg>
                    Bang
                </button>
                <button class="view-toggle__btn" aria-label="Kanban" data-view="kanban">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="3" height="12" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="5.5" y="1" width="3" height="8" rx="0.5" stroke="currentColor" stroke-width="1.2"/><rect x="10" y="1" width="3" height="10" rx="0.5" stroke="currentColor" stroke-width="1.2"/></svg>
                    Kanban
                </button>
                <button class="view-toggle__btn" aria-label="Timeline" data-view="timeline">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M3 4h8M3 7h8M3 10h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Timeline
                </button>
            </div>
            <button class="btn-icon" title="Xuat PDF" aria-label="Xuat PDF">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 1h5l4 4v9a1 1 0 01-1 1H4a1 1 0 01-1-1V2a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3"/><path d="M9 1v4h4" stroke="currentColor" stroke-width="1.3"/></svg>
            </button>
            <button class="btn-icon" title="Xuat Excel" aria-label="Xuat Excel">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="1" stroke="currentColor" stroke-width="1.3"/><path d="M5 5l6 6M11 5l-6 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            </button>
            <a href="/procedures/create" class="btn-primary">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                Tao quy trinh moi
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-panel">
        <div class="filter-bar__search">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input type="text" class="filter-panel__input" placeholder="Tim kiem quy trinh..." aria-label="Tim kiem quy trinh" />
        </div>
        <div class="filter-bar__chips">
            <span class="filter-chip filter-chip--active">Tat ca <span class="filter-chip__count">128</span></span>
            <span class="filter-chip">Nhap <span class="filter-chip__count">23</span></span>
            <span class="filter-chip">Cho duyet <span class="filter-chip__count">15</span></span>
            <span class="filter-chip">Hoat dong <span class="filter-chip__count">78</span></span>
            <span class="filter-chip">Luu tru <span class="filter-chip__count">12</span></span>
        </div>
        <select class="filter-panel__input" aria-label="Khoa phong">
            <option>Tat ca khoa/phong</option>
            <option>Ngoai tong hop</option>
            <option>Noi tong hop</option>
            <option>Xet nghiem</option>
            <option>Chan doan hinh anh</option>
            <option>San phu khoa</option>
        </select>
        <select class="filter-panel__input" aria-label="Sap xep">
            <option>Moi nhat</option>
            <option>Ten A-Z</option>
            <option>Ten Z-A</option>
            <option>Phien ban</option>
        </select>
        <div class="date-range-picker">
            <input type="date" class="date-range-picker__input" aria-label="Tu ngay" />
            <span class="date-range-picker__sep">-</span>
            <input type="date" class="date-range-picker__input" aria-label="Den ngay" />
        </div>
    </div>

    <!-- Bulk Actions -->
    <div class="bulk-actions" style="display:none;" aria-label="Thao tac hang loat">
        <span class="bulk-actions__count">3 muc da chon</span>
        <button class="bulk-actions__btn">Phe duyet</button>
        <button class="bulk-actions__btn">Luu tru</button>
        <button class="bulk-actions__btn bulk-actions__btn--danger">Xoa</button>
    </div>

    <!-- TABLE VIEW -->
    <div class="data-table-container glass-card" data-view-content="table">
        <table class="data-table" aria-label="Danh sach quy trinh">
            <thead>
                <tr>
                    <th><input type="checkbox" aria-label="Chon tat ca" /></th>
                    <th>Ma QT</th>
                    <th>Ten quy trinh</th>
                    <th>Khoa/Phong</th>
                    <th>Trang thai</th>
                    <th>Phien ban</th>
                    <th>Ngay cap nhat</th>
                    <th>Thao tac</th>
                </tr>
            </thead>
            <tbody class="stagger-children">
                <tr>
                    <td><input type="checkbox" aria-label="Chon QT-001" /></td>
                    <td><span class="data-table__code">QT-001</span></td>
                    <td><span class="data-table__name">Quy trinh mo noi soi o bung</span></td>
                    <td><span class="data-table__dept">Ngoai tong hop</span></td>
                    <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td>
                    <td>v2.1</td>
                    <td>15/03/2024</td>
                    <td><div class="actions-cell"><a href="/procedures/QT-001" class="action-btn" title="Xem">&#128065;</a><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn action-btn--danger" title="Luu tru">&#128451;</button></div></td>
                </tr>
                <tr>
                    <td><input type="checkbox" aria-label="Chon QT-002" /></td>
                    <td><span class="data-table__code">QT-002</span></td>
                    <td><span class="data-table__name">Quy trinh xet nghiem dong mau</span></td>
                    <td><span class="data-table__dept">Xet nghiem</span></td>
                    <td><span class="status-badge status-badge--draft"><span class="status-badge__dot"></span>Nhap</span></td>
                    <td>v1.0</td>
                    <td>10/04/2024</td>
                    <td><div class="actions-cell"><a href="/procedures/QT-002" class="action-btn" title="Xem">&#128065;</a><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn action-btn--danger" title="Luu tru">&#128451;</button></div></td>
                </tr>
                <tr>
                    <td><input type="checkbox" aria-label="Chon QT-003" /></td>
                    <td><span class="data-table__code">QT-003</span></td>
                    <td><span class="data-table__name">Quy trinh truyen mau va che pham mau</span></td>
                    <td><span class="data-table__dept">Huyet hoc</span></td>
                    <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td>
                    <td>v3.2</td>
                    <td>22/02/2024</td>
                    <td><div class="actions-cell"><a href="/procedures/QT-003" class="action-btn" title="Xem">&#128065;</a><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn action-btn--danger" title="Luu tru">&#128451;</button></div></td>
                </tr>
                <tr>
                    <td><input type="checkbox" aria-label="Chon QT-004" /></td>
                    <td><span class="data-table__code">QT-004</span></td>
                    <td><span class="data-table__name">Quy trinh phau thuat noi soi khop goi</span></td>
                    <td><span class="data-table__dept">Chinh hinh</span></td>
                    <td><span class="status-badge status-badge--pending"><span class="status-badge__dot"></span>Cho duyet</span></td>
                    <td>v1.2</td>
                    <td>05/04/2024</td>
                    <td><div class="actions-cell"><a href="/procedures/QT-004" class="action-btn" title="Xem">&#128065;</a><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn action-btn--danger" title="Luu tru">&#128451;</button></div></td>
                </tr>
                <tr>
                    <td><input type="checkbox" aria-label="Chon QT-005" /></td>
                    <td><span class="data-table__code">QT-005</span></td>
                    <td><span class="data-table__name">Quy trinh cham soc vet thuong man tinh</span></td>
                    <td><span class="data-table__dept">Dieu duong</span></td>
                    <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td>
                    <td>v3.0</td>
                    <td>18/03/2024</td>
                    <td><div class="actions-cell"><a href="/procedures/QT-005" class="action-btn" title="Xem">&#128065;</a><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn action-btn--danger" title="Luu tru">&#128451;</button></div></td>
                </tr>
                <tr>
                    <td><input type="checkbox" aria-label="Chon QT-006" /></td>
                    <td><span class="data-table__code">QT-006</span></td>
