                    <td><div class="actions-cell"><a href="/procedures/QT-008" class="action-btn" title="Xem">&#128065;</a><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn action-btn--danger" title="Luu tru">&#128451;</button></div></td>
