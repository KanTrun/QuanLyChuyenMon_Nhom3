            <div class="kanban__column-header"><span class="kanban__column-title">Nhap</span><span class="kanban__column-count">3</span></div>
            <div class="kanban__card tilt-card"><div class="kanban__card-title">Quy trinh xet nghiem dong mau</div><span class="kanban__card-dept">Xet nghiem</span><div class="kanban__card-meta"><span class="kanban__card-version">v1.0</span><span class="kanban__card-avatar">NV</span></div></div>
            <div class="kanban__card tilt-card"><div class="kanban__card-title">Quy trinh noi soi dai trang</div><span class="kanban__card-dept">Tieu hoa</span><div class="kanban__card-meta"><span class="kanban__card-version">v1.0</span><span class="kanban__card-avatar">TH</span></div></div>
