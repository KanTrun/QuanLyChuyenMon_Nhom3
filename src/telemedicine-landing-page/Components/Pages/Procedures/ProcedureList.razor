                    <td><span class="data-table__dept">Cap cuu</span></td>
                    <td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td>
                    <td>v4.1</td>
                    <td>28/01/2024</td>
                    <td><div class="actions-cell"><a href="/procedures/QT-007" class="action-btn" title="Xem">&#128065;</a><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn action-btn--danger" title="Luu tru">&#128451;</button></div></td>
                </tr>
                <tr>
