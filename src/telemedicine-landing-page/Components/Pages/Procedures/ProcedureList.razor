        </span>
        <input type="text" placeholder="Tìm kiếm quy trình..." />
    </div>
    <div class="filter-bar__chips">
        <span class="filter-chip filter-chip--active">Tất cả <span class="filter-chip__count">128</span></span>
        <span class="filter-chip">Nhap <span class="filter-chip__count">23</span></span>
        <span class="filter-chip">Chờ duyệt <span class="filter-chip__count">15</span></span>
        <span class="filter-chip">Hoạt động <span class="filter-chip__count">78</span></span>
        <span class="filter-chip">Lưu trữ <span class="filter-chip__count">12</span></span>
    </div>
    <select class="filter-bar__select">
        <option>Tất cả khoa/phòng</option>
        <option>Ngoại tổng hợp</option>
        <option>Nội tổng hợp</option>
        <option>Xét nghiệm</option>
        <option>Chẩn đoán hình ảnh</option>
        <option>Sản phụ khoa</option>
        <option>Nhi khoa</option>
        <option>Tim mạch</option>
        <option>Phẫu thuật</option>
    </select>
    <select class="filter-bar__select">
        <option>Mới nhất</option>
        <option>Ten A-Z</option>
        <option>Ten Z-A</option>
        <option>Phiên bản</option>
    </select>
</div>

