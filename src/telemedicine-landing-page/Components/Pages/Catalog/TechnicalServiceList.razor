@page "/catalog"
@layout AppLayout

<PageTitle>Danh muc Ky thuat - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <h1>Danh muc Ky thuat &amp; Dinh muc</h1>
        <p>Quan ly dich vu ky thuat va dinh muc tai nguyen</p>
    </div>
    <div class="module-page__actions">
        <button class="btn-primary" aria-label="Them dich vu moi">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Them dich vu
        </button>
    </div>
</div>

<!-- Stats Row -->
<div class="stats-row">
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Tong dich vu</div>
        <div class="stat-card-mini__value stat-card-mini__value--primary">48</div>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Dang hoat dong</div>
        <div class="stat-card-mini__value stat-card-mini__value--success">42</div>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Tong dinh muc</div>
        <div class="stat-card-mini__value">312</div>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Canh bao ton kho</div>
        <div class="stat-card-mini__value stat-card-mini__value--danger">5</div>
    </div>
</div>

<!-- Category Tabs -->
<div class="category-tabs" role="tablist" aria-label="Danh muc dich vu">
    <button class="category-tab @(activeCategory == "all" ? "category-tab--active" : "")" role="tab" @onclick='() => activeCategory = "all"'>Tat ca <span class="category-tab__count">48</span></button>
    <button class="category-tab @(activeCategory == "xn" ? "category-tab--active" : "")" role="tab" @onclick='() => activeCategory = "xn"'>Xet nghiem <span class="category-tab__count">15</span></button>
    <button class="category-tab @(activeCategory == "cdha" ? "category-tab--active" : "")" role="tab" @onclick='() => activeCategory = "cdha"'>Chan doan hinh anh <span class="category-tab__count">10</span></button>
    <button class="category-tab @(activeCategory == "tt" ? "category-tab--active" : "")" role="tab" @onclick='() => activeCategory = "tt"'>Thu thuat <span class="category-tab__count">8</span></button>
    <button class="category-tab @(activeCategory == "pt" ? "category-tab--active" : "")" role="tab" @onclick='() => activeCategory = "pt"'>Phau thuat <span class="category-tab__count">9</span></button>
    <button class="category-tab @(activeCategory == "ns" ? "category-tab--active" : "")" role="tab" @onclick='() => activeCategory = "ns"'>Noi soi <span class="category-tab__count">6</span></button>
</div>

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="filter-bar__search">
        <span class="filter-bar__search-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <input type="text" placeholder="Tim kiem dich vu..." aria-label="Tim kiem dich vu" />
    </div>
    <select class="filter-bar__select" aria-label="Loc theo khoa">
        <option>Tat ca khoa/phong</option>
        <option>Xet nghiem</option>
        <option>Chan doan hinh anh</option>
        <option>Ngoai khoa</option>
        <option>Noi khoa</option>
    </select>
    <select class="filter-bar__select" aria-label="Loc theo trang thai">
        <option>Tat ca trang thai</option>
        <option>Active</option>
        <option>Draft</option>
    </select>
    <div class="view-toggle" role="group" aria-label="Che do hien thi">
        <button class="view-toggle__btn view-toggle__btn--active" aria-label="Danh sach" title="Danh sach">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button class="view-toggle__btn" aria-label="Luoi" title="Luoi">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
    </div>
</div>

