@page "/catalog"
@layout AppLayout

<PageTitle>Danh mục Kỹ thuật - QLCM Pro</PageTitle>

<!-- Page Header -->
<div class="module-page__header">
    <div class="module-page__header-left">
        <h1>Danh mục Kỹ thuật &amp; Định mức</h1>
        <p>Quản lý dịch vụ kỹ thuật va định mức tài nguyên</p>
    </div>
    <div class="module-page__actions">
        <button class="btn-primary" aria-label="Thêm dịch vụ mới">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Thêm dịch vụ
        </button>
    </div>
</div>

<!-- Stats Row -->
<div class="stats-row">
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Tổng dịch vụ</div>
        <div class="stat-card-mini__value stat-card-mini__value--primary">48</div>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Đang hoạt động</div>
        <div class="stat-card-mini__value stat-card-mini__value--success">42</div>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Tổng định mức</div>
        <div class="stat-card-mini__value">312</div>
    </div>
    <div class="stat-card-mini">
        <div class="stat-card-mini__label">Cảnh báo tồn kho</div>
        <div class="stat-card-mini__value stat-card-mini__value--danger">5</div>
    </div>
</div>

<!-- Category Tabs -->
<div class="category-tabs" role="tablist" aria-label="Danh mục dịch vụ">
    <button class="category-tab @(activeCategory == "all" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeCategory == "all" ? "true" : "false")" @onclick='() => activeCategory = "all"' >Tất cả <span class="category-tab__count">48</span></button>
    <button class="category-tab @(activeCategory == "xn" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeCategory == "xn" ? "true" : "false")" @onclick='() => activeCategory = "xn"' >Xét nghiệm <span class="category-tab__count">15</span></button>
    <button class="category-tab @(activeCategory == "cdha" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeCategory == "cdha" ? "true" : "false")" @onclick='() => activeCategory = "cdha"' >Chẩn đoán hình ảnh <span class="category-tab__count">10</span></button>
    <button class="category-tab @(activeCategory == "tt" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeCategory == "tt" ? "true" : "false")" @onclick='() => activeCategory = "tt"' >Thủ thuật <span class="category-tab__count">8</span></button>
    <button class="category-tab @(activeCategory == "pt" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeCategory == "pt" ? "true" : "false")" @onclick='() => activeCategory = "pt"' >Phẫu thuật <span class="category-tab__count">9</span></button>
    <button class="category-tab @(activeCategory == "ns" ? "category-tab--active" : "")" role="tab" aria-selected="@(activeCategory == "ns" ? "true" : "false")" @onclick='() => activeCategory = "ns"' >Nội soi <span class="category-tab__count">6</span></button>
</div>

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="filter-bar__search">
        <span class="filter-bar__search-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <input type="text" placeholder="Tìm kiếm dịch vụ..." aria-label="Tìm kiếm dịch vụ" />
    </div>
    <select class="filter-bar__select" aria-label="Lọc theo khoa">
        <option>Tất cả khoa/phòng</option>
        <option>Xét nghiệm</option>
        <option>Chẩn đoán hình ảnh</option>
        <option>Ngoại khoa</option>
        <option>Nội khoa</option>
    </select>
    <select class="filter-bar__select" aria-label="Lọc theo trạng thái">
        <option>Tất cả trang thai</option>
        <option>Active</option>
        <option>Draft</option>
    </select>
    <div class="view-toggle" role="group" aria-label="Chế độ hiển thị">
        <button class="view-toggle__btn view-toggle__btn--active" aria-label="Danh sách" title="Danh sách">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button class="view-toggle__btn" aria-label="Lưới" title="Lưới">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
    </div>
</div>

