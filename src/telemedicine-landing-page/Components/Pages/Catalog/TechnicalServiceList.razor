@page "/catalog/services"
@layout AppLayout

<PageTitle>Danh muc Ky thuat Chuyen mon - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <div class="module-page__header">
        <div class="module-page__header-left">
            <h1>Danh muc Ky thuat Chuyen mon</h1>
            <p>Quan ly danh muc cac ky thuat y te</p>
        </div>
        <div class="module-page__actions">
            <button class="btn-primary" aria-label="Them ky thuat moi">+ Them ky thuat</button>
        </div>
    </div>

    <!-- Category Tabs -->
    <div class="tabs-animated" style="margin-bottom:1.5rem;">
        <button class="tabs-animated__tab tabs-animated__tab--active">Tat ca</button>
        <button class="tabs-animated__tab">Noi khoa</button>
        <button class="tabs-animated__tab">Ngoai khoa</button>
        <button class="tabs-animated__tab">San khoa</button>
        <button class="tabs-animated__tab">Chan doan hinh anh</button>
        <button class="tabs-animated__tab">Xet nghiem</button>
    </div>

    <!-- Search & Filter -->
    <div class="filter-panel">
        <input type="text" class="filter-panel__input" placeholder="Tim kiem ky thuat..." aria-label="Tim kiem" style="flex:1;" />
        <select class="filter-panel__input" aria-label="Trang thai">
            <option>Tat ca trang thai</option>
            <option>Dang hoat dong</option>
            <option>Tam ngung</option>
        </select>
    </div>

    <!-- Data Table grouped by department -->
    <div class="glass-card" style="padding:1.25rem;">
        <!-- Group: Ngoai khoa -->
        <div class="accordion__item accordion__item--open" style="margin-bottom:1rem;">
            <div style="display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0; font-weight:600; font-size:0.875rem; color:var(--text-primary); border-bottom:1px solid var(--border-color); margin-bottom:0.75rem;">
                <span>Ngoai khoa</span><span class="kanban__column-count">4</span>
            </div>
            <table class="data-table" aria-label="Ky thuat Ngoai khoa">
                <thead><tr><th>Ma KT</th><th>Ten ky thuat</th><th>Loai</th><th>Trang thai</th><th>Dinh muc</th><th>Thao tac</th></tr></thead>
                <tbody class="stagger-children">
                    <tr><td>KT-N001</td><td>Phau thuat noi soi cat tui mat</td><td>Phau thuat</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>12 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                    <tr><td>KT-N002</td><td>Phau thuat noi soi ruot thua</td><td>Phau thuat</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>10 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                    <tr><td>KT-N003</td><td>Phau thuat thay khop hang toan phan</td><td>Phau thuat</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>18 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                    <tr><td>KT-N004</td><td>Mo noi soi khop vai</td><td>Thu thuat</td><td><span class="status-badge status-badge--draft"><span class="status-badge__dot"></span>Tam ngung</span></td><td>8 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                </tbody>
            </table>
        </div>

        <!-- Group: Chan doan hinh anh -->
        <div class="accordion__item accordion__item--open" style="margin-bottom:1rem;">
            <div style="display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0; font-weight:600; font-size:0.875rem; color:var(--text-primary); border-bottom:1px solid var(--border-color); margin-bottom:0.75rem;">
                <span>Chan doan hinh anh</span><span class="kanban__column-count">3</span>
            </div>
            <table class="data-table" aria-label="Ky thuat CDHA">
                <thead><tr><th>Ma KT</th><th>Ten ky thuat</th><th>Loai</th><th>Trang thai</th><th>Dinh muc</th><th>Thao tac</th></tr></thead>
                <tbody>
                    <tr><td>KT-C001</td><td>Chup CT-Scanner 128 lat co tiem thuoc</td><td>Chan doan</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>6 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                    <tr><td>KT-C002</td><td>Chup MRI 1.5 Tesla</td><td>Chan doan</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>5 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                    <tr><td>KT-C003</td><td>Sieu am Doppler mau mach mau</td><td>Chan doan</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>4 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                </tbody>
            </table>
        </div>

        <!-- Group: Xet nghiem -->
        <div class="accordion__item accordion__item--open">
            <div style="display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0; font-weight:600; font-size:0.875rem; color:var(--text-primary); border-bottom:1px solid var(--border-color); margin-bottom:0.75rem;">
                <span>Xet nghiem</span><span class="kanban__column-count">3</span>
            </div>
            <table class="data-table" aria-label="Ky thuat Xet nghiem">
                <thead><tr><th>Ma KT</th><th>Ten ky thuat</th><th>Loai</th><th>Trang thai</th><th>Dinh muc</th><th>Thao tac</th></tr></thead>
                <tbody>
                    <tr><td>KT-X001</td><td>Xet nghiem cong thuc mau toan phan</td><td>Xet nghiem</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>5 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                    <tr><td>KT-X002</td><td>Xet nghiem sinh hoa mau 17 chi so</td><td>Xet nghiem</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>8 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                    <tr><td>KT-X003</td><td>Xet nghiem PCR SARS-CoV-2</td><td>Xet nghiem</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Hoat dong</span></td><td>6 muc</td><td><div class="actions-cell"><button class="action-btn" title="Sua">&#9998;</button><button class="action-btn" title="Dinh muc">&#128202;</button></div></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Quick-add Modal -->
    <div class="modal-dialog" aria-hidden="true" data-modal="add-service">
        <div class="modal-dialog__backdrop"></div>
        <div class="modal-dialog__content">
            <div class="modal-dialog__header"><span class="modal-dialog__title">Them ky thuat moi</span><button class="slide-over__close">&times;</button></div>
            <div class="modal-dialog__body">
                <div class="form-group"><label class="form-label">Ma ky thuat</label><input type="text" class="form-input" placeholder="KT-XXX" /></div>
                <div class="form-group"><label class="form-label">Ten ky thuat</label><input type="text" class="form-input" placeholder="Nhap ten..." /></div>
                <div class="form-group"><label class="form-label">Loai</label><select class="form-input"><option>Phau thuat</option><option>Thu thuat</option><option>Chan doan</option><option>Xet nghiem</option></select></div>
                <div class="form-group"><label class="form-label">Khoa</label><select class="form-input"><option>Ngoai khoa</option><option>CDHA</option><option>Xet nghiem</option><option>Noi khoa</option></select></div>
            </div>
            <div class="modal-dialog__footer"><button class="btn-secondary">Huy</button><button class="btn-primary">Luu</button></div>
        </div>
    </div>
</div>

@code {
    private string activeCategory = "all";
}
