@page "/catalog/consumption-report"
@layout AppLayout

<PageTitle>Bao cao Tieu thu - QLCM Pro</PageTitle>

<div class="module-page reveal">
    <h1 style="margin-bottom:1.5rem;">Bao cao Tieu thu</h1>

    <!-- Filters -->
    <div class="filter-panel">
        <div class="date-range-picker">
            <input type="date" class="date-range-picker__input" value="2024-03-01" aria-label="Tu ngay" />
            <span class="date-range-picker__sep">-</span>
            <input type="date" class="date-range-picker__input" value="2024-04-15" aria-label="Den ngay" />
        </div>
        <select class="filter-panel__input" aria-label="Khoa phong">
            <option>Tat ca khoa/phong</option>
            <option>Ngoai khoa</option>
            <option>CDHA</option>
            <option>Xet nghiem</option>
        </select>
        <select class="filter-panel__input" aria-label="Loai ky thuat">
            <option>Tat ca loai</option>
            <option>Phau thuat</option>
            <option>Thu thuat</option>
            <option>Chan doan</option>
            <option>Xet nghiem</option>
        </select>
        <button class="btn-icon" title="Xuat PDF" aria-label="Xuat PDF" style="margin-left:auto;">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 1h5l4 4v9a1 1 0 01-1 1H4a1 1 0 01-1-1V2a1 1 0 011-1z" stroke="currentColor" stroke-width="1.3"/></svg>
        </button>
        <button class="btn-icon" title="Xuat Excel" aria-label="Xuat Excel">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="1" stroke="currentColor" stroke-width="1.3"/><path d="M5 5l6 6M11 5l-6 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        </button>
    </div>

    <!-- KPI Summary Cards -->
    <div class="dashboard__kpi-row stagger-children" style="display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-bottom:2rem;">
        <div class="glass-card" style="padding:1.25rem; text-align:center;">
            <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">Tong tieu thu</div>
            <div style="font-size:1.5rem; font-weight:700; color:var(--text-primary);" class="counter-animate" data-target="1245">0</div>
            <div style="font-size:0.6875rem; color:var(--text-secondary);">don vi</div>
        </div>
        <div class="glass-card" style="padding:1.25rem; text-align:center;">
            <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">Vuot dinh muc</div>
            <div style="font-size:1.5rem; font-weight:700; color:var(--color-danger);" class="counter-animate" data-target="12" data-suffix="%">0</div>
            <div style="font-size:0.6875rem; color:var(--text-secondary);">trung binh</div>
        </div>
        <div class="glass-card" style="padding:1.25rem; text-align:center;">
            <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">Tiet kiem</div>
            <div style="font-size:1.5rem; font-weight:700; color:var(--color-success);" class="counter-animate" data-target="8" data-suffix="%">0</div>
            <div style="font-size:0.6875rem; color:var(--text-secondary);">trung binh</div>
        </div>
        <div class="glass-card" style="padding:1.25rem; text-align:center;">
            <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.25rem;">Chi phi</div>
            <div style="font-size:1.5rem; font-weight:700; color:var(--text-primary);">2.4 ty</div>
            <div style="font-size:0.6875rem; color:var(--text-secondary);">VND</div>
        </div>
    </div>

    <!-- CSS Bar Chart: Consumption vs Norm -->
    <div class="glass-card" style="padding:1.5rem; margin-bottom:2rem;">
        <h3 style="font-size:0.9375rem; margin-bottom:1.25rem;">Tieu thu vs Dinh muc (Top 8 ky thuat)</h3>
        <div class="bar-chart" style="display:flex; flex-direction:column; gap:0.875rem;">
            <div class="bar-chart__row" style="display:grid; grid-template-columns:180px 1fr 50px; align-items:center; gap:0.75rem;">
                <span style="font-size:0.75rem; text-align:right;">Cat tui mat NS</span>
                <div style="position:relative; height:20px;">
                    <div style="position:absolute; top:0; left:0; height:9px; width:70%; background:var(--color-primary); border-radius:2px; opacity:0.7;"></div>
                    <div style="position:absolute; top:11px; left:0; height:9px; width:82%; background:var(--color-danger); border-radius:2px; opacity:0.7;"></div>
                </div>
                <span style="font-size:0.6875rem; color:var(--color-danger);">+12%</span>
            </div>
            <div class="bar-chart__row" style="display:grid; grid-template-columns:180px 1fr 50px; align-items:center; gap:0.75rem;">
                <span style="font-size:0.75rem; text-align:right;">CT-Scanner 128</span>
                <div style="position:relative; height:20px;">
                    <div style="position:absolute; top:0; left:0; height:9px; width:60%; background:var(--color-primary); border-radius:2px; opacity:0.7;"></div>
                    <div style="position:absolute; top:11px; left:0; height:9px; width:55%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                </div>
                <span style="font-size:0.6875rem; color:var(--color-success);">-8%</span>
            </div>
            <div class="bar-chart__row" style="display:grid; grid-template-columns:180px 1fr 50px; align-items:center; gap:0.75rem;">
                <span style="font-size:0.75rem; text-align:right;">Xet nghiem CTM</span>
                <div style="position:relative; height:20px;">
                    <div style="position:absolute; top:0; left:0; height:9px; width:85%; background:var(--color-primary); border-radius:2px; opacity:0.7;"></div>
                    <div style="position:absolute; top:11px; left:0; height:9px; width:90%; background:var(--color-warning); border-radius:2px; opacity:0.7;"></div>
                </div>
                <span style="font-size:0.6875rem; color:var(--color-warning);">+6%</span>
            </div>
            <div class="bar-chart__row" style="display:grid; grid-template-columns:180px 1fr 50px; align-items:center; gap:0.75rem;">
                <span style="font-size:0.75rem; text-align:right;">MRI 1.5 Tesla</span>
                <div style="position:relative; height:20px;">
                    <div style="position:absolute; top:0; left:0; height:9px; width:50%; background:var(--color-primary); border-radius:2px; opacity:0.7;"></div>
                    <div style="position:absolute; top:11px; left:0; height:9px; width:48%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                </div>
                <span style="font-size:0.6875rem; color:var(--color-success);">-4%</span>
            </div>
            <div class="bar-chart__row" style="display:grid; grid-template-columns:180px 1fr 50px; align-items:center; gap:0.75rem;">
                <span style="font-size:0.75rem; text-align:right;">Thay khop hang</span>
                <div style="position:relative; height:20px;">
                    <div style="position:absolute; top:0; left:0; height:9px; width:40%; background:var(--color-primary); border-radius:2px; opacity:0.7;"></div>
                    <div style="position:absolute; top:11px; left:0; height:9px; width:56%; background:var(--color-danger); border-radius:2px; opacity:0.7;"></div>
                </div>
                <span style="font-size:0.6875rem; color:var(--color-danger);">+40%</span>
            </div>
            <div class="bar-chart__row" style="display:grid; grid-template-columns:180px 1fr 50px; align-items:center; gap:0.75rem;">
                <span style="font-size:0.75rem; text-align:right;">Sinh hoa mau 17</span>
                <div style="position:relative; height:20px;">
                    <div style="position:absolute; top:0; left:0; height:9px; width:75%; background:var(--color-primary); border-radius:2px; opacity:0.7;"></div>
                    <div style="position:absolute; top:11px; left:0; height:9px; width:72%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                </div>
                <span style="font-size:0.6875rem; color:var(--color-success);">-4%</span>
            </div>
            <div class="bar-chart__row" style="display:grid; grid-template-columns:180px 1fr 50px; align-items:center; gap:0.75rem;">
                <span style="font-size:0.75rem; text-align:right;">PCR SARS-CoV-2</span>
                <div style="position:relative; height:20px;">
                    <div style="position:absolute; top:0; left:0; height:9px; width:30%; background:var(--color-primary); border-radius:2px; opacity:0.7;"></div>
                    <div style="position:absolute; top:11px; left:0; height:9px; width:28%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                </div>
                <span style="font-size:0.6875rem; color:var(--color-success);">-7%</span>
            </div>
            <div class="bar-chart__row" style="display:grid; grid-template-columns:180px 1fr 50px; align-items:center; gap:0.75rem;">
                <span style="font-size:0.75rem; text-align:right;">Doppler mau</span>
                <div style="position:relative; height:20px;">
                    <div style="position:absolute; top:0; left:0; height:9px; width:45%; background:var(--color-primary); border-radius:2px; opacity:0.7;"></div>
                    <div style="position:absolute; top:11px; left:0; height:9px; width:44%; background:var(--color-success); border-radius:2px; opacity:0.7;"></div>
                </div>
                <span style="font-size:0.6875rem; color:var(--color-success);">-2%</span>
            </div>
        </div>
        <div style="display:flex; gap:1.5rem; margin-top:1rem; font-size:0.6875rem; color:var(--text-muted);">
            <span><span style="display:inline-block; width:12px; height:4px; background:var(--color-primary); border-radius:2px; margin-right:4px;"></span>Dinh muc</span>
            <span><span style="display:inline-block; width:12px; height:4px; background:var(--color-danger); border-radius:2px; margin-right:4px;"></span>Thuc te</span>
        </div>
    </div>

    <!-- Variance Detail Table -->
    <div class="glass-card" style="padding:1.25rem;">
        <h3 style="font-size:0.9375rem; margin-bottom:1rem;">Chi tiet chenh lech</h3>
        <table class="data-table" aria-label="Chi tiet chenh lech">
            <thead><tr><th>Ky thuat</th><th>Dinh muc</th><th>Thuc te</th><th>Chenh lech</th><th>Ty le (%)</th><th>Trang thai</th></tr></thead>
            <tbody class="stagger-children">
                <tr><td>Cat tui mat NS</td><td>120</td><td>134</td><td>+14</td><td>+12%</td><td><span class="status-badge status-badge--draft" style="background:rgba(239,68,68,0.1); color:var(--color-danger);">Vuot</span></td></tr>
                <tr><td>CT-Scanner 128</td><td>85</td><td>78</td><td>-7</td><td>-8%</td><td><span class="status-badge" style="background:rgba(59,130,246,0.1); color:var(--color-info);">Tiet kiem</span></td></tr>
                <tr><td>Xet nghiem CTM</td><td>350</td><td>371</td><td>+21</td><td>+6%</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Binh thuong</span></td></tr>
                <tr><td>MRI 1.5 Tesla</td><td>45</td><td>43</td><td>-2</td><td>-4%</td><td><span class="status-badge" style="background:rgba(59,130,246,0.1); color:var(--color-info);">Tiet kiem</span></td></tr>
                <tr><td>Thay khop hang</td><td>15</td><td>21</td><td>+6</td><td>+40%</td><td><span class="status-badge status-badge--draft" style="background:rgba(239,68,68,0.1); color:var(--color-danger);">Vuot</span></td></tr>
                <tr><td>Sinh hoa mau 17</td><td>280</td><td>269</td><td>-11</td><td>-4%</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Binh thuong</span></td></tr>
                <tr><td>PCR SARS-CoV-2</td><td>60</td><td>56</td><td>-4</td><td>-7%</td><td><span class="status-badge" style="background:rgba(59,130,246,0.1); color:var(--color-info);">Tiet kiem</span></td></tr>
                <tr><td>Doppler mau</td><td>95</td><td>93</td><td>-2</td><td>-2%</td><td><span class="status-badge status-badge--active"><span class="status-badge__dot"></span>Binh thuong</span></td></tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    private string reportPeriod = "2024-03";
}
