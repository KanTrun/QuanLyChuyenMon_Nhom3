@page "/thong-bao"
@layout PersonaLayout
@using TelemedicineLandingPage.Services.Admin.Sql
@using TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@implements IDisposable

<PageTitle>Thông báo | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Thông báo</span>
            <h1 class="admin-page-title">Trung tâm thông báo</h1>
            <p class="admin-page-subtitle">Tất cả thông báo hệ thống gửi đến người dùng hiện tại.</p>
        </div>
    </header>

    <AdminDataTable TItem="MedNotification"
                    Items="_pagedItems"
                    ColumnCount="5"
                    CurrentPage="_page"
                    PageSize="_pageSize"
                    TotalItems="_total"
                    CurrentPageChanged="p => { _page = p; Paginate(); }"
                    EmptyTitle="Không có thông báo"
                    EmptyBody="Bạn chưa nhận được thông báo nào.">
        <HeaderTemplate>
            <th>Tiêu đề</th>
            <th>Nội dung</th>
            <th>Loại</th>
            <th>Mức độ</th>
            <th>Thời gian</th>
        </HeaderTemplate>
        <RowTemplate Context="notif">
            <tr>
                <td>@notif.Title</td>
                <td>@notif.Body</td>
                <td>@notif.NotificationType</td>
                <td>
                    <AdminBadge Tone="@GetSeverityTone(notif.Severity)">@notif.Severity</AdminBadge>
                </td>
                <td>@notif.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        </RowTemplate>
    </AdminDataTable>
</section>

@code {
    private int _page = 1;
    private const int _pageSize = 10;
    private int _total;
    private IReadOnlyList<MedNotification> _pagedItems = Array.Empty<MedNotification>();

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
        Paginate();
    }

    private void OnChanged() => InvokeAsync(() => { Paginate(); StateHasChanged(); });

    private void Paginate()
    {
        var all = Store.Notifications.OrderByDescending(n => n.CreatedAt).ToList();
        _total = all.Count;
        _pagedItems = all.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    }

    private static string GetSeverityTone(string severity) => severity switch
    {
        "critical" => "tone-danger",
        "warning" => "tone-warning",
        "info" => "tone-primary",
        _ => "tone-muted"
    };

    public void Dispose() => Store.StateChanged -= OnChanged;
}
