@page "/session-expired"
@layout EmptyLayout

<PageTitle>Phien het han | QLCM Pro</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="session-expired-page" data-theme-aware="true">
    <main class="session-expired-page__content" role="main" aria-labelledby="session-heading">
        <!-- Animated Lock Icon -->
        <div class="session-expired-page__illustration" aria-hidden="true">
            <svg width="120" height="120" viewBox="0 0 120 120" fill="none" class="session-expired-page__lock-svg">
                <g class="session-expired-page__lock">
                    <rect x="30" y="55" width="60" height="45" rx="8" stroke="var(--color-primary, #2563eb)" stroke-width="3" fill="none"/>
                    <path d="M42 55V42a18 18 0 0136 0v13" stroke="var(--color-primary, #2563eb)" stroke-width="3" stroke-linecap="round" fill="none"/>
                    <circle cx="60" cy="78" r="6" fill="var(--color-primary, #2563eb)" opacity="0.8"/>
                    <path d="M60 84v8" stroke="var(--color-primary, #2563eb)" stroke-width="3" stroke-linecap="round"/>
                </g>
            </svg>
        </div>

        <!-- Content -->
        <h1 id="session-heading" class="session-expired-page__title">Phien lam viec da het han</h1>
        <p class="session-expired-page__message">De bao mat thong tin, phien lam viec cua ban da tu dong ket thuc sau 30 phut khong hoat dong.</p>

        <!-- Timer -->
        <div class="session-expired-page__timer" aria-label="Thoi gian phien het han">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/>
                <path d="M8 4v4l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span>Phien het han luc: <strong>14:32 - 15/05/2025</strong></span>
        </div>

        <!-- Actions -->
        <div class="session-expired-page__actions">
            <a href="/login" class="button button-primary session-expired-page__login-btn" aria-label="Dang nhap lai">
                Dang nhap lai
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="/" class="session-expired-page__home-link" aria-label="Ve trang chu">Ve trang chu</a>
        </div>

        <!-- Security Tips -->
        <section class="session-expired-page__tips" aria-labelledby="tips-heading">
            <h3 id="tips-heading" class="session-expired-page__tips-title">Meo bao mat tai khoan</h3>
            <div class="session-expired-page__tips-grid">
                <div class="session-expired-page__tip">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2l5.5 3v4.5c0 3-2.2 5.5-5.5 7-3.3-1.5-5.5-4-5.5-7V5L9 2z" stroke="currentColor" stroke-width="1.5"/></svg>
                    <span>Su dung mat khau manh, ket hop chu hoa, so va ky tu dac biet</span>
                </div>
                <div class="session-expired-page__tip">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M15 9a6 6 0 11-12 0 6 6 0 0112 0z" stroke="currentColor" stroke-width="1.5"/><path d="M9 6v3l2 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <span>Dang xuat khi roi khoi may tinh, dac biet o noi cong cong</span>
                </div>
                <div class="session-expired-page__tip">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9l4 4 8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>Kiem tra nhat ky hoat dong thuong xuyen de phat hien truy cap trai phep</span>
                </div>
            </div>
        </section>
    </main>
</div>

<style>
    .session-expired-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-bg-primary, #f8fafc);
        font-family: 'Inter', sans-serif;
        padding: 2rem;
        position: relative;
    }

    [data-theme="dark"] .session-expired-page {
        background: var(--color-bg-dark, #0f172a);
    }

    .session-expired-page__content {
        text-align: center;
        max-width: 540px;
        z-index: 1;
    }

    .session-expired-page__illustration {
        margin-bottom: 1.5rem;
    }

    .session-expired-page__lock {
        animation: lockShake 2s ease-in-out infinite;
        transform-origin: 60px 70px;
    }

    .session-expired-page__title {
        font-size: clamp(1.5rem, 3.5vw, 2rem);
        font-weight: 700;
        color: var(--color-text-primary, #1e293b);
        margin: 0 0 1rem;
    }

    [data-theme="dark"] .session-expired-page__title {
        color: #f1f5f9;
    }

    .session-expired-page__message {
        font-size: 1rem;
        color: var(--color-text-secondary, #64748b);
        line-height: 1.7;
        margin: 0 0 1.5rem;
    }

    .session-expired-page__timer {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 8px;
        padding: 0.6rem 1rem;
        font-size: 0.85rem;
        color: var(--color-danger, #ef4444);
        margin-bottom: 2rem;
    }

    .session-expired-page__actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    .session-expired-page__login-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 2rem;
        background: var(--color-primary, #2563eb);
        color: white;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        transition: all 0.2s;
    }

    .session-expired-page__login-btn:hover {
        background: var(--color-primary-dark, #1d4ed8);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.3);
    }

    .session-expired-page__home-link {
        color: var(--color-text-secondary, #64748b);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s;
    }

    .session-expired-page__home-link:hover {
        color: var(--color-primary, #2563eb);
    }

    .session-expired-page__tips {
        background: var(--color-bg-secondary, #ffffff);
        border: 1px solid var(--color-border, #e2e8f0);
        border-radius: 12px;
        padding: 1.5rem;
        text-align: left;
    }

    [data-theme="dark"] .session-expired-page__tips {
        background: rgba(30, 41, 59, 0.5);
        border-color: rgba(51, 65, 85, 0.5);
    }

    .session-expired-page__tips-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-text-primary, #1e293b);
        margin: 0 0 1rem;
    }

    [data-theme="dark"] .session-expired-page__tips-title {
        color: #f1f5f9;
    }

    .session-expired-page__tips-grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .session-expired-page__tip {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.85rem;
        color: var(--color-text-secondary, #64748b);
        line-height: 1.5;
    }

    .session-expired-page__tip svg {
        flex-shrink: 0;
        margin-top: 2px;
        color: var(--color-primary, #2563eb);
    }

    @@keyframes lockShake {
        0%, 80%, 100% { transform: rotate(0deg); }
        85% { transform: rotate(-3deg); }
        90% { transform: rotate(3deg); }
        95% { transform: rotate(-2deg); }
    }

    @@media (max-width: 640px) {
        .session-expired-page__tips {
            padding: 1rem;
        }
    }
</style>
