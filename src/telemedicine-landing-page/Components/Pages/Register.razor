@page "/register"
@using System.Text.Json
@using TelemedicineLandingPage.Data
@using TelemedicineLandingPage.Models.Admin.Sql
@using TelemedicineLandingPage.Services.Admin.Sql
@inject MedDbContext Db
@inject NavigationManager Navigation
@inject IToastService Toast
@inject EffectivePermissionResolver Resolver

<PageTitle>Đăng ký | QLCM Pro</PageTitle>

<div class="login-page">
    <!-- Left: Branding Panel -->
    <div class="login-brand">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>

        <div class="login-brand-content">
            <div class="login-logo">+</div>
            <h1>QLCM Pro</h1>
            <p>Hệ thống Quản lý Chuyên môn bệnh viện — quản lý quy trình, phân quyền, phác đồ và báo cáo.</p>

            <div class="login-features">
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </span>
                    <span>An toàn và bảo mật thông tin chuẩn y tế</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </span>
                    <span>Phân quyền chi tiết theo vai trò và khoa/phòng</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </span>
                    <span>Quản lý vòng đời quy trình chuyên môn</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Register Form -->
    <div class="login-form-panel">
        <div class="login-form-wrapper">
            <div class="login-form-header">
                <p class="eyebrow">Đăng ký mới</p>
                <h2>Tạo tài khoản hệ thống</h2>
                <p>Điền thông tin dưới đây để đăng ký tài khoản QLCM Pro.</p>
            </div>

            <form class="login-form" @onsubmit="HandleRegister" @onsubmit:preventDefault>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                    <div class="form-group">
                        <label for="reg-fname">Họ</label>
                        <input type="text" id="reg-fname" @bind="_firstName" placeholder="Nguyễn Văn" required />
                    </div>
                    <div class="form-group">
                        <label for="reg-lname">Tên</label>
                        <input type="text" id="reg-lname" @bind="_lastName" placeholder="A" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="reg-email">Email</label>
                    <input type="email" id="reg-email" @bind="_email" placeholder="nguyenvana@benhvien.vn" autocomplete="username" required />
                </div>

                <div class="form-group">
                    <label for="reg-password">Mật khẩu</label>
                    <input type="password" id="reg-password" @bind="_password" placeholder="Tạo mật khẩu (tối thiểu 6 ký tự)" autocomplete="new-password" required />
                </div>

                <div class="form-group">
                    <label for="reg-confirm">Xác nhận mật khẩu</label>
                    <input type="password" id="reg-confirm" @bind="_confirmPassword" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="login-error" role="alert">
                        <span>⚠️ @_errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div style="padding:0.75rem 1rem;border-radius:var(--radius-sm);background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;font-size:0.88rem;font-weight:500;">
                        ✓ @_successMessage
                    </div>
                }

                <button type="submit" class="login-submit" disabled="@_isLoading">
                    @if (_isLoading) { <span class="login-spinner"></span><span>Đang xử lý...</span> }
                    else { <span>Đăng ký tài khoản</span> }
                </button>
            </form>

            <p class="login-footer">
                Đã có tài khoản? <a href="/login">Đăng nhập</a>
            </p>
        </div>
    </div>
</div>

@code {
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _password = "";
    private string _confirmPassword = "";
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;

    private async Task HandleRegister()
    {
        _errorMessage = null;
        _successMessage = null;
        _isLoading = true;

        try
        {
            await Task.Delay(300);
            // Kiểm tra dữ liệu
            if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
            {
                _errorMessage = "Vui lòng nhập đầy đủ họ và tên.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_email))
            {
                _errorMessage = "Vui lòng nhập email.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_password) || _password.Length < 6)
            {
                _errorMessage = "Mật khẩu phải có tối thiểu 6 ký tự.";
                return;
            }

            if (_password != _confirmPassword)
            {
                _errorMessage = "Mật khẩu xác nhận không khớp.";
                return;
            }

            // Kiểm tra email đã tồn tại chưa
            var existingUser = Db.Users.FirstOrDefault(u => u.Email == _email.Trim());
            if (existingUser is not null)
            {
                _errorMessage = "Email này đã được sử dụng. Vui lòng dùng email khác.";
                return;
            }

            // Tạo username từ email (phần trước @)
            var username = _email.Trim().Split('@')[0].ToLowerInvariant();

            // Kiểm tra username đã tồn tại
            if (Db.Users.Any(u => u.Username == username))
            {
                username = username + DateTime.Now.ToString("HHmmss");
            }

            // Tạo user mới trong database
            var fullName = $"{_firstName.Trim()} {_lastName.Trim()}";
            var passwordHash = CurrentUserContext.HashPassword(_password);

            var newUser = new AppUser
            {
                Username = username,
                FullName = fullName,
                Email = _email.Trim(),
                PasswordHash = passwordHash,
                Status = "inactive"
            };

            Db.Users.Add(newUser);
            Db.SaveChanges();

            // Ghi audit log đăng ký
            Db.AuditLogs.Add(new AuditLog
            {
                CorrelationId = Guid.NewGuid(),
                ActorUserId = newUser.UserId,
                ActorUsername = newUser.Username,
                ActionCode = "create",
                TargetType = "user",
                TargetId = newUser.UserId.ToString(),
                AfterJson = JsonSerializer.Serialize(new { newUser.Username, newUser.FullName })
            });
            NotifyAdministrators(newUser);
            Db.SaveChanges();

            _successMessage = $"Đã ghi nhận đăng ký. Tên đăng nhập của bạn là: {username}. Tài khoản cần quản trị viên kích hoạt trước khi sử dụng.";

            // Redirect sang trang đăng nhập sau 2 giây
            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                InvokeAsync(() => Navigation.NavigateTo("/login", forceLoad: false));
            });
        }
        catch (Exception)
        {
            _errorMessage = "Đã xảy ra lỗi khi đăng ký. Vui lòng thử lại.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NotifyAdministrators(AppUser newUser)
    {
        var activeUsers = Db.Users
            .Where(u => u.Status == "active" && u.DeletedAt == null)
            .ToList();
        var recipients = activeUsers
            .Where(u => string.Equals(u.Username, "admin", StringComparison.OrdinalIgnoreCase)
                || Resolver.HasPermission(u.UserId, "SCR_ORG_USERS:VIEW")
                || Resolver.HasPermission(u.UserId, "SCR_ORG_USERS:UPDATE"))
            .ToList();

        foreach (var admin in recipients)
        {
            Db.Notifications.Add(new MedNotification
            {
                RecipientUserId = admin.UserId,
                NotificationType = "user_registration_pending",
                Title = "Tài khoản mới chờ kích hoạt",
                Body = $"Tài khoản {newUser.FullName} ({newUser.Username}) vừa đăng ký và cần quản trị viên kích hoạt.",
                Severity = "warning",
                SourceType = "user",
                SourceId = newUser.UserId.ToString(),
                PayloadJson = JsonSerializer.Serialize(new { newUser.UserId, newUser.Username, newUser.Email })
            });
        }
    }
}
