@page "/register"
@using System.Text.Json
@using TelemedicineLandingPage.Application.Validation
@using TelemedicineLandingPage.Data
@using TelemedicineLandingPage.Models.Admin.Sql
@using TelemedicineLandingPage.Services.Admin.Sql
@using TelemedicineLandingPage.Services.Notifications
@inject MedDbContext Db
@inject NavigationManager Navigation
@inject EffectivePermissionResolver Resolver
@inject IValidationService Validation
@inject IPasswordStrengthService PasswordStrengthService
@inject TelemedicineLandingPage.Services.Notifications.INotificationService Notifications

<PageTitle>Đăng ký | QLCM Pro</PageTitle>

<div class="login-page" data-auth-page data-auth-variant="register">
    <section class="login-brand" aria-label="QLCM Pro">
        <div class="auth-grid-lines" aria-hidden="true"></div>
        <div class="auth-depth-field" aria-hidden="true">
            <span class="auth-plane auth-plane-one"></span>
            <span class="auth-plane auth-plane-two"></span>
            <span class="auth-plane auth-plane-three"></span>
            <span class="auth-ring auth-ring-one"></span>
            <span class="auth-ring auth-ring-two"></span>
        </div>
        <div class="auth-signal auth-signal-one" aria-hidden="true"></div>
        <div class="auth-signal auth-signal-two" aria-hidden="true"></div>

        <div class="login-brand-content">
            <div class="auth-product-row">
                <div class="login-logo" data-auth-float><img src="/brand/logo-hos.jpg" alt="" /></div>
                <div class="auth-product-copy">
                    <span>Account provisioning</span>
                    <strong>Approval required</strong>
                </div>
            </div>
            <p class="auth-kicker">Tài khoản chuyên môn</p>
            <h1>Gia nhập QLCM Pro</h1>
            <p>Tài khoản mới sẽ được ghi nhận và chờ quản trị viên kích hoạt để bảo vệ dữ liệu bệnh viện.</p>

            <div class="auth-command-strip" aria-label="Quy trình đăng ký">
                <span>Đăng ký</span>
                <span>Duyệt quyền</span>
                <span>Kích hoạt</span>
            </div>

            <div class="login-features">
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
                    </span>
                    <span>Bảo vệ thông tin theo chuẩn vận hành y tế</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M20 6 12 3 4 6v6c0 5 3.4 8.7 8 9 4.6-.3 8-4 8-9V6Z"/></svg>
                    </span>
                    <span>Phân quyền theo vai trò, nhóm và khoa phòng</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9"/></svg>
                    </span>
                    <span>Thông báo tự động đến quản trị viên phụ trách</span>
                </div>
            </div>

            <div class="auth-status-card" data-auth-float-layer>
                <div>
                    <span class="auth-status-label">Luồng kích hoạt</span>
                    <strong>Đăng ký → duyệt → sử dụng</strong>
                </div>
                <div class="auth-status-meter" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </section>

    <section class="login-form-panel" aria-label="Đăng ký">
        <div class="auth-form-aura" aria-hidden="true"></div>
        <div class="login-form-wrapper register-form-wrapper">
            <div class="auth-route-pill">
                <span></span>
                Yêu cầu tài khoản mới
            </div>
            <div class="login-form-header">
                <p class="eyebrow">Đăng ký mới</p>
                <h2>Tạo tài khoản hệ thống</h2>
                <p>Điền thông tin công việc để gửi yêu cầu kích hoạt tài khoản.</p>
            </div>

            <form class="login-form" @onsubmit="HandleRegister" @onsubmit:preventDefault>
                <div class="auth-name-grid">
                    <div class="form-group">
                        <label for="reg-fname">Họ</label>
                        <input type="text" id="reg-fname" @bind="_firstName" placeholder="Nguyễn Văn" autocomplete="given-name" required />
                    </div>
                    <div class="form-group">
                        <label for="reg-lname">Tên</label>
                        <input type="text" id="reg-lname" @bind="_lastName" placeholder="A" autocomplete="family-name" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="reg-email">Email</label>
                    <input type="email" id="reg-email" @bind="_email" placeholder="nguyenvana@benhvien.vn" autocomplete="username" required />
                </div>

                <div class="form-group">
                    <label for="reg-password">Mật khẩu</label>
                    <div class="password-field">
                        <input type="@PasswordInputType" id="reg-password" @bind="_password" @bind:event="oninput" placeholder="Tạo mật khẩu mạnh" autocomplete="new-password" required />
                        <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility" aria-label="@PasswordToggleLabel" title="@PasswordToggleLabel">
                            @if (_showPassword)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 10.6A2 2 0 0 0 13.4 13.4"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5 0 8.5 4.3 9.7 6a13.5 13.5 0 0 1-3.1 3.6"/><path d="M6.6 6.6A13.7 13.7 0 0 0 2.3 11c1.2 1.7 4.7 6 9.7 6 1.5 0 2.9-.4 4.1-1"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.3 12S5.8 5 12 5s9.7 7 9.7 7-3.5 7-9.7 7-9.7-7-9.7-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_password))
                    {
                        <div class="password-strength" aria-live="polite">
                            <meter min="0" max="@PasswordStrength.MaxScore" value="@PasswordStrength.Score"></meter>
                            <span>@PasswordStrength.Label</span>
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label for="reg-confirm">Xác nhận mật khẩu</label>
                    <div class="password-field">
                        <input type="@ConfirmPasswordInputType" id="reg-confirm" @bind="_confirmPassword" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required />
                        <button type="button" class="password-toggle" @onclick="ToggleConfirmPasswordVisibility" aria-label="@ConfirmPasswordToggleLabel" title="@ConfirmPasswordToggleLabel">
                            @if (_showConfirmPassword)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 10.6A2 2 0 0 0 13.4 13.4"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5 0 8.5 4.3 9.7 6a13.5 13.5 0 0 1-3.1 3.6"/><path d="M6.6 6.6A13.7 13.7 0 0 0 2.3 11c1.2 1.7 4.7 6 9.7 6 1.5 0 2.9-.4 4.1-1"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.3 12S5.8 5 12 5s9.7 7 9.7 7-3.5 7-9.7 7-9.7-7-9.7-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="login-error" role="alert">
                        <span>@_errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="login-success" role="status">
                        <span>@_successMessage</span>
                    </div>
                }

                <button type="submit" class="login-submit" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="login-spinner"></span><span>Đang xử lý...</span>
                    }
                    else
                    {
                        <span>Đăng ký tài khoản</span>
                    }
                </button>
            </form>

            <p class="login-footer">
                Đã có tài khoản? <a href="/login">Đăng nhập</a>
            </p>
            <div class="auth-assurance">
                <span>Chờ kích hoạt</span>
                <span>Thông báo quản trị</span>
                <span>RBAC</span>
            </div>
        </div>
    </section>
</div>

@code {
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _password = "";
    private string _confirmPassword = "";
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;
    private bool _showPassword;
    private bool _showConfirmPassword;

    private PasswordStrengthResult PasswordStrength => PasswordStrengthService.Evaluate(_password, _email);
    private string PasswordInputType => _showPassword ? "text" : "password";
    private string ConfirmPasswordInputType => _showConfirmPassword ? "text" : "password";
    private string PasswordToggleLabel => _showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu";
    private string ConfirmPasswordToggleLabel => _showConfirmPassword ? "Ẩn mật khẩu xác nhận" : "Hiện mật khẩu xác nhận";

    private async Task HandleRegister()
    {
        _errorMessage = null;
        _successMessage = null;
        _isLoading = true;

        try
        {
            await Task.Delay(300);
            var validationErrors = await Validation.ValidateAsync(new RegisterAccountCommand(
                _firstName,
                _lastName,
                _email,
                _password,
                _confirmPassword));
            if (validationErrors.Count > 0)
            {
                _errorMessage = validationErrors[0];
                return;
            }

            var existingUser = Db.Users.FirstOrDefault(u => u.Email == _email.Trim());
            if (existingUser is not null)
            {
                _errorMessage = "Email này đã được sử dụng. Vui lòng dùng email khác.";
                return;
            }

            var username = _email.Trim().Split('@')[0].ToLowerInvariant();
            if (Db.Users.Any(u => u.Username == username))
            {
                username = username + AdminDateTimeDisplay.Now().ToString("HHmmss");
            }

            var newUser = new AppUser
            {
                Username = username,
                FullName = $"{_firstName.Trim()} {_lastName.Trim()}",
                Email = _email.Trim(),
                PasswordHash = CurrentUserContext.HashPassword(_password),
                Status = "inactive",
                OnboardingStatus = "submitted"
            };

            Db.Users.Add(newUser);
            Db.SaveChanges();

            Db.AuditLogs.Add(new AuditLog
            {
                CorrelationId = Guid.NewGuid(),
                ActorUserId = newUser.UserId,
                ActorUsername = newUser.Username,
                ActionCode = "create",
                TargetType = "user",
                TargetId = newUser.UserId.ToString(),
                AfterJson = JsonSerializer.Serialize(new { newUser.Username, newUser.FullName })
            });
            await NotifyAdministrators(newUser);
            Db.SaveChanges();

            _successMessage = $"Đã ghi nhận đăng ký. Tên đăng nhập của bạn là: {username}. Tài khoản cần quản trị viên kích hoạt trước khi sử dụng.";

            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                InvokeAsync(() => Navigation.NavigateTo("/login", forceLoad: false));
            });
        }
        catch (Exception)
        {
            _errorMessage = "Đã xảy ra lỗi khi đăng ký. Vui lòng thử lại.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void TogglePasswordVisibility()
        => _showPassword = !_showPassword;

    private void ToggleConfirmPasswordVisibility()
        => _showConfirmPassword = !_showConfirmPassword;

    private async Task NotifyAdministrators(AppUser newUser)
    {
        var activeUsers = Db.Users
            .Where(u => u.Status == "active" && u.DeletedAt == null)
            .ToList();
        var recipients = activeUsers
            .Where(u => string.Equals(u.Username, "admin", StringComparison.OrdinalIgnoreCase)
                || Resolver.HasPermission(u.UserId, "SCR_ORG_USERS:VIEW")
                || Resolver.HasPermission(u.UserId, "SCR_ORG_USERS:UPDATE"))
            .ToList();

        foreach (var admin in recipients)
        {
            await Notifications.SendToUserAsync(admin.UserId, new NotificationMessage(
                "user_registration_pending",
                "Tài khoản mới chờ kích hoạt",
                $"Tài khoản {newUser.FullName} ({newUser.Username}) vừa đăng ký và cần quản trị viên kích hoạt.",
                "warning",
                "user",
                newUser.UserId.ToString(),
                JsonSerializer.Serialize(new { newUser.UserId, newUser.Username, newUser.Email })));
        }
    }
}
