@page "/register"

<PageTitle>Dang ky | QLCM Pro</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Dang ky tai khoan QLCM Pro - He thong quan ly quy trinh ky thuat chuyen mon benh vien." />
</HeadContent>

<div class="login-page login-page--animated-bg">
    <!-- Left: Branding Panel -->
    <div class="login-brand">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>

        <div class="login-brand-content">
            <div class="login-logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            </div>
            <h1>Tham gia He thong</h1>
            <p>Dang ky tai khoan de truy cap he thong quan ly quy trinh ky thuat chuyen mon benh vien.</p>

            <div class="login-features">
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>
                    </span>
                    <span>Truy cap toan bo quy trinh chuyen mon</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span>
                    <span>Phan quyen theo vai tro va khoa/phong</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    </span>
                    <span>Phac do lam sang va goi y theo ICD</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Register Form (Multi-step) -->
    <div class="login-form-panel">
        <div class="login-form-wrapper">
            <div class="login-form-header">
                <p class="eyebrow">Dang ky moi</p>
                <h2>Tao tai khoan QLCM</h2>
                <p>Dien thong tin duoi day de dang ky tai khoan he thong quan ly chuyen mon.</p>
            </div>

            <!-- Registration Progress -->
            <div class="register-progress" aria-label="Tien trinh dang ky">
                <div class="register-progress__step register-progress__step--active" aria-current="step">
                    <span class="register-progress__dot">1</span>
                    <span class="register-progress__label">Vai tro</span>
                </div>
                <div class="register-progress__connector"></div>
                <div class="register-progress__step">
                    <span class="register-progress__dot">2</span>
                    <span class="register-progress__label">Ca nhan</span>
                </div>
                <div class="register-progress__connector"></div>
                <div class="register-progress__step">
                    <span class="register-progress__dot">3</span>
                    <span class="register-progress__label">Khoa/Phong</span>
                </div>
                <div class="register-progress__connector"></div>
                <div class="register-progress__step">
                    <span class="register-progress__dot">4</span>
                    <span class="register-progress__label">Tai khoan</span>
                </div>
                <div class="register-progress__connector"></div>
                <div class="register-progress__step">
                    <span class="register-progress__dot">5</span>
                    <span class="register-progress__label">Xac nhan</span>
                </div>
            </div>

            <form class="login-form register-form" action="/login" method="post" novalidate>
                <!-- Step 1: Role Selection -->
                <fieldset class="register-step register-step--active" aria-label="Buoc 1: Chon vai tro">
                    <legend class="register-step__title">Chon vai tro chuyen mon</legend>
                    <div class="register-roles">
                        <label class="register-role-card">
                            <input type="radio" name="role" value="bac-si" required />
                            <div class="register-role-card__content">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                                <span>Bac si</span>
                            </div>
                        </label>
                        <label class="register-role-card">
                            <input type="radio" name="role" value="dieu-duong" />
                            <div class="register-role-card__content">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                <span>Dieu duong</span>
                            </div>
                        </label>
                        <label class="register-role-card">
                            <input type="radio" name="role" value="ky-thuat-vien" />
                            <div class="register-role-card__content">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33"/></svg>
                                <span>Ky thuat vien</span>
                            </div>
                        </label>
                        <label class="register-role-card">
                            <input type="radio" name="role" value="duoc-si" />
                            <div class="register-role-card__content">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3"/></svg>
                                <span>Duoc si</span>
                            </div>
                        </label>
                        <label class="register-role-card">
                            <input type="radio" name="role" value="quan-tri" />
                            <div class="register-role-card__content">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                <span>Quan tri</span>
                            </div>
                        </label>
                    </div>
                </fieldset>

                <!-- Step 2: Personal Info -->
                <fieldset class="register-step" aria-label="Buoc 2: Thong tin ca nhan">
                    <legend class="register-step__title">Thong tin ca nhan</legend>
                    <div class="form-row">
                        <div class="form-group form-group--floating">
                            <input type="text" id="reg-fullname" name="fullname" placeholder=" " required class="form-input" />
                            <label for="reg-fullname" class="form-label--floating">Ho va ten</label>
                        </div>
                    </div>
                    <div class="form-group form-group--floating">
                        <input type="email" id="reg-email" name="email" placeholder=" " autocomplete="email" required class="form-input" />
                        <label for="reg-email" class="form-label--floating">Email cong vu</label>
                    </div>
                    <div class="form-row">
                        <div class="form-group form-group--floating">
                            <input type="tel" id="reg-phone" name="phone" placeholder=" " class="form-input" />
                            <label for="reg-phone" class="form-label--floating">So dien thoai</label>
                        </div>
                        <div class="form-group form-group--floating">
                            <input type="text" id="reg-cccd" name="cccd" placeholder=" " class="form-input" />
                            <label for="reg-cccd" class="form-label--floating">CCCD</label>
                        </div>
                    </div>
                </fieldset>

                <!-- Step 3: Department Info -->
                <fieldset class="register-step" aria-label="Buoc 3: Thong tin khoa phong">
                    <legend class="register-step__title">Khoa / Phong ban</legend>
                    <div class="form-group">
                        <label for="reg-department">Khoa / Phong ban</label>
                        <select id="reg-department" name="department" required class="form-input">
                            <option value="" disabled selected>Chon khoa/phong</option>
                            <option value="noi-tong-hop">Noi tong hop</option>
                            <option value="ngoai-tong-hop">Ngoai tong hop</option>
                            <option value="san-phu-khoa">San phu khoa</option>
                            <option value="nhi">Nhi</option>
                            <option value="cap-cuu">Cap cuu</option>
                            <option value="xet-nghiem">Xet nghiem</option>
                            <option value="chan-doan-hinh-anh">Chan doan hinh anh</option>
                            <option value="duoc">Duoc</option>
                            <option value="ky-thuat-y-sinh">Ky thuat y sinh</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <div class="form-group form-group--floating">
                            <input type="text" id="reg-position" name="position" placeholder=" " class="form-input" />
                            <label for="reg-position" class="form-label--floating">Chuc vu</label>
                        </div>
                        <div class="form-group form-group--floating">
                            <input type="number" id="reg-experience" name="experience" placeholder=" " min="0" max="50" class="form-input" />
                            <label for="reg-experience" class="form-label--floating">So nam kinh nghiem</label>
                        </div>
                    </div>
                </fieldset>

                <!-- Step 4: Account Setup -->
                <fieldset class="register-step" aria-label="Buoc 4: Thiet lap tai khoan">
                    <legend class="register-step__title">Thiet lap tai khoan</legend>
                    <div class="form-group form-group--floating">
                        <input type="text" id="reg-username" name="username" placeholder=" " autocomplete="username" required class="form-input" />
                        <label for="reg-username" class="form-label--floating">Ten dang nhap</label>
                    </div>
                    <div class="form-group form-group--floating">
                        <div class="form-input-wrapper">
                            <input type="password" id="reg-password" name="password" placeholder=" " autocomplete="new-password" required class="form-input" />
                            <label for="reg-password" class="form-label--floating">Mat khau</label>
                            <button type="button" class="form-password-toggle" onclick="(function(btn){var i=btn.previousElementSibling.previousElementSibling;i.type=i.type==='password'?'text':'password'})(this)" aria-label="Hien/An mat khau">
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M1 9s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
                            </button>
                        </div>
                        <div class="password-strength" aria-label="Do manh mat khau">
                            <div class="password-strength__bar">
                                <span class="password-strength__segment"></span>
                                <span class="password-strength__segment"></span>
                                <span class="password-strength__segment"></span>
                                <span class="password-strength__segment"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group form-group--floating">
                        <input type="password" id="reg-password-confirm" name="password_confirm" placeholder=" " autocomplete="new-password" required class="form-input" />
                        <label for="reg-password-confirm" class="form-label--floating">Xac nhan mat khau</label>
                    </div>
                </fieldset>

                <!-- Step 5: Terms & Submit -->
                <fieldset class="register-step" aria-label="Buoc 5: Xac nhan va gui">
                    <legend class="register-step__title">Xac nhan dang ky</legend>
                    <div class="register-summary">
                        <p>Vui long xem lai thong tin truoc khi gui dang ky.</p>
                    </div>
                    <div class="form-options">
                        <label class="toggle-switch">
                            <input type="checkbox" name="terms" required />
                            <span class="toggle-switch__slider"></span>
                            <span class="toggle-switch__label">Toi dong y voi <a href="javascript:void(0)">Dieu khoan su dung</a> va <a href="javascript:void(0)">Chinh sach bao mat</a></span>
                        </label>
                    </div>
                    <button type="submit" class="login-submit" aria-label="Gui dang ky">
                        <span class="login-submit__text">Dang ky tai khoan</span>
                        <span class="login-submit__spinner" aria-hidden="true"></span>
                    </button>
                </fieldset>

                <!-- Success State (hidden by default) -->
                <div class="register-success confetti-active" style="display:none;" aria-live="polite">
                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                        <circle cx="32" cy="32" r="28" stroke="var(--color-success, #10b981)" stroke-width="3" fill="none"/>
                        <path d="M20 32l8 8 16-16" stroke="var(--color-success, #10b981)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <h3>Dang ky thanh cong!</h3>
                    <p>Tai khoan cua ban dang cho xet duyet. Ban se nhan duoc thong bao qua email khi tai khoan duoc kich hoat.</p>
                    <a href="/login" class="button button-primary">Chuyen den trang dang nhap</a>
                </div>
            </form>

            <p class="login-footer">
                Da co tai khoan? <a href="/login">Dang nhap</a>
            </p>
        </div>
    </div>
</div>
