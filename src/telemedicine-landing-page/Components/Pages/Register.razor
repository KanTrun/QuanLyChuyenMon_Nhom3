@page "/register"

<PageTitle>Đăng ký | QLCM Pro</PageTitle>

<div class="login-page">
    <!-- Left: Branding Panel -->
    <div class="login-brand">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>

        <div class="login-brand-content">
            <div class="login-logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            </div>
            <h1>Tham gia Hệ thống</h1>
            <p>Đăng ký tài khoản để truy cập hệ thống quản lý quy trình kỹ thuật chuyên môn bệnh viện.</p>

            <div class="login-features">
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>
                    </span>
                    <span>Truy cập toàn bộ quy trình chuyên môn</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span>
                    <span>Phân quyền theo vai trò và khoa/phòng</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    </span>
                    <span>Phác đồ lâm sàng và gợi ý theo ICD</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Register Form -->
    <div class="login-form-panel">
        <div class="login-form-wrapper">
            <div class="login-form-header">
                <p class="eyebrow">Đăng ký mới</p>
                <h2>Tạo tài khoản QLCM</h2>
                <p>Điền thông tin dưới đây để đăng ký tài khoản hệ thống quản lý chuyên môn.</p>
            </div>

            <form class="login-form" action="/" method="get">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                    <div class="form-group">
                        <label for="reg-fname">Họ</label>
                        <input type="text" id="reg-fname" name="fname" placeholder="Nguyễn Văn" required />
                    </div>
                    <div class="form-group">
                        <label for="reg-lname">Tên</label>
                        <input type="text" id="reg-lname" name="lname" placeholder="A" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="reg-email">Email công vụ</label>
                    <input type="email" id="reg-email" name="email" placeholder="nguyenvana@benhvien.vn" autocomplete="email" required />
                </div>

                <div class="form-group">
                    <label for="reg-role">Vai trò chuyên môn</label>
                    <select id="reg-role" name="role" required>
                        <option value="" disabled selected>Chọn vai trò</option>
                        <option value="bac-si">Bác sĩ</option>
                        <option value="dieu-duong">Điều dưỡng</option>
                        <option value="duoc-si">Dược sĩ</option>
                        <option value="ky-thuat-vien">Kỹ thuật viên</option>
                        <option value="quan-tri-vien">Quản trị viên</option>
                        <option value="lanh-dao">Lãnh đạo / Kiểm duyệt</option>
                        <option value="kiem-toan">Kiểm toán / QA</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="reg-department">Khoa / Phòng ban</label>
                    <select id="reg-department" name="department" required>
                        <option value="" disabled selected>Chọn khoa/phòng</option>
                        <option value="noi-tong-hop">Nội tổng hợp</option>
                        <option value="ngoai-tong-hop">Ngoại tổng hợp</option>
                        <option value="san-phu-khoa">Sản phụ khoa</option>
                        <option value="nhi">Nhi</option>
                        <option value="cap-cuu">Cấp cứu</option>
                        <option value="xet-nghiem">Xét nghiệm</option>
                        <option value="chan-doan-hinh-anh">Chẩn đoán hình ảnh</option>
                        <option value="duoc">Dược</option>
                        <option value="ky-thuat-y-sinh">Kỹ thuật y sinh</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="reg-password">Mật khẩu</label>
                    <input type="password" id="reg-password" name="password" placeholder="Tạo mật khẩu (tối thiểu 8 ký tự)" autocomplete="new-password" required />
                </div>

                <div class="form-options">
                    <label>
                        <input type="checkbox" name="terms" required />
                        Tôi đồng ý với <a href="#" style="margin-left: 4px;">Điều khoản sử dụng</a> và <a href="#" style="margin-left: 4px;">Chính sách bảo mật</a>
                    </label>
                </div>

                <button type="submit" class="login-submit">Đăng ký tài khoản</button>
            </form>

            <p class="login-footer">
                Đã có tài khoản? <a href="/login">Đăng nhập</a>
            </p>
        </div>
    </div>
</div>
