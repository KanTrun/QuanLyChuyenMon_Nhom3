@page "/register"

<PageTitle>Đăng ký | Bệnh viện số</PageTitle>

<div class="login-page">
    <!-- Left: Branding Panel -->
    <div class="login-brand">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>

        <div class="login-brand-content">
            <div class="login-logo">+</div>
            <h1>Gia nhập mạng lưới</h1>
            <p>Bắt đầu hành trình chăm sóc sức khỏe chủ động với Bệnh viện số ngay hôm nay.</p>

            <div class="login-features">
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </span>
                    <span>An toàn & bảo mật thông tin chuẩn y tế</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </span>
                    <span>Kết nối nhanh chóng với 1000+ bác sĩ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Register Form -->
    <div class="login-form-panel">
        <div class="login-form-wrapper">
            <div class="login-form-header">
                <p class="eyebrow">Đăng ký mới</p>
                <h2>Tạo tài khoản của bạn</h2>
                <p>Điền thông tin dưới đây để đăng ký tài khoản Bệnh viện số miễn phí.</p>
            </div>

            <form class="login-form" action="/" method="get">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
                    <div class="form-group">
                        <label for="reg-fname">Họ</label>
                        <input type="text" id="reg-fname" name="fname" placeholder="Nguyễn Văn" required />
                    </div>
                    <div class="form-group">
                        <label for="reg-lname">Tên</label>
                        <input type="text" id="reg-lname" name="lname" placeholder="A" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="reg-email">Email hoặc Số điện thoại</label>
                    <input type="text" id="reg-email" name="email" placeholder="nguyenvana@email.com" autocomplete="username" required />
                </div>

                <div class="form-group">
                    <label for="reg-password">Mật khẩu</label>
                    <input type="password" id="reg-password" name="password" placeholder="Tạo mật khẩu" autocomplete="new-password" required />
                </div>

                <div class="form-options">
                    <label>
                        <input type="checkbox" name="terms" required />
                        Tôi đồng ý với <a href="#" style="margin-left: 4px;">Điều khoản dịch vụ</a>
                    </label>
                </div>

                <button type="submit" class="login-submit">Đăng ký tài khoản</button>
            </form>

            <div class="login-divider"><span>Hoặc đăng ký với</span></div>

            <div class="social-login">
                <button type="button" class="social-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                    Google
                </button>
            </div>

            <p class="login-footer">
                Đã có tài khoản? <a href="/login">Đăng nhập</a>
            </p>
        </div>
    </div>
</div>
