@page "/lam-sang"
@layout PersonaLayout
@using TelemedicineLandingPage.Services.Admin.Sql
@using TelemedicineLandingPage.Models.Admin.Sql
@inject IMedDataStore Store
@implements IDisposable

<PageTitle>Lâm sàng | QLCM Pro</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Lâm sàng</span>
            <h1 class="admin-page-title">Bảng điều phối lâm sàng</h1>
            <p class="admin-page-subtitle">Theo dõi lượt khám, áp dụng phác đồ và trạng thái bệnh nhân.</p>
        </div>
    </header>

    <div class="admin-panel">
        <h2 class="admin-panel-title" style="margin-bottom:1rem;">Bệnh nhân đang theo dõi</h2>
        <AdminDataTable TItem="PatientRef"
                        Items="_pagedPatients"
                        ColumnCount="5"
                        CurrentPage="_page"
                        PageSize="_pageSize"
                        TotalItems="_total"
                        CurrentPageChanged="p => { _page = p; Paginate(); }"
                        EmptyTitle="Chưa có bệnh nhân"
                        EmptyBody="Hệ thống chưa ghi nhận bệnh nhân nào.">
            <HeaderTemplate>
                <th>Mã BN</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Giới tính</th>
                <th>Số lượt khám</th>
            </HeaderTemplate>
            <RowTemplate Context="patient">
                <tr>
                    <td>@patient.PatientCode</td>
                    <td>@patient.DisplayName</td>
                    <td>@patient.BirthDate?.ToString("dd/MM/yyyy")</td>
                    <td>@(patient.GenderCode == "F" ? "Nữ" : "Nam")</td>
                    <td>@Store.EncounterRefs.Count(e => e.PatientRefId == patient.PatientRefId)</td>
                </tr>
            </RowTemplate>
        </AdminDataTable>
    </div>
</section>

@code {
    private int _page = 1;
    private const int _pageSize = 10;
    private int _total;
    private IReadOnlyList<PatientRef> _pagedPatients = Array.Empty<PatientRef>();

    protected override void OnInitialized()
    {
        Store.StateChanged += OnChanged;
        Paginate();
    }

    private void OnChanged() => InvokeAsync(() => { Paginate(); StateHasChanged(); });

    private void Paginate()
    {
        var all = Store.PatientRefs.OrderBy(p => p.DisplayName).ToList();
        _total = all.Count;
        _pagedPatients = all.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    }

    public void Dispose() => Store.StateChanged -= OnChanged;
}
