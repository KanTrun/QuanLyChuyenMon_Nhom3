@page "/login"

<PageTitle>Đăng nhập | Bệnh viện số</PageTitle>

<div class="login-page">
    <!-- Left: Royal Branding Panel -->
    <div class="login-brand">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>

        <div class="login-brand-content">
            <div class="login-logo">+</div>
            <h1>Bệnh viện số</h1>
            <p>Nền tảng khám từ xa hiện đại, kết nối bạn với đội ngũ bác sĩ chuyên khoa hàng đầu.</p>

            <div class="login-features">
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    </span>
                    <span>Tư vấn video HD bảo mật đầu cuối</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </span>
                    <span>Hồ sơ y tế số được bảo vệ tuyệt đối</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </span>
                    <span>Đặt lịch khám 24/7, kết nối trong 12 phút</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Login Form -->
    <div class="login-form-panel">
        <div class="login-form-wrapper">
            <div class="login-form-header">
                <p class="eyebrow">Chào mừng trở lại</p>
                <h2>Đăng nhập tài khoản</h2>
                <p>Nhập thông tin đăng nhập để truy cập hệ thống khám từ xa.</p>
            </div>

            <form class="login-form" action="/" method="get">
                <div class="form-group">
                    <label for="login-email">Email hoặc Số điện thoại</label>
                    <input type="text" id="login-email" name="email" placeholder="nguyenvana@email.com" autocomplete="username" required />
                </div>

                <div class="form-group">
                    <label for="login-password">Mật khẩu</label>
                    <input type="password" id="login-password" name="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                </div>

                <div class="form-options">
                    <label>
                        <input type="checkbox" name="remember" />
                        Ghi nhớ đăng nhập
                    </label>
                    <a href="#">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="login-submit">Đăng nhập</button>
            </form>

            <div class="login-divider"><span>Hoặc tiếp tục với</span></div>

            <div class="social-login">
                <button type="button" class="social-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                    Google
                </button>
                <button type="button" class="social-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    Facebook
                </button>
            </div>

            <p class="login-footer">
                Chưa có tài khoản? <a href="#">Đăng ký ngay</a>
            </p>
        </div>
    </div>
</div>
