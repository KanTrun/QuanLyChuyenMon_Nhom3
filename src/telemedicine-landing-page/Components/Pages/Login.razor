@page "/login"
@using Microsoft.AspNetCore.WebUtilities
@using TelemedicineLandingPage.Data
@using TelemedicineLandingPage.Models.Admin.Sql
@using TelemedicineLandingPage.Services.Admin
@using TelemedicineLandingPage.Services.Admin.Sql
@inject ICurrentUserContext UserContext
@inject BrowserSessionService BrowserSession
@inject NavigationManager Navigation
@inject MedDbContext Db
@inject NavGate Gate
@inject IAdminNavigationState NavState

<PageTitle>Đăng nhập | QLCM Pro</PageTitle>

<div class="login-page" data-auth-page data-auth-variant="login">
    <section class="login-brand" aria-label="QLCM Pro">
        <div class="auth-grid-lines" aria-hidden="true"></div>
        <div class="auth-depth-field" aria-hidden="true">
            <span class="auth-plane auth-plane-one"></span>
            <span class="auth-plane auth-plane-two"></span>
            <span class="auth-plane auth-plane-three"></span>
            <span class="auth-ring auth-ring-one"></span>
            <span class="auth-ring auth-ring-two"></span>
        </div>
        <div class="auth-signal auth-signal-one" aria-hidden="true"></div>
        <div class="auth-signal auth-signal-two" aria-hidden="true"></div>

        <div class="login-brand-content">
            <div class="auth-product-row">
                <div class="login-logo" data-auth-float><img src="/brand/logo-hos.jpg" alt="" /></div>
                <div class="auth-product-copy">
                    <span>Clinical command access</span>
                    <strong>Secure session</strong>
                </div>
            </div>
            <p class="auth-kicker">Quản lý chuyên môn bệnh viện</p>
            <h1>QLCM Pro</h1>
            <p>Điều phối quy trình kỹ thuật, phân quyền, phác đồ và báo cáo vận hành trong một hệ thống an toàn.</p>

            <div class="auth-command-strip" aria-label="Chỉ số hệ thống">
                <span>RBAC</span>
                <span>Audit</span>
                <span>Clinical ops</span>
            </div>

            <div class="login-features">
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M20 6 12 3 4 6v6c0 5 3.4 8.7 8 9 4.6-.3 8-4 8-9V6Z"/></svg>
                    </span>
                    <span>Phân quyền chi tiết theo vai trò và khoa phòng</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9"/></svg>
                    </span>
                    <span>Theo dõi vòng đời quy trình chuyên môn</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V5"/><path d="M8 17V9"/><path d="M12 17V7"/><path d="M16 17v-5"/><path d="M20 19H3"/></svg>
                    </span>
                    <span>Nhật ký kiểm toán đầy đủ cho thao tác nhạy cảm</span>
                </div>
            </div>

            <div class="auth-status-card" data-auth-float-layer>
                <div>
                    <span class="auth-status-label">Phiên trực tuyến</span>
                    <strong>Kiểm soát truy cập</strong>
                </div>
                <div class="auth-status-meter" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </section>

    <section class="login-form-panel" aria-label="Đăng nhập">
        <div class="auth-form-aura" aria-hidden="true"></div>
        <div class="login-form-wrapper">
            <div class="auth-route-pill">
                <span></span>
                Cổng quản trị nội bộ
            </div>
            <div class="login-form-header">
                <p class="eyebrow">Chào mừng trở lại</p>
                <h2>Đăng nhập hệ thống</h2>
                <p>Nhập tài khoản nội bộ để vào không gian quản trị chuyên môn.</p>
            </div>

            <form class="login-form" @onsubmit="HandleLogin" @onsubmit:preventDefault>
                <div class="form-group">
                    <label for="login-username">Tên đăng nhập</label>
                    <input type="text" id="login-username" @bind="_username" placeholder="vd: admin" autocomplete="username" required />
                </div>

                <div class="form-group">
                    <label for="login-password">Mật khẩu</label>
                    <div class="password-field">
                        <input type="@PasswordInputType" id="login-password" @bind="_password" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                        <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility" aria-label="@PasswordToggleLabel" title="@PasswordToggleLabel">
                            @if (_showPassword)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 10.6A2 2 0 0 0 13.4 13.4"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5 0 8.5 4.3 9.7 6a13.5 13.5 0 0 1-3.1 3.6"/><path d="M6.6 6.6A13.7 13.7 0 0 0 2.3 11c1.2 1.7 4.7 6 9.7 6 1.5 0 2.9-.4 4.1-1"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.3 12S5.8 5 12 5s9.7 7 9.7 7-3.5 7-9.7 7-9.7-7-9.7-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="login-error" role="alert">
                        <span>@_errorMessage</span>
                    </div>
                }

                <button type="submit" class="login-submit" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="login-spinner"></span><span>Đang xử lý...</span>
                    }
                    else
                    {
                        <span>Đăng nhập</span>
                    }
                </button>
            </form>

            <p class="login-footer">
                Chưa có tài khoản? <a href="/register">Đăng ký ngay</a>
            </p>
            <div class="auth-assurance">
                <span>Mã hóa phiên</span>
                <span>Audit log</span>
                <span>RBAC</span>
            </div>
        </div>
    </section>
</div>

@code {
    private const int MaxFailedAttempts = 5;
    private static readonly TimeSpan LockoutDuration = TimeSpan.FromMinutes(15);

    private string _username = "";
    private string _password = "";
    private string? _errorMessage;
    private bool _isLoading;
    private bool _showPassword;
    private int _failedAttempts;
    private DateTime? _lockedUntilUtc;

    private string PasswordInputType => _showPassword ? "text" : "password";
    private string PasswordToggleLabel => _showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu";

    protected override void OnInitialized()
    {
        if (UserContext.CurrentUser is not null)
        {
            Navigation.NavigateTo(GetPostLoginRoute(), forceLoad: false, replace: true);
            return;
        }

        LoadSessionReason();
    }

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            await Task.Delay(300);
            if (IsLockedOut(out var remaining))
            {
                _errorMessage = $"Tài khoản đăng nhập đang bị tạm khóa. Thử lại sau {Math.Max(1, (int)Math.Ceiling(remaining.TotalMinutes))} phút.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_username))
            {
                _errorMessage = "Vui lòng nhập tên đăng nhập.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_password))
            {
                _errorMessage = "Vui lòng nhập mật khẩu.";
                return;
            }

            var loginResult = UserContext.LoginByUsernameDetailed(_username.Trim(), _password);
            if (loginResult.Status == LoginAttemptStatus.Inactive)
            {
                _errorMessage = "Tài khoản đã được ghi nhận trong hệ thống nhưng chưa được quản trị viên kích hoạt.";
                return;
            }

            if (loginResult.Status == LoginAttemptStatus.Rejected)
            {
                _errorMessage = "Yêu cầu tài khoản này đã bị từ chối. Vui lòng liên hệ quản trị viên để cập nhật hồ sơ.";
                return;
            }

            if (loginResult.Status == LoginAttemptStatus.PasswordNotSet)
            {
                _errorMessage = "Tài khoản chưa có mật khẩu. Vui lòng liên hệ quản trị viên để nhận liên kết thiết lập mật khẩu.";
                return;
            }

            var user = loginResult.User;

            if (user is null)
            {
                RegisterFailedAttempt();
                _errorMessage = "Tên đăng nhập hoặc mật khẩu không đúng.";
                return;
            }

            _failedAttempts = 0;
            _lockedUntilUtc = null;

            Db.AuditLogs.Add(new AuditLog
            {
                CorrelationId = Guid.NewGuid(),
                ActorUserId = user.UserId,
                ActorUsername = user.Username,
                ActionCode = "login",
                TargetType = "session",
                TargetId = user.UserId.ToString()
            });
            Db.SaveChanges();

            await BrowserSession.PersistCurrentUserAsync();

            Navigation.NavigateTo(GetPostLoginRoute(), forceLoad: false, replace: true);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void TogglePasswordVisibility()
        => _showPassword = !_showPassword;

    private void LoadSessionReason()
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var reason = query.TryGetValue("reason", out var values) ? values.ToString() : null;
        _errorMessage = reason switch
        {
            "replaced" => "Phiên đăng nhập đã hết hạn vì tài khoản này vừa đăng nhập trên một thiết bị hoặc trình duyệt khác.",
            "expired" => "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại để tiếp tục.",
            "disabled" => "Tài khoản hiện không còn hợp lệ hoặc đã bị vô hiệu hóa. Vui lòng liên hệ quản trị viên.",
            _ => _errorMessage
        };
    }

    private string GetPostLoginRoute()
        => Gate.GetFirstAccessibleRoute(NavState.NavItems, "/AccessDenied");

    private bool IsLockedOut(out TimeSpan remaining)
    {
        if (_lockedUntilUtc is null || _lockedUntilUtc <= DateTime.UtcNow)
        {
            _lockedUntilUtc = null;
            remaining = TimeSpan.Zero;
            return false;
        }

        remaining = _lockedUntilUtc.Value - DateTime.UtcNow;
        return true;
    }

    private void RegisterFailedAttempt()
    {
        _failedAttempts++;
        if (_failedAttempts >= MaxFailedAttempts)
        {
            _lockedUntilUtc = DateTime.UtcNow.Add(LockoutDuration);
        }
    }
}
