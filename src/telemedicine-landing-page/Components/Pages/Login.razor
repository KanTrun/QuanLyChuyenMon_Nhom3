@page "/login"
@using TelemedicineLandingPage.Services.Admin.Sql
@inject ICurrentUserContext UserContext
@inject NavigationManager Navigation

<PageTitle>Đăng nhập | QLCM Pro</PageTitle>

<div class="login-page">
    <!-- Left: Royal Branding Panel -->
    <div class="login-brand">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>

        <div class="login-brand-content">
            <div class="login-logo">+</div>
            <h1>QLCM Pro</h1>
            <p>Hệ thống Quản lý Chuyên môn bệnh viện — quản lý quy trình, phân quyền, phác đồ và báo cáo.</p>

            <div class="login-features">
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </span>
                    <span>Phân quyền chi tiết theo vai trò và khoa/phòng</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </span>
                    <span>Quản lý vòng đời quy trình chuyên môn</span>
                </div>
                <div class="login-feature">
                    <span class="login-feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                    </span>
                    <span>Nhật ký kiểm toán đầy đủ mọi thao tác</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Login Form -->
    <div class="login-form-panel">
        <div class="login-form-wrapper">
            <div class="login-form-header">
                <p class="eyebrow">Chào mừng trở lại</p>
                <h2>Đăng nhập hệ thống</h2>
                <p>Nhập tên đăng nhập để truy cập hệ thống quản lý chuyên môn.</p>
            </div>

            <form class="login-form" @onsubmit="HandleLogin" @onsubmit:preventDefault>
                <div class="form-group">
                    <label for="login-username">Tên đăng nhập</label>
                    <input type="text" id="login-username" @bind="_username" placeholder="Nhập tên đăng nhập" autocomplete="username" required />
                </div>

                <div class="form-group">
                    <label for="login-password">Mật khẩu</label>
                    <input type="password" id="login-password" @bind="_password" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="login-error" role="alert">
                        <span>⚠️ @_errorMessage</span>
                    </div>
                }

                <button type="submit" class="login-submit" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <span>Đăng nhập</span>
                    }
                </button>
            </form>

            <p class="login-footer" style="margin-top:1.5rem;font-size:0.85rem;color:var(--text-muted,#888);">
                Liên hệ quản trị viên nếu quên mật khẩu.
            </p>
        </div>
    </div>
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string? _errorMessage;
    private bool _isLoading;

    protected override void OnInitialized()
    {
        // Nếu đã đăng nhập rồi thì chuyển thẳng vào admin
        if (UserContext.CurrentUser is not null)
        {
            Navigation.NavigateTo("/admin", forceLoad: false);
        }
    }

    private void HandleLogin()
    {
        _errorMessage = null;
        _isLoading = true;

        try
        {
            if (string.IsNullOrWhiteSpace(_username))
            {
                _errorMessage = "Vui lòng nhập tên đăng nhập.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_password))
            {
                _errorMessage = "Vui lòng nhập mật khẩu.";
                return;
            }

            // Thử đăng nhập với mật khẩu
            var user = UserContext.LoginByUsername(_username.Trim(), _password);

            // Nếu thất bại, thử đăng nhập không mật khẩu (tài khoản chưa đặt password)
            if (user is null)
            {
                user = UserContext.LoginByUsernameOnly(_username.Trim());
            }

            if (user is null)
            {
                _errorMessage = "Tên đăng nhập hoặc mật khẩu không đúng.";
                return;
            }

            // Đăng nhập thành công
            Navigation.NavigateTo("/admin", forceLoad: false);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
