@page "/dashboard"
@layout AppLayout

@* Dashboard.razor - World-class post-login dashboard with KPIs, charts, heatmap, calendar *@

<div class="dashboard">
    <!-- Section 1: Welcome Banner -->
    <section class="dashboard__welcome reveal" aria-label="Chào mừng">
        <div class="dashboard__welcome-left">
            <h1 class="dashboard__greeting">@GetGreeting(), <span class="dashboard__greeting-name">BS. Nguyễn Văn An</span></h1>
            <p class="dashboard__subtitle typewriter">Hệ thống quản lý chuyên môn hoạt động ổn định</p>
            <div class="dashboard__date">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M2 6h12M5 1v3M11 1v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                <span>@DateTime.Now.ToString("dddd, dd/MM/yyyy")</span>
                <span class="dashboard__refresh-indicator" title="Tự động cập nhật"></span>
            </div>
        </div>
        <div class="dashboard__welcome-right">
            <div class="dashboard__quick-actions">
                <a href="/procedures/create" class="dashboard__quick-btn">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2"/><path d="M7 4.5v5M4.5 7h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                    Tạo quy trình
                </a>
                <a href="/procedures/publish" class="dashboard__quick-btn">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M4 7l2.5 2.5L10 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Phê duyệt
                </a>
                <a href="/reports" class="dashboard__quick-btn">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 3v8h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M5 9l2-2 2 1.5 3-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Báo cáo
                </a>
            </div>
        </div>
    </section>

    <!-- Section 2: KPI Cards -->
    <section class="dashboard__kpi-row reveal stagger-children" aria-label="Chỉ số KPI">
        @foreach (var kpi in kpiCards)
        {
            <div class="kpi-card">
                <div class="kpi-card__header">
                    <div class="kpi-card__icon kpi-card__icon--@kpi.Color">
                        @((MarkupString)kpi.IconSvg)
                    </div>
                    <span class="kpi-card__title">@kpi.Title</span>
                </div>
                <span class="kpi-card__value counter-animate" data-target="@kpi.Value" data-suffix="@kpi.Suffix">0</span>
                <span class="kpi-card__trend kpi-card__trend--@kpi.Trend">
                    @if (kpi.Trend == "up")
                    {
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 9V3M3.5 5L6 2.5 8.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    }
                    else if (kpi.Trend == "down")
                    {
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 3v6M3.5 7L6 9.5 8.5 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    }
                    @kpi.TrendText
                </span>
                <svg class="kpi-card__sparkline" viewBox="0 0 80 32" fill="none" aria-hidden="true">
                    <polyline class="sparkline__path" points="@kpi.SparklinePoints" stroke="@kpi.SparklineColor" />
                </svg>
            </div>
        }
    </section>

    <!-- Section 3: Donut Chart + Area Trend -->
    <section class="dashboard__charts-row reveal" aria-label="Biểu đồ">
        <!-- Donut Chart -->
        <div class="dashboard__chart-panel">
            <h3 class="dashboard__chart-title">Phân bố trạng thái quy trình</h3>
            <div class="donut-chart">
                <div class="donut-chart__ring" style="background: conic-gradient(var(--color-primary) 0deg 223.2deg, var(--color-warning) 223.2deg 266.4deg, var(--color-subtle) 266.4deg 331.2deg, var(--color-border) 331.2deg 360deg);">
                    <div class="donut-chart__center">
                        <span class="donut-chart__center-value counter-animate" data-target="128">0</span>
                        <span class="donut-chart__center-label">Tổng</span>
                    </div>
                </div>
                <div class="donut-chart__legend">
                    <div class="donut-chart__legend-item">
                        <span class="donut-chart__legend-dot" style="background: var(--color-primary);"></span>
                        <span>Hoạt động (62%)</span>
                    </div>
                    <div class="donut-chart__legend-item">
                        <span class="donut-chart__legend-dot" style="background: var(--color-warning);"></span>
                        <span>Chờ duyệt (12%)</span>
                    </div>
                    <div class="donut-chart__legend-item">
                        <span class="donut-chart__legend-dot" style="background: var(--color-subtle);"></span>
                        <span>Nháp (18%)</span>
                    </div>
                    <div class="donut-chart__legend-item">
                        <span class="donut-chart__legend-dot" style="background: var(--color-border);"></span>
                        <span>Lưu trữ (8%)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Area Trend Chart -->
        <div class="dashboard__chart-panel">
            <h3 class="dashboard__chart-title">Xu hướng hoạt động</h3>
            <p class="dashboard__chart-subtitle">Số quy trình được cập nhật theo tuần (12 tuần gần nhất)</p>
            <div class="area-chart__container">
                <svg class="area-chart__svg" viewBox="0 0 480 180" preserveAspectRatio="none">
                    <polygon class="area-chart__fill" points="0,180 0,140 40,130 80,120 120,110 160,90 200,100 240,80 280,70 320,60 360,50 400,40 440,30 480,20 480,180" fill="url(#areaGradient)" />
                    <polyline class="area-chart__line sparkline__path" points="0,140 40,130 80,120 120,110 160,90 200,100 240,80 280,70 320,60 360,50 400,40 440,30 480,20" stroke="var(--color-primary)" />
                    <defs>
                        <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.3"/>
                            <stop offset="100%" stop-color="var(--color-primary)" stop-opacity="0.02"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <div class="area-chart__labels">
                <span class="area-chart__label">T1</span>
                <span class="area-chart__label">T3</span>
                <span class="area-chart__label">T5</span>
                <span class="area-chart__label">T7</span>
                <span class="area-chart__label">T9</span>
                <span class="area-chart__label">T11</span>
                <span class="area-chart__label">T12</span>
            </div>
        </div>
    </section>

    <!-- Section 4: Activity Heatmap -->
    <section class="dashboard__heatmap reveal" aria-label="Hoạt động">
        <h3 class="heatmap__title">Hoạt động 5 tuần gần nhất</h3>
        <div class="heatmap__grid">
            <span class="heatmap__day-label">T2</span>
            <span class="heatmap__day-label">T3</span>
            <span class="heatmap__day-label">T4</span>
            <span class="heatmap__day-label">T5</span>
            <span class="heatmap__day-label">T6</span>
            <span class="heatmap__day-label">T7</span>
            <span class="heatmap__day-label">CN</span>
            @foreach (var cell in heatmapData)
            {
                <div class="heatmap__cell heatmap__cell--@cell.Level" data-tooltip="@cell.Count hoạt động"></div>
            }
        </div>
        <div class="heatmap__legend">
            <span>Ít</span>
            <div class="heatmap__legend-cell heatmap__cell--0"></div>
            <div class="heatmap__legend-cell heatmap__cell--1"></div>
            <div class="heatmap__legend-cell heatmap__cell--2"></div>
            <div class="heatmap__legend-cell heatmap__cell--3"></div>
            <div class="heatmap__legend-cell heatmap__cell--4"></div>
            <span>Nhiều</span>
        </div>
    </section>

    <!-- Section 5: Approval Queue + Calendar -->
    <section class="dashboard__two-col reveal" aria-label="Phê duyệt và lịch">
        <!-- Approval Queue -->
        <div class="approval-queue">
            <div class="approval-queue__header">
                <h3 class="approval-queue__title">Phê duyệt chờ xử lý</h3>
                <span class="approval-queue__badge">5</span>
            </div>
            <div class="approval-queue__list">
                @foreach (var item in approvalItems)
                {
                    <div class="approval-queue__item approval-queue__item--@item.Priority">
                        <span class="approval-queue__priority approval-queue__priority--@item.Priority">@item.PriorityLabel</span>
                        <div class="approval-queue__avatar" style="background: @item.AvatarBg;">@item.Initials</div>
                        <div class="approval-queue__info">
                            <span class="approval-queue__name">@item.Name</span>
                            <span class="approval-queue__meta">@item.Requester</span>
                        </div>
                        <span class="approval-queue__time">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1"/><path d="M6 4v2.5l1.5 1" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
                            @item.TimeRemaining
                        </span>
                        <div class="approval-queue__actions">
                            <button class="approval-queue__btn approval-queue__btn--approve" title="Phê duyệt">Duyệt</button>
                            <button class="approval-queue__btn approval-queue__btn--reject" title="Từ chối">Từ chối</button>
                            <button class="approval-queue__btn approval-queue__btn--view" title="Xem chi tiết">Xem</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Calendar Widget -->
        <div class="calendar">
            <div class="calendar__header">
                <span class="calendar__month-label">@GetCurrentMonthLabel()</span>
                <div class="calendar__nav">
                    <button class="calendar__nav-btn calendar__nav--prev" aria-label="Tháng trước">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 3L5 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <button class="calendar__nav-btn calendar__nav--next" aria-label="Tháng sau">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
            </div>
            <div class="calendar__weekdays">
                <span class="calendar__weekday">T2</span>
                <span class="calendar__weekday">T3</span>
                <span class="calendar__weekday">T4</span>
                <span class="calendar__weekday">T5</span>
                <span class="calendar__weekday">T6</span>
                <span class="calendar__weekday">T7</span>
                <span class="calendar__weekday">CN</span>
            </div>
            <div class="calendar__days">
                @foreach (var day in calendarDays)
                {
                    <span class="calendar__day @day.CssClass">@day.Label</span>
                }
            </div>
            <div class="calendar__events">
                <h4 class="calendar__events-title">Sự kiện sắp tới</h4>
                <div class="calendar__event-item">
                    <span class="calendar__event-dot calendar__event-dot--blue"></span>
                    <span>15/05 - Hết hạn quyền Khoa Ngoại</span>
                </div>
                <div class="calendar__event-item">
                    <span class="calendar__event-dot calendar__event-dot--green"></span>
                    <span>18/05 - Họp Hội đồng Phác đồ</span>
                </div>
                <div class="calendar__event-item">
                    <span class="calendar__event-dot calendar__event-dot--orange"></span>
                    <span>20/05 - Review quy trình ICU</span>
                </div>
                <div class="calendar__event-item">
                    <span class="calendar__event-dot calendar__event-dot--purple"></span>
                    <span>25/05 - Kiểm tra tuân thủ JCI</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 6: System Health -->
    <section class="dashboard__health-row reveal stagger-children" aria-label="Sức khỏe hệ thống">
        <div class="health-card">
            <div class="health-card__ring">
                <svg viewBox="0 0 100 100">
                    <circle class="health-ring__bg" cx="50" cy="50" r="40"/>
                    <circle class="health-ring__progress health-ring__progress--green" cx="50" cy="50" r="40" data-percent="45"/>
                </svg>
                <span class="health-card__percent counter-animate" data-target="45" data-suffix="%">0%</span>
            </div>
            <span class="health-card__label">CPU</span>
            <span class="health-card__status">Hoạt động bình thường</span>
        </div>
        <div class="health-card">
            <div class="health-card__ring">
                <svg viewBox="0 0 100 100">
                    <circle class="health-ring__bg" cx="50" cy="50" r="40"/>
                    <circle class="health-ring__progress health-ring__progress--yellow" cx="50" cy="50" r="40" data-percent="68"/>
                </svg>
                <span class="health-card__percent counter-animate" data-target="68" data-suffix="%">0%</span>
            </div>
            <span class="health-card__label">Memory</span>
            <span class="health-card__status">Mức sử dụng trung bình</span>
        </div>
        <div class="health-card">
            <div class="health-card__ring">
                <svg viewBox="0 0 100 100">
                    <circle class="health-ring__bg" cx="50" cy="50" r="40"/>
                    <circle class="health-ring__progress health-ring__progress--green" cx="50" cy="50" r="40" data-percent="99.9"/>
                </svg>
                <span class="health-card__percent counter-animate" data-target="99.9" data-suffix="%">0%</span>
            </div>
            <span class="health-card__label">Uptime</span>
            <span class="health-card__status">Cực kỳ ổn định</span>
        </div>
    </section>

    <!-- Section 7: Quick Access Modules -->
    <section class="dashboard__quick-access reveal" aria-label="Truy cập nhanh">
        <h3 class="dashboard__section-title">Truy cập nhanh</h3>
        <div class="dashboard__modules-grid">
            @foreach (var module in modules)
            {
                <a href="@module.Route" class="dashboard__module-card tilt-card">
                    <div class="dashboard__module-icon dashboard__module-icon--@module.Color">
                        @((MarkupString)module.IconSvg)
                    </div>
                    <h4 class="dashboard__module-name">@module.Name</h4>
                    <p class="dashboard__module-desc">@module.Description</p>
                    <div class="dashboard__module-footer">
                        <span class="dashboard__module-link">Truy cập <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span class="dashboard__module-shortcut">@module.Shortcut</span>
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- Section 8: Recent Activity Feed -->
    <section class="dashboard__activity-feed reveal" aria-label="Hoạt động gần đây">
        <div class="activity-feed-v2__header">
            <h3 class="activity-feed-v2__title">Hoạt động gần đây</h3>
            <a href="/reports" class="activity-feed-v2__link">Xem tất cả</a>
        </div>
        <div class="activity-feed-v2__list stagger-children">
            @foreach (var activity in recentActivities)
            {
                <div class="activity-feed-v2__item activity-feed-v2__item--@activity.Type">
                    <div class="activity-feed-v2__avatar" style="background: @activity.AvatarBg;">@activity.Initials</div>
                    <div class="activity-feed-v2__content">
                        <p class="activity-feed-v2__item-title">@activity.Title</p>
                        <p class="activity-feed-v2__item-desc">@activity.Description</p>
                        <span class="activity-feed-v2__item-time">@activity.Timestamp</span>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Chào buổi sáng";
        if (hour < 18) return "Chào buổi chiều";
        return "Chào buổi tối";
    }

    private string GetCurrentMonthLabel()
    {
        var months = new[] { "Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12" };
        return months[DateTime.Now.Month - 1] + " " + DateTime.Now.Year;
    }

    private record KpiCard(string Title, string Value, string Suffix, string Trend, string TrendText, string Color, string IconSvg, string SparklinePoints, string SparklineColor);

    private List<KpiCard> kpiCards = new()
    {
        new("Quy trình Active", "128", "", "up", "+5 tháng này", "primary", "<svg width='18' height='18' viewBox='0 0 18 18' fill='none'><path d='M3 3h12v12H3z' stroke='currentColor' stroke-width='1.3' rx='2'/><path d='M6 7h6M6 9.5h6M6 12h4' stroke='currentColor' stroke-width='1.2' stroke-linecap='round'/></svg>", "5,28 15,24 25,26 40,22 55,18 65,16 75,12", "var(--color-primary)"),
        new("Chờ phê duyệt", "12", "", "neutral", "3 khẩn cấp", "warning", "<svg width='18' height='18' viewBox='0 0 18 18' fill='none'><circle cx='9' cy='9' r='7' stroke='currentColor' stroke-width='1.3'/><path d='M9 5.5v4l2.5 1.5' stroke='currentColor' stroke-width='1.3' stroke-linecap='round'/></svg>", "5,16 15,18 25,16 40,17 55,16 65,18 75,16", "var(--color-warning)"),
        new("Phác đồ lâm sàng", "45", "", "up", "+2 mới", "success", "<svg width='18' height='18' viewBox='0 0 18 18' fill='none'><path d='M9 3a3.5 3.5 0 013.5 3.5V8h1.5a1.5 1.5 0 011.5 1.5v5a1.5 1.5 0 01-1.5 1.5h-9A1.5 1.5 0 014 14.5v-5A1.5 1.5 0 015.5 8H7V6.5A3.5 3.5 0 019 3z' stroke='currentColor' stroke-width='1.3'/></svg>", "5,26 15,24 25,22 40,20 55,18 65,14 75,10", "var(--color-success)"),
        new("Thông báo chưa đọc", "7", "", "down", "3 ưu tiên", "info", "<svg width='18' height='18' viewBox='0 0 18 18' fill='none'><path d='M9 3a5 5 0 015 5v3l1.5 1.5H3.5L5 11V8a5 5 0 015-5z' stroke='currentColor' stroke-width='1.3'/><path d='M7.5 14a1.5 1.5 0 003 0' stroke='currentColor' stroke-width='1.3'/></svg>", "5,10 15,14 25,18 40,20 55,22 65,26 75,28", "var(--color-info)"),
        new("Nhân viên trực tuyến", "234", "", "up", "+12 vs hôm qua", "teal", "<svg width='18' height='18' viewBox='0 0 18 18' fill='none'><circle cx='9' cy='6' r='3' stroke='currentColor' stroke-width='1.3'/><path d='M3 15c0-3 3-5.5 6-5.5s6 2.5 6 5.5' stroke='currentColor' stroke-width='1.3' stroke-linecap='round'/></svg>", "5,24 15,22 25,18 40,16 55,14 65,12 75,8", "var(--color-secondary)"),
        new("Tuân thủ quy trình", "96.5", "%", "up", "+1.2% vs tháng trước", "purple", "<svg width='18' height='18' viewBox='0 0 18 18' fill='none'><path d='M9 2l6 3.5v5c0 3.5-2.5 6-6 7.5-3.5-1.5-6-4-6-7.5v-5L9 2z' stroke='currentColor' stroke-width='1.3'/><path d='M6.5 9l2 2 3.5-3.5' stroke='currentColor' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round'/></svg>", "5,20 15,18 25,16 40,14 55,12 65,10 75,6", "#8b5cf6")
    };

    private record HeatmapCell(int Level, int Count);
    private List<HeatmapCell> heatmapData = new()
    {
        new(2,5), new(3,8), new(1,2), new(4,12), new(3,9), new(1,3), new(0,0),
        new(1,3), new(2,6), new(3,7), new(2,5), new(4,14), new(2,4), new(0,0),
        new(3,8), new(4,11), new(2,6), new(3,9), new(1,2), new(1,3), new(0,1),
        new(2,5), new(1,2), new(4,13), new(3,8), new(2,6), new(0,1), new(0,0),
        new(4,15), new(3,9), new(2,4), new(4,12), new(3,7), new(1,2), new(0,0)
    };

    private record ApprovalItem(string Name, string Requester, string Priority, string PriorityLabel, string Initials, string AvatarBg, string TimeRemaining);
    private List<ApprovalItem> approvalItems = new()
    {
        new("QT Phẫu thuật nội soi gan", "BS. Trần Văn Bình", "urgent", "Khẩn cấp", "TB", "#ef4444", "2 giờ"),
        new("Phác đồ điều trị ung thư phổi", "PGS. Nguyễn Thị Hoa", "urgent", "Khẩn cấp", "NH", "#f97316", "5 giờ"),
        new("QT Xét nghiệm HIV nhanh", "BS. Lê Minh Tuấn", "normal", "Bình thường", "LT", "#2563eb", "1 ngày"),
        new("Định mức vật tư mổ tim", "DS. Phạm Anh Thư", "normal", "Bình thường", "PT", "#0d9488", "2 ngày"),
        new("QT Chăm sóc bệnh nhân ICU", "DD. Hoàng Thị Mai", "low", "Thấp", "HM", "#64748b", "5 ngày")
    };

    private record CalendarDay(string Label, string CssClass);
    private List<CalendarDay> calendarDays = new()
    {
        new("28", "calendar__day--other"), new("29", "calendar__day--other"), new("30", "calendar__day--other"), new("1", ""), new("2", ""), new("3", ""), new("4", ""),
        new("5", ""), new("6", ""), new("7", ""), new("8", ""), new("9", ""), new("10", ""), new("11", ""),
        new("12", ""), new("13", ""), new("14", "calendar__day--today"), new("15", "calendar__day--event"), new("16", ""), new("17", ""), new("18", "calendar__day--event"),
        new("19", ""), new("20", "calendar__day--event"), new("21", ""), new("22", ""), new("23", ""), new("24", ""), new("25", "calendar__day--event"),
        new("26", ""), new("27", ""), new("28", ""), new("29", ""), new("30", ""), new("31", ""), new("1", "calendar__day--other")
    };

    private record ModuleItem(string Name, string Description, string Route, string Color, string IconSvg, string Shortcut);
