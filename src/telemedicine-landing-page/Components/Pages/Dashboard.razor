@page "/dashboard"
@layout AppLayout
@using TelemedicineLandingPage.Components.Shared

@* Dashboard.razor - World-class post-login dashboard *@

<div class="dashboard">
    <!-- Row 1: Welcome Banner -->
    <section class="dashboard__welcome reveal is-visible" aria-label="Chào mừng">
        <div class="dashboard__welcome-left">
            <h1 class="dashboard__greeting">@GetGreeting(), <span class="dashboard__greeting-name">BS. Nguyen Van A</span></h1>
            <p class="dashboard__subtitle">Đây là tổng quan hoạt động hôm nay của bạn</p>
        </div>
        <div class="dashboard__welcome-right">
            <div class="dashboard__date">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="2" y="3" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M2 7h14M6 1v4M12 1v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <span>@DateTime.Now.ToString("dddd, dd/MM/yyyy")</span>
            </div>
        </div>
    </section>

    <!-- Row 2: Stats Cards -->
    <section class="dashboard__stats reveal is-visible" aria-label="Thống kê tổng quan">
        <StatCard Title="Quy trình Active" Value="128" TrendText="+5 tháng này" TrendDirection="up" ColorClass="primary">
            <Icon>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 4h16v16H4z" stroke="currentColor" stroke-width="1.5" rx="2"/><path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </Icon>
        </StatCard>
        <StatCard Title="Chờ phê duyệt" Value="12" TrendText="3 khẩn cấp" TrendDirection="neutral" ColorClass="warning">
            <Icon>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </Icon>
        </StatCard>
        <StatCard Title="Phác đồ lâm sàng" Value="45" TrendText="+2 mới" TrendDirection="up" ColorClass="success">
            <Icon>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 4a4 4 0 014 4v1h2a2 2 0 012 2v7a2 2 0 01-2 2H6a2 2 0 01-2-2v-7a2 2 0 012-2h2V8a4 4 0 014-4z" stroke="currentColor" stroke-width="1.5"/><path d="M10 14h4M12 12v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </Icon>
        </StatCard>
        <StatCard Title="Thông báo" Value="7" TrendText="3 chưa đọc" TrendDirection="neutral" ColorClass="info">
            <Icon>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 3a6 6 0 016 6v4l2 2H4l2-2V9a6 6 0 016-6z" stroke="currentColor" stroke-width="1.5"/><path d="M10 17a2 2 0 004 0" stroke="currentColor" stroke-width="1.5"/></svg>
            </Icon>
        </StatCard>
    </section>

    <!-- Row 3: Activity + Approvals -->
    <section class="dashboard__row-3 reveal">
        <!-- Activity Feed -->
        <div class="dashboard__activity-col">
            <ActivityFeed Activities="@activities" />
        </div>

        <!-- Pending Approvals -->
        <div class="dashboard__approvals-col">
            <div class="dashboard__approvals">
                <div class="dashboard__approvals-header">
                    <h3>Phê duyệt chờ xử lý</h3>
                    <span class="dashboard__approvals-badge">5</span>
                </div>
                <div class="dashboard__approvals-list">
                    @foreach (var approval in pendingApprovals)
                    {
                        <div class="dashboard__approval-item">
                            <div class="dashboard__approval-info">
                                <span class="dashboard__approval-name">@approval.Name</span>
                                <span class="dashboard__approval-meta">@approval.Requester &bull; @approval.Date</span>
                            </div>
                            <span class="dashboard__approval-priority dashboard__approval-priority--@approval.Priority">@approval.PriorityLabel</span>
                            <div class="dashboard__approval-actions">
                                <button class="dashboard__btn dashboard__btn--approve" title="Phê duyệt" aria-label="Phê duyệt @approval.Name">Duyệt</button>
                                <button class="dashboard__btn dashboard__btn--reject" title="Từ chối" aria-label="Từ chối @approval.Name">Từ chối</button>
                                <button class="dashboard__btn dashboard__btn--view" title="Xem chi tiết" aria-label="Xem @approval.Name">Xem</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Row 4: Quick Access Grid -->
    <section class="dashboard__quick-access reveal" aria-label="Truy cập nhanh">
        <h3 class="dashboard__section-title">Truy cập nhanh</h3>
        <div class="dashboard__modules-grid">
            @foreach (var module in modules)
            {
                <a href="@module.Route" class="dashboard__module-card">
                    <div class="dashboard__module-icon dashboard__module-icon--@module.Color">
                        @((MarkupString)module.IconSvg)
                    </div>
                    <h4 class="dashboard__module-name">@module.Name</h4>
                    <p class="dashboard__module-desc">@module.Description</p>
                    <span class="dashboard__module-link">Truy cập <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </a>
            }
        </div>
    </section>

    <!-- Row 5: Schedule + Chart -->
    <section class="dashboard__row-5 reveal">
        <!-- Schedule Widget -->
        <div class="dashboard__schedule-col">
            <div class="dashboard__schedule">
                <h3 class="dashboard__schedule-title">Lịch trình sắp tới</h3>
                <div class="dashboard__schedule-list">
                    @foreach (var evt in scheduleEvents)
                    {
                        <div class="dashboard__schedule-item">
                            <div class="dashboard__schedule-date-badge">
                                <span class="dashboard__schedule-day">@evt.Day</span>
                                <span class="dashboard__schedule-month">@evt.Month</span>
                            </div>
                            <div class="dashboard__schedule-info">
                                <span class="dashboard__schedule-event-title">@evt.Title</span>
                                <span class="dashboard__schedule-event-desc">@evt.Description</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Mini Bar Chart -->
        <div class="dashboard__chart-col">
            <div class="dashboard__chart">
                <h3 class="dashboard__chart-title">Thống kê nhanh</h3>
                <p class="dashboard__chart-subtitle">Số lượng quy trình theo khoa</p>
                <div class="dashboard__bar-chart" role="img" aria-label="Biểu đồ quy trình theo khoa">
                    <div class="dashboard__bar-row">
                        <span class="dashboard__bar-label">Nội khoa</span>
                        <div class="dashboard__bar-track"><div class="dashboard__bar-fill dashboard__bar-fill--1" style="width: 85%;"></div></div>
                        <span class="dashboard__bar-value">34</span>
                    </div>
                    <div class="dashboard__bar-row">
                        <span class="dashboard__bar-label">Ngoại khoa</span>
                        <div class="dashboard__bar-track"><div class="dashboard__bar-fill dashboard__bar-fill--2" style="width: 70%;"></div></div>
                        <span class="dashboard__bar-value">28</span>
                    </div>
                    <div class="dashboard__bar-row">
                        <span class="dashboard__bar-label">Sản khoa</span>
                        <div class="dashboard__bar-track"><div class="dashboard__bar-fill dashboard__bar-fill--3" style="width: 55%;"></div></div>
                        <span class="dashboard__bar-value">22</span>
                    </div>
                    <div class="dashboard__bar-row">
                        <span class="dashboard__bar-label">Nhi khoa</span>
                        <div class="dashboard__bar-track"><div class="dashboard__bar-fill dashboard__bar-fill--4" style="width: 45%;"></div></div>
                        <span class="dashboard__bar-value">18</span>
                    </div>
                    <div class="dashboard__bar-row">
                        <span class="dashboard__bar-label">CĐHA</span>
                        <div class="dashboard__bar-track"><div class="dashboard__bar-fill dashboard__bar-fill--5" style="width: 40%;"></div></div>
                        <span class="dashboard__bar-value">16</span>
                    </div>
                    <div class="dashboard__bar-row">
                        <span class="dashboard__bar-label">Dược</span>
                        <div class="dashboard__bar-track"><div class="dashboard__bar-fill dashboard__bar-fill--6" style="width: 25%;"></div></div>
                        <span class="dashboard__bar-value">10</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Chào buổi sáng";
        if (hour < 18) return "Chào buổi chiều";
        return "Chào buổi tối";
    }

