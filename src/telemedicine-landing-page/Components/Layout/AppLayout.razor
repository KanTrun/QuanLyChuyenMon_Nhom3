@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* AppLayout.razor - Authenticated area layout with sidebar + header + content *@

<!-- Skip to content (accessibility) -->
<a href="#main-content" class="skip-to-content">Chuyen den noi dung chinh</a>

<div class="app-layout @(sidebarCollapsed ? "app-layout--sidebar-collapsed" : "")" data-layout="app">
    <!-- Mobile Overlay Backdrop -->
    @if (mobileMenuOpen)
    {
        <div class="app-layout__backdrop" @onclick="CloseMobileMenu" aria-hidden="true"></div>
    }

    <!-- Sidebar -->
    <aside class="app-layout__sidebar @(mobileMenuOpen ? "app-layout__sidebar--mobile-open" : "")" role="navigation" aria-label="Menu dieu huong">
        <SidebarNav IsCollapsed="@sidebarCollapsed" IsCollapsedChanged="OnSidebarCollapsedChanged" />
    </aside>

    <!-- Main Content Area -->
    <div class="app-layout__main">
        <!-- Header -->
        <AppHeader PageTitle="@pageTitle" OnHamburgerClicked="ToggleMobileMenu" />

        <!-- Scroll Progress Bar -->
        <div class="scroll-progress-bar" aria-hidden="true"></div>

        <!-- Page Content -->
        <main class="app-layout__content" id="main-content" role="main" aria-label="Noi dung chinh">
            @Body
        </main>
    </div>

    <!-- Global Overlays -->
    <CommandPalette />
    <FloatingActionButton />
    <ToastContainer />

    <!-- Scroll to Top -->
    <button class="scroll-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Cuon len dau trang" title="Len dau trang">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 16V4M5 9l5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
</div>

@code {
    private bool sidebarCollapsed = false;
    private bool mobileMenuOpen = false;

    private string pageTitle => GetPageTitle();

    private string GetPageTitle()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Split('#')[0];
        if (path.StartsWith("/dashboard")) return "Tong quan";
        if (path.StartsWith("/procedures")) return "Quy trinh Ky thuat";
        if (path.StartsWith("/permissions")) return "Phan quyen";
        if (path.StartsWith("/catalog")) return "Danh muc Ky thuat";
        if (path.StartsWith("/protocols")) return "Phac do Lam sang";
        if (path.StartsWith("/notifications")) return "Thong bao";
        if (path.StartsWith("/reports")) return "Bao cao";
        if (path.StartsWith("/settings")) return "Cai dat";
        return "Tong quan";
    }

    private void OnSidebarCollapsedChanged(bool collapsed)
    {
        sidebarCollapsed = collapsed;
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        mobileMenuOpen = false;
    }
}
