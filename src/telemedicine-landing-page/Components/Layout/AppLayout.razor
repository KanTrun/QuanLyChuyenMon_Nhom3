@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* AppLayout.razor - Authenticated area layout with sidebar + header + content *@

<div class="app-layout @(sidebarCollapsed ? "app-layout--sidebar-collapsed" : "")">
    <!-- Mobile Overlay Backdrop -->
    @if (mobileMenuOpen)
    {
        <div class="app-layout__backdrop" @onclick="CloseMobileMenu" aria-hidden="true"></div>
    }

    <!-- Sidebar -->
    <div class="app-layout__sidebar @(mobileMenuOpen ? "app-layout__sidebar--mobile-open" : "")">
        <SidebarNav IsCollapsed="@sidebarCollapsed" IsCollapsedChanged="OnSidebarCollapsedChanged" />
    </div>

    <!-- Main Content Area -->
    <div class="app-layout__main">
        <!-- Header -->
        <AppHeader PageTitle="@pageTitle" OnHamburgerClicked="ToggleMobileMenu" />

        <!-- Page Content -->
        <main class="app-layout__content" id="main-content" role="main">
            @Body
        </main>
    </div>
</div>

<!-- Global Overlays -->
<CommandPalette />
<FloatingActionButton />
<ToastContainer />

@code {
    private bool sidebarCollapsed = false;
    private bool mobileMenuOpen = false;

    private string pageTitle => GetPageTitle();

    private string GetPageTitle()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Split('#')[0];
        if (path.StartsWith("/dashboard")) return "Tổng quan";
        if (path.StartsWith("/procedures")) return "Quy trình Kỹ thuật";
        if (path.StartsWith("/permissions")) return "Phân quyền";
        if (path.StartsWith("/catalog")) return "Danh mục Kỹ thuật";
        if (path.StartsWith("/protocols")) return "Phác đồ Lâm sàng";
        if (path.StartsWith("/notifications")) return "Thông báo";
        if (path.StartsWith("/reports")) return "Báo cáo";
        if (path.StartsWith("/settings")) return "Cài đặt";
        return "Tổng quan";
    }

    private void OnSidebarCollapsedChanged(bool collapsed)
    {
        sidebarCollapsed = collapsed;
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        mobileMenuOpen = false;
    }
}
