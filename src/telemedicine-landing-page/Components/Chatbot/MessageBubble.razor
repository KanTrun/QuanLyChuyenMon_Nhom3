@using System.Globalization

<div class="chatbot-bubble @RoleClass">
    <div class="chatbot-bubble-content">
        @if (Message.Role == ChatRole.Assistant)
        {
            if (string.IsNullOrEmpty(Message.Content) && Message.IsStreaming)
            {
                <TypingIndicator />
            }
            else
            {
                @((MarkupString)MiniMarkdown.ToHtml(Message.Content))
                @if (Message.IsStreaming)
                {
                    <span class="chatbot-cursor" aria-hidden="true"></span>
                }
            }
        }
        else if (Message.Role == ChatRole.System)
        {
            <span class="chatbot-system-pill">@Message.Content</span>
        }
        else
        {
            @((MarkupString)EscapeUserContent(Message.Content))
        }
    </div>
    <div class="chatbot-bubble-time">@FormatTime(Message.Timestamp)</div>
</div>

@code {
    [Parameter, EditorRequired]
    public ChatMessage Message { get; set; } = default!;

    private string RoleClass => Message.Role switch
    {
        ChatRole.User => "is-user",
        ChatRole.Assistant => "is-assistant",
        ChatRole.System => "is-system",
        _ => "is-assistant",
    };

    private static readonly CultureInfo Vi = CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatTime(DateTime when) =>
        when.ToLocalTime().ToString("HH:mm", Vi);

    private static string EscapeUserContent(string? content)
    {
        if (string.IsNullOrEmpty(content)) return string.Empty;
        var sb = new System.Text.StringBuilder(content.Length);
        foreach (var ch in content)
        {
            switch (ch)
            {
                case '&': sb.Append("&amp;"); break;
                case '<': sb.Append("&lt;"); break;
                case '>': sb.Append("&gt;"); break;
                case '"': sb.Append("&quot;"); break;
                case '\'': sb.Append("&#39;"); break;
                case '\n': sb.Append("<br/>"); break;
                default: sb.Append(ch); break;
            }
        }
        return sb.ToString();
    }
}
